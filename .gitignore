# Private repository: artifacts/ deliberately holds binaries (the NeuralHub installer, its extracted
# gfx1201 code objects, a prebuilt Mesa). A public copy must be a new repository without artifacts/.
# NVIDIA's DLLs and weights are never committed, here or anywhere.
nvngx_*.dll
dlssnr*.bin

# Regenerated by tools/exe/extract.py or the build scripts.
out/
toolchain/
build/
tools/radv-offline/pipestats
__pycache__/

# Downloaded third-party pieces (the reference's fetch_deps.sh writes them here): pinned glslang,
# Vulkan-Headers, GE-Proton. Reproducible, not worth a copy in git.
artifacts/ref/
