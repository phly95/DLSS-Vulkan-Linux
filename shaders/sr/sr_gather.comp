#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol { uint8_t in_col_bytes[]; };
layout(set = 0, binding = 1) readonly buffer InMv  { uint8_t in_mv_bytes[]; };
layout(set = 0, binding = 2) readonly buffer InDep { uint8_t in_dep_bytes[]; };

layout(set = 0, binding = 3) writeonly buffer OutCol { f16vec4 g_col[]; };
layout(set = 0, binding = 4) writeonly buffer OutMv  { f16vec2 g_mv[]; };
layout(set = 0, binding = 5) writeonly buffer OutDep { float g_dep[]; };

layout(push_constant) uniform GatherArgs {
    layout(offset = 24) uint pitch_col;
    uint pitch_mv;
    uint pitch_dep;
    int fmt_col;
    int fmt_mv;
    int fmt_dep;
    layout(offset = 72) int W;
    int H;
    int mvhi;
    int pad;
};

uint read_u32_col(uint off) {
    uint b0 = uint(in_col_bytes[off]);
    uint b1 = uint(in_col_bytes[off + 1]);
    uint b2 = uint(in_col_bytes[off + 2]);
    uint b3 = uint(in_col_bytes[off + 3]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

uint16_t read_u16_col(uint off) {
    uint b0 = uint(in_col_bytes[off]);
    uint b1 = uint(in_col_bytes[off + 1]);
    return uint16_t(b0 | (b1 << 8));
}

uint read_u32_mv(uint off) {
    uint b0 = uint(in_mv_bytes[off]);
    uint b1 = uint(in_mv_bytes[off + 1]);
    uint b2 = uint(in_mv_bytes[off + 2]);
    uint b3 = uint(in_mv_bytes[off + 3]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

uint16_t read_u16_mv(uint off) {
    uint b0 = uint(in_mv_bytes[off]);
    uint b1 = uint(in_mv_bytes[off + 1]);
    return uint16_t(b0 | (b1 << 8));
}

uint read_u32_dep(uint off) {
    uint b0 = uint(in_dep_bytes[off]);
    uint b1 = uint(in_dep_bytes[off + 1]);
    uint b2 = uint(in_dep_bytes[off + 2]);
    uint b3 = uint(in_dep_bytes[off + 3]);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= W || y >= H) return;

    int out_idx = y * W + x;

    // Decode colour
    f16vec4 c = f16vec4(0.0);
    if (fmt_col == 0) {
        uint off = y * pitch_col + x * 8;
        uint16_t r = read_u16_col(off);
        uint16_t g = read_u16_col(off + 2);
        uint16_t b = read_u16_col(off + 4);
        uint16_t a = read_u16_col(off + 6);
        c = f16vec4(uint16BitsToFloat16(r), uint16BitsToFloat16(g), uint16BitsToFloat16(b), uint16BitsToFloat16(a));
    } else if (fmt_col == 1) {
        uint off = y * pitch_col + x * 4;
        float16_t r = float16_t(in_col_bytes[off]) / float16_t(255.0);
        float16_t g = float16_t(in_col_bytes[off + 1]) / float16_t(255.0);
        float16_t b = float16_t(in_col_bytes[off + 2]) / float16_t(255.0);
        float16_t a = float16_t(in_col_bytes[off + 3]) / float16_t(255.0);
        c = f16vec4(r, g, b, a);
    } else if (fmt_col == 2) {
        uint off = y * pitch_col + x * 4;
        float r = float(in_col_bytes[off]) / 255.0;
        float g = float(in_col_bytes[off + 1]) / 255.0;
        float b = float(in_col_bytes[off + 2]) / 255.0;
        float a = float(in_col_bytes[off + 3]) / 255.0;
        r = (r <= 0.04045) ? (r / 12.92) : pow((r + 0.055) / 1.055, 2.4);
        g = (g <= 0.04045) ? (g / 12.92) : pow((g + 0.055) / 1.055, 2.4);
        b = (b <= 0.04045) ? (b / 12.92) : pow((b + 0.055) / 1.055, 2.4);
        c = f16vec4(float16_t(r), float16_t(g), float16_t(b), float16_t(a));
    } else if (fmt_col == 3) {
        uint off = y * pitch_col + x * 4;
        uint u = read_u32_col(off);
        float r = float(u & 0x3ffu) / 1023.0;
        float g = float((u >> 10) & 0x3ffu) / 1023.0;
        float b = float((u >> 20) & 0x3ffu) / 1023.0;
        float a = float((u >> 30) & 0x3u) / 3.0;
        c = f16vec4(float16_t(r), float16_t(g), float16_t(b), float16_t(a));
    } else if (fmt_col == 4) {
        uint off = y * pitch_col + x * 4;
        uint u = read_u32_col(off);
        uint16_t r = uint16_t((u << 4) & 0x7ff0u);
        uint16_t g = uint16_t((u >> 7) & 0x7ff0u);
        uint16_t b = uint16_t((u >> 17) & 0x7fe0u);
        c = f16vec4(uint16BitsToFloat16(r), uint16BitsToFloat16(g), uint16BitsToFloat16(b), float16_t(1.0));
    } else if (fmt_col == 5) {
        uint off = y * pitch_col + x * 16;
        uint u0 = read_u32_col(off);
        uint u1 = read_u32_col(off + 4);
        uint u2 = read_u32_col(off + 8);
        uint u3 = read_u32_col(off + 12);
        c = f16vec4(float16_t(uintBitsToFloat(u0)),
                    float16_t(uintBitsToFloat(u1)),
                    float16_t(uintBitsToFloat(u2)),
                    float16_t(uintBitsToFloat(u3)));
    } else { // fmt_col == 6
        uint off = y * pitch_col + x * 4;
        uint u = read_u32_col(off);
        int exp_val = int((u >> 27) & 0x1fu) - 24;
        float scale = ldexp(1.0, exp_val);
        float r = float(u & 0x1ffu) * scale;
        float g = float((u >> 9) & 0x1ffu) * scale;
        float b = float((u >> 18) & 0x1ffu) * scale;
        c = f16vec4(float16_t(r), float16_t(g), float16_t(b), float16_t(1.0));
    }
    g_col[out_idx] = c;

    // Decode motion vector
    if (mvhi == 0) {
        if (fmt_mv == 0) {
            uint off_mv = y * pitch_mv + x * 4;
            uint16_t mx = read_u16_mv(off_mv);
            uint16_t my = read_u16_mv(off_mv + 2);
            g_mv[out_idx] = f16vec2(uint16BitsToFloat16(mx), uint16BitsToFloat16(my));
        } else if (fmt_mv == 1) {
            uint off_mv = y * pitch_mv + x * 8;
            uint mx = read_u32_mv(off_mv);
            uint my = read_u32_mv(off_mv + 4);
            g_mv[out_idx] = f16vec2(float16_t(uintBitsToFloat(mx)), float16_t(uintBitsToFloat(my)));
        } else {
            uint off_mv = y * pitch_mv + x * 8;
            uint16_t mx = read_u16_mv(off_mv);
            uint16_t my = read_u16_mv(off_mv + 2);
            g_mv[out_idx] = f16vec2(uint16BitsToFloat16(mx), uint16BitsToFloat16(my));
        }
    }

    // Decode depth
    if (fmt_dep == 0) {
        uint off_dep = y * pitch_dep + x * 4;
        uint du = read_u32_dep(off_dep);
        g_dep[out_idx] = uintBitsToFloat(du);
    } else {
        uint off_dep = y * pitch_dep + x * 4;
        uint du = read_u32_dep(off_dep);
        g_dep[out_idx] = float(du & 0xffffffu) / 16777215.0;
    }
}
