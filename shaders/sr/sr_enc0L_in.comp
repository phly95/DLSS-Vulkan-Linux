#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : enable

#include "rh.glsl"

// k_sr_enc0L_in (NeuralHub SR preset L, oracle launch 2). Spec: tools/sr/sr_enc0L_model.py
// (L-1 green: l0_in 100.0000% bit-exact vs the oracle on BOTH frames, the three MV buffers 100%).
// Every feature formula, constant and rounding point below is the model's, in its operation
// order; what changed against the first (bit-exact) port is the shape of the work, not the maths
// - the same techniques preset M's k_sr_enc0 (sr_enc0.comp) measured from 45.4 to 2.1 ms:
//
//  * one workgroup = one 8x8 tile of the PADDED grid = 64 lanes; the tile's 10x10 depth +
//    motion-vector neighbourhood (image coordinates, min row/col of the tile's mirrored rows
//    minus one) is loaded cooperatively into LDS once, so the 3x3 tournament costs 18 LDS reads
//    instead of 12 scattered global loads a pixel (sr_enc0.comp's sdep/smv staging, generalised
//    for the 2-pixel mirror border: the window is staged at image coordinates so every lane's
//    tournament reads the model's clamp(y+-1) cells in the model's exact visit order).
//  * the tournament tracks the winning MV VALUES (f16vec2 is one register) rather than the
//    winning row/column - same selection rule (ties keep the earlier element), ~25 fewer ops
//    a pixel, and the coordinates are never needed again.
//  * the four dhist samples share one bilinear setup per sample (dhsamp3: R,G,B ride the same
//    four word loads, 48 -> 16 a pixel), one dither word a pixel (the index depends on
//    (fc, y, x) only, 20 -> 1), and the hidden taps load one dword a tap (4 channels adjacent,
//    16 -> 4).
//  * dq()'s f16 round trips are the hardware's f16 adds/subtracts (the same RNE roundings the
//    bit-twiddled f32_to_f16_bits/f16_bits_to_f32 chain spelled out, ~6x fewer instructions):
//    dq_f32 is bit-identical to the model's, and the final E4M3 code stays the software q8r
//    (RNE, half-even subnormal grid) so the stored bytes keep the oracle's rounding exactly.
//
// Workgroup: one thread per PADDED pixel, 8x8 per tile (grid ((W0+8)+7)/8, (H0+8)+7)/8, block
// 64). r = padded row, c = padded column; the content region is rows 2..H0+1, cols 2..W0+1 =
// M's H0xW0 feature grid; the 2-pixel border mirrors it (yref = mirror2(r-2, H), xref =
// mirror2(c-2, W), model coords()/mirror()).
// Two jobs share the thread:
//  * the three MV outputs (model mv_outputs): the 3x3 depth tournament at (xref, yref) with the
//    reset select, stored for level-0 y in [0,H) and x in [0,W) as f16(3.0*(mvoff + g_mv[read]))
//    - prev_mvec[p^1] = reset ? max : min, mv_ero = reset ? min : max, mv_nondil = centre.
//    3.0 is Enc0Args+0xb4/0xb8 (mv_scale, exactly 3.0 in f32), mvoff is +0xbc (0 unjittered).
//  * l0_in: the 20 logical features (model features()), each through dq() (the dithered e4m3
//    quantizer, dither = enc0_w[0:4096] as 2048 u16, fc from push +0xdc, index phase
//    |coord-2| & 15), stored P-permuted: byte j of the pixel's 32 holds logical feature P(j)
//    (P = perm_invP's inverse; logical 20..31 are never written -> 0), eight dword writes a
//    pixel instead of 32 byte writes.
//
// Features 0..19 - identical set and math to preset M's k_sr_enc0 (tools/sr/sr_enc0_model.py),
// on the padded grid with L's preset constants from the push:
//   0..2  tm(e*rgb) of the mirrored+clamped g_col texel, e = expo[parity] (1.0 when 0),
//   3..14 four bilinear dhist samples (R,G,B) at the positions built from the min/centre/max MV
//         reads (+ F20 for samples 0..2, none for sample 3 = centre again); a sample whose
//         position word leaves [0,W15]x[0,H15] is not computed and keeps the colour feature,
//   15    SC * ln(1 + sqrt(S)) of the MV-vs-prev_mvec difference (L: k = +0xe8 = 2774.36/H,
//         SC = +0xd0 = 0.08225896209478378; no position mask),
//   16..19 the 4 int8 hidden0 channels warped at the sample-0 position (F28/size terms),
//   20..31 zero.
//
// Push constants: the oracle's Enc0Args offsets (the 288-byte struct cannot push; the host
// fills +0x58..+0xe8 for this pipeline, push 240 B - binding 9 = l0_in, 11 = expo).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// The tile's 10x10 depth + motion-vector neighbourhood, image coordinates, loaded cooperatively
// once: the 3x3 tournament then costs LDS reads instead of scattered global loads.
shared float sdep[100];
shared f16vec2 smv[100];
shared uint s_expo;

layout(set = 0, binding = 0) readonly buffer InCol        { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InDep        { float g_dep[]; };
layout(set = 0, binding = 2) readonly buffer InMv         { f16vec2 g_mv[]; };
layout(set = 0, binding = 3) readonly buffer InPrevMv     { f16vec2 in_prev_mvec[]; };
layout(set = 0, binding = 4) readonly buffer InDhist      { uint in_dhist[]; };
// the four int8 hidden channels of a pixel are adjacent bytes: one dword a tap, four taps a
// pixel (the buffer is raw bytes, the view type is this kernel's choice).
layout(set = 0, binding = 5) readonly buffer InHidden     { uint in_h4[]; };

layout(set = 0, binding = 6) writeonly buffer OutPrevMv   { f16vec2 out_prev_mvec[]; };
layout(set = 0, binding = 7) writeonly buffer OutMvEro    { f16vec2 out_mv_ero[]; };
layout(set = 0, binding = 8) writeonly buffer OutMvNondil { f16vec2 out_mv_nondil[]; };
// the pixel's 32 stored bytes = eight dwords (little-endian), one write a dword.
layout(set = 0, binding = 9) writeonly buffer OutL0In     { uint out_l0d[]; };
layout(set = 0, binding = 10) readonly buffer InEnc0W     { uint8_t enc0_w[]; };
// the exposure buffer holds the two parity words (Enc0Args+0x80); the kernel reads enc0[parity]
// as an f16 bit pattern and uses 1.0 when the word is 0 (model load()).
layout(set = 0, binding = 11) readonly buffer InExpo      { uint in_expo[]; };

layout(push_constant) uniform Enc0Args {
    layout(offset = 88) int W;
    int H;
    layout(offset = 104) int W0;
    int H0;
    layout(offset = 112) int W15;
    int H15;
    layout(offset = 120) int hW15;
    int hH15;
    layout(offset = 136) int parity;
    float F20x;                                 // +0x8c this frame's jitter
    float F20y;
    float F28x;                                 // +0x94 the previous frame's jitter
    float F28y;
    layout(offset = 188) float mvoffx;          // +0xbc mv_offset_kernel (0 unjittered)
    float mvoffy;
    layout(offset = 208) float SC;              // +0xd0 L: 0.08225896209478378
    layout(offset = 216) uint resetv;           // +0xd8 the reset select of the MV stores
    uint fc;                                    // +0xdc dither frame counter
    layout(offset = 232) float resetk;          // +0xe8 L: 2774.359619140625/H
};

// ---------------------------------------------------------------- helpers

// f32 -> e4m3 CODE, RNE, saturating at 448, subnormal grid rounded half-to-even: the model's
// q8r_code (the hardware packed e4m3 convert after the & 0xff80 truncation). NaN -> the normal
// branch, exactly as numpy's bits take it (0x7fc00000 -> code 0x3c). Kept as the first port
// spelled it: the stored bytes are the oracle's rounding, not the hardware convert's.
uint e4m3_q8r(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    uint bits = floatBitsToUint(a);
    if (a < 0.015625) {
        float s512 = a * 512.0;
        float nf = floor(s512);
        uint n = uint(nf);
        float d = s512 - nf;
        uint sub = ((d > 0.5) || (d == 0.5 && (n & 1u) != 0u)) ? n + 1u : n;
        return sign | sub;
    }
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | (norm & 0x7fu);
}

// f16 bits -> f32, exact (subnormals, +-inf, NaN) - the exposure decode below.
float f16_bits_to_f32(uint h) {
    uint s = (h & 0x8000u) << 16u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 0x3FFu;
    if (e == 0u) {
        float v = float(m) * 5.9604644775390625e-08;
        return ((h & 0x8000u) != 0u) ? -v : v;
    }
    if (e == 31u) return uintBitsToFloat(s | 0x7F800000u | (m << 13u));
    return uintBitsToFloat(s | ((e + 112u) << 23u) | (m << 13u));
}

// perm_P: stored byte (mod 32) -> logical channel = the inverse of perm_invP (model l0_in():
// byte j carries logical P[j]; verified 100% vs the oracle's stored channels).
uint perm_P(uint j) {
    return (j & 1u) | (((j >> 1u) & 1u) << 4u) | (((j >> 2u) & 1u) << 1u)
         | (((j >> 3u) & 1u) << 2u) | (((j >> 4u) & 1u) << 3u);
}

// The mirror of one axis (model mirror()): |v| if |v| < n else 2n-2-|v|, clamped [0, n-1].
int mirror2(int v, int n) {
    int a = abs(v);
    int r = (a < n) ? a : (2 * n - 2 - a);
    return clamp(r, 0, n - 1);
}

// ---------------------------------------------------------------- the MV fields (model mv_fields)

void mvstep(float d, f16vec2 m,
            inout float mxv, inout f16vec2 mxm,
            inout float mnv, inout f16vec2 mnm) {
    bool kp = mxv >= d;                     // keep the earlier element on ties
    mxv = kp ? mxv : d;  mxm = kp ? mxm : m;
    bool nw = d < mnv;
    mnv = nw ? d : mnv;  mnm = nw ? m : mnm;
}

struct MVF {
    vec2 mn;        // min-depth 3x3 read (+mvoff) -> dhist sample 0, reset's mv, prev_mvec on reset
    vec2 mx;        // max-depth 3x3 read          -> dhist sample 2, mv_ero on non-reset
    vec2 ct;        // centre read                 -> mv_nondil, dhist sample 1 and 3
};

// The 3x3 tournament from the wave's LDS copy of the tile's neighbourhood, in the model's exact
// visit order (centre, then the eight neighbours) with the model's clamped image coordinates:
// the window is staged at image coordinates, so the border lanes' reads are the oracle's cells
// and the tie-break order matches it. The winning MV VALUES are tracked, not row/col.
MVF mvf(int x, int row, int row0, int col0) {
    int xc = clamp(x, 0, W - 1);            // the padded grid's reads clamp to the render image
    int yc = clamp(row, 0, H - 1);
    int y1 = clamp(yc - 1, 0, H - 1), y2 = clamp(yc + 1, 0, H - 1);
    int x1 = clamp(xc - 1, 0, W - 1), x2 = clamp(xc + 1, 0, W - 1);
    // six base offsets (three row bases + three columns) instead of eighteen index products
    uint b0 = uint(yc - row0) * 10u, b1 = uint(y1 - row0) * 10u, b2 = uint(y2 - row0) * 10u;
    uint lx0 = uint(xc - col0), lx1 = uint(x1 - col0), lx2 = uint(x2 - col0);

    float d0 = sdep[b0 + lx0];                // centre
    float d1 = sdep[b1 + lx1];                // (y-1, x-1)
    float d2 = sdep[b1 + lx0];                // (y-1, x)
    float d3 = sdep[b1 + lx2];                // (y-1, x+1)
    float d4 = sdep[b0 + lx1];                // (y, x-1)
    float d5 = sdep[b0 + lx2];                // (y, x+1)
    float d6 = sdep[b2 + lx1];                // (y+1, x-1)
    float d7 = sdep[b2 + lx0];                // (y+1, x)
    float d8 = sdep[b2 + lx2];                // (y+1, x+1)

    f16vec2 m0 = smv[b0 + lx0];
    f16vec2 m1 = smv[b1 + lx1];
    f16vec2 m2 = smv[b1 + lx0];
    f16vec2 m3 = smv[b1 + lx2];
    f16vec2 m4 = smv[b0 + lx1];
    f16vec2 m5 = smv[b0 + lx2];
    f16vec2 m6 = smv[b2 + lx1];
    f16vec2 m7 = smv[b2 + lx0];
    f16vec2 m8 = smv[b2 + lx2];

    bool ge = d0 >= d1, gt = d0 > d1;
    float mxv = ge ? d0 : d1;  f16vec2 mxm = ge ? m0 : m1;
    float mnv = gt ? d1 : d0;  f16vec2 mnm = gt ? m1 : m0;
    mvstep(d2, m2, mxv, mxm, mnv, mnm);
    mvstep(d3, m3, mxv, mxm, mnv, mnm);
    mvstep(d4, m4, mxv, mxm, mnv, mnm);
    mvstep(d5, m5, mxv, mxm, mnv, mnm);
    mvstep(d6, m6, mxv, mxm, mnv, mnm);
    mvstep(d7, m7, mxv, mxm, mnv, mnm);
    mvstep(d8, m8, mxv, mxm, mnv, mnm);

    MVF f;
    f.ct = vec2(mvoffx, mvoffy) + vec2(float(m0.x), float(m0.y));
    f.mn = vec2(mvoffx, mvoffy) + vec2(float(mnm.x), float(mnm.y));
    f.mx = vec2(mvoffx, mvoffy) + vec2(float(mxm.x), float(mxm.y));
    return f;
}

// ---------------------------------------------------------------- the model's scalar functions

// The model's constants, by their exact f32 bit patterns (tools/sr/sr_enc0L_model.py hex).
#define C_CLAMP uintBitsToFloat(0x46FE0000u)   // 32512, min before the log
#define C_LO    uintBitsToFloat(0x38D1B717u)   // 1e-4
#define C_LOG   uintBitsToFloat(0x3E9A209Bu)   // log10(2)
#define C_SCALE uintBitsToFloat(0x3EB851ECu)   // 0.36
#define INV1023 uintBitsToFloat(0x3A802008u)   // 1/1023
#define C245    uintBitsToFloat(0x401CCCCDu)   // 2.45
#define LN2     uintBitsToFloat(0x3F317218u)   // ln(2)

// tm(v) (model colour feature pre-pass): fma(100, v, 1), max with 1e-4, log2*log10(2)*0.36,
// NaN -> 0.
float tm(float v) {
    float vc = (v > C_CLAMP) ? C_CLAMP : v;
    float t = fma(100.0, vc, 1.0);
    t = max(t, C_LO);
    float r = log2(t) * C_LOG;
    r = r * C_SCALE;
    return (v != v) ? 0.0 : r;
}

// One axis of a dhist sample position (model _axis): the round trip through (0.5/h)*C and the
// [-2, h+2] clamp (NaN -> -0.5), snapped to 1/256. Returns (tap, frac).
vec2 axis_dhist(float C, int h) {
    float a = (0.5 / float(h)) * C;
    float b = float(h) * a;
    float u = b - 0.5;
    u = (u != u) ? -0.5 : min(max(u, -2.0), float(h) + 2.0);
    float s = floor(u * 256.0 + 0.5) * (1.0 / 256.0);
    float tp = floor(s);
    return vec2(tp, s - tp);
}

// One bilinear dhist sample x 2.45 (model dhist_sample), all three channels at once: the taps
// and the bilinear weights are shared, only the 10-bit field of the loaded word moves (bits
// 0/10/20). The f32 accumulation order per channel is the model's
// ((w00*t00+w01*t01)+w10*t10)+w11*t11.
vec3 dhsamp3(vec2 C) {
    vec2 tx = axis_dhist(C.x, hW15);
    vec2 ty = axis_dhist(C.y, hH15);
    int ix = int(tx.x), iy = int(ty.x);
    float fx = tx.y, fy = ty.y;
    int x0 = clamp(ix, 0, hW15 - 1);
    int x1 = clamp(max(ix, -1) + 1, 0, hW15 - 1);
    int y0 = clamp(iy, 0, hH15 - 1);
    int y1 = clamp(max(iy, -1) + 1, 0, hH15 - 1);
    uint w00 = in_dhist[uint(y0 * hW15 + x0)];
    uint w01 = in_dhist[uint(y0 * hW15 + x1)];
    uint w10 = in_dhist[uint(y1 * hW15 + x0)];
    uint w11 = in_dhist[uint(y1 * hW15 + x1)];
    float b00 = (1.0 - fx) * (1.0 - fy);
    float b01 = fx * (1.0 - fy);
    float b10 = (1.0 - fx) * fy;
    float b11 = fx * fy;
    vec3 v;
    [[unroll]] for (uint ch = 0u; ch < 3u; ++ch) {
        uint sh = ch * 10u;
        float t00 = float((w00 >> sh) & 0x3FFu) * INV1023;
        float t01 = float((w01 >> sh) & 0x3FFu) * INV1023;
        float t10 = float((w10 >> sh) & 0x3FFu) * INV1023;
        float t11 = float((w11 >> sh) & 0x3FFu) * INV1023;
        v[ch] = (((b00 * t00 + b01 * t01) + b10 * t10) + b11 * t11) * C245;
    }
    return v;
}

// One axis of the prev_mvec interpolation (model reset_feature axis): clamp to [0,1] first,
// then the same [-2, n+2] clamp (NaN -> -0.5) and the 1/256 snap.
vec2 axis_reset(float u0, int n) {
    float t = u0 / float(n);
    t = min(max(t, 0.0), 1.0);
    float c = float(n) * t - 0.5;
    c = (c != c) ? -0.5 : min(max(c, -2.0), float(n) + 2.0);
    float s = floor(c * 256.0 + 0.5) * (1.0 / 256.0);
    float tp = floor(s);
    return vec2(tp, s - tp);
}

// Feature 15 (model reset_feature): the MV difference against the bilinear prev_mvec interp,
// the ISA's sqrt refinement, then SC * ln(1 + sqrt(S)) - L's k = +0xe8 and SC = +0xd0 come from
// the push (the oracle's own args words); NO position mask (model note).
float reset_feat(MVF f, float xx, float yy) {
    float ux = (F28x + (xx - F20x)) + f.mn.x;
    float uy = (F28y + (yy - F20y)) + f.mn.y;
    vec2 ax = axis_reset(ux, W);
    vec2 ay = axis_reset(uy, H);
    int ix = int(ax.x), iy = int(ay.x);
    float fx = ax.y, fy = ay.y;
    int x0 = clamp(ix, 0, W - 1);
    int x1 = clamp(max(ix, -1) + 1, 0, W - 1);
    int y0 = clamp(iy, 0, H - 1);
    int y1 = clamp(max(iy, -1) + 1, 0, H - 1);
    f16vec2 m00 = in_prev_mvec[uint(y0 * W + x0)];
    f16vec2 m01 = in_prev_mvec[uint(y0 * W + x1)];
    f16vec2 m10 = in_prev_mvec[uint(y1 * W + x0)];
    f16vec2 m11 = in_prev_mvec[uint(y1 * W + x1)];
    float w00 = (1.0 - fy) * (1.0 - fx);
    float w01 = fx * (1.0 - fy);
    float w10 = fy * (1.0 - fx);
    float w11 = fx * fy;
    float ipx = ((w00 * float(m00.x) + w01 * float(m01.x))
               + w10 * float(m10.x)) + w11 * float(m11.x);
    float ipy = ((w00 * float(m00.y) + w01 * float(m01.y))
               + w10 * float(m10.y)) + w11 * float(m11.y);
    float dx = f.mn.x - ipx * (1.0 / 3.0);
    float dy = f.mn.y - ipy * (1.0 / 3.0);
    float axv = resetk * dx;
    float ayv = resetk * dy;
    float S = axv * axv + ayv * ayv;
    float rt = sqrt(S);
    float down = uintBitsToFloat(floatBitsToUint(rt) - 1u);
    float up = uintBitsToFloat(floatBitsToUint(rt) + 1u);
    float r10 = S - up * rt;
    float root = (r10 > 0.0) ? up : ((r10 <= 0.0) ? down : rt);
    float v = 1.0 + root;
    v = log2(v) * LN2;
    v = v * SC;
    return v;
}

// One axis of the hidden warp (model _axis_hidden): one fused multiply-add t = C*(1/W15) + F28/W,
// then n*((1/n)*(n*t)) - 0.5 with the same clamp (NaN -> -0.5) and 1/256 snap.
vec2 axis_hid(float C, int n, float inv15, float off) {
    float t = fma(C, inv15, off);
    float nn = float(n);
    float c = nn * ((1.0 / nn) * (nn * t)) - 0.5;
    c = (c != c) ? -0.5 : min(max(c, -2.0), nn + 2.0);
    float s = floor(c * 256.0 + 0.5) * (1.0 / 256.0);
    float tp = floor(s);
    return vec2(tp, s - tp);
}

// The four int8 taps at one position as f32 (max(-1, i8/127)): one dword load, four extracts.
vec4 tap_hid4(int r, int c) {
    uint u = in_h4[uint(r * W + c)];
    return vec4(max(-1.0, float(int(int8_t(u        ))) * (1.0 / 127.0)),
                max(-1.0, float(int(int8_t(u >>  8u))) * (1.0 / 127.0)),
                max(-1.0, float(int(int8_t(u >> 16u))) * (1.0 / 127.0)),
                max(-1.0, float(int(int8_t(u >> 24u))) * (1.0 / 127.0)));
}

// dq() (model feature quantizer): x16 = f16(min(x, 1024)), the dither word OR-ed into the
// exponent, an f16 add and an f16 subtract (the hardware's, both RNE - the same roundings the
// bit-twiddled rh() chain spelled out, ~6x fewer instructions and no branch), the three high
// mantissa bits kept by a bit mask, then the model's q8r_code (RNE e4m3, half-even subnormal
// grid, software so the stored bytes keep the oracle's rounding). The dither word d =
// dither[idx] >> 9 depends on (fc, y, x) only, so the caller fetches it once a pixel.
uint dq_lo, dq_hi;                      // the two codes dq2 produces

// The dithered quantizer for TWO features a call (the pixel's twenty features run as ten
// pairs): identical per-value maths and rounding to the scalar dq(), but the f16 round trips
// are packed instructions and each pack/unpack moves both halves. The q8r keeps its sub/normal
// branch - the branchless spelling (attempt 2) measured SLOWER (0.546 vs 0.489): the branch is
// near-uniform a wave and both-paths-always cost more than it saved.
void dq2(vec2 x, uint d) {
    f16vec2 x16 = f16vec2(min(x, vec2(1024.0)));
    uint p = packHalf2x16(vec2(x16));
    uint Ex = p & 0xFC00u, Ey = (p >> 16u) & 0xFC00u;
    f16vec2 a = x16 + f16vec2(unpackHalf2x16(Ex | d).x, unpackHalf2x16(Ey | d).x);
    f16vec2 b = a - f16vec2(unpackHalf2x16(Ex).x, unpackHalf2x16(Ey).x);
    uint pb = packHalf2x16(vec2(b));
    f16vec2 t = f16vec2(unpackHalf2x16(pb & 0xFF80u).x,
                        unpackHalf2x16((pb >> 16u) & 0xFF80u).x);
    dq_lo = e4m3_q8r(t.x);
    dq_hi = e4m3_q8r(t.y);
}
#define DQ2(i0, v0, i1, v1) { dq2(vec2(v0, v1), dw); feat[i0] = dq_lo; feat[i1] = dq_hi; }

// ---------------------------------------------------------------- dispatch

void main() {
    uint tid = gl_LocalInvocationIndex;
    int r = int(gl_WorkGroupID.y * 8u + (tid >> 3));    // padded row
    int c = int(gl_WorkGroupID.x * 8u + (tid & 7u));    // padded column
    bool valid = (r < H0 + 8) && (c < W0 + 8);

    // The tile's window in IMAGE coordinates: the min mirrored row/col of the tile's eight
    // padded rows/cols, minus one - ten rows/cols cover every lane's +-1 neighbourhood whatever
    // the mirror border folds (the eight mapped coords always span <= 8).
    int r0p = int(gl_WorkGroupID.y * 8u) - 2;
    int c0p = int(gl_WorkGroupID.x * 8u) - 2;
    int row0 = mirror2(r0p, H);
    int col0 = mirror2(c0p, W);
    [[unroll]] for (int i = 1; i < 8; ++i) {
        row0 = min(row0, mirror2(r0p + i, H));
        col0 = min(col0, mirror2(c0p + i, W));
    }
    row0 -= 1;
    col0 -= 1;

    // The neighbourhood, every entry clamped at load time exactly as the tournament clamps its
    // reads. 100 entries, 64 lanes.
    [[loop]] for (uint i = tid; i < 100u; i += 64u) {
        uint ty = i / 10u, tx = i % 10u;
        int yy = clamp(row0 + int(ty), 0, H - 1);
        int xx = clamp(col0 + int(tx), 0, W - 1);
        uint gi = uint(yy * W + xx);
        sdep[i] = g_dep[gi];
        smv[i] = g_mv[gi];
    }
    if (tid == 0u) s_expo = in_expo[0];
    barrier();

    if (!valid) return;
    int yref = mirror2(r - 2, H);
    int xref = mirror2(c - 2, W);
    float xx = float(xref) + 0.5;
    float yy = float(yref) + 0.5;

    // e = expo[parity] as f16, 1.0 when the word is 0
    uint ep = s_expo;
    uint eb = ((uint(parity) & 1u) != 0u) ? (ep >> 16u) : (ep & 0xFFFFu);
    float e = (eb == 0u) ? 1.0 : f16_bits_to_f32(eb);

    MVF m = mvf(xref, yref, row0, col0);

    // ---- the three MV outputs (model mv_outputs): stored for level-0 y in [0,H), x in [0,W) ----
    int yl = r - 2, xl = c - 2;
    if (yl >= 0 && yl < H && xl >= 0 && xl < W) {
        uint oi = uint(yl * W + xl);
        vec2 prev = (resetv != 0u) ? m.mx : m.mn;
        vec2 ero  = (resetv != 0u) ? m.mn : m.mx;
        // the f16 conversion IS the model's rh(): v_cvt_f16_f32 rounds RNE
        out_prev_mvec[oi] = f16vec2(3.0 * prev.x, 3.0 * prev.y);
        out_mv_ero[oi]    = f16vec2(3.0 * ero.x, 3.0 * ero.y);
        out_mv_nondil[oi] = f16vec2(3.0 * m.ct.x, 3.0 * m.ct.y);
    }

    // ---- l0_in: the 20 logical features, dq'd, stored P-permuted ----
    uint xi = uint(abs(c - 2));
    uint yi = uint(abs(r - 2));

    // 0..2: tm(e * rgb) of the mirrored+clamped g_col texel
    uint ci = uint(xref) + uint(yref) * uint(W);
    f16vec4 gc = g_col[ci];
    float tm0 = tm(float(gc.x) * e);
    float tm1 = tm(float(gc.y) * e);
    float tm2 = tm(float(gc.z) * e);

    // one dither word for the pixel's twenty features (model dq: idx = fc, y, x)
    uint didx = ((fc & 7u) << 8u) | ((yi & 15u) << 4u) | (xi & 15u);
    uint dw = (uint(enc0_w[2u * didx]) | (uint(enc0_w[2u * didx + 1u]) << 8u)) >> 9u;

    // 3..14: four dhist samples x R,G,B. Samples 0..2 ride the min/centre/max MV reads with the
    // 3*((p+0.5) - F20) base; sample 3 has no -F20 term and uses the centre read again. A sample
    // whose position word leaves [0,W15]x[0,H15] is not computed and keeps the colour feature
    // (model oob_mask).
    float base_x = 3.0 * (xx - F20x);
    float base_y = 3.0 * (yy - F20y);
    vec2 P0 = vec2(base_x + 3.0 * m.mn.x, base_y + 3.0 * m.mn.y);
    vec2 P1 = vec2(base_x + 3.0 * m.ct.x, base_y + 3.0 * m.ct.y);
    vec2 P2 = vec2(base_x + 3.0 * m.mx.x, base_y + 3.0 * m.mx.y);
    vec2 P3 = vec2(3.0 * xx + 3.0 * m.ct.x, 3.0 * yy + 3.0 * m.ct.y);

    uint feat[20];
    float fv[20];
    fv[0] = tm0; fv[1] = tm1; fv[2] = tm2;
#define DHSAMP(P, b0, b1, b2) { \
        vec2 Cc = (P); \
        bool oob = (Cc.x < 0.0) || (Cc.x > float(W15)) || (Cc.y < 0.0) || (Cc.y > float(H15)); \
        vec3 v = oob ? vec3(b0, b1, b2) : dhsamp3(Cc); \
        fv[k] = v.x; fv[k + 1u] = v.y; fv[k + 2u] = v.z; }
    uint k = 3u; DHSAMP(P0, tm0, tm1, tm2)
    k = 6u;  DHSAMP(P1, tm0, tm1, tm2)
    k = 9u;  DHSAMP(P2, tm0, tm1, tm2)
    k = 12u; DHSAMP(P3, tm0, tm1, tm2)
#undef DHSAMP

    // 15: reset (L's k/SC, no position mask)
    fv[15] = reset_feat(m, xx, yy);

    // 16..19: the hidden warp at the sample-0 position, four channels a tap position
    vec2 hx = axis_hid(P0.x, W, 1.0 / float(W15), F28x / float(W));
    vec2 hy = axis_hid(P0.y, H, 1.0 / float(H15), F28y / float(H));
    int hix = int(hx.x), hiy = int(hy.x);
    int hx0 = clamp(hix, 0, W - 1);
    int hx1 = clamp(max(hix, -1) + 1, 0, W - 1);
    int hy0 = clamp(hiy, 0, H - 1);
    int hy1 = clamp(max(hiy, -1) + 1, 0, H - 1);
    float hfx = hx.y, hfy = hy.y;
    vec4 wv = vec4((1.0 - hfy) * (1.0 - hfx), (1.0 - hfy) * hfx,
                   hfy * (1.0 - hfx), hfy * hfx);
    vec4 t00 = tap_hid4(hy0, hx0), t01 = tap_hid4(hy0, hx1);
    vec4 t10 = tap_hid4(hy1, hx0), t11 = tap_hid4(hy1, hx1);
    [[unroll]] for (uint kk = 0u; kk < 4u; ++kk) {
        fv[16u + kk] = ((wv.x * t00[kk] + wv.y * t01[kk])
                      + wv.z * t10[kk]) + wv.w * t11[kk];
    }

    // the twenty quantizers as ten independent pairs
    DQ2(0, fv[0], 1, fv[1])     DQ2(2, fv[2], 3, fv[3])
    DQ2(4, fv[4], 5, fv[5])     DQ2(6, fv[6], 7, fv[7])
    DQ2(8, fv[8], 9, fv[9])     DQ2(10, fv[10], 11, fv[11])
    DQ2(12, fv[12], 13, fv[13]) DQ2(14, fv[14], 15, fv[15])
    DQ2(16, fv[16], 17, fv[17]) DQ2(18, fv[18], 19, fv[19])

    // the store: byte j = logical feature P(j); logical 20..31 are never written -> 0; eight
    // dwords a pixel (little-endian).
    uint base4 = uint(r * int(W0 + 8) + c) * 8u;
    [[unroll]] for (uint b = 0u; b < 8u; ++b) {
        uint word = 0u;
        [[unroll]] for (uint kk = 0u; kk < 4u; ++kk) {
            uint L = perm_P(4u * b + kk);
            uint code = (L < 20u) ? feat[L] : 0u;
            word |= code << (8u * kk);
        }
        out_l0d[base4 + b] = word;
    }
}
