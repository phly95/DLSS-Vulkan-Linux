#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform ExposurePushConstants {
    uint g_col_offset;
    uint expo_offset;
    uint luma_offset;
    int W;
    int H;
    float fixed_exposure;
    float pre_exposure;
    int is_auto;
    int phase; // 0 = fixed, 1 = ae_luma, 2 = ae_reduce, 3 = ae_copy
    int count;
} pc;

layout(set = 0, binding = 0, std430) buffer ActBuffer {
    uint8_t acts[];
};

float16_t read_f16(uint idx) {
    uint16_t lo = uint16_t(acts[idx]) | (uint16_t(acts[idx + 1u]) << 8u);
    return unpackFloat2x16(uint(lo)).x;
}

void write_f16(uint idx, float16_t val) {
    uint16_t u = uint16_t(packHalf2x16(vec2(float(val), 0.0)) & 0xFFFFu);
    acts[idx]      = uint8_t(u & 0xFFu);
    acts[idx + 1u] = uint8_t((u >> 8u) & 0xFFu);
}

float read_f32(uint idx) {
    uint b0 = uint(acts[idx]) | (uint(acts[idx + 1u]) << 8u) | (uint(acts[idx + 2u]) << 16u) | (uint(acts[idx + 3u]) << 24u);
    return uintBitsToFloat(b0);
}

void write_f32(uint idx, float val) {
    uint b0 = floatBitsToUint(val);
    acts[idx]      = uint8_t(b0 & 0xFFu);
    acts[idx + 1u] = uint8_t((b0 >> 8u) & 0xFFu);
    acts[idx + 2u] = uint8_t((b0 >> 16u) & 0xFFu);
    acts[idx + 3u] = uint8_t((b0 >> 24u) & 0xFFu);
}

void main() {
    uint tid = gl_GlobalInvocationID.x;

    if (pc.phase == 0) {
        // Fixed exposure
        if (tid == 0u) {
            write_f16(pc.expo_offset, float16_t(pc.fixed_exposure));
            write_f16(pc.expo_offset + 2u, float16_t(pc.pre_exposure));
        }
    } else if (pc.phase == 1) {
        // Auto-exposure: luma calculation
        int ae_gw = (pc.W + 7) / 8;
        int ae_gh = (pc.H + 7) / 8;
        int total_tiles = ae_gw * ae_gh;
        if (int(tid) >= total_tiles) return;

        int tx = int(tid) % ae_gw;
        int ty = int(tid) / ae_gw;
        int rx0 = tx * 8;
        int ry0 = ty * 8;

        float luma_sum = 0.0;
        for (int dy = 0; dy < 8; ++dy) {
            for (int dx = 0; dx < 8; ++dx) {
                int cx = clamp(rx0 + dx, 0, pc.W - 1);
                int cy = clamp(ry0 + dy, 0, pc.H - 1);
                uint c_idx = pc.g_col_offset + uint((cy * pc.W + cx) * 8);
                float r = float(read_f16(c_idx));
                float g = float(read_f16(c_idx + 2u));
                float b = float(read_f16(c_idx + 4u));
                float Y = 0.2126 * r + 0.7152 * g + 0.0722 * b;
                luma_sum += log(max(Y, 0.0001));
            }
        }
        write_f32(pc.luma_offset + tid * 4u, luma_sum / 64.0);
    } else if (pc.phase == 2) {
        // Reduction
        if (int(tid) >= pc.count) return;
        float v = read_f32(pc.luma_offset + tid * 4u);
        float sum = subgroupAdd(v);
        if (subgroupElect()) {
            write_f32(pc.luma_offset + (gl_SubgroupID) * 4u, sum);
        }
    } else if (pc.phase == 3) {
        // Copy final exposure
        if (tid == 0u) {
            float avg_log_luma = read_f32(pc.luma_offset);
            float exp_val = clamp(0.18 / exp(avg_log_luma), 0.1, 10.0);
            write_f16(pc.expo_offset, float16_t(exp_val));
            write_f16(pc.expo_offset + 2u, float16_t(pc.pre_exposure));
        }
    }
}
