#version 460
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InData  { float in_data[]; };
layout(set = 0, binding = 1) writeonly buffer OutData { float out_data[]; };

layout(push_constant) uniform AEReduceArgs {
    layout(offset = 8) int n;
    layout(offset = 24) int exact_sum;
};

shared float s_data[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_WorkGroupID.x;
    uint base = gid * 512;
    uint idx1 = base + tid;
    uint idx2 = base + tid + 256;

    float sum = 0.0;
    if (idx1 < n) sum += in_data[idx1];
    if (idx2 < n) sum += in_data[idx2];
    s_data[tid] = sum;
    barrier();

    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            s_data[tid] += s_data[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        out_data[gid] = s_data[0];
    }
}
