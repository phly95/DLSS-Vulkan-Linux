#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable
// NR_QUANT_MODE 4: the layer-1 ReLU clamp's upper bound (448) is the driver's saturating
// convert (the MODE register), the same choice as sr_swin.comp.
#define NR_QUANT_MODE 4
#include "nh_mm.glsl"

// sr_l0emb: preset L's enc0L embedding (launch 3's first phase). Spec: tools/sr/sr_l0_model.py
// embed(): E = f16(e1 . W2 + b2) with e1 = q8(clip(f16(x . W1 + b1), 0, 448)) over every pixel
// of the padded (W0+8)x(H0+8) l0_in buffer. The block kernel downstream works in the STORED
// channel basis (slot j = logical perm_P(j), like sr_swin), so the host bakes the permutation
// into the row-major W1s/W2s matrices (both axes) and the biases are already in stored order
// in the blob (32-channel P-permuted f16 vector = stored order); the kernel never permutes.
//
// One wave = 16 pixels (M = 16, one WMMA M-tile). Layer 1: A = 16x32 input tile staged from
// l0_in into LDS (raw fp8 bytes), B = W1s [32][32] row-major from wrep (ColumnMajor load, K
// contiguous); quantise the accumulator (ReLU + E4M3) into sE bytes; layer 2: A from sE,
// B = W2s, epilogue + f16 bias, f16 stores to E. f32 accumulation everywhere (precision policy).
// E is fp8 (the model's f16 rounding at this point is dropped per the precision policy -
// the M chain already quantises every block input to fp8) in stored basis, [NP][32]
// row-major, which is exactly the single-group [H][W][32] tensor the block kernel stages.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InW16 { float16_t wbuf16[]; };
layout(set = 0, binding = 1) readonly buffer InAct { uvec4 in_act4[]; };
#ifndef NR_OPERAND_F16
layout(set = 0, binding = 2) writeonly buffer OutE { NR_OPERAND out_e[]; };
#else
layout(set = 0, binding = 2) writeonly buffer OutE { float16_t out_e[]; };
#endif
#ifndef NR_OPERAND_F16
layout(set = 0, binding = 3, std430) readonly buffer WRep { NR_OPERAND wrep[]; };
#else
layout(set = 0, binding = 3) readonly buffer WRepB { uint8_t wrep8[]; };
#endif

layout(push_constant) uniform EmbArgs {
    uint w1_off;      // W1s row-major base in wrep (bytes->elements: same count, u8 vs e4m3)
    uint w2_off;
    uint b1_off;      // f16 index base in wbuf16 (blob byte offset >> 1)
    uint b2_off;
    uint dimW;        // padded width IW (pixels)
    uint dimH;        // padded height IH
};

float e4m3_to_f32(uint b) {
    uint e = (b >> 3u) & 15u;
    float v = (e == 0u) ? float(b & 7u) * 0.001953125
                        : uintBitsToFloat(((e + 120u) << 23u) | ((b & 7u) << 20u));
    return ((b & 0x80u) != 0u) ? -v : v;
}
// f32 -> E4M3, RNE with ties-to-even in the SUBNORMAL path, saturating at 448 (the model's
// to_e4m3 / the old shader's f32_to_e4m3_rne). Scalar fallback only (RADV uses hardware).
uint f32_to_e4m3_rne(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    float s = a * 512.0;
    float n = floor(s);
    float d = s - n;
    uint sub = uint(((d > 0.5) || (d == 0.5 && ((uint(n) & 1u) != 0u))) ? (n + 1.0) : n);
    uint bits = floatBitsToUint(a);
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | ((a < 0.015625) ? sub : (norm & 0x7fu));
}
uint byte_of(uint w, uint k) { return (w >> (8u * k)) & 0xffu; }

#ifndef NR_OPERAND_F16
shared NR_OPERAND sX[16 * 32];   // layer-1 A tile: 16 pixels x 32 ch (raw fp8 bytes)
shared NR_OPERAND sE[16 * 32];   // layer-1 output tile: 16 pixels x 32 ch (quantised fp8)

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint h = tid >> 4u;                 // pixel-half of this lane (rows 8h..8h+7)
    uint m = tid & 15u;                 // column of this lane inside a 16-wide tile
    uint NP = dimW * dimH;
    // 2D grid (the 1080p padded tensor holds 2.1 M pixels > 64K waves): each workgroup
    // covers 16 consecutive pixels of one row.
    uint wbase = gl_WorkGroupID.y * dimW + gl_WorkGroupID.x * 16u;

    // ---- stage 16 pixels into sX (16 bytes a lane, then one barrier) ----
    {
        uint pix = (tid >> 1u);
        uint hh = tid & 1u;
        uint p = wbase + pix;
        uint byte = p * 32u + hh * 16u;
        uvec4 q = (p < NP) ? in_act4[byte >> 4u] : uvec4(0u);
        sX[pix * 32u + hh * 16u + 0u] = NR_OPERAND(e4m3_to_f32(byte_of(q.x, 0u)));
        sX[pix * 32u + hh * 16u + 1u] = NR_OPERAND(e4m3_to_f32(byte_of(q.x, 1u)));
        sX[pix * 32u + hh * 16u + 2u] = NR_OPERAND(e4m3_to_f32(byte_of(q.x, 2u)));
        sX[pix * 32u + hh * 16u + 3u] = NR_OPERAND(e4m3_to_f32(byte_of(q.x, 3u)));
        sX[pix * 32u + hh * 16u + 4u] = NR_OPERAND(e4m3_to_f32(byte_of(q.y, 0u)));
        sX[pix * 32u + hh * 16u + 5u] = NR_OPERAND(e4m3_to_f32(byte_of(q.y, 1u)));
        sX[pix * 32u + hh * 16u + 6u] = NR_OPERAND(e4m3_to_f32(byte_of(q.y, 2u)));
        sX[pix * 32u + hh * 16u + 7u] = NR_OPERAND(e4m3_to_f32(byte_of(q.y, 3u)));
        sX[pix * 32u + hh * 16u + 8u] = NR_OPERAND(e4m3_to_f32(byte_of(q.z, 0u)));
        sX[pix * 32u + hh * 16u + 9u] = NR_OPERAND(e4m3_to_f32(byte_of(q.z, 1u)));
        sX[pix * 32u + hh * 16u + 10u] = NR_OPERAND(e4m3_to_f32(byte_of(q.z, 2u)));
        sX[pix * 32u + hh * 16u + 11u] = NR_OPERAND(e4m3_to_f32(byte_of(q.z, 3u)));
        sX[pix * 32u + hh * 16u + 12u] = NR_OPERAND(e4m3_to_f32(byte_of(q.w, 0u)));
        sX[pix * 32u + hh * 16u + 13u] = NR_OPERAND(e4m3_to_f32(byte_of(q.w, 1u)));
        sX[pix * 32u + hh * 16u + 14u] = NR_OPERAND(e4m3_to_f32(byte_of(q.w, 2u)));
        sX[pix * 32u + hh * 16u + 15u] = NR_OPERAND(e4m3_to_f32(byte_of(q.w, 3u)));
    }
    memoryBarrierShared();
    barrier();

    // ---- layer 1: 16 px x 32 ch, two N tiles ----
    NR_FRAG_ACC a0 = NR_ACC_ZERO, a1 = NR_ACC_ZERO;
    for (uint k = 0u; k < 32u; k += 16u) {
        NR_FRAG_A fa;
        NR_LOAD_A(fa, sX, k, 32u);
        NR_FRAG_B b0, b1;
        NR_LOAD_B(b0, wrep, w1_off + k, 32u);
        NR_LOAD_B(b1, wrep, w1_off + 16u * 32u + k, 32u);
        NR_MMA(a0, fa, b0);
        NR_MMA(a1, fa, b1);
    }
    // ---- ReLU + E4M3 into sE bytes (scalar stores, one barrier) ----
    {
        float g0 = float(wbuf16[b1_off + m]);
        float g1 = float(wbuf16[b1_off + 16u + m]);
        for (uint i = 0u; i < 8u; i += 2u) {
            vec2 v0 = vec2(max(a0[i] + g0, 0.0), max(a0[i + 1u] + g0, 0.0));
            vec2 v1 = vec2(max(a1[i] + g1, 0.0), max(a1[i + 1u] + g1, 0.0));
            // NOTE: no local for the packed result (R1 forbids naming the FP8 vec type in
            // shaders/): the .x/.y reads fold into the same v_cvt pair.
            sE[(8u * h + i) * 32u + m] = nr_quant_pair32(v0).x;
            sE[(8u * h + i + 1u) * 32u + m] = nr_quant_pair32(v0).y;
            sE[(8u * h + i) * 32u + 16u + m] = nr_quant_pair32(v1).x;
            sE[(8u * h + i + 1u) * 32u + 16u + m] = nr_quant_pair32(v1).y;
        }
    }
    memoryBarrierShared();
    barrier();

    // ---- layer 2 + quantised epilogue, one N tile a step ----
    // E is fp8 in stored basis (the block kernel stages it like any activation tensor;
    // the model's f16 rounding here is dropped per the precision policy).
    for (uint n0 = 0u; n0 < 32u; n0 += 16u) {
        NR_FRAG_ACC acc = NR_ACC_ZERO;
        for (uint k = 0u; k < 32u; k += 16u) {
            NR_FRAG_A fa;
            NR_LOAD_A(fa, sE, k, 32u);
            NR_FRAG_B fb;
            NR_LOAD_B(fb, wrep, w2_off + 16u * (n0 >> 4u) * 32u + k, 32u);
            NR_MMA(acc, fa, fb);
        }
        float g = float(wbuf16[b2_off + n0 + m]);
        for (uint i = 0u; i < 8u; i += 2u) {
            uint p0 = wbase + 8u * h + i;
            uint p1 = wbase + 8u * h + i + 1u;
            if (p0 < NP) out_e[p0 * 32u + n0 + m] =
                nr_quant_pair32(vec2(acc[i] + g, acc[i + 1u] + g)).x;
            if (p1 < NP) out_e[p1 * 32u + n0 + m] =
                nr_quant_pair32(vec2(acc[i] + g, acc[i + 1u] + g)).y;
        }
    }
}

#else
// Lavapipe / offline fallback (O7): same math, scalar, deterministic. The fp8 input bytes are
// read raw and decoded by hand (they are NOT f16); the f16 build only widens the OPERAND type.
// Same 2D grid as the RADV path (16 pixels a wave); each pixel is computed twice (once per
// lane pair) - idempotent, lavapipe only.
void main() {
    uint tid = gl_LocalInvocationID.x;
    uint NP = dimW * dimH;
    uint p = gl_WorkGroupID.y * dimW + gl_WorkGroupID.x * 16u + (tid >> 1u);
    if (p >= NP) return;
    float x[32];
    {
        uvec4 q0 = in_act4[(p * 32u) >> 4u];
        uvec4 q1 = in_act4[((p * 32u) >> 4u) + 1u];
        uint ws[8]; ws[0] = q0.x; ws[1] = q0.y; ws[2] = q0.z; ws[3] = q0.w;
                    ws[4] = q1.x; ws[5] = q1.y; ws[6] = q1.z; ws[7] = q1.w;
        for (uint i = 0u; i < 32u; ++i) x[i] = e4m3_to_f32(byte_of(ws[i >> 2u], i & 3u));
    }
    float e1[32];
    for (uint s = 0u; s < 32u; ++s) {
        float a = float(wbuf16[b1_off + s]);
        for (uint t = 0u; t < 32u; ++t) a += x[t] * e4m3_to_f32(uint(wrep8[w1_off + s * 32u + t]));
        // the model's q8: clip the f16 value, then E4M3-quantise (and back to f32)
        e1[s] = e4m3_to_f32(f32_to_e4m3_rne(clamp(float16_t(a), float16_t(0.0), float16_t(448.0))));
    }
    for (uint s = 0u; s < 32u; ++s) {
        float a = float(wbuf16[b2_off + s]);
        for (uint t = 0u; t < 32u; ++t) a += e1[t] * e4m3_to_f32(uint(wrep8[w2_off + s * 32u + t]));
        out_e[p * 32u + s] = float16_t(a);
    }
}
#endif
