#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InWeights { uint8_t wbuf[]; };
layout(set = 0, binding = 1) readonly buffer InAct     { uint8_t in_act[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct   { uint8_t out_act[]; };
layout(set = 0, binding = 3) buffer OutAct2            { uint8_t out_act2[]; };
// Decoder (mode 2) skip input: oracle launches 11/12 pass it at StageArgs offset 16
// (t3 for st8, t1 for st9).  Same [C/32][H][W][32] shape as this stage's own output, so
// it is indexed with out_base.  Never read in mode 0 - that is why the oracle omits
// offset 16 there.
layout(set = 0, binding = 4) readonly buffer SkipAct    { uint8_t skip_act[]; };

layout(push_constant) uniform StageArgs {
    uint wbuf_lo;
    uint wbuf_hi;
    layout(offset = 40) int dimW;
    int dimH;
    int shiftX;
    int shiftY;
};

const uint P[32] = uint[32](
    0, 1, 16, 17, 2, 3, 18, 19, 4, 5, 20, 21, 6, 7, 22, 23,
    8, 9, 24, 25, 10, 11, 26, 27, 12, 13, 28, 29, 14, 15, 30, 31
);

const uint invP[32] = uint[32](
    0, 1, 4, 5, 8, 9, 12, 13, 16, 17, 20, 21, 24, 25, 28, 29,
    2, 3, 6, 7, 10, 11, 14, 15, 18, 19, 22, 23, 26, 27, 30, 31
);

shared float16_t s_act[64][96];   // 12288 bytes
shared float16_t s_norm[64][96];  // 12288 bytes
shared float16_t s_mlp[64][96];   // 12288 bytes
shared float16_t s_kv[4][16][32]; // 4096 bytes

