#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable

// k_sr_stage (NeuralHub SR stage launches 3, 4 = mode 0; 11, 12 = mode 2). The arithmetic is the
// spec in tools/sr/sr_stage_model.py (run_stage and its helpers): every rounding point is an
// explicit f16 (rh) or E4M3 (q8) step, in the model's order. Notes: docs/notes/k_sr_stage.md
// (Review R1, R2); byte map docs/sr/STAGE-LAYOUT.md.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InWeights { uint8_t wbuf[]; };
layout(set = 0, binding = 1) readonly buffer InAct     { uint8_t in_act[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct   { uint8_t out_act[]; };
layout(set = 0, binding = 3) buffer OutAct2            { uint8_t out_act2[]; };
// Mode 2 (decoder) skip: the fp8 tensor bound at StageArgs offset 16 (oracle launches 11/12).
// Same [C/32][H][W][32] layout as this stage's output. Never read in mode 0.
layout(set = 0, binding = 4) readonly buffer SkipAct   { uint8_t skip_act[]; };

layout(push_constant) uniform StageArgs {
    uint wbuf_lo;
    uint wbuf_hi;
    layout(offset = 40) int dimW;
    int dimH;
    int shiftX;
    int shiftY;
};

// One thread per token. A 16-token window is 16 consecutive threads; the 8x8 tile holds 4 windows.
// Token index in a tile: tid = ((dy>>2)*2 + (dx>>2))*16 + (dy&3)*4 + (dx&3)  (window-major).
shared float16_t s_act[64][96];    // residual stream
shared float16_t s_norm[64][96];   // RMSNorm output (q8); then q8(out) for the mode-0 projection
shared float s_acc[64][96];        // attention sum (f32), then the MLP sum (holds f16 values)
shared float16_t s_K8[4][16][32];  // q8(K) of the window's 16 tokens
shared float16_t s_V[4][16][32];   // V = f16(K)

const float16_t e4m3_lut[256] = float16_t[256](
    float16_t(0), float16_t(0.001953125), float16_t(0.00390625), float16_t(0.005859375), float16_t(0.0078125), float16_t(0.009765625), float16_t(0.01171875), float16_t(0.013671875),
    float16_t(0.015625), float16_t(0.017578125), float16_t(0.01953125), float16_t(0.021484375), float16_t(0.0234375), float16_t(0.025390625), float16_t(0.02734375), float16_t(0.029296875),
    float16_t(0.03125), float16_t(0.03515625), float16_t(0.0390625), float16_t(0.04296875), float16_t(0.046875), float16_t(0.05078125), float16_t(0.0546875), float16_t(0.05859375),
    float16_t(0.0625), float16_t(0.0703125), float16_t(0.078125), float16_t(0.0859375), float16_t(0.09375), float16_t(0.1015625), float16_t(0.109375), float16_t(0.1171875),
    float16_t(0.125), float16_t(0.140625), float16_t(0.15625), float16_t(0.171875), float16_t(0.1875), float16_t(0.203125), float16_t(0.21875), float16_t(0.234375),
    float16_t(0.25), float16_t(0.28125), float16_t(0.3125), float16_t(0.34375), float16_t(0.375), float16_t(0.40625), float16_t(0.4375), float16_t(0.46875),
    float16_t(0.5), float16_t(0.5625), float16_t(0.625), float16_t(0.6875), float16_t(0.75), float16_t(0.8125), float16_t(0.875), float16_t(0.9375),
    float16_t(1), float16_t(1.125), float16_t(1.25), float16_t(1.375), float16_t(1.5), float16_t(1.625), float16_t(1.75), float16_t(1.875),
    float16_t(2), float16_t(2.25), float16_t(2.5), float16_t(2.75), float16_t(3), float16_t(3.25), float16_t(3.5), float16_t(3.75),
    float16_t(4), float16_t(4.5), float16_t(5), float16_t(5.5), float16_t(6), float16_t(6.5), float16_t(7), float16_t(7.5),
    float16_t(8), float16_t(9), float16_t(10), float16_t(11), float16_t(12), float16_t(13), float16_t(14), float16_t(15),
    float16_t(16), float16_t(18), float16_t(20), float16_t(22), float16_t(24), float16_t(26), float16_t(28), float16_t(30),
    float16_t(32), float16_t(36), float16_t(40), float16_t(44), float16_t(48), float16_t(52), float16_t(56), float16_t(60),
    float16_t(64), float16_t(72), float16_t(80), float16_t(88), float16_t(96), float16_t(104), float16_t(112), float16_t(120),
    float16_t(128), float16_t(144), float16_t(160), float16_t(176), float16_t(192), float16_t(208), float16_t(224), float16_t(240),
    float16_t(256), float16_t(288), float16_t(320), float16_t(352), float16_t(384), float16_t(416), float16_t(448), float16_t(480),
    float16_t(-0), float16_t(-0.001953125), float16_t(-0.00390625), float16_t(-0.005859375), float16_t(-0.0078125), float16_t(-0.009765625), float16_t(-0.01171875), float16_t(-0.013671875),
    float16_t(-0.015625), float16_t(-0.017578125), float16_t(-0.01953125), float16_t(-0.021484375), float16_t(-0.0234375), float16_t(-0.025390625), float16_t(-0.02734375), float16_t(-0.029296875),
    float16_t(-0.03125), float16_t(-0.03515625), float16_t(-0.0390625), float16_t(-0.04296875), float16_t(-0.046875), float16_t(-0.05078125), float16_t(-0.0546875), float16_t(-0.05859375),
    float16_t(-0.0625), float16_t(-0.0703125), float16_t(-0.078125), float16_t(-0.0859375), float16_t(-0.09375), float16_t(-0.1015625), float16_t(-0.109375), float16_t(-0.1171875),
    float16_t(-0.125), float16_t(-0.140625), float16_t(-0.15625), float16_t(-0.171875), float16_t(-0.1875), float16_t(-0.203125), float16_t(-0.21875), float16_t(-0.234375),
    float16_t(-0.25), float16_t(-0.28125), float16_t(-0.3125), float16_t(-0.34375), float16_t(-0.375), float16_t(-0.40625), float16_t(-0.4375), float16_t(-0.46875),
    float16_t(-0.5), float16_t(-0.5625), float16_t(-0.625), float16_t(-0.6875), float16_t(-0.75), float16_t(-0.8125), float16_t(-0.875), float16_t(-0.9375),
    float16_t(-1), float16_t(-1.125), float16_t(-1.25), float16_t(-1.375), float16_t(-1.5), float16_t(-1.625), float16_t(-1.75), float16_t(-1.875),
    float16_t(-2), float16_t(-2.25), float16_t(-2.5), float16_t(-2.75), float16_t(-3), float16_t(-3.25), float16_t(-3.5), float16_t(-3.75),
    float16_t(-4), float16_t(-4.5), float16_t(-5), float16_t(-5.5), float16_t(-6), float16_t(-6.5), float16_t(-7), float16_t(-7.5),
    float16_t(-8), float16_t(-9), float16_t(-10), float16_t(-11), float16_t(-12), float16_t(-13), float16_t(-14), float16_t(-15),
    float16_t(-16), float16_t(-18), float16_t(-20), float16_t(-22), float16_t(-24), float16_t(-26), float16_t(-28), float16_t(-30),
    float16_t(-32), float16_t(-36), float16_t(-40), float16_t(-44), float16_t(-48), float16_t(-52), float16_t(-56), float16_t(-60),
    float16_t(-64), float16_t(-72), float16_t(-80), float16_t(-88), float16_t(-96), float16_t(-104), float16_t(-112), float16_t(-120),
    float16_t(-128), float16_t(-144), float16_t(-160), float16_t(-176), float16_t(-192), float16_t(-208), float16_t(-224), float16_t(-240),
    float16_t(-256), float16_t(-288), float16_t(-320), float16_t(-352), float16_t(-384), float16_t(-416), float16_t(-448), float16_t(-480)
);

float e4m3_to_f32(uint b) {
    return float(e4m3_lut[b & 255u]);
}

// f32 -> E4M3, RNE, saturating at 448 (the model's to_e4m3).
uint f32_to_e4m3_rne(float x) {
    if (isnan(x)) return 0x7fu;
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    if (a < 0.015625) {
        uint sub = uint(floor(a * 512.0 + 0.5));
        return sign | sub;
    }
    uint bits = floatBitsToUint(a);
    uint norm = uint((bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u);
    return sign | (norm & 0x7fu);
}

// q8(x): round to E4M3 and back.
float q8(float x) {
    return e4m3_to_f32(f32_to_e4m3_rne(x));
}

// f16(x) as f32, round to nearest even: the model's f16(). Done by integer bit operations because
// float(float16_t(x)) is folded away by the driver (a register round trip does not round) and
// packHalf2x16 truncates. A 16-bit LDS store/load does round (RNE); this is verified bit-exact against
// numpy float16 on ties, normal and subnormal values.
float rh(float x) {
    uint b = floatBitsToUint(x);
    uint sgn = b & 0x80000000u;
    float a = abs(x);
    if (a >= 6.103515625e-05) {                       // normal f16 (>= 2^-14): 11 significant bits
        uint ab = b & 0x7fffffffu;
        uint r = (ab + 0xfffu + ((ab >> 13u) & 1u)) & 0xffffe000u;
        return uintBitsToFloat(sgn | r);
    }
    float q = roundEven(a * 16777216.0) * 5.9604644775390625e-08;   // subnormal f16: multiples of 2^-24
    return (x < 0.0) ? -q : q;
}

// The P permutation of 32-channel groups: stored index i holds logical channel P[i].
uint perm_P(uint i) {
    return ((i >> 2u) << 1u) | (i & 1u) | (((i >> 1u) & 1u) << 4u);
}

// invP: logical channel (mod 32) -> stored index.
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// Element index of logical channel c in a P-permuted f16 vector (the blob's layout).
uint vidx(uint c) {
    return (c & ~31u) | perm_invP(c);
}

uint frag_off(uint r, uint c, uint cols) {
    uint u1 = ((r & 0x7FFFFFE1u) | ((r >> 3u) & 2u)) + (r & 0xEu) * 2u;
    uint u5 = 2u * c;
    uint u9 = 16u * c;
    uint low = (u5 & 4u) | (c & 1u) | ((c >> 3u) & 2u);
    uint high = ((u5 & 0x10u) << 4u) + (u9 & (~0x1FFu)) + (cols << 4u) * (u1 >> 4u);
    return (low | high) + ((u1 & 0xFu) + (u5 & 8u) * 2u) * 8u;
}

float read_f16(uint byte_off) {
    uint b0 = uint(wbuf[byte_off]);
    uint b1 = uint(wbuf[byte_off + 1u]);
    return unpackHalf2x16(b0 | (b1 << 8u)).x;
}

int reflect_coord(int p, int dim) {
    if (p < 0) p = -p;
    if (p >= dim) p = 2 * (dim - 1) - p;
    return clamp(p, 0, dim - 1);
}

// The model's nr_swin_exp: every rounding is an explicit f16 step, then the bit-built exp.
float nr_swin_exp(float x) {
    float hx = rh(x);
    float y = clamp(rh(hx * 0.017181396484375), -0.55615234375, 0.55615234375);
    float base = rh(-y * y + 0.92724609375);
    float p = rh(y * base + 1.375);
    uint h = packHalf2x16(vec2(p, 0.0)) & 0xffffu;
    uint exp_bits = ((h << 5u) + 0x8000u) & 0xffffu;
    return unpackHalf2x16(exp_bits).x;
}

// NeuralHub's activation (k_sr_stage ISA, the v_pk_*_f16 block with constants 0xad30 / 0x3698):
// z = f16(acc + b1), t = clamp(z, -2, 2), gate = 0.5 + t * (0.412109375 - 0.0810546875 * |t|),
// act = z * gate, every step rounded to f16 (rh, since RADV folds float16_t round trips) - the
// model's act_fn 'nhgelu'.
float nh_gelu(float z) {
    float zh = rh(z);
    float t = clamp(zh, -2.0, 2.0);
    float u = rh(rh(abs(t) * -0.0810546875) + 0.412109375);
    float g = rh(rh(t * u) + 0.5);
    return rh(zh * g);
}

// RMSNorm of token row t over C channels, gain applied after the norm:
// s = q8(f16(f16(x * rs) * gain)), rs = 1 / sqrt(sum x^2 + 2^-14).
void rmsnorm_row(uint t, uint C, uint gain_base) {
    float ss = 0.0;
    for (uint c = 0u; c < C; ++c) {
        float x = float(s_act[t][c]);
        ss += x * x;
    }
    float rs = 1.0 / sqrt(ss + 6.103515625e-05);
    for (uint c = 0u; c < C; ++c) {
        float xr = rh(float(s_act[t][c]) * rs);
        float g = read_f16(gain_base + 2u * vidx(c));
        s_norm[t][c] = float16_t(q8(rh(xr * g)));
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;   // 0..63
    uint win = tid / 16u;                // 0..3 (window within the 8x8 tile)
    uint tok = tid % 16u;                // 0..15 (token within the window)

    int gx = int(gl_WorkGroupID.x);
    int gy = int(gl_WorkGroupID.y);
    int x0 = gx * 8 - shiftX;
    int y0 = gy * 8 - shiftY;

    int dx = int((win % 2u) * 4u + (tok % 4u));
    int dy = int((win / 2u) * 4u + (tok / 4u));
    int px = reflect_coord(x0 + dx, dimW);
    int py = reflect_coord(y0 + dy, dimH);

    uint w_off = wbuf_lo & 0x1fffffu;
    bool st0 = (w_off == 0u || w_off == 1505536u);
    uint C = st0 ? 64u : 96u;
    uint g_heads = st0 ? 2u : 4u;
    uint Cn = st0 ? 96u : 128u;
    uint mode = (w_off >= 1341440u) ? 2u : 0u;
    uint HW = uint(dimH * dimW);
    uint pos = uint(py * dimW + px);

    uint cur_w = w_off;

    // 1. Input token (mode 0), or the decoder's up-projection of the half-res input plus the skip (mode 2).
    if (mode == 0u) {
        for (uint cg = 0u; cg < C / 32u; ++cg) {
            uint base = (cg * HW + pos) * 32u;
            for (uint i = 0u; i < 32u; ++i) {
                s_act[tid][cg * 32u + perm_P(i)] = float16_t(e4m3_to_f32(uint(in_act[base + i])));
            }
        }
    } else {
        // up[c] = f16(sum_k low[k] * Wup[q*C + c][k] + bup[q*C + c]), q = (px&1) + 2*(py&1),
        // low = the parent pixel (px>>1, py>>1) of the half-res input (Cn channels).
        uint HW2 = uint((dimH / 2) * (dimW / 2));
        uint lpos = uint((py / 2) * (dimW / 2) + (px / 2));
        uint q = uint((px & 1) + 2 * (py & 1));
        uint up_b = w_off + 4u * C * Cn;
        for (uint c = 0u; c < C; ++c) {
            uint row = q * C + c;
            float acc = 0.0;
            for (uint kg = 0u; kg < Cn / 32u; ++kg) {
                uint lbase = (kg * HW2 + lpos) * 32u;
                for (uint i = 0u; i < 32u; ++i) {
                    uint k = kg * 32u + perm_P(i);
                    acc += e4m3_to_f32(uint(in_act[lbase + i])) *
                           float(e4m3_lut[uint(wbuf[w_off + frag_off(row, k, Cn)])]);
                }
            }
            float up = rh(acc + read_f16(up_b + 2u * vidx(row)));
            float skip = e4m3_to_f32(uint(skip_act[((c / 32u) * HW + pos) * 32u + perm_invP(c)]));
            s_act[tid][c] = float16_t(rh(up + skip));
        }
        cur_w += 4u * C * Cn + 8u * C;
    }

    // 2. RMSNorm 1 (gain1)
    rmsnorm_row(tid, C, cur_w);
    cur_w += 2u * C;

    // 3. Attention, per head. Each thread is one query token; K and V of the window are shared.
    for (uint c = 0u; c < C; ++c) s_acc[tid][c] = 0.0;
    for (uint h = 0u; h < g_heads; ++h) {
        uint hb = cur_w;                       // head: Wq (32 x C), Wk (32 x C), rel (16 x 16), Wo (C x 32)
        uint wo = hb + 64u * C + 512u;

        float Q[32];
        for (uint r = 0u; r < 32u; ++r) {
            float sq = 0.0;
            float sk = 0.0;
            for (uint c = 0u; c < C; ++c) {
                float sv = float(s_norm[tid][c]);
                sq += sv * float(e4m3_lut[uint(wbuf[hb + frag_off(r, c, C)])]);
                sk += sv * float(e4m3_lut[uint(wbuf[hb + 32u * C + frag_off(r, c, C)])]);
            }
            Q[r] = q8(sq);
            float kf = rh(sk);
            s_V[win][tok][r] = float16_t(kf);
            s_K8[win][tok][r] = float16_t(q8(kf));
        }
        barrier();

        float pe[16];
        for (uint j = 0u; j < 16u; ++j) {
            float dot = 0.0;
            for (uint r = 0u; r < 32u; ++r) dot += Q[r] * float(s_K8[win][j][r]);
            float rel = read_f16(hb + 64u * C + 2u * (tok * 16u + j));
            pe[j] = nr_swin_exp(dot + rel);
        }
        // balanced f16 tree over the 16 keys: (0+1),(2+3),... then pairs again
        float s8[8];
        float s4[4];
        float s2[2];
        for (uint i = 0u; i < 8u; ++i) s8[i] = rh(pe[2u * i] + pe[2u * i + 1u]);
        for (uint i = 0u; i < 4u; ++i) s4[i] = rh(s8[2u * i] + s8[2u * i + 1u]);
        for (uint i = 0u; i < 2u; ++i) s2[i] = rh(s4[2u * i] + s4[2u * i + 1u]);
        float tot = rh(s2[0] + s2[1]);
        float inv = 1.0 / max(tot, 1e-4);
        float prob[16];
        for (uint j = 0u; j < 16u; ++j) prob[j] = pe[j] * inv;

        float ctx[32];
        for (uint r = 0u; r < 32u; ++r) {
            float a = 0.0;
            for (uint j = 0u; j < 16u; ++j) a += prob[j] * float(s_V[win][j][r]);
            ctx[r] = q8(a);
        }

        // attn[c] += ctx . Wo[c] over all C output channels (f32)
        for (uint c = 0u; c < C; ++c) {
            float dot = 0.0;
            for (uint r = 0u; r < 32u; ++r) dot += ctx[r] * float(e4m3_lut[uint(wbuf[wo + frag_off(c, r, 32u)])]);
            s_acc[tid][c] += dot;
        }
        barrier();                             // K/V are read; the next head may overwrite them
        cur_w = wo + 32u * C;
    }

    // 4. Residuals: s = f16(s + attn); s = f16(s + f16(v270)); RMSNorm 2 (gain2)
    for (uint c = 0u; c < C; ++c) s_act[tid][c] = float16_t(float(s_act[tid][c]) + s_acc[tid][c]);
    uint v270 = cur_w;
    cur_w += 2u * C;
    for (uint c = 0u; c < C; ++c) {
        s_act[tid][c] = float16_t(float(s_act[tid][c]) + read_f16(v270 + 2u * vidx(c)));
    }
    rmsnorm_row(tid, C, cur_w);
    cur_w += 2u * C;

    // 5. MLP: C/8 blocks of fc1 (32 x C) + b1, GELU, fc2 (C x 32). s_acc holds the f16 MLP sum.
    for (uint c = 0u; c < C; ++c) s_acc[tid][c] = 0.0;
    uint fc2_bias = 0u;
    for (uint j = 0u; j < C / 8u; ++j) {
        uint fc1 = cur_w;
        cur_w += 32u * C;
        uint b1 = cur_w;
        cur_w += 64u;
        uint fc2 = cur_w;
        cur_w += 32u * C;
        if (j == 0u) {
            fc2_bias = cur_w;                  // fc2_bias (C halfs) sits once, after block 0
            cur_w += 2u * C;
        }

        float h1[32];
        for (uint m = 0u; m < 32u; ++m) {
            float z = 0.0;
            for (uint c = 0u; c < C; ++c) {
                z += float(s_norm[tid][c]) * float(e4m3_lut[uint(wbuf[fc1 + frag_off(m, c, C)])]);
            }
            z += read_f16(b1 + 2u * vidx(m));
            h1[m] = q8(nh_gelu(z));
        }
        for (uint c = 0u; c < C; ++c) {
            float sum = 0.0;
            for (uint m = 0u; m < 32u; ++m) {
                sum += h1[m] * float(e4m3_lut[uint(wbuf[fc2 + frag_off(c, m, 32u)])]);
            }
            s_acc[tid][c] = rh(s_acc[tid][c] + rh(sum));
        }
    }

    // 6. out = clamp(s + mlp + fc2_bias, -448, 448) as E4M3 RNE. Its q8 copy goes to s_norm for step 7.
    int real_x = x0 + dx;
    int real_y = y0 + dy;
    bool inb = real_x >= 0 && real_x < dimW && real_y >= 0 && real_y < dimH;
    uint opos = inb ? uint(real_y * dimW + real_x) : 0u;
    for (uint c = 0u; c < C; ++c) {
        float b2 = read_f16(fc2_bias + 2u * vidx(c));
        float v = clamp(float(s_act[tid][c]) + s_acc[tid][c] + b2, -448.0, 448.0);
        uint code = f32_to_e4m3_rne(v);
        s_norm[tid][c] = float16_t(e4m3_to_f32(code));
        if (inb) {
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c)] = uint8_t(code);
        }
    }

    // 7. Mode 0: 2x2 patch-merge projection to the second output. Each half-res pixel of the tile
    // (4x4 per 8x8 tile) reads its four full-res tokens (quad order (0,0),(1,0),(0,1),(1,1)).
    barrier();
    if (mode == 0u && tid < 16u) {
        uint dpx = tid % 4u;
        uint dpy = tid / 4u;
        int W2 = dimW / 2;
        int H2 = dimH / 2;
        int X = ((gx * 8 - shiftX) >> 1) + int(dpx);
        int Y = ((gy * 8 - shiftY) >> 1) + int(dpy);
        if (X >= 0 && X < W2 && Y >= 0 && Y < H2) {
            uint pw = cur_w;                   // dn_W: Cn x 4C
            uint pb = cur_w + Cn * 4u * C;     // dn_b: Cn halfs
            uint HW2 = uint(W2 * H2);
            uint o2 = uint(Y * W2 + X);
            for (uint co = 0u; co < Cn; ++co) {
                float sum = 0.0;
                for (uint quad = 0u; quad < 4u; ++quad) {
                    uint tx = 2u * dpx + (quad & 1u);
                    uint ty = 2u * dpy + (quad >> 1u);
                    uint t2 = ((ty >> 2u) * 2u + (tx >> 2u)) * 16u + (ty & 3u) * 4u + (tx & 3u);
                    for (uint c = 0u; c < C; ++c) {
                        sum += float(s_norm[t2][c]) *
                               float(e4m3_lut[uint(wbuf[pw + frag_off(co, quad * C + c, 4u * C)])]);
                    }
                }
                float y = rh(sum + read_f16(pb + 2u * vidx(co)));
                uint code = f32_to_e4m3_rne(clamp(y, -6.28125, 6.28125));
                out_act2[((co / 32u) * HW2 + o2) * 32u + perm_invP(co)] = uint8_t(code);
            }
        }
    }
}
