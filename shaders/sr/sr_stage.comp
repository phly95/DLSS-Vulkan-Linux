#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable
// NR_QUANT_MODE 4: f32 -> E4M3 through the driver's saturating convert (the MODE register): a bare
// v_cvt_pk_fp8_f32 instead of clamp + convert (the reference include prices both; verified with
// tools/radv-offline/pipestats --isa: 0 v_maxmin_num_f32, s_setreg_imm32_b32 present).
#define NR_QUANT_MODE 4
#include "nh_mm.glsl"

// k_sr_stage (NeuralHub SR stage launches 3, 4 = mode 0; 11, 12 = mode 2). The arithmetic follows
// tools/sr/sr_stage_model.py structurally - same projections, same softmax, same activation, same
// tensor interfaces - but the f16 rounding emulation (rh), the ISA-order sum trees and the K=32
// chain splits are gone: bit-exactness with the oracle is not a goal in the optimisation phase,
// the quality guard (tools/report/quality_guard.py, ground truth) is.
//
// Performance shape (build/agents/stage/progress.md has the measurements behind every number):
//   * 64 threads = one 8x8 tile = four 4x4 windows - the reference's geometry. 8x8 makes the mode-0
//     patch merge's M = 16 real pixels (the 32-thread 8x4 tile padded half a tile of zeros into
//     every projection) and halves the weight traffic per unit of work.
//   * LDS 28032 B: one workgroup per SIMD = 2 waves/SIMD (the LDS budget is 32768 B/SIMD; measured
//     with the occupancy probe in progress.md). Before: 29696 B at 32 threads = 1 wave/SIMD.
//   * One f32 accumulator per GEMM over the whole K - no K=32 chain splits, no IN_PLACE LDS
//     read-modify-writes. Residual adds are fragment ops: narrow -> load f16 -> add -> store.
//   * Every GEMM keeps four v_wmma in flight (M-chunk 2 x N-chunk 2, K unrolled by 2 where K=32 is
//     a compile-time shape): the MMA microbenchmark (progress.md) measured 5.1 GMMA/s with one
//     v_wmma per loop iteration and 14.8 GMMA/s with four - the whole target lives in that ratio.
//   * Buffer reuse instead of dedicated arrays: Q -> V -> fc1 z in sQV, ctx8 -> gelu hidden in sH,
//     MLP sum in sA, RMSNorm output / patch-merge staging / decoder low gather + up staging in sN8.
// Weights come from wrep (row-major copy of the stage blob, src/vk/pipeline.cpp); f16 vectors and
// relpos tables from wbuf. Notes: docs/notes/k_sr_stage.md (Review R1-R9); byte map
// docs/sr/STAGE-LAYOUT.md.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// f16 view of the frag-order blob (the vectors and relpos tables; the fp8 matrices come from wrep).
layout(set = 0, binding = 0) readonly buffer InWeights { float16_t wbuf16[]; };
// 16-byte views: a token's 32 channel bytes are two aligned uvec4 loads, not 32 byte loads.
layout(set = 0, binding = 1) readonly buffer InAct     { uvec4 in_act4[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct   { NR_OPERAND out_act[]; };
layout(set = 0, binding = 3) buffer OutAct2            { NR_OPERAND out_act2[]; };
// Mode 2 (decoder) skip: the fp8 tensor bound at StageArgs offset 16 (oracle launches 11/12).
layout(set = 0, binding = 4) readonly buffer SkipAct   { uvec4 skip_act4[]; };
// Row-major fp8 copy of every stage matrix (same offsets as wbuf): B operands [N][K], K contiguous.
layout(set = 0, binding = 5, std430) readonly buffer WRep { NR_OPERAND wrep[]; };

layout(push_constant) uniform StageArgs {
    uint wbuf_lo;
    uint wbuf_hi;
    layout(offset = 40) int dimW;
    int dimH;
    int shiftX;
    int shiftY;
};

// Token-major LDS arrays use a row stride of 96 (the largest C). Budget at C = 96: 12288 + 6144 +
// 4096 + 2048 + 2048 + 576 + 256 + 64 + 512 = 28032 B <= 32768, i.e. one workgroup (two waves) per
// SIMD. Every array below is sized for 64 tokens / C = 96 and reused in the order documented here.
shared float16_t sA[64 * 96];      // residual stream: input | + v270 + heads | mlp sum | proj rows
shared NR_OPERAND sN8[6144];       // RMSNorm output [64][C]; mode 0: patch-merge staging [16][4C];
                                   // mode 2: low gather [16][Cn] then up staging [16][2C]
shared float16_t sQV[64 * 32];     // Q -> V -> fc1 z (f16, [token][32])
shared float16_t sP[4 * 16 * 16];  // logits then probs, one 16x16 block per window
shared NR_OPERAND sH[64 * 32];     // ctx8 (Wo operand) -> gelu hidden (fc2 operand)
shared float16_t sVecC[3 * 96];    // gain1 | gain2 (same slot) | v270 | fc2_bias
shared float16_t sBias[128];       // mode 0: dn_b (Cn)
shared float16_t sB1[32];          // this MLP block's b1
shared float16_t sRel[256];        // this head's relpos table (query x key)

// ---- scalar helpers ---------------------------------------------------------------------------

// Quantisation for the fp8-declared buffers: NR_OPERAND is their element type, so the conversion is
// spelled through it and type-checks in both builds of this shader (the float16 build the offline
// check runs on lavapipe declares those buffers float16_t - assigning an E4M3 fragment there is what
// made kernel_run segfault).
#ifdef NR_OPERAND_F16
#define q8_store(v) NR_OPERAND((v))
#define STORE_E4M3(acc, arr, rowbase, colbase, stride) { \
    NR_FRAG_ACC16 e = NR_NARROW_ACC(acc); \
    NR_STORE_ACC(e, arr, (stride) * (rowbase) + (colbase), stride); }
#else
#define q8_store(v) nr_quant_e4m3(v)
#define STORE_E4M3(acc, arr, rowbase, colbase, stride) { \
    NR_FRAG_E4M3 e = NR_FRAG_E4M3(acc); \
    NR_STORE_ACC(e, arr, (stride) * (rowbase) + (colbase), stride); }
#endif

// E4M3 code -> f32 (the input tensor arrives as bytes; this is the model's LUT for all 256 codes).
float e4m3_to_f32(uint b) {
    uint e = (b >> 3u) & 15u;
    float v = (e == 0u) ? float(b & 7u) * 0.001953125
                        : uintBitsToFloat(((e + 120u) << 23u) | ((b & 7u) << 20u));
    return ((b & 0x80u) != 0u) ? -v : v;
}

vec2 rh2(vec2 v) {
    return v;
}

float rsqrt16(float h) {
    return inversesqrt(h);
}

float rcp16(float x) {
    return 1.0 / x;
}

// The P permutation of 32-channel groups: stored index i holds logical channel P[i].
uint perm_P(uint i) {
    return ((i >> 2u) << 1u) | (i & 1u) | (((i >> 1u) & 1u) << 4u);
}

// invP: logical channel (mod 32) -> stored index.
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// Element index of logical channel c in a P-permuted f16 vector (the blob's layout).
uint vidx(uint c) {
    return (c & ~31u) | perm_invP(c);
}

// Element of an f16 vector at byte offset byte_off (always even in the blob).
float read_f16(uint byte_off) {
    return float(wbuf16[byte_off >> 1u]);
}

// The kernel's border rule (model reflect): a = |p|, b = 2(n-1) - a, r = min(a, b, n-1), and r = n-1
// when b < 0 (beyond a double fold, the far edge).
int reflect_coord(int p, int dim) {
    int a = abs(p);
    int b = 2 * (dim - 1) - a;
    int r = min(min(a, b), dim - 1);
    return (b < 0) ? dim - 1 : r;
}

// The model's nr_swin_exp: clamp, cubic, mantissa shift - a bit-built f16 exponential, kept because
// it is what the reference computes (hardware exp costs 7.9 dB on the 9-frame oracle sequence;
// see progress.md). rh() is the identity now, so only the clamp/poly/bit steps remain, ~10
// instructions where the emulation was ~25.
float nr_swin_exp(float x) {
    float y = clamp(x * 0.017181396484375, -0.55615234375, 0.55615234375);
    float base = -y * y + 0.92724609375;
    float p = y * base + 1.375;
    uint h = packHalf2x16(vec2(p, 0.0)) & 0xffffu;
    uint exp_bits = ((h << 5u) + 0x8000u) & 0xffffu;
    return unpackHalf2x16(exp_bits).x;
}

// NeuralHub's activation (k_sr_stage ISA, the v_pk_*_f16 block with constants 0xad30 / 0x3698):
// t = clamp(z, -2, 2), gate = 0.5 + t * (0.412109375 - 0.0810546875 * |t|), act = z * gate.
float nh_gelu(float z) {
    float t = clamp(z, -2.0, 2.0);
    float u = 0.412109375 - 0.0810546875 * abs(t);
    return z * (t * u + 0.5);
}

void sync_lds() {
    memoryBarrierShared();
    barrier();
}

// ---- RMSNorm ----------------------------------------------------------------------------------
// One token per lane: the sum over C channels is a scalar reduction in that lane, so this is C
// multiplies + a tree, in f32 (the model's ss_isa f16 tree is rounding emulation). The output is
// quantised once, at the fp8 store.
void rmsnorm_row(uint t, uint C, uint goff) {
    float ss = 0.0;
    for (uint c = 0u; c < C; c += 4u) {
        float x0 = float(sA[t * 96u + c]);
        float x1 = float(sA[t * 96u + c + 1u]);
        float x2 = float(sA[t * 96u + c + 2u]);
        float x3 = float(sA[t * 96u + c + 3u]);
        ss += x0 * x0 + x1 * x1 + x2 * x2 + x3 * x3;
    }
    float rs = rsqrt16(ss + 1.220703125e-4);
    for (uint c = 0u; c < C; c += 4u) {
        float g0 = rs * float(sVecC[goff + c]);
        float g1 = rs * float(sVecC[goff + c + 1u]);
        float g2 = rs * float(sVecC[goff + c + 2u]);
        float g3 = rs * float(sVecC[goff + c + 3u]);
        sN8[t * 96u + c] = q8_store(float(sA[t * 96u + c]) * g0);
        sN8[t * 96u + c + 1u] = q8_store(float(sA[t * 96u + c + 1u]) * g1);
        sN8[t * 96u + c + 2u] = q8_store(float(sA[t * 96u + c + 2u]) * g2);
        sN8[t * 96u + c + 3u] = q8_store(float(sA[t * 96u + c + 3u]) * g3);
    }
}

// ---- fragment helpers -------------------------------------------------------------------------

// Residual add: narrow the f32 accumulator to f16, add the f16 row block of sA, store it back.
// Four instructions for sixteen elements, where the old IN_PLACE path did sixteen LDS
// read-modify-writes. Rows are lane-owned inside a wave (row = 8*(tid/16) + c), so no barrier.
#define RESID_ADD(acc, rowbase, colbase) { \
    NR_FRAG_ACC16 r = NR_NARROW_ACC(acc); \
    NR_FRAG_ACC16 s; \
    NR_LOAD_ACC(s, sA, 96u * (rowbase) + (colbase), 96u); \
    r = r + s; \
    NR_STORE_ACC(r, sA, 96u * (rowbase) + (colbase), 96u); }


// ---- main -------------------------------------------------------------------------------------

// The bytes b0..b3 of a 32-bit word (little endian): byte k is channel group bytes [4w + k].
uint byte_of(uint w, uint k) {
    return (w >> (8u * k)) & 0xffu;
}

// The 32 bytes of one token's channel group: word WI of the pair (WD0..WD7) holds stored indices
// 4*WI..4*WI+3. BODY(i, byte) is expanded once per stored index i (a constant), so no array is
// indexed by a computed value.
#define BYTES_OF(WD, WI, BODY) \
    BODY(4u * WI + 0u, byte_of(WD, 0u)); BODY(4u * WI + 1u, byte_of(WD, 1u)); \
    BODY(4u * WI + 2u, byte_of(WD, 2u)); BODY(4u * WI + 3u, byte_of(WD, 3u));
#define GROUP_BYTES(VA, VB, BODY) \
    BYTES_OF(VA.x, 0u, BODY) BYTES_OF(VA.y, 1u, BODY) BYTES_OF(VA.z, 2u, BODY) BYTES_OF(VA.w, 3u, BODY) \
    BYTES_OF(VB.x, 4u, BODY) BYTES_OF(VB.y, 5u, BODY) BYTES_OF(VB.z, 6u, BODY) BYTES_OF(VB.w, 7u, BODY)

void main() {
    uint tid = gl_LocalInvocationID.x;   // 0..63
    uint win = tid >> 4u;                // window of this token (0..3)
    uint tok = tid & 15u;                // token within the window
    uint wbase = 2u * (win >> 1u);       // window-pair base tile (0 for windows 0,1; 2 for 2,3)

    int gx = int(gl_WorkGroupID.x);
    int gy = int(gl_WorkGroupID.y);
    int x0 = gx * 8 - shiftX;            // tile origin (even: shifts are 0 or 2)
    int y0 = gy * 8 - shiftY;

    int dx = int((win & 1u) * 4u + (tok & 3u));
    int dy = int((win >> 1u) * 4u + (tok >> 2u));
    int px = reflect_coord(x0 + dx, dimW);
    int py = reflect_coord(y0 + dy, dimH);

    uint w_off = wbuf_lo & 0x1fffffu;
    bool st0 = (w_off == 0u || w_off == 1505536u);
    uint C = st0 ? 64u : 96u;
    uint NH = st0 ? 2u : 4u;             // g
    uint Cn = st0 ? 96u : 128u;
    uint mode = (w_off >= 1341440u) ? 2u : 0u;
    uint HW = uint(dimH * dimW);
    uint pos = uint(py * dimW + px);     // the token's own (reflected) full-res position
    uint NTC = C / 16u;                  // N tiles of a C-wide output
    uint NB = C / 8u;                    // MLP blocks
    uint G = C / 32u;                    // K=32 groups of a C-wide projection
    uint tb = tid * 96u;                 // this token's row in the 96-wide LDS arrays
    uint tbS = tid * 32u;                // this token's row in the 32-wide LDS arrays
    uint K4 = 4u * C;                    // mode 0 patch merge / its projection's K

    uint cur = w_off;
    // gain1 (C halfs) into LDS: one cooperative pass, then a barrier before RMSNorm1 reads it.
    {
        uint g1 = (mode == 0u) ? w_off : w_off + 4u * C * Cn + 8u * C;
        for (uint c = tid; c < C; c += 64u) sVecC[c] = float16_t(read_f16(g1 + 2u * vidx(c)));
    }

    // ---- 0. the input token (mode 0), or the decoder's up-projection (mode 2) + skip
    if (mode == 0u) {
        for (uint cg = 0u; cg < C / 32u; ++cg) {
            uint v16 = ((cg * HW + pos) * 32u) >> 4u;      // 32-byte aligned: two uvec4
            uvec4 va = in_act4[v16];
            uvec4 vb = in_act4[v16 + 1u];
#define IN_BODY(i, bv) sA[tb + cg * 32u + perm_P(i)] = float16_t(e4m3_to_f32(bv));
            GROUP_BYTES(va, vb, IN_BODY)
#undef IN_BODY
        }
    } else {
        // up[row] = sum_k low[k] * Wup[row][k], row = q*C + c, the pixel-shuffled output at sub-pixel
        // q of the low pixel (Review R9 addendum, upref=low): a token reads the up value of the low
        // pixel reflect(t >> 1) at its own sub-pixel parity (t & 1), t UNREFLECTED. The tile origin is
        // even, so its 16 parent pixels are the 4x4 block at (x0 >> 1, y0 >> 1): slot = 4*(dy>>1) +
        // (dx >> 1). The skip is read at the reflected position.
        int W2 = dimW / 2;
        int H2 = dimH / 2;
        uint HW2 = uint(W2 * H2);
        int LX0 = x0 >> 1;
        int LY0 = y0 >> 1;
        if (tid < 16u) {
            uint s = tid;
            int qx = reflect_coord(LX0 + int(s & 3u), W2);
            int qy = reflect_coord(LY0 + int(s >> 2u), H2);
            uint lpos = uint(qy * W2 + qx);
            for (uint cg = 0u; cg < Cn / 32u; ++cg) {
                uint v16 = ((cg * HW2 + lpos) * 32u) >> 4u;
                uvec4 va = in_act4[v16];
                uvec4 vb = in_act4[v16 + 1u];
#define LOW_BODY(i, bv) sN8[s * Cn + cg * 32u + perm_P(i)] = NR_OPERAND(e4m3_to_f32(bv));
                GROUP_BYTES(va, vb, LOW_BODY)
#undef LOW_BODY
            }
        }
        // up_b (4C halfs) lives in sQV: the MLP's Q buffer is free before the first head.
        for (uint c = tid; c < 4u * C; c += 64u) sQV[c] = float16_t(read_f16(w_off + 4u * C * Cn + 2u * vidx(c)));
        sync_lds();

        // The up projection: M = 16 low pixels (one fragment, no padding), N = 4C, K = Cn. Both waves
        // run it; each half of N is staged into sN8 after the gather (which stays live for all K).
        // Four v_wmma per K step: M chunk = the single 16-row tile, N chunk = two tiles, K unrolled
        // by 2 (Cn = 96/128, both multiples of 32).
        uint stag = 16u * Cn;            // staging base: [16 low pixels][2C] fp8, one half at a time
        uint slot = 4u * (uint(dy) >> 1) + (uint(dx) >> 1);
        uint q = uint((dx & 1) + 2 * (dy & 1));
        uint NH2 = C / 8u;               // N tiles of one half of the 4C-wide output
        for (uint hf = 0u; hf < 2u; ++hf) {
            // wave w computes the N-chunks with (chunk % 2) == w: the two waves used to compute the
            // same half twice (write-write benign, pure waste); the token read below is barriered.
            for (uint n0 = hf * NH2; n0 < hf * NH2 + NH2; n0 += 4u) {
                // four output tiles per iteration (8 v_wmma per K step); the tail (C=96 has 12
                // tiles per half) falls back to the two-tile form.
                if ((((n0 - hf * NH2) / 4u) % 2u) != (tid >> 5u) || n0 + 3u >= hf * NH2 + NH2) {
                  if ((((n0 - hf * NH2) / 2u) % 2u) != (tid >> 5u) || n0 + 1u >= hf * NH2 + NH2) continue;
                  { NR_FRAG_ACC p0 = NR_ACC_ZERO, p1 = NR_ACC_ZERO;
                    for (uint k = 0u; k < Cn; k += 32u) {
                        NR_FRAG_A fa0, fa1;
                        NR_LOAD_A(fa0, sN8, k, Cn);
                        NR_LOAD_A(fa1, sN8, k + 16u, Cn);
                        NR_FRAG_B b0, b1, b2, b3;
                        NR_LOAD_B(b0, wrep, w_off + 16u * n0 * Cn + k, Cn);
                        NR_LOAD_B(b1, wrep, w_off + 16u * n0 * Cn + k + 16u, Cn);
                        NR_LOAD_B(b2, wrep, w_off + 16u * (n0 + 1u) * Cn + k, Cn);
                        NR_LOAD_B(b3, wrep, w_off + 16u * (n0 + 1u) * Cn + k + 16u, Cn);
                        NR_MMA(p0, fa0, b0); NR_MMA(p0, fa1, b1);
                        NR_MMA(p1, fa0, b2); NR_MMA(p1, fa1, b3);
                    }
                    uint cb = stag + 16u * (n0 - hf * NH2);
                    STORE_E4M3(p0, sN8, 0u, cb, 2u * C)
                    STORE_E4M3(p1, sN8, 0u, cb + 16u, 2u * C) }
                  continue;
                }
                NR_FRAG_ACC p0 = NR_ACC_ZERO, p1 = NR_ACC_ZERO, p2 = NR_ACC_ZERO, p3 = NR_ACC_ZERO;
                for (uint k = 0u; k < Cn; k += 32u) {
                    NR_FRAG_A fa0, fa1;
                    NR_LOAD_A(fa0, sN8, k, Cn);
                    NR_LOAD_A(fa1, sN8, k + 16u, Cn);
                    NR_FRAG_B b0, b1, b2, b3, b4, b5, b6, b7;
                    NR_LOAD_B(b0, wrep, w_off + 16u * n0 * Cn + k, Cn);
                    NR_LOAD_B(b1, wrep, w_off + 16u * n0 * Cn + k + 16u, Cn);
                    NR_LOAD_B(b2, wrep, w_off + 16u * (n0 + 1u) * Cn + k, Cn);
                    NR_LOAD_B(b3, wrep, w_off + 16u * (n0 + 1u) * Cn + k + 16u, Cn);
                    NR_LOAD_B(b4, wrep, w_off + 16u * (n0 + 2u) * Cn + k, Cn);
                    NR_LOAD_B(b5, wrep, w_off + 16u * (n0 + 2u) * Cn + k + 16u, Cn);
                    NR_LOAD_B(b6, wrep, w_off + 16u * (n0 + 3u) * Cn + k, Cn);
                    NR_LOAD_B(b7, wrep, w_off + 16u * (n0 + 3u) * Cn + k + 16u, Cn);
                    NR_MMA(p0, fa0, b0); NR_MMA(p0, fa1, b1);
                    NR_MMA(p1, fa0, b2); NR_MMA(p1, fa1, b3);
                    NR_MMA(p2, fa0, b4); NR_MMA(p2, fa1, b5);
                    NR_MMA(p3, fa0, b6); NR_MMA(p3, fa1, b7);
                }
                uint cb = stag + 16u * (n0 - hf * NH2);
                STORE_E4M3(p0, sN8, 0u, cb, 2u * C)
                STORE_E4M3(p1, sN8, 0u, cb + 16u, 2u * C)
                STORE_E4M3(p2, sN8, 0u, cb + 32u, 2u * C)
                STORE_E4M3(p3, sN8, 0u, cb + 48u, 2u * C)
            }   // for (n0 ... ) batched four-tile form
            sync_lds();
            // block input: f16(up8 + skip), up8 = E4M3(up + up_b) (R9 addendum's up8, the bias folded
            // in at the quantisation point exactly as the model's bias-first chain).
            if ((q >> 1u) == hf) {
                for (uint cg = 0u; cg < C / 32u; ++cg) {
                    uint v16 = ((cg * HW + pos) * 32u) >> 4u;
                    uvec4 va = skip_act4[v16];
                    uvec4 vb = skip_act4[v16 + 1u];
#define SKIP_BODY(i, bv) { uint c = cg * 32u + perm_P(i); \
    float uv = float(q8_store(float(sN8[stag + slot * 2u * C + (q & 1u) * C + c]) + float(sQV[q * C + c]))); \
    sA[tb + c] = float16_t(uv + e4m3_to_f32(bv)); }
                    GROUP_BYTES(va, vb, SKIP_BODY)
#undef SKIP_BODY
                }
            }
            sync_lds();
        }
        cur = w_off + 4u * C * Cn + 8u * C;
    }
    sync_lds();

    // ---- 1. RMSNorm 1 (gain1) ------------------------------------------------------------------
    rmsnorm_row(tid, C, 0u);
    cur += 2u * C;
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

    // The tail of the stage (v270, gain2, fc2_bias) sits after the heads: cache it now, as the
    // residual starts from f16(x + v270) before any head is added. gain2 reuses gain1's slot -
    // RMSNorm1 is past.
    uint v270 = cur + NH * (96u * C + 512u);
    uint gain2 = v270 + 2u * C;
    uint mlp0 = v270 + 4u * C;
    uint fc2_bias = mlp0 + 64u * C + 64u;      // block 0's fc2 is followed by fc2_bias
    for (uint c = tid; c < C; c += 64u) {
        sVecC[96u + c] = float16_t(read_f16(v270 + 2u * vidx(c)));
        sVecC[c] = float16_t(read_f16(gain2 + 2u * vidx(c)));
        sVecC[2u * 96u + c] = float16_t(read_f16(fc2_bias + 2u * vidx(c)));
    }
    sync_lds();
    // attn = f16(s + v270): the residual accumulator (sA; s is the RMSNorm-1 input)
    for (uint c = 0u; c < C; c += 4u) {
        float a0 = float(sA[tb + c]);
        float a1 = float(sA[tb + c + 1u]);
        float a2 = float(sA[tb + c + 2u]);
        float a3 = float(sA[tb + c + 3u]);
        float v0 = float(sVecC[96u + c]);
        float v1 = float(sVecC[96u + c + 1u]);
        float v2 = float(sVecC[96u + c + 2u]);
        float v3 = float(sVecC[96u + c + 3u]);
        sA[tb + c] = float16_t(a0 + v0);
        sA[tb + c + 1u] = float16_t(a1 + v1);
        sA[tb + c + 2u] = float16_t(a2 + v2);
        sA[tb + c + 3u] = float16_t(a3 + v3);
    }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

    // ---- 2. attention, one head at a time ------------------------------------------------------
    // Per head: Q (M = this wave's 32 tokens = two 16-token windows, N = 32, K = C) -> logits
    // (Q.Q^T, Review R8) + softmax -> V = Wk * s (reuses Q's buffer: Q is dead once the logits are
    // stored) -> ctx = P V -> Wo, added to the residual through f16 by the owning lanes.
    for (uint h = 0u; h < NH; ++h) {
        uint hb = cur;                   // head: Wq (32 x C), Wk (32 x C), rel (16 x 16), Wo (C x 32)
        uint wo = hb + 64u * C + 512u;
        for (uint i = tid; i < 256u; i += 64u) sRel[i] = float16_t(read_f16(hb + 64u * C + 2u * i));

        // 2a. Q. Two M tiles (this wave's windows) x two N tiles, one f32 accumulator over K = C.
        {
            NR_FRAG_ACC q00 = NR_ACC_ZERO, q01 = NR_ACC_ZERO, q10 = NR_ACC_ZERO, q11 = NR_ACC_ZERO;
            // K unrolled by 2 (two 16-steps per iteration): 8 loads in flight with 8 v_wmma - the
            // MMA microbenchmark measured 2.9x for 4-in-flight over 1-in-flight.
            for (uint k = 0u; k < C; k += 32u) {
                NR_FRAG_A a0, a1, c0, c1;
                NR_LOAD_A(a0, sN8, 16u * wbase * 96u + k, 96u);
                NR_LOAD_A(a1, sN8, 16u * (wbase + 1u) * 96u + k, 96u);
                NR_LOAD_A(c0, sN8, 16u * wbase * 96u + k + 16u, 96u);
                NR_LOAD_A(c1, sN8, 16u * (wbase + 1u) * 96u + k + 16u, 96u);
                NR_FRAG_B b0, b1, e0, e1;
                NR_LOAD_B(b0, wrep, hb + k, C);
                NR_LOAD_B(b1, wrep, hb + 16u * C + k, C);
                NR_LOAD_B(e0, wrep, hb + k + 16u, C);
                NR_LOAD_B(e1, wrep, hb + 16u * C + k + 16u, C);
                NR_MMA(q00, a0, b0); NR_MMA(q01, a0, b1);
                NR_MMA(q10, a1, b0); NR_MMA(q11, a1, b1);
                NR_MMA(q00, c0, e0); NR_MMA(q01, c0, e1);
                NR_MMA(q10, c1, e0); NR_MMA(q11, c1, e1);
            }
            // qk8=1 of the spec: Q quantised to fp8 before Q.Q^T (and the logits' A/B fragments are
            // fp8, so they must be staged in an fp8 array - sH is free until ctx).
            STORE_E4M3(q00, sH, 16u * wbase, 0u, 32u)
            STORE_E4M3(q01, sH, 16u * wbase, 16u, 32u)
            STORE_E4M3(q10, sH, 16u * (wbase + 1u), 0u, 32u)
            STORE_E4M3(q11, sH, 16u * (wbase + 1u), 16u, 32u)
        }
        sync_lds();

        // 2b. logits = Q Q^T for this wave's two window blocks (each: M = N = 16, K = 32), stored
        // f16 to sP. All four v_wmma (2 windows x 2 K steps) issue back to back.
        {
            uint qb = 512u * wbase;                 // sH row of the first window of this wave
            uint ob = 256u * wbase;                 // sP block of the same window
            NR_FRAG_ACC l0 = NR_ACC_ZERO, l1 = NR_ACC_ZERO;
            NR_FRAG_A la0, la1;
            NR_FRAG_B lb0, lb1;
            NR_LOAD_A(la0, sH, qb + 0u, 32u);
            NR_LOAD_B(lb0, sH, qb + 0u, 32u);
            NR_LOAD_A(la1, sH, qb + 16u, 32u);
            NR_LOAD_B(lb1, sH, qb + 16u, 32u);
            NR_MMA(l0, la0, lb0);
            NR_MMA(l0, la1, lb1);
            NR_LOAD_A(la0, sH, qb + 512u, 32u);
            NR_LOAD_B(lb0, sH, qb + 512u, 32u);
            NR_LOAD_A(la1, sH, qb + 528u, 32u);
            NR_LOAD_B(lb1, sH, qb + 528u, 32u);
            NR_MMA(l1, la0, lb0);
            NR_MMA(l1, la1, lb1);
            NR_STORE_ACC(NR_NARROW_ACC(l0), sP, ob, 16u);
            NR_STORE_ACC(NR_NARROW_ACC(l1), sP, ob + 256u, 16u);
        }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

        // 2c. softmax over the window's 16 keys: lane = (window, query). Hardware-free exp is the
        // model's; the 1/tot is a plain f16 reciprocal now (the 1/h table was rounding emulation).
        {
            float pe[16];
            for (uint j = 0u; j < 16u; ++j) {
                pe[j] = nr_swin_exp(sP[256u * win + tok * 16u + j] + float(sRel[tok * 16u + j]));
            }
            float a08 = pe[0] + pe[8];
            float a210 = pe[2] + pe[10];
            float a412 = pe[4] + pe[12];
            float a614 = pe[6] + pe[14];
            float a19 = pe[1] + pe[9];
            float a311 = pe[3] + pe[11];
            float a513 = pe[5] + pe[13];
            float a715 = pe[7] + pe[15];
            float ev = (a08 + a210) + (a412 + a614);
            float od = (a19 + a311) + (a513 + a715);
            float inv = rcp16(ev + od);
            for (uint j = 0u; j < 16u; ++j) {
                sP[256u * win + tok * 16u + j] = float16_t(pe[j] * inv);
            }
        }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

        // 2d. V = Wk * s, into Q's buffer (Q's last reader, the logits, is past the barrier above).
        {
            NR_FRAG_ACC k00 = NR_ACC_ZERO, k01 = NR_ACC_ZERO, k10 = NR_ACC_ZERO, k11 = NR_ACC_ZERO;
            for (uint k = 0u; k < C; k += 32u) {
                NR_FRAG_A a0, a1, c0, c1;
                NR_LOAD_A(a0, sN8, 16u * wbase * 96u + k, 96u);
                NR_LOAD_A(a1, sN8, 16u * (wbase + 1u) * 96u + k, 96u);
                NR_LOAD_A(c0, sN8, 16u * wbase * 96u + k + 16u, 96u);
                NR_LOAD_A(c1, sN8, 16u * (wbase + 1u) * 96u + k + 16u, 96u);
                NR_FRAG_B b0, b1, e0, e1;
                NR_LOAD_B(b0, wrep, hb + 32u * C + k, C);
                NR_LOAD_B(b1, wrep, hb + 32u * C + 16u * C + k, C);
                NR_LOAD_B(e0, wrep, hb + 32u * C + k + 16u, C);
                NR_LOAD_B(e1, wrep, hb + 32u * C + 16u * C + k + 16u, C);
                NR_MMA(k00, a0, b0); NR_MMA(k01, a0, b1);
                NR_MMA(k10, a1, b0); NR_MMA(k11, a1, b1);
                NR_MMA(k00, c0, e0); NR_MMA(k01, c0, e1);
                NR_MMA(k10, c1, e0); NR_MMA(k11, c1, e1);
            }
            NR_STORE_ACC(NR_NARROW_ACC(k00), sQV, 16u * wbase * 32u, 32u);
            NR_STORE_ACC(NR_NARROW_ACC(k01), sQV, 16u * wbase * 32u + 16u, 32u);
            NR_STORE_ACC(NR_NARROW_ACC(k10), sQV, 16u * (wbase + 1u) * 32u, 32u);
            NR_STORE_ACC(NR_NARROW_ACC(k11), sQV, 16u * (wbase + 1u) * 32u + 16u, 32u);
        }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

        // 2e. ctx = P V (M = 16 queries per window block, N = 32 head dims, K = 16 keys), quantised
        // in registers to sH - the fp8 operand Wo loads. Four v_wmma (2 windows x 2 N tiles).
        {
            NR_FRAG_ACC c00 = NR_ACC_ZERO, c01 = NR_ACC_ZERO, c10 = NR_ACC_ZERO, c11 = NR_ACC_ZERO;
            NR_FRAG_A16 pa;
            NR_FRAG_B16 vb0, vb1;
            NR_LOAD_A(pa, sP, 256u * wbase, 16u);
            NR_LOAD_B_ROW(vb0, sQV, 512u * wbase + 0u, 32u);
            NR_LOAD_B_ROW(vb1, sQV, 512u * wbase + 16u, 32u);
            NR_MMA(c00, pa, vb0);
            NR_MMA(c01, pa, vb1);
            NR_LOAD_A(pa, sP, 256u * (wbase + 1u), 16u);
            NR_LOAD_B_ROW(vb0, sQV, 512u * (wbase + 1u) + 0u, 32u);
            NR_LOAD_B_ROW(vb1, sQV, 512u * (wbase + 1u) + 16u, 32u);
            NR_MMA(c10, pa, vb0);
            NR_MMA(c11, pa, vb1);
            STORE_E4M3(c00, sH, 16u * wbase, 0u, 32u)
            STORE_E4M3(c01, sH, 16u * wbase, 16u, 32u)
            STORE_E4M3(c10, sH, 16u * (wbase + 1u), 0u, 32u)
            STORE_E4M3(c11, sH, 16u * (wbase + 1u), 16u, 32u)
        }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

        // 2f. Wo: M = this wave's 32 tokens (two windows), N = C in two-tile chunks, K = 32; each
        // chunk lands in the residual through f16 (RESID_ADD).
        {
            for (uint n0 = 0u; n0 < NTC; n0 += 2u) {
                NR_FRAG_ACC a00 = NR_ACC_ZERO, a01 = NR_ACC_ZERO, a10 = NR_ACC_ZERO, a11 = NR_ACC_ZERO;
                {   // K = 32 in one shot: 8 loads in flight, 8 v_wmma, no loop overhead
                    NR_FRAG_A fa0, fa1, fc0, fc1;
                    NR_LOAD_A(fa0, sH, 16u * wbase * 32u + 0u, 32u);
                    NR_LOAD_A(fa1, sH, 16u * (wbase + 1u) * 32u + 0u, 32u);
                    NR_LOAD_A(fc0, sH, 16u * wbase * 32u + 16u, 32u);
                    NR_LOAD_A(fc1, sH, 16u * (wbase + 1u) * 32u + 16u, 32u);
                    NR_FRAG_B fb0, fb1, fe0, fe1;
                    NR_LOAD_B(fb0, wrep, wo + 16u * n0 * 32u + 0u, 32u);
                    NR_LOAD_B(fb1, wrep, wo + 16u * (n0 + 1u) * 32u + 0u, 32u);
                    NR_LOAD_B(fe0, wrep, wo + 16u * n0 * 32u + 16u, 32u);
                    NR_LOAD_B(fe1, wrep, wo + 16u * (n0 + 1u) * 32u + 16u, 32u);
                    NR_MMA(a00, fa0, fb0); NR_MMA(a01, fa0, fb1);
                    NR_MMA(a10, fa1, fb0); NR_MMA(a11, fa1, fb1);
                    NR_MMA(a00, fc0, fe0); NR_MMA(a01, fc0, fe1);
                    NR_MMA(a10, fc1, fe0); NR_MMA(a11, fc1, fe1);
                }
                RESID_ADD(a00, 16u * wbase, 16u * n0)
                RESID_ADD(a01, 16u * wbase, 16u * (n0 + 1u))
                RESID_ADD(a10, 16u * (wbase + 1u), 16u * n0)
                RESID_ADD(a11, 16u * (wbase + 1u), 16u * (n0 + 1u))
            }
        }
        cur = wo + 32u * C;
    }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

    // ---- 3. RMSNorm 2 (gain2, which reused gain1's slot 0), mlp = f16(s + fc2_bias) ------------
    rmsnorm_row(tid, C, 0u);
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous
    for (uint c = 0u; c < C; c += 4u) {          // four independent LDS chains (one wave reads its own
        float a0 = float(sA[tb + c]);            // token's row: the barrier above orders sN8)
        float a1 = float(sA[tb + c + 1u]);
        float a2 = float(sA[tb + c + 2u]);
        float a3 = float(sA[tb + c + 3u]);
        float v0 = float(sVecC[2u * 96u + c]);
        float v1 = float(sVecC[2u * 96u + c + 1u]);
        float v2 = float(sVecC[2u * 96u + c + 2u]);
        float v3 = float(sVecC[2u * 96u + c + 3u]);
        sA[tb + c] = float16_t(a0 + v0);
        sA[tb + c + 1u] = float16_t(a1 + v1);
        sA[tb + c + 2u] = float16_t(a2 + v2);
        sA[tb + c + 3u] = float16_t(a3 + v3);
    }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

    // ---- 4. MLP: NB blocks of fc1 (C -> 32) with nh_gelu, fc2 (32 -> C) into the residual --------
    // z lives in sQV (Q/V are dead once the heads are done), the quantised hidden in sH.
    cur = mlp0;
    for (uint jb = 0u; jb < NB; ++jb) {
        uint fc1 = cur;
        uint b1 = fc1 + 32u * C;
        uint fc2 = b1 + 64u;
        cur = fc2 + 32u * C;
        if (jb == 0u) cur += 2u * C;         // fc2_bias sits once, after block 0's fc2
        for (uint i = tid; i < 32u; i += 64u) sB1[i] = float16_t(read_f16(b1 + 2u * vidx(i)));
        sync_lds();
        // fc1: M = this wave's own 32 rows (m0 = 0 for wave0, 32 for wave1 - the chunk must NOT run
        // for both waves: fc2's RESID_ADD is a read-modify-write and a second wave doing the same
        // rows races it), N = 32 (one chunk), K = C -> sQV as f16.
        uint m0 = 32u * (tid >> 5u);
        {
            NR_FRAG_ACC z00 = NR_ACC_ZERO, z01 = NR_ACC_ZERO, z10 = NR_ACC_ZERO, z11 = NR_ACC_ZERO;
            for (uint k = 0u; k < C; k += 32u) {
                NR_FRAG_A a0, a1, c0, c1;
                NR_LOAD_A(a0, sN8, 96u * m0 + k, 96u);
                NR_LOAD_A(a1, sN8, 96u * (m0 + 16u) + k, 96u);
                NR_LOAD_A(c0, sN8, 96u * m0 + k + 16u, 96u);
                NR_LOAD_A(c1, sN8, 96u * (m0 + 16u) + k + 16u, 96u);
                NR_FRAG_B b0, b1, e0, e1;
                NR_LOAD_B(b0, wrep, fc1 + k, C);
                NR_LOAD_B(b1, wrep, fc1 + 16u * C + k, C);
                NR_LOAD_B(e0, wrep, fc1 + k + 16u, C);
                NR_LOAD_B(e1, wrep, fc1 + 16u * C + k + 16u, C);
                NR_MMA(z00, a0, b0); NR_MMA(z01, a0, b1);
                NR_MMA(z10, a1, b0); NR_MMA(z11, a1, b1);
                NR_MMA(z00, c0, e0); NR_MMA(z01, c0, e1);
                NR_MMA(z10, c1, e0); NR_MMA(z11, c1, e1);
            }
            NR_STORE_ACC(NR_NARROW_ACC(z00), sQV, 32u * m0, 32u);
            NR_STORE_ACC(NR_NARROW_ACC(z01), sQV, 32u * m0 + 16u, 32u);
            NR_STORE_ACC(NR_NARROW_ACC(z10), sQV, 32u * (m0 + 16u), 32u);
            NR_STORE_ACC(NR_NARROW_ACC(z11), sQV, 32u * (m0 + 16u) + 16u, 32u);
        }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous
        // hidden = q8(nhgelu(z + b1)) into sH, one pass over the lane's own token row.
        for (uint m = 0u; m < 32u; m += 8u) {
            float b = float(sB1[m]);
            float z0 = nh_gelu(float(sQV[tbS + m]) + b);
            float z1 = nh_gelu(float(sQV[tbS + m + 1u]) + float(sB1[m + 1u]));
            float z2 = nh_gelu(float(sQV[tbS + m + 2u]) + float(sB1[m + 2u]));
            float z3 = nh_gelu(float(sQV[tbS + m + 3u]) + float(sB1[m + 3u]));
            float z4 = nh_gelu(float(sQV[tbS + m + 4u]) + float(sB1[m + 4u]));
            float z5 = nh_gelu(float(sQV[tbS + m + 5u]) + float(sB1[m + 5u]));
            float z6 = nh_gelu(float(sQV[tbS + m + 6u]) + float(sB1[m + 6u]));
            float z7 = nh_gelu(float(sQV[tbS + m + 7u]) + float(sB1[m + 7u]));
            sH[tbS + m] = q8_store(z0);
            sH[tbS + m + 1u] = q8_store(z1);
            sH[tbS + m + 2u] = q8_store(z2);
            sH[tbS + m + 3u] = q8_store(z3);
            sH[tbS + m + 4u] = q8_store(z4);
            sH[tbS + m + 5u] = q8_store(z5);
            sH[tbS + m + 6u] = q8_store(z6);
            sH[tbS + m + 7u] = q8_store(z7);
        }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous
        // fc2: M = this wave's own 32 rows (wave-local - see fc1), N = C in two-tile chunks, K = 32
        // -> into the residual.
        {
        uint m0 = 32u * (tid >> 5u);
        for (uint n0 = 0u; n0 < NTC; n0 += 2u) {
                NR_FRAG_ACC m00 = NR_ACC_ZERO, m01 = NR_ACC_ZERO, m10 = NR_ACC_ZERO, m11 = NR_ACC_ZERO;
                {   // K = 32 in one shot: 8 loads in flight, 8 v_wmma, no loop overhead
                    NR_FRAG_A a0, a1, c0, c1;
                    NR_LOAD_A(a0, sH, 32u * m0 + 0u, 32u);
                    NR_LOAD_A(a1, sH, 32u * (m0 + 16u) + 0u, 32u);
                    NR_LOAD_A(c0, sH, 32u * m0 + 16u, 32u);
                    NR_LOAD_A(c1, sH, 32u * (m0 + 16u) + 16u, 32u);
                    NR_FRAG_B b0, b1, e0, e1;
                    NR_LOAD_B(b0, wrep, fc2 + 16u * n0 * 32u + 0u, 32u);
                    NR_LOAD_B(b1, wrep, fc2 + 16u * (n0 + 1u) * 32u + 0u, 32u);
                    NR_LOAD_B(e0, wrep, fc2 + 16u * n0 * 32u + 16u, 32u);
                    NR_LOAD_B(e1, wrep, fc2 + 16u * (n0 + 1u) * 32u + 16u, 32u);
                    NR_MMA(m00, a0, b0); NR_MMA(m01, a0, b1);
                    NR_MMA(m10, a1, b0); NR_MMA(m11, a1, b1);
                    NR_MMA(m00, c0, e0); NR_MMA(m01, c0, e1);
                    NR_MMA(m10, c1, e0); NR_MMA(m11, c1, e1);
                }
                RESID_ADD(m00, m0, 16u * n0)
                RESID_ADD(m01, m0, 16u * (n0 + 1u))
                RESID_ADD(m10, m0 + 16u, 16u * n0)
                RESID_ADD(m11, m0 + 16u, 16u * (n0 + 1u))
            }
        }
    }
    // intra-wave data only (wave-local rows): ACO fences LDS within the wave - no workgroup rendezvous

    // ---- 5. out = clamp(mlp, -448, 448) as E4M3. Mode 0 also writes the patch-merge operand:
    // token (dx, dy) of the tile is quad (dx&1, dy&1) of pixel (dx>>1, dy>>1), cat row = pixel,
    // columns = quad * C + c.
    int real_x = x0 + dx;
    int real_y = y0 + dy;
    bool inb = real_x >= 0 && real_x < dimW && real_y >= 0 && real_y < dimH;
    uint opos = inb ? uint(real_y * dimW + real_x) : 0u;
    uint pix = uint((dy >> 1) * 4 + (dx >> 1));
    uint quad = uint((dx & 1) + 2 * (dy & 1));
    if (mode == 0u) {
        // dn_W follows the MLP: mlp0 + every block + the one fc2_bias (independent of cur so the
        // block loop can be ablated for timing without moving the projection's bias).
        uint pb0 = mlp0 + NB * (64u * C + 64u) + 2u * C + Cn * K4;
        for (uint i = tid; i < Cn; i += 64u) sBias[i] = float16_t(read_f16(pb0 + 2u * vidx(i)));
    }
    for (uint c = 0u; c < C; c += 4u) {
        NR_OPERAND k0 = q8_store(float(sA[tb + c]));
        NR_OPERAND k1 = q8_store(float(sA[tb + c + 1u]));
        NR_OPERAND k2 = q8_store(float(sA[tb + c + 2u]));
        NR_OPERAND k3 = q8_store(float(sA[tb + c + 3u]));
        if (mode == 0u) {
            sN8[pix * K4 + quad * C + c] = k0;
            sN8[pix * K4 + quad * C + c + 1u] = k1;
            sN8[pix * K4 + quad * C + c + 2u] = k2;
            sN8[pix * K4 + quad * C + c + 3u] = k3;
        }
        if (inb) {
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c)] = k0;
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c + 1u)] = k1;
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c + 2u)] = k2;
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c + 3u)] = k3;
        }
    }
    sync_lds();

    // ---- 6. mode 0: 2x2 patch-merge projection, M = 16 real pixels ------------------------------
    // y = clamp(f16(dn_b + y), +-6.28125) as E4M3. The accumulator is stored to sA (free: its last
    // reader is above) and the bias/clamp/quantise happen in the output loop, one pass.
    if (mode == 0u) {
        uint NTCN = Cn / 16u;
        for (uint n0 = 0u; n0 < NTCN; n0 += 2u) {
            // one wave per N-chunk pair (see the up projection); the epilogue below is barriered
            if (((n0 / 2u) % 2u) != (tid >> 5u)) continue;
            NR_FRAG_ACC p0 = NR_ACC_ZERO, p1 = NR_ACC_ZERO;
            // M = the 16 patch pixels, N = two output tiles, K = 4C unrolled by 2.
            for (uint k = 0u; k < K4; k += 32u) {
                NR_FRAG_A fa0, fa1;
                NR_LOAD_A(fa0, sN8, k, K4);
                NR_LOAD_A(fa1, sN8, k + 16u, K4);
                NR_FRAG_B b0, b1, b2, b3;
                NR_LOAD_B(b0, wrep, cur + 16u * n0 * K4 + k, K4);
                NR_LOAD_B(b1, wrep, cur + 16u * n0 * K4 + k + 16u, K4);
                NR_LOAD_B(b2, wrep, cur + 16u * (n0 + 1u) * K4 + k, K4);
                NR_LOAD_B(b3, wrep, cur + 16u * (n0 + 1u) * K4 + k + 16u, K4);
                NR_MMA(p0, fa0, b0); NR_MMA(p0, fa1, b1);
                NR_MMA(p1, fa0, b2); NR_MMA(p1, fa1, b3);
            }
            NR_STORE_ACC(NR_NARROW_ACC(p0), sA, 16u * n0, Cn);
            NR_STORE_ACC(NR_NARROW_ACC(p1), sA, 16u * (n0 + 1u), Cn);
        }
        sync_lds();
        int W2 = dimW / 2;
        int H2 = dimH / 2;
        for (uint e = tid; e < 16u * Cn; e += 64u) {
            uint co = e % Cn;
            uint m = e / Cn;
            NR_OPERAND code = q8_store(clamp(float(sA[e]) + float(sBias[co]), -6.28125, 6.28125));
            int X = ((gx * 8 - shiftX) >> 1) + int(m & 3u);
            int Y = ((gy * 8 - shiftY) >> 1) + int(m >> 2u);
            if (X >= 0 && X < W2 && Y >= 0 && Y < H2) {
                out_act2[((co / 32u) * uint(W2 * H2) + uint(Y * W2 + X)) * 32u + perm_invP(co)] = code;
            }
        }
    }
}
