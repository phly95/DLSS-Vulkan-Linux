#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable
#include "nh_mm.glsl"
#include "rh.glsl"

// k_sr_stage (NeuralHub SR stage launches 3, 4 = mode 0; 11, 12 = mode 2). The arithmetic is the
// spec in tools/sr/sr_stage_model.py (run_stage and its helpers) with its DEFAULTS (Review R9 and the
// R9 addendum): every rounding point is an explicit f16 (rh) or E4M3 (q8) step, in the model's order.
// Every GEMM is a KHR cooperative matrix (fp8 16x16x16 for the operands that are fp8 in the spec, f16
// for the context product, which NeuralHub also runs in f16). The weights come from wrep, the
// row-major copy of the stage blob built on the host (src/vk/pipeline.cpp); the f16 vectors and
// relpos tables are read from wbuf.
// Each K=32 group of a projection is its own accumulator: the group's f32 partial is stored to LDS
// and the running f16 value is combined with it through rh(), group 0 first (the model's mmc / fc1 /
// up / fc2 chains). Notes: docs/notes/k_sr_stage.md (Review R1-R9, the R9 addendum); byte map
// docs/sr/STAGE-LAYOUT.md.
//
// Workgroup = one 8x4 tile = 32 tokens = two 4x4 windows (window-major token order, tid = win*16 +
// tok, window 0 left of window 1). It is ONE 32-lane wave: RADV runs a 64-thread workgroup as wave64,
// and the fragment layout below is the wave32 one (a 64-thread group silently computes garbage).
// C = 64 (stages 3, 12) or 96 (stages 4, 11) is a runtime value; every fragment array is sized for
// C = 96 and its j-loops are guarded by the uniform C, so the indices stay compile-time constants.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// f16 view of the frag-order blob (the vectors and relpos tables; the fp8 matrices come from wrep).
layout(set = 0, binding = 0) readonly buffer InWeights { float16_t wbuf16[]; };
// 16-byte views: a token's 32 channel bytes are two aligned uvec4 loads, not 32 byte loads.
layout(set = 0, binding = 1) readonly buffer InAct     { uvec4 in_act4[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct   { uint8_t out_act[]; };
layout(set = 0, binding = 3) buffer OutAct2            { uint8_t out_act2[]; };
// Mode 2 (decoder) skip: the fp8 tensor bound at StageArgs offset 16 (oracle launches 11/12).
layout(set = 0, binding = 4) readonly buffer SkipAct   { uvec4 skip_act4[]; };
// Row-major fp8 copy of every stage matrix (same offsets as wbuf): B operands [N][K], K contiguous.
layout(set = 0, binding = 5, std430) readonly buffer WRep { NR_OPERAND wrep[]; };

layout(push_constant) uniform StageArgs {
    uint wbuf_lo;
    uint wbuf_hi;
    layout(offset = 40) int dimW;
    int dimH;
    int shiftX;
    int shiftY;
};

// Token-major LDS arrays use a row stride of 96 (the largest C); flat indices are explicit so that
// every fragment load offset and stride is a multiple of 16 bytes.
shared float16_t sA[32 * 96];      // residual stream: the input, then the attention accumulator, then s
// RMSNorm output (fp8, [token][96]). Mode 0 reuses it as the patch-merge operand [16][4C] and mode 2
// as the decoder low gather [16][Cn]: both are written after sN8 has been read for the last time.
shared NR_OPERAND   sN8[16 * 384];
shared float     sF[32 * 96];      // f32 scratch: group partials, logits, ctx, Wo partial, fc2 partial, projection
shared float16_t sMlp[32 * 96];    // f16 chain state: Q (attention), the MLP sum, the decoder's up value
shared NR_OPERAND   sQ8[32 * 32];     // q8(Q) per token; q8(ctx) after the logits
shared NR_OPERAND   sK8[32 * 32];     // q8(GELU hidden) in the MLP
shared float16_t sV[32 * 32];      // V = f16(K) per token (the K chain's f16 state)
shared float16_t sP[2 * 16 * 16];  // f16 softmax probabilities, one 16x16 block per window
// The f16 vectors, cached in LDS in logical order. A global load per element inside a token loop is
// a dependent round trip to memory per channel; one cooperative load per phase is not.
shared float16_t sVecC[4 * 96];    // gain1 | gain2 | v270 | fc2_bias (C each)
shared float16_t sBias[4 * 96];    // mode 2: up_b (4C); mode 0: dn_b (Cn)
shared float16_t sB1[32];          // this MLP block's b1
shared float16_t sRel[256];        // this head's relpos table (query x key)

// ---- scalar helpers (the model's arithmetic) ----------------------------------------------------

// E4M3 code -> f32. Bit arithmetic, not a table: it is exactly the model's LUT for all 256 codes
// (code 0x7f/0xff decodes to +-480 there and no stored code has it: to_e4m3 saturates at 448).
float e4m3_to_f32(uint b) {
    uint e = (b >> 3u) & 15u;
    float v = (e == 0u) ? float(b & 7u) * 0.001953125
                        : uintBitsToFloat(((e + 120u) << 23u) | ((b & 7u) << 20u));
    return ((b & 0x80u) != 0u) ? -v : v;
}

// f32 -> E4M3, RNE, saturating at 448 (the model's to_e4m3).
// Branch-free (both forms are computed and selected): a divergent branch costs both paths in a wave.
uint f32_to_e4m3_rne(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    uint sub = uint(floor(a * 512.0 + 0.5));
    uint bits = floatBitsToUint(a);
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | ((a < 0.015625) ? sub : (norm & 0x7fu));
}

// q8(x): round to E4M3 and back.
float q8(float x) {
    return e4m3_to_f32(f32_to_e4m3_rne(x));
}

// rh(x) (rh.glsl): f16 rounding, RNE, by integer bit operations.

vec2 rh2(vec2 v) {
    return vec2(rh(v.x), rh(v.y));
}

// The model's rsqrt_lut and 1/h table, f16(f32(1/x)) of an f16 value x. Exhaustively checked over all
// 30720 positive normal f16 values against the model's tables (build/agents/stage-r9/lut).
float rsqrt16(float h) {
    return rh(inversesqrt(h));
}

float rcp16(float x) {
    return rh(1.0 / x);
}

// The four bytes b0..b3 of a 32-bit word (little endian): byte k is channel group bytes [4w + k].
uint byte_of(uint w, uint k) {
    return (w >> (8u * k)) & 0xffu;
}

// The P permutation of 32-channel groups: stored index i holds logical channel P[i].
uint perm_P(uint i) {
    return ((i >> 2u) << 1u) | (i & 1u) | (((i >> 1u) & 1u) << 4u);
}

// invP: logical channel (mod 32) -> stored index.
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// Element index of logical channel c in a P-permuted f16 vector (the blob's layout).
uint vidx(uint c) {
    return (c & ~31u) | perm_invP(c);
}

// Element of an f16 vector at byte offset byte_off (always even in the blob).
float read_f16(uint byte_off) {
    return float(wbuf16[byte_off >> 1u]);
}

// The kernel's border rule (model reflect): a = |p|, b = 2(n-1) - a, r = min(a, b, n-1), and r = n-1 when
// b < 0 (beyond a double fold, the far edge).
int reflect_coord(int p, int dim) {
    int a = abs(p);
    int b = 2 * (dim - 1) - a;
    int r = min(min(a, b), dim - 1);
    return (b < 0) ? dim - 1 : r;
}

// The model's nr_swin_exp: every rounding is an explicit f16 step, then the bit-built exp.
float nr_swin_exp(float x) {
    float hx = rh(x);
    float y = clamp(rh(hx * 0.017181396484375), -0.55615234375, 0.55615234375);
    float base = rh(-y * y + 0.92724609375);
    float p = rh(y * base + 1.375);
    uint h = packHalf2x16(vec2(p, 0.0)) & 0xffffu;
    uint exp_bits = ((h << 5u) + 0x8000u) & 0xffffu;
    return unpackHalf2x16(exp_bits).x;
}

// NeuralHub's activation (k_sr_stage ISA, the v_pk_*_f16 block with constants 0xad30 / 0x3698):
// z = f16(acc + b1), t = clamp(z, -2, 2), gate = 0.5 + t * (0.412109375 - 0.0810546875 * |t|),
// act = z * gate, every step rounded to f16 - the model's act_fn 'nhgelu'.
float nh_gelu(float z) {
    float zh = rh(z);
    float t = clamp(zh, -2.0, 2.0);
    float u = rh(rh(abs(t) * -0.0810546875) + 0.412109375);
    float g = rh(rh(t * u) + 0.5);
    return rh(zh * g);
}

void sync_lds() {
    memoryBarrierShared();
    barrier();
}

// ---- RMSNorm, the kernel's f16 sum of squares (model ss_isa) ---------------------------------------
// The sum runs over the STORED channel order: stored index k of 32-channel group gi is logical channel
// gi*32 + P[k].

float sq_stored(uint t, uint gi, uint k) {
    float x = float(sA[t * 96u + gi * 32u + perm_P(k)]);
    return rh(x * x);
}

// (b0^2 + b2^2, b1^2 + b3^2) of the dword at stored offset off of group gi.
vec2 pair_stored(uint t, uint gi, uint off) {
    return vec2(rh(sq_stored(t, gi, off) + sq_stored(t, gi, off + 2u)),
                rh(sq_stored(t, gi, off + 1u) + sq_stored(t, gi, off + 3u)));
}

// The balanced f16 tree over the G groups: ((g0+g1)+g2) for 3, ((g0+g1)+(g2+g3)) for 4.
vec2 tree_groups(uint t, uint G, uint off) {
    vec2 p0 = pair_stored(t, 0u, off);
    vec2 p1 = pair_stored(t, 1u, off);
    if (G == 2u) return rh2(p0 + p1);
    vec2 p2 = pair_stored(t, 2u, off);
    if (G == 3u) return rh2(rh2(p0 + p1) + p2);
    return rh2(rh2(p0 + p1) + rh2(p2 + pair_stored(t, 3u, off)));
}

// Lane half h: dword 0 + dword 1 of (low load + high load), per pair component.
vec2 lane_half(uint t, uint G, uint h) {
    vec2 d0 = rh2(tree_groups(t, G, 8u * h) + tree_groups(t, G, 16u + 8u * h));
    vec2 d1 = rh2(tree_groups(t, G, 8u * h + 4u) + tree_groups(t, G, 16u + 8u * h + 4u));
    return rh2(d0 + d1);
}

float ss_isa_row(uint t, uint G) {
    vec2 s = rh2(lane_half(t, G, 0u) + lane_half(t, G, 1u));
    return rh(s.x + s.y);
}

// RMSNorm of token row t over C channels, gain applied after the norm (model rmsnorm, norm=isa):
// rs = rsqrt16(rh(ss + 2^-13)), s = rh(x * rh(rs * gain)), fp8 RNE. Writes the per-token fp8 row.
void rmsnorm_row(uint t, uint C, uint goff) {
    float ss = ss_isa_row(t, C / 32u);
    float rs = rsqrt16(rh(ss + 1.220703125e-4));
    for (uint c = 0u; c < C; ++c) {
        float g = rh(rs * float(sVecC[goff + c]));
        sN8[t * 96u + c] = NR_OPERAND(q8(rh(float(sA[t * 96u + c]) * g)));
    }
}

// ---- main ----------------------------------------------------------------------------------------
// Fragment products. The token-wise GEMMs take their two M-tiles (windows 0 and 1) in one wave;
// the j-loops over output N tiles are guarded by the uniform C, so every index is a constant.
// The per-token loops are unrolled by four with all LDS loads of a group issued before its math:
// a loop that loads one channel and then uses it waits a full LDS round trip per channel.

#define ZERO_AA(j) aa[0][j] = NR_ACC_ZERO; aa[1][j] = NR_ACC_ZERO;
#define STORE_AA(j) if (j < NTC) { NR_STORE_ACC(aa[0][j], sF, 16u * uint(j), C); \
                                   NR_STORE_ACC(aa[1][j], sF, 16u * C + 16u * uint(j), C); }
#define ZERO_MM(j) mm[0][j] = NR_ACC_ZERO; mm[1][j] = NR_ACC_ZERO;
#define STORE_MM(j) if (j < NTC) { NR_STORE_ACC(mm[0][j], sF, 16u * uint(j), C); \
                                   NR_STORE_ACC(mm[1][j], sF, 16u * C + 16u * uint(j), C); }
#define WO_J(j) if (j < NTC) { NR_FRAG_B fbw; NR_LOAD_B(fbw, wrep, wo + 16u * uint(j) * 32u + 16u * kk, 32u); \
                               NR_MMA(aa[0][j], fa0, fbw); NR_MMA(aa[1][j], fa1, fbw); }
#define MLP2_J(j) if (j < NTC) { NR_FRAG_B fbm; NR_LOAD_B(fbm, wrep, fc2 + 16u * uint(j) * 32u + 16u * kk, 32u); \
                                 NR_MMA(mm[0][j], fa0, fbm); NR_MMA(mm[1][j], fa1, fbm); }

// The 32 bytes of one token's channel group: word WI of the pair (WD0..WD7) holds stored indices
// 4*WI..4*WI+3. BODY(i, byte) is expanded once per stored index i (a constant), so no array is indexed.
#define BYTES_OF(WD, WI, BODY) \
    BODY(4u * WI + 0u, byte_of(WD, 0u)); BODY(4u * WI + 1u, byte_of(WD, 1u)); \
    BODY(4u * WI + 2u, byte_of(WD, 2u)); BODY(4u * WI + 3u, byte_of(WD, 3u));
#define GROUP_BYTES(VA, VB, BODY) \
    BYTES_OF(VA.x, 0u, BODY) BYTES_OF(VA.y, 1u, BODY) BYTES_OF(VA.z, 2u, BODY) BYTES_OF(VA.w, 3u, BODY) \
    BYTES_OF(VB.x, 4u, BODY) BYTES_OF(VB.y, 5u, BODY) BYTES_OF(VB.z, 6u, BODY) BYTES_OF(VB.w, 7u, BODY)

void main() {
    uint tid = gl_LocalInvocationID.x;   // 0..31
    uint win = tid >> 4u;                // window of this token (0 or 1)
    uint tok = tid & 15u;                // token within the window

    int gx = int(gl_WorkGroupID.x);
    int gy = int(gl_WorkGroupID.y);
    int x0 = gx * 8 - shiftX;            // tile origin (even: shifts are 0 or 2)
    int y0 = gy * 4 - shiftY;

    int dx = int(win * 4u + (tok & 3u));
    int dy = int(tok >> 2u);
    int px = reflect_coord(x0 + dx, dimW);
    int py = reflect_coord(y0 + dy, dimH);

    uint w_off = wbuf_lo & 0x1fffffu;
    bool st0 = (w_off == 0u || w_off == 1505536u);
    uint C = st0 ? 64u : 96u;
    uint NH = st0 ? 2u : 4u;             // g
    uint Cn = st0 ? 96u : 128u;
    uint mode = (w_off >= 1341440u) ? 2u : 0u;
    uint HW = uint(dimH * dimW);
    uint pos = uint(py * dimW + px);     // the token's own (reflected) full-res position
    uint NTC = C / 16u;                  // N tiles of a C-wide output
    uint NB = C / 8u;                    // MLP blocks
    uint G = C / 32u;                    // K=32 groups of a C-wide projection
    uint tb = tid * 96u;                 // this token's row in the 96-wide LDS arrays
    uint tbS = tid * 32u;                // this token's row in the 32-wide LDS arrays

    uint cur = w_off;
    // gain1 (C halfs) and, for mode 2, up_b (4C halfs) into LDS: independent loads, one round trip
    {
        uint g1 = (mode == 0u) ? w_off : w_off + 4u * C * Cn + 8u * C;
        for (uint c = tid; c < C; c += 32u) sVecC[c] = float16_t(read_f16(g1 + 2u * vidx(c)));
        if (mode == 2u) {
            for (uint c = tid; c < 4u * C; c += 32u) sBias[c] = float16_t(read_f16(w_off + 4u * C * Cn + 2u * vidx(c)));
        }
    }

    // ---- 0. the input token (mode 0), or the decoder's up-projection (mode 2) + skip
    if (mode == 0u) {
        for (uint cg = 0u; cg < C / 32u; ++cg) {
            uint v16 = ((cg * HW + pos) * 32u) >> 4u;      // 32-byte aligned: two uvec4
            uvec4 va = in_act4[v16];
            uvec4 vb = in_act4[v16 + 1u];
#define IN_BODY(i, bv) sA[tb + cg * 32u + perm_P(i)] = float16_t(e4m3_to_f32(bv));
            GROUP_BYTES(va, vb, IN_BODY)
#undef IN_BODY
        }
    } else {
        // up[row] = sum_k low[k] * Wup[row][k] + bup[row], row = q*C + c, the pixel-shuffled output at
        // sub-pixel q of the low pixel. Review R9 addendum (upref=low): a token reads the up value of the
        // low pixel reflect(t >> 1) at its own sub-pixel parity (t & 1), where t is its UNREFLECTED
        // full-res coordinate. The tile origin is even, so the tile's 8 parent pixels are the 4x2 block at
        // (x0 >> 1, y0 >> 1): slot = 4*(dy >> 1) + (dx >> 1). The skip is read at the reflected position.
        int W2 = dimW / 2;
        int H2 = dimH / 2;
        uint HW2 = uint(W2 * H2);
        int LX0 = x0 >> 1;
        int LY0 = y0 >> 1;
        if (tid < 8u) {
            uint s = tid;
            int qx = reflect_coord(LX0 + int(s & 3u), W2);
            int qy = reflect_coord(LY0 + int(s >> 2u), H2);
            uint lpos = uint(qy * W2 + qx);
            for (uint cg = 0u; cg < Cn / 32u; ++cg) {
                uint v16 = ((cg * HW2 + lpos) * 32u) >> 4u;
                uvec4 va = in_act4[v16];
                uvec4 vb = in_act4[v16 + 1u];
#define LOW_BODY(i, bv) sN8[s * Cn + cg * 32u + perm_P(i)] = NR_OPERAND(e4m3_to_f32(bv));
                GROUP_BYTES(va, vb, LOW_BODY)
#undef LOW_BODY
            }
        }
        for (uint i = tid; i < 8u * Cn; i += 32u) sN8[8u * Cn + i] = NR_OPERAND(0.0);
        sync_lds();
        // The up chain: state in sMlp, group partials in sF. Half hf holds the sub-pixels q = 2hf, 2hf+1.
        uint slot = 4u * uint(dy >> 1) + uint(dx >> 1);
        uint q = uint((dx & 1) + 2 * (dy & 1));
        uint NH2 = C / 8u;               // N tiles of one half of the 4C-wide output
        for (uint hf = 0u; hf < 2u; ++hf) {
            for (uint gg = 0u; gg < Cn / 32u; ++gg) {
                for (uint g4 = 0u; g4 < NH2; g4 += 4u) {
                    NR_FRAG_ACC u0 = NR_ACC_ZERO;
                    NR_FRAG_ACC u1 = NR_ACC_ZERO;
                    NR_FRAG_ACC u2 = NR_ACC_ZERO;
                    NR_FRAG_ACC u3 = NR_ACC_ZERO;
                    uint t0 = hf * NH2 + g4;   // first global N tile of this group
                    for (uint kk = 2u * gg; kk < 2u * gg + 2u; ++kk) {
                        NR_FRAG_A fa;
                        NR_LOAD_A(fa, sN8, 16u * kk, Cn);
                        NR_FRAG_B fb0;
                        NR_LOAD_B(fb0, wrep, w_off + (16u * (t0 + 0u)) * Cn + 16u * kk, Cn);
                        NR_MMA(u0, fa, fb0);
                        NR_FRAG_B fb1;
                        NR_LOAD_B(fb1, wrep, w_off + (16u * (t0 + 1u)) * Cn + 16u * kk, Cn);
                        NR_MMA(u1, fa, fb1);
                        NR_FRAG_B fb2;
                        NR_LOAD_B(fb2, wrep, w_off + (16u * (t0 + 2u)) * Cn + 16u * kk, Cn);
                        NR_MMA(u2, fa, fb2);
                        NR_FRAG_B fb3;
                        NR_LOAD_B(fb3, wrep, w_off + (16u * (t0 + 3u)) * Cn + 16u * kk, Cn);
                        NR_MMA(u3, fa, fb3);
                    }
                    NR_STORE_ACC(u0, sF, 16u * (g4 + 0u), 2u * C);
                    NR_STORE_ACC(u1, sF, 16u * (g4 + 1u), 2u * C);
                    NR_STORE_ACC(u2, sF, 16u * (g4 + 2u), 2u * C);
                    NR_STORE_ACC(u3, sF, 16u * (g4 + 3u), 2u * C);
                }
                sync_lds();
                for (uint i = tid; i < 16u * 2u * C; i += 32u) {
                    uint col = i % (2u * C);
                    uint qc = 2u * hf + col / C;          // sub-pixel of this column
                    float bias = float(sBias[qc * C + col % C]);
                    if (gg == 0u) sMlp[i] = float16_t(rh(bias + sF[i]));
                    else sMlp[i] = float16_t(rh(float(sMlp[i]) + sF[i]));
                }
                sync_lds();
            }
            // block input: f16(skip + up8), up8 = fp8(clamp(up, +-448)) (the R9 addendum's up8)
            if ((q >> 1u) == hf) {
                for (uint cg = 0u; cg < C / 32u; ++cg) {
                    uint v16 = ((cg * HW + pos) * 32u) >> 4u;
                    uvec4 va = skip_act4[v16];
                    uvec4 vb = skip_act4[v16 + 1u];
#define SKIP_BODY(i, bv) { uint c = cg * 32u + perm_P(i); \
    float up8 = q8(clamp(float(sMlp[slot * 2u * C + (q & 1u) * C + c]), -448.0, 448.0)); \
    sA[tb + c] = float16_t(rh(up8 + e4m3_to_f32(bv))); }
                    GROUP_BYTES(va, vb, SKIP_BODY)
#undef SKIP_BODY
                }
            }
            sync_lds();
        }
        cur = w_off + 4u * C * Cn + 8u * C;
    }
    sync_lds();

    // ---- 1. RMSNorm 1 (gain1)
    rmsnorm_row(tid, C, 0u);
    cur += 2u * C;
    sync_lds();

    // The tail of the stage (v270, gain2, fc2_bias) sits after the heads: cache it now, as the model's
    // residual starts from f16(x + v270) before any head is added.
    uint v270 = cur + NH * (96u * C + 512u);
    uint gain2 = v270 + 2u * C;
    uint mlp0 = v270 + 4u * C;
    uint fc2_bias = mlp0 + 64u * C + 64u;      // block 0's fc2 is followed by fc2_bias
    for (uint c = tid; c < C; c += 32u) {
        sVecC[2u * 96u + c] = float16_t(read_f16(v270 + 2u * vidx(c)));
        sVecC[96u + c] = float16_t(read_f16(gain2 + 2u * vidx(c)));
        sVecC[3u * 96u + c] = float16_t(read_f16(fc2_bias + 2u * vidx(c)));
    }
    sync_lds();
    // attn = f16(s + v270): the accumulator of the heads (kept in sA, s is the RMSNorm-1 input)
    for (uint c = 0u; c < C; ++c) sA[tb + c] = float16_t(rh(float(sA[tb + c]) + float(sVecC[192u + c])));
    sync_lds();

    // ---- 2. attention: one head at a time; each head's Wo product is its own f32 partial, added to the
    // residual through f16: attn = f16(attn + Wo_h . ctx_h).
    for (uint h = 0u; h < NH; ++h) {
        uint hb = cur;                   // head: Wq (32 x C), Wk (32 x C), rel (16 x 16), Wo (C x 32)
        uint wo = hb + 64u * C + 512u;
        for (uint i = tid; i < 256u; i += 32u) sRel[i] = float16_t(read_f16(hb + 64u * C + 2u * i));

        // 2a. Q and K: f16 chain over the G groups of 32 channels. Q state in sMlp, K state in sV.
        for (uint g = 0u; g < G; ++g) {
            NR_FRAG_ACC q00 = NR_ACC_ZERO;
            NR_FRAG_ACC q01 = NR_ACC_ZERO;
            NR_FRAG_ACC q10 = NR_ACC_ZERO;
            NR_FRAG_ACC q11 = NR_ACC_ZERO;
            NR_FRAG_ACC k00 = NR_ACC_ZERO;
            NR_FRAG_ACC k01 = NR_ACC_ZERO;
            NR_FRAG_ACC k10 = NR_ACC_ZERO;
            NR_FRAG_ACC k11 = NR_ACC_ZERO;
            for (uint kk = 2u * g; kk < 2u * g + 2u; ++kk) {
                NR_FRAG_A fa0;
                NR_LOAD_A(fa0, sN8, 16u * kk, 96u);
                NR_FRAG_A fa1;
                NR_LOAD_A(fa1, sN8, 16u * 96u + 16u * kk, 96u);
                NR_FRAG_B bq0;
                NR_LOAD_B(bq0, wrep, hb + 16u * kk, C);
                NR_FRAG_B bq1;
                NR_LOAD_B(bq1, wrep, hb + 16u * C + 16u * kk, C);
                NR_FRAG_B bk0;
                NR_LOAD_B(bk0, wrep, hb + 32u * C + 16u * kk, C);
                NR_FRAG_B bk1;
                NR_LOAD_B(bk1, wrep, hb + 32u * C + 16u * C + 16u * kk, C);
                NR_MMA(q00, fa0, bq0);
                NR_MMA(q01, fa0, bq1);
                NR_MMA(q10, fa1, bq0);
                NR_MMA(q11, fa1, bq1);
                NR_MMA(k00, fa0, bk0);
                NR_MMA(k01, fa0, bk1);
                NR_MMA(k10, fa1, bk0);
                NR_MMA(k11, fa1, bk1);
            }
            NR_STORE_ACC(q00, sF, 0u, 32u);
            NR_STORE_ACC(q01, sF, 16u, 32u);
            NR_STORE_ACC(q10, sF, 512u, 32u);
            NR_STORE_ACC(q11, sF, 528u, 32u);
            NR_STORE_ACC(k00, sF, 1024u, 32u);
            NR_STORE_ACC(k01, sF, 1040u, 32u);
            NR_STORE_ACC(k10, sF, 1536u, 32u);
            NR_STORE_ACC(k11, sF, 1552u, 32u);
            sync_lds();
            for (uint r = 0u; r < 32u; ++r) {
                float pq = sF[tbS + r];
                float pk = sF[1024u + tbS + r];
                if (g == 0u) {
                    sMlp[tbS + r] = float16_t(rh(pq));
                    sV[tbS + r] = float16_t(rh(pk));
                } else {
                    sMlp[tbS + r] = float16_t(rh(float(sMlp[tbS + r]) + pq));
                    sV[tbS + r] = float16_t(rh(float(sV[tbS + r]) + pk));
                }
            }
            sync_lds();
        }
        // Q8 = q8(Q); V = f16(K) (sV). K8 is not formed: the logits are Q.Q^T (Review R8).
        for (uint r = 0u; r < 32u; r += 4u) {
            sQ8[tbS + r] = NR_OPERAND(q8(float(sMlp[tbS + r])));
            sQ8[tbS + r + 1u] = NR_OPERAND(q8(float(sMlp[tbS + r + 1u])));
            sQ8[tbS + r + 2u] = NR_OPERAND(q8(float(sMlp[tbS + r + 2u])));
            sQ8[tbS + r + 3u] = NR_OPERAND(q8(float(sMlp[tbS + r + 3u])));
        }
        sync_lds();

        // 2b. logits = Q8 Q8^T per window (16x16, K = 32), stored to sF[256 w + 16 q + k]
        for (uint w = 0u; w < 2u; ++w) {
            NR_FRAG_ACC lg = NR_ACC_ZERO;
            NR_FRAG_A la0;
            NR_LOAD_A(la0, sQ8, 512u * w + 0u, 32u);
            NR_FRAG_B lb0;
            NR_LOAD_B(lb0, sQ8, 512u * w + 0u, 32u);
            NR_MMA(lg, la0, lb0);
            NR_FRAG_A la1;
            NR_LOAD_A(la1, sQ8, 512u * w + 16u, 32u);
            NR_FRAG_B lb1;
            NR_LOAD_B(lb1, sQ8, 512u * w + 16u, 32u);
            NR_MMA(lg, la1, lb1);
            NR_STORE_ACC(lg, sF, 256u * w, 16u);
        }
        sync_lds();

        // 2c. softmax over the window's 16 keys: thread (window, query). The f16 sum is the kernel's order
        // ([((e0+e8)+(e2+e10)) + ((e4+e12)+(e6+e14))] + the odd keys), 1/tot is the f16 1/h table.
        {
            float pe[16];
            for (uint j = 0u; j < 16u; ++j) {
                pe[j] = nr_swin_exp(sF[256u * win + tok * 16u + j] + float(sRel[tok * 16u + j]));
            }
            float a08 = rh(pe[0] + pe[8]);
            float a210 = rh(pe[2] + pe[10]);
            float a412 = rh(pe[4] + pe[12]);
            float a614 = rh(pe[6] + pe[14]);
            float a19 = rh(pe[1] + pe[9]);
            float a311 = rh(pe[3] + pe[11]);
            float a513 = rh(pe[5] + pe[13]);
            float a715 = rh(pe[7] + pe[15]);
            float ev = rh(rh(a08 + a210) + rh(a412 + a614));
            float od = rh(rh(a19 + a311) + rh(a513 + a715));
            float inv = rcp16(rh(ev + od));
            for (uint j = 0u; j < 16u; ++j) {
                sP[256u * win + tok * 16u + j] = float16_t(rh(pe[j] * inv));
            }
        }
        sync_lds();

        // 2d. ctx = P V per window (f16 WMMA, one K=16 step: P is one f16 operand), stored to sF
        for (uint w = 0u; w < 2u; ++w) {
            NR_FRAG_A16 pa;
            NR_LOAD_A(pa, sP, 256u * w, 16u);
            NR_FRAG_B16 vb0;
            NR_LOAD_B_ROW(vb0, sV, 512u * w + 0u, 32u);
            NR_FRAG_ACC c0 = NR_ACC_ZERO;
            NR_MMA(c0, pa, vb0);
            NR_FRAG_B16 vb1;
            NR_LOAD_B_ROW(vb1, sV, 512u * w + 16u, 32u);
            NR_FRAG_ACC c1 = NR_ACC_ZERO;
            NR_MMA(c1, pa, vb1);
            NR_STORE_ACC(c0, sF, 512u * w + 0u, 32u);
            NR_STORE_ACC(c1, sF, 512u * w + 16u, 32u);
        }
        sync_lds();

        // ctx8 = q8(f16(ctx)), written over Q8 (its last reader, the logits, is past the barrier above)
        for (uint r = 0u; r < 32u; r += 4u) {
            sQ8[tbS + r] = NR_OPERAND(q8(rh(sF[tbS + r])));
            sQ8[tbS + r + 1u] = NR_OPERAND(q8(rh(sF[tbS + r + 1u])));
            sQ8[tbS + r + 2u] = NR_OPERAND(q8(rh(sF[tbS + r + 2u])));
            sQ8[tbS + r + 3u] = NR_OPERAND(q8(rh(sF[tbS + r + 3u])));
        }
        sync_lds();

        // 2e. this head's Wo partial over all C outputs (K = 32: one f32 accumulator), then attn = f16(attn + P)
        {
            NR_FRAG_ACC aa[2][6];
            NR_FOR_J(6, ZERO_AA)
            for (uint kk = 0u; kk < 2u; ++kk) {
                NR_FRAG_A fa0;
                NR_LOAD_A(fa0, sQ8, 16u * kk, 32u);
                NR_FRAG_A fa1;
                NR_LOAD_A(fa1, sQ8, 512u + 16u * kk, 32u);
                NR_FOR_J(6, WO_J)
            }
            NR_FOR_J(6, STORE_AA)
        }
        sync_lds();
        for (uint c = 0u; c < C; ++c) sA[tb + c] = float16_t(rh(float(sA[tb + c]) + sF[tid * C + c]));
        sync_lds();
        cur = wo + 32u * C;
    }

    // ---- 3. RMSNorm 2 (gain2), the MLP residual mlp = f16(s + fc2_bias)
    rmsnorm_row(tid, C, 96u);
    sync_lds();
    for (uint c = 0u; c < C; ++c) sMlp[tb + c] = float16_t(rh(float(sA[tb + c]) + float(sVecC[288u + c])));
    sync_lds();

    // ---- 4. MLP: NB blocks of fc1 (C -> 32) with the f16 chain, nhgelu, fc2 (32 -> C) added through f16
    cur = mlp0;
    for (uint jb = 0u; jb < NB; ++jb) {
        uint fc1 = cur;
        uint b1 = fc1 + 32u * C;
        uint fc2 = b1 + 64u;
        cur = fc2 + 32u * C;
        if (jb == 0u) cur += 2u * C;         // fc2_bias sits once, after block 0's fc2
        if (tid < 32u) sB1[tid] = float16_t(read_f16(b1 + 2u * vidx(tid)));
        sync_lds();
        // fc1: z = f16(f16(b1 + group 0) + group 1) ... in sF[0..1023] (z[token][hidden])
        for (uint g = 0u; g < G; ++g) {
            NR_FRAG_ACC z00 = NR_ACC_ZERO;
            NR_FRAG_ACC z01 = NR_ACC_ZERO;
            NR_FRAG_ACC z10 = NR_ACC_ZERO;
            NR_FRAG_ACC z11 = NR_ACC_ZERO;
            for (uint kk = 2u * g; kk < 2u * g + 2u; ++kk) {
                NR_FRAG_A fa0;
                NR_LOAD_A(fa0, sN8, 16u * kk, 96u);
                NR_FRAG_A fa1;
                NR_LOAD_A(fa1, sN8, 16u * 96u + 16u * kk, 96u);
                NR_FRAG_B fb0;
                NR_LOAD_B(fb0, wrep, fc1 + 16u * kk, C);
                NR_FRAG_B fb1;
                NR_LOAD_B(fb1, wrep, fc1 + 16u * C + 16u * kk, C);
                NR_MMA(z00, fa0, fb0);
                NR_MMA(z01, fa0, fb1);
                NR_MMA(z10, fa1, fb0);
                NR_MMA(z11, fa1, fb1);
            }
            NR_STORE_ACC(z00, sF, 1024u, 32u);
            NR_STORE_ACC(z01, sF, 1040u, 32u);
            NR_STORE_ACC(z10, sF, 1536u, 32u);
            NR_STORE_ACC(z11, sF, 1552u, 32u);
            sync_lds();
            for (uint m = 0u; m < 32u; ++m) {
                float p = sF[1024u + tbS + m];
                if (g == 0u) sF[tbS + m] = rh(float(sB1[m]) + p);
                else sF[tbS + m] = rh(sF[tbS + m] + p);
            }
            sync_lds();
        }
        // hidden H1 = q8(nhgelu(z)) into sK8
        for (uint m = 0u; m < 32u; m += 8u) {
            float g0 = nh_gelu(sF[tbS + m]);
            float g1 = nh_gelu(sF[tbS + m + 1u]);
            float g2 = nh_gelu(sF[tbS + m + 2u]);
            float g3 = nh_gelu(sF[tbS + m + 3u]);
            float g4 = nh_gelu(sF[tbS + m + 4u]);
            float g5 = nh_gelu(sF[tbS + m + 5u]);
            float g6 = nh_gelu(sF[tbS + m + 6u]);
            float g7 = nh_gelu(sF[tbS + m + 7u]);
            sK8[tbS + m] = NR_OPERAND(q8(g0));
            sK8[tbS + m + 1u] = NR_OPERAND(q8(g1));
            sK8[tbS + m + 2u] = NR_OPERAND(q8(g2));
            sK8[tbS + m + 3u] = NR_OPERAND(q8(g3));
            sK8[tbS + m + 4u] = NR_OPERAND(q8(g4));
            sK8[tbS + m + 5u] = NR_OPERAND(q8(g5));
            sK8[tbS + m + 6u] = NR_OPERAND(q8(g6));
            sK8[tbS + m + 7u] = NR_OPERAND(q8(g7));
        }
        sync_lds();
        // fc2: this block's f32 partial (K = 32), then mlp = f16(mlp + partial)
        {
            NR_FRAG_ACC mm[2][6];
            NR_FOR_J(6, ZERO_MM)
            for (uint kk = 0u; kk < 2u; ++kk) {
                NR_FRAG_A fa0;
                NR_LOAD_A(fa0, sK8, 16u * kk, 32u);
                NR_FRAG_A fa1;
                NR_LOAD_A(fa1, sK8, 512u + 16u * kk, 32u);
                NR_FOR_J(6, MLP2_J)
            }
            NR_FOR_J(6, STORE_MM)
        }
        sync_lds();
        for (uint c = 0u; c < C; ++c) sMlp[tb + c] = float16_t(rh(float(sMlp[tb + c]) + sF[tid * C + c]));
        sync_lds();
    }

    // ---- 5. out = clamp(mlp, -448, 448) as E4M3 RNE. Mode 0 also writes the patch-merge operand:
    // token (dx, dy) of the tile is quad (dx&1, dy&1) of pixel (dx>>1, dy>>1), and cat row = pixel,
    // columns = quad * C + c.
    int real_x = x0 + dx;
    int real_y = y0 + dy;
    bool inb = real_x >= 0 && real_x < dimW && real_y >= 0 && real_y < dimH;
    uint opos = inb ? uint(real_y * dimW + real_x) : 0u;
    uint pix = uint((dy >> 1) * 4 + (dx >> 1));
    uint quad = uint((dx & 1) + 2 * (dy & 1));
    if (mode == 0u) {
        uint pb0 = cur + Cn * 4u * C;
        for (uint i = tid; i < Cn; i += 32u) sBias[i] = float16_t(read_f16(pb0 + 2u * vidx(i)));
        for (uint i = tid; i < 8u * 4u * C; i += 32u) sN8[8u * 4u * C + i] = NR_OPERAND(0.0);   // rows 8..15: unused
    }
    for (uint c = 0u; c < C; c += 4u) {
        float m0 = clamp(float(sMlp[tb + c]), -448.0, 448.0);
        float m1 = clamp(float(sMlp[tb + c + 1u]), -448.0, 448.0);
        float m2 = clamp(float(sMlp[tb + c + 2u]), -448.0, 448.0);
        float m3 = clamp(float(sMlp[tb + c + 3u]), -448.0, 448.0);
        uint k0 = f32_to_e4m3_rne(m0);
        uint k1 = f32_to_e4m3_rne(m1);
        uint k2 = f32_to_e4m3_rne(m2);
        uint k3 = f32_to_e4m3_rne(m3);
        if (mode == 0u) {
            sN8[pix * (4u * C) + quad * C + c] = NR_OPERAND(e4m3_to_f32(k0));
            sN8[pix * (4u * C) + quad * C + c + 1u] = NR_OPERAND(e4m3_to_f32(k1));
            sN8[pix * (4u * C) + quad * C + c + 2u] = NR_OPERAND(e4m3_to_f32(k2));
            sN8[pix * (4u * C) + quad * C + c + 3u] = NR_OPERAND(e4m3_to_f32(k3));
        }
        if (inb) {
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c)] = uint8_t(k0);
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c + 1u)] = uint8_t(k1);
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c + 2u)] = uint8_t(k2);
            out_act[((c / 32u) * HW + opos) * 32u + perm_invP(c + 3u)] = uint8_t(k3);
        }
    }
    sync_lds();

    // ---- 6. mode 0: 2x2 patch-merge projection (8 pixels of the tile, M = 16). The R9 addendum's chain
    // (projacc=isa): y = f16(dn_b), then for each 32-channel group of the concatenation (quad-major,
    // K = 4C) y = f16(y + group partial), so the state is in sMlp (rows 0..7 x Cn). Output: clamp to
    // +-6.28125 (f16 0x4648), fp8.
    if (mode == 0u) {
        uint K4 = 4u * C;
        uint pw = cur;                   // dn_W: Cn x 4C (row-major copy in wrep)
        uint NTCN = Cn / 16u;
        for (uint Gk = 0u; Gk < K4 / 32u; ++Gk) {
            for (uint g4 = 0u; g4 < NTCN; g4 += 4u) {
                NR_FRAG_ACC p0 = NR_ACC_ZERO;
                NR_FRAG_ACC p1 = NR_ACC_ZERO;
                NR_FRAG_ACC p2 = NR_ACC_ZERO;
                NR_FRAG_ACC p3 = NR_ACC_ZERO;
                for (uint kk = 2u * Gk; kk < 2u * Gk + 2u; ++kk) {
                    NR_FRAG_A fa;
                    NR_LOAD_A(fa, sN8, 16u * kk, K4);
                    NR_FRAG_B fb;
                    NR_LOAD_B(fb, wrep, pw + 16u * g4 * K4 + 16u * kk, K4);
                    NR_MMA(p0, fa, fb);
                    if (g4 + 1u < NTCN) {
                        NR_FRAG_B fb1;
                        NR_LOAD_B(fb1, wrep, pw + 16u * (g4 + 1u) * K4 + 16u * kk, K4);
                        NR_MMA(p1, fa, fb1);
                    }
                    if (g4 + 2u < NTCN) {
                        NR_FRAG_B fb2;
                        NR_LOAD_B(fb2, wrep, pw + 16u * (g4 + 2u) * K4 + 16u * kk, K4);
                        NR_MMA(p2, fa, fb2);
                    }
                    if (g4 + 3u < NTCN) {
                        NR_FRAG_B fb3;
                        NR_LOAD_B(fb3, wrep, pw + 16u * (g4 + 3u) * K4 + 16u * kk, K4);
                        NR_MMA(p3, fa, fb3);
                    }
                }
                NR_STORE_ACC(p0, sF, 16u * g4 + 0u, Cn);
                if (g4 + 1u < NTCN) NR_STORE_ACC(p1, sF, 16u * (g4 + 1u), Cn);
                if (g4 + 2u < NTCN) NR_STORE_ACC(p2, sF, 16u * (g4 + 2u), Cn);
                if (g4 + 3u < NTCN) NR_STORE_ACC(p3, sF, 16u * (g4 + 3u), Cn);
            }
            sync_lds();
            for (uint e = tid; e < 8u * Cn; e += 32u) {
                uint co = e % Cn;
                float base = (Gk == 0u) ? float(sBias[co]) : float(sMlp[e]);
                sMlp[e] = float16_t(rh(base + sF[e]));
            }
            sync_lds();
        }
        int W2 = dimW / 2;
        int H2 = dimH / 2;
        for (uint e = tid; e < 8u * Cn; e += 32u) {
            uint m = e / Cn;
            uint co = e - m * Cn;
            uint code = f32_to_e4m3_rne(clamp(float(sMlp[e]), -6.28125, 6.28125));
            int X = ((gx * 8 - shiftX) >> 1) + int(m & 3u);
            int Y = ((gy * 4 - shiftY) >> 1) + int(m >> 2u);
            if (X >= 0 && X < W2 && Y >= 0 && Y < H2) {
                out_act2[((co / 32u) * uint(W2 * H2) + uint(Y * W2 + X)) * 32u + perm_invP(co)] = uint8_t(code);
            }
        }
    }
}
