#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable

// k_sr_tube_split (NeuralHub SR tube launches 5..10, C = 128, g = 4, mode 1). The arithmetic is the
// spec in tools/sr/sr_stage_model.py (run_stage and its helpers), as in sr_stage.comp; one 4x4
// window per workgroup. Thread (tok, head) owns one token and one head's 32 channels.
// Notes: docs/notes/k_sr_stage.md (Review R1, R2); byte map docs/sr/STAGE-LAYOUT.md.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InWeights { uint8_t wbuf[]; };
layout(set = 0, binding = 1) readonly buffer InAct     { uint8_t in_act[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct   { uint8_t out_act[]; };

layout(push_constant) uniform StageArgs {
    uint wbuf_lo;
    uint wbuf_hi;
    layout(offset = 40) int dimW;
    int dimH;
    int shiftX;
    int shiftY;
};

shared float16_t s_act[16][128];    // residual stream
shared float16_t s_norm[16][128];   // RMSNorm output (q8)
shared float16_t s_K8[4][16][32];   // q8(Q) per head, key-token (the logits are Q.Q^T, Review R8)
shared float16_t s_V[4][16][32];    // V = f16(K) per head, key-token
shared float16_t s_ctx[4][16][32];  // q8(attention context) per head
shared float16_t s_mlp[16][128];    // MLP sum (f16 values)
shared float16_t s_h1[16][32];      // q8(GELU) hidden, one block

