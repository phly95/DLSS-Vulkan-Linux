float e4m3_to_f32(uint b) {
    return float(e4m3_lut[b & 255u]);
}

// f32 -> E4M3, RNE, saturating at 448 (the model's to_e4m3).
uint f32_to_e4m3_rne(float x) {
    if (isnan(x)) return 0x7fu;
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    if (a < 0.015625) {
        uint sub = uint(floor(a * 512.0 + 0.5));
        return sign | sub;
    }
    uint bits = floatBitsToUint(a);
    uint norm = uint((bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u);
    return sign | (norm & 0x7fu);
}

// q8(x): round to E4M3 and back.
float q8(float x) {
    return e4m3_to_f32(f32_to_e4m3_rne(x));
}

vec2 rh2(vec2 v) {
    return vec2(rh(v.x), rh(v.y));
}

// The model's rsqrt_lut and 1/h table, f16(f32(1/x)) of an f16 value x (exhaustively checked on the GPU
// against the model's tables: build/agents/stage-r9/lut).
float rsqrt16(float h) {
    return rh(inversesqrt(h));
}

float rcp16(float x) {
    return rh(1.0 / x);
}

// The P permutation of 32-channel groups: stored index i holds logical channel P[i].
uint perm_P(uint i) {
    return ((i >> 2u) << 1u) | (i & 1u) | (((i >> 1u) & 1u) << 4u);
}

// invP: logical channel (mod 32) -> stored index.
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// Element index of logical channel c in a P-permuted f16 vector (the blob's layout).
uint vidx(uint c) {
    return (c & ~31u) | perm_invP(c);
}

uint frag_off(uint r, uint c, uint cols) {
    uint u1 = ((r & 0x7FFFFFE1u) | ((r >> 3u) & 2u)) + (r & 0xEu) * 2u;
    uint u5 = 2u * c;
    uint u9 = 16u * c;
    uint low = (u5 & 4u) | (c & 1u) | ((c >> 3u) & 2u);
    uint high = ((u5 & 0x10u) << 4u) + (u9 & (~0x1FFu)) + (cols << 4u) * (u1 >> 4u);
    return (low | high) + ((u1 & 0xFu) + (u5 & 8u) * 2u) * 8u;
}

float read_f16(uint byte_off) {
    uint b0 = uint(wbuf[byte_off]);
    uint b1 = uint(wbuf[byte_off + 1u]);
    return unpackHalf2x16(b0 | (b1 << 8u)).x;
}

// The kernel's border rule (model reflect): a = |p|, b = 2(n-1) - a, r = min(a, b, n-1), and r = n-1 when
// b < 0 (beyond a double fold, the far edge).
int reflect_coord(int p, int dim) {
    int a = abs(p);
    int b = 2 * (dim - 1) - a;
    int r = min(min(a, b), dim - 1);
    return (b < 0) ? dim - 1 : r;
}

// The model's nr_swin_exp: every rounding is an explicit f16 step, then the bit-built exp.
float nr_swin_exp(float x) {
    float hx = rh(x);
    float y = clamp(rh(hx * 0.017181396484375), -0.55615234375, 0.55615234375);
    float base = rh(-y * y + 0.92724609375);
    float p = rh(y * base + 1.375);
    uint h = packHalf2x16(vec2(p, 0.0)) & 0xffffu;
    uint exp_bits = ((h << 5u) + 0x8000u) & 0xffffu;
    return unpackHalf2x16(exp_bits).x;
}

// NeuralHub's activation, the model's act_fn 'nhgelu': every step rounded to f16.
float nh_gelu(float z) {
    float zh = rh(z);
    float t = clamp(zh, -2.0, 2.0);
    float u = rh(rh(abs(t) * -0.0810546875) + 0.412109375);
    float g = rh(rh(t * u) + 0.5);
    return rh(zh * g);
}

// ---- RMSNorm: the kernel's f16 sum of squares (model ss_isa), over the STORED channel order: stored
// index k of 32-channel group gi is logical channel gi*32 + P[k]. All four groups (C = 128).

float sq_stored(uint t, uint gi, uint k) {
    float x = float(s_act[t][gi * 32u + perm_P(k)]);
    return rh(x * x);
}

vec2 pair_stored(uint t, uint gi, uint off) {
    return vec2(rh(sq_stored(t, gi, off) + sq_stored(t, gi, off + 2u)),
                rh(sq_stored(t, gi, off + 1u) + sq_stored(t, gi, off + 3u)));
}

// ((g0+g1)+(g2+g3)) of the pair vectors at stored offset off.
vec2 tree4(uint t, uint off) {
    return rh2(rh2(pair_stored(t, 0u, off) + pair_stored(t, 1u, off)) +
               rh2(pair_stored(t, 2u, off) + pair_stored(t, 3u, off)));
}

vec2 lane_half(uint t, uint h) {
    vec2 d0 = rh2(tree4(t, 8u * h) + tree4(t, 16u + 8u * h));
    vec2 d1 = rh2(tree4(t, 8u * h + 4u) + tree4(t, 16u + 8u * h + 4u));
    return rh2(d0 + d1);
}

float ss_isa_row(uint t) {
    vec2 s = rh2(lane_half(t, 0u) + lane_half(t, 1u));
    return rh(s.x + s.y);
}

// RMSNorm of row t, this thread's head group `h` of channels written (gain applied after the norm).
void rmsnorm_part(uint t, uint h, uint gain_base) {
    float ss = ss_isa_row(t);
    float rs = rsqrt16(rh(ss + 1.220703125e-4));
    for (uint c = 0u; c < 32u; ++c) {
        uint cc = h * 32u + c;
        float g = rh(rs * read_f16(gain_base + 2u * vidx(cc)));
        s_norm[t][cc] = float16_t(q8(rh(float(s_act[t][cc]) * g)));
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;  // 0..63
    uint tok = tid % 16u;               // token within the 4x4 window
    uint head = tid / 16u;              // 0..3: attention head and channel group

    int gx = int(gl_WorkGroupID.x);
    int gy = int(gl_WorkGroupID.y);
    int x0 = gx * 4 - shiftX;
    int y0 = gy * 4 - shiftY;

    int dx = int(tok % 4u);
    int dy = int(tok / 4u);
    int px = reflect_coord(x0 + dx, dimW);
    int py = reflect_coord(y0 + dy, dimH);

    uint HW = uint(dimH * dimW);
    uint pos = uint(py * dimW + px);
    uint w_off = wbuf_lo & 0x1fffffu;

    // 1. This thread's 32 channels of its token (input group = head).
    for (uint i = 0u; i < 32u; ++i) {
        s_act[tok][head * 32u + perm_P(i)] = float16_t(e4m3_to_f32(uint(in_act[(head * HW + pos) * 32u + i])));
    }
    barrier();

    // 2. RMSNorm 1 (gain1)
    rmsnorm_part(tok, head, w_off);
    barrier();

    // 3. Q, K of head `head` for this token: f16 chains over the four groups of 32 channels.
    // Head h: Wq (32 x 128), Wk (32 x 128), rel (16 x 16), Wo (128 x 32).
    uint hb = w_off + 256u + head * 12800u;
    float Q[32];
    for (uint r = 0u; r < 32u; ++r) {
        float qa = 0.0;
        float ka = 0.0;
        for (uint g = 0u; g < 4u; ++g) {
            float sq = 0.0;
            float sk = 0.0;
            for (uint c = 0u; c < 32u; ++c) {
                uint cc = g * 32u + c;
                float sv = float(s_norm[tok][cc]);
                sq += sv * float(e4m3_lut[uint(wbuf[hb + frag_off(r, cc, 128u)])]);
                sk += sv * float(e4m3_lut[uint(wbuf[hb + 4096u + frag_off(r, cc, 128u)])]);
            }
            if (g == 0u) {
                qa = rh(sq);
                ka = rh(sk);
            } else {
                qa = rh(qa + sq);
                ka = rh(ka + sk);
            }
        }
        Q[r] = q8(qa);
        s_V[head][tok][r] = float16_t(ka);
        // The logits are Q.Q^T (Review R8): the shared B operand is q8(Q). V = f16(K) is s_V.
        s_K8[head][tok][r] = float16_t(Q[r]);
    }
    barrier();

    // 4. Attention of this query token over the window's 16 keys, then the context (q8 of f16).
    float pe[16];
    for (uint j = 0u; j < 16u; ++j) {
        float dot = 0.0;
        for (uint r = 0u; r < 32u; ++r) dot += Q[r] * float(s_K8[head][j][r]);
        float rel = read_f16(hb + 8192u + 2u * (tok * 16u + j));
        pe[j] = nr_swin_exp(dot + rel);
    }
    float a08 = rh(pe[0] + pe[8]);
    float a210 = rh(pe[2] + pe[10]);
    float a412 = rh(pe[4] + pe[12]);
    float a614 = rh(pe[6] + pe[14]);
    float a19 = rh(pe[1] + pe[9]);
    float a311 = rh(pe[3] + pe[11]);
    float a513 = rh(pe[5] + pe[13]);
    float a715 = rh(pe[7] + pe[15]);
    float ev = rh(rh(a08 + a210) + rh(a412 + a614));
    float od = rh(rh(a19 + a311) + rh(a513 + a715));
    float inv = rcp16(rh(ev + od));
    float prob[16];
    for (uint j = 0u; j < 16u; ++j) prob[j] = rh(pe[j] * inv);
    for (uint r = 0u; r < 32u; ++r) {
        float a = 0.0;
        for (uint j = 0u; j < 16u; ++j) a += prob[j] * float(s_V[head][j][r]);
        s_ctx[head][tok][r] = float16_t(q8(rh(a)));
    }
    barrier();

    // 5. Residual: acc = f16(s + v270), then per head acc = f16(acc + Wo_h . ctx_h), this thread's 32 channels.
    uint v270 = w_off + 256u + 4u * 12800u;
    for (uint c = 0u; c < 32u; ++c) {
        uint cc = head * 32u + c;
        float acc = rh(float(s_act[tok][cc]) + read_f16(v270 + 2u * vidx(cc)));
        for (uint hh = 0u; hh < 4u; ++hh) {
            uint wo = w_off + 256u + hh * 12800u + 8704u;
            float dot = 0.0;
            for (uint r = 0u; r < 32u; ++r) {
                dot += float(s_ctx[hh][tok][r]) * float(e4m3_lut[uint(wbuf[wo + frag_off(cc, r, 32u)])]);
            }
            acc = rh(acc + dot);
        }
        s_act[tok][cc] = float16_t(acc);
    }
    barrier();

    // 6. RMSNorm 2 (gain2)
    uint gain2 = v270 + 256u;
    rmsnorm_part(tok, head, gain2);
    barrier();

    // 7. MLP: 16 blocks of fc1 (C -> 32) + b1 with the f16 chain, GELU, fc2 (32 -> C) added through f16.
    // This thread: hidden 8*head..+8 of fc1, output channels 32*head..+32 of fc2.
    uint ffn = gain2 + 256u;
    uint fc2_bias = ffn + 4096u + 64u + 4096u;
    for (uint c = 0u; c < 32u; ++c) {
        uint cc = head * 32u + c;
        s_mlp[tok][cc] = float16_t(rh(float(s_act[tok][cc]) + read_f16(fc2_bias + 2u * vidx(cc))));
    }
    uint cur = ffn;
    for (uint b = 0u; b < 16u; ++b) {
        uint fc1 = cur;
        cur += 4096u;
        uint b1 = cur;
        cur += 64u;
        uint fc2 = cur;
        cur += 4096u;
        if (b == 0u) cur += 256u;           // fc2_bias sits once, after block 0

        for (uint ms = 0u; ms < 8u; ++ms) {
            uint m = head * 8u + ms;
            float zc = read_f16(b1 + 2u * vidx(m));
            for (uint g = 0u; g < 4u; ++g) {
                float part = 0.0;
                for (uint c = 0u; c < 32u; ++c) {
                    uint cc = g * 32u + c;
                    part += float(s_norm[tok][cc]) * float(e4m3_lut[uint(wbuf[fc1 + frag_off(m, cc, 128u)])]);
                }
                zc = rh(zc + part);
            }
            s_h1[tok][m] = float16_t(q8(nh_gelu(zc)));
        }
        barrier();
        for (uint c = 0u; c < 32u; ++c) {
            uint cc = head * 32u + c;
            float sum = 0.0;
            for (uint m = 0u; m < 32u; ++m) {
                sum += float(s_h1[tok][m]) * float(e4m3_lut[uint(wbuf[fc2 + frag_off(cc, m, 32u)])]);
            }
            s_mlp[tok][cc] = float16_t(rh(float(s_mlp[tok][cc]) + sum));
        }
        barrier();
    }

    // 8. out = clamp(mlp, -448, 448) as E4M3 RNE, this thread's 32 channels.
    int real_x = x0 + dx;
    int real_y = y0 + dy;
    if (real_x >= 0 && real_x < dimW && real_y >= 0 && real_y < dimH) {
        uint opos = uint(real_y * dimW + real_x);
        for (uint c = 0u; c < 32u; ++c) {
            uint cc = head * 32u + c;
            float v = clamp(float(s_mlp[tok][cc]), -448.0, 448.0);
            out_act[(head * HW + opos) * 32u + perm_invP(c)] = uint8_t(f32_to_e4m3_rne(v));
        }
    }
}
