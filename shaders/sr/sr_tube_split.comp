float e4m3_to_f32(uint b) {
    return float(e4m3_lut[b & 255u]);
}

// f32 -> E4M3, RNE, saturating at 448 (the model's to_e4m3).
uint f32_to_e4m3_rne(float x) {
    if (isnan(x)) return 0x7fu;
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    if (a < 0.015625) {
        uint sub = uint(floor(a * 512.0 + 0.5));
        return sign | sub;
    }
    uint bits = floatBitsToUint(a);
    uint norm = uint((bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u);
    return sign | (norm & 0x7fu);
}

// q8(x): round to E4M3 and back.
float q8(float x) {
    return e4m3_to_f32(f32_to_e4m3_rne(x));
}

// f16(x) as f32, round to nearest even: the model's f16(). Done by integer bit operations because
// float(float16_t(x)) is folded away by the driver (a register round trip does not round) and
// packHalf2x16 truncates. A 16-bit LDS store/load does round (RNE); this is verified bit-exact against
// numpy float16 on ties, normal and subnormal values.
float rh(float x) {
    uint b = floatBitsToUint(x);
    uint sgn = b & 0x80000000u;
    float a = abs(x);
    if (a >= 6.103515625e-05) {                       // normal f16 (>= 2^-14): 11 significant bits
        uint ab = b & 0x7fffffffu;
        uint r = (ab + 0xfffu + ((ab >> 13u) & 1u)) & 0xffffe000u;
        return uintBitsToFloat(sgn | r);
    }
    float q = roundEven(a * 16777216.0) * 5.9604644775390625e-08;   // subnormal f16: multiples of 2^-24
    return (x < 0.0) ? -q : q;
}

// The P permutation of 32-channel groups: stored index i holds logical channel P[i].
uint perm_P(uint i) {
    return ((i >> 2u) << 1u) | (i & 1u) | (((i >> 1u) & 1u) << 4u);
}

// invP: logical channel (mod 32) -> stored index.
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// Element index of logical channel c in a P-permuted f16 vector (the blob's layout).
uint vidx(uint c) {
    return (c & ~31u) | perm_invP(c);
}

uint frag_off(uint r, uint c, uint cols) {
    uint u1 = ((r & 0x7FFFFFE1u) | ((r >> 3u) & 2u)) + (r & 0xEu) * 2u;
    uint u5 = 2u * c;
    uint u9 = 16u * c;
    uint low = (u5 & 4u) | (c & 1u) | ((c >> 3u) & 2u);
    uint high = ((u5 & 0x10u) << 4u) + (u9 & (~0x1FFu)) + (cols << 4u) * (u1 >> 4u);
    return (low | high) + ((u1 & 0xFu) + (u5 & 8u) * 2u) * 8u;
}

float read_f16(uint byte_off) {
    uint b0 = uint(wbuf[byte_off]);
    uint b1 = uint(wbuf[byte_off + 1u]);
    return unpackHalf2x16(b0 | (b1 << 8u)).x;
}

int reflect_coord(int p, int dim) {
    if (p < 0) p = -p;
    if (p >= dim) p = 2 * (dim - 1) - p;
    return clamp(p, 0, dim - 1);
}

// The model's nr_swin_exp: every rounding is an explicit f16 step, then the bit-built exp.
float nr_swin_exp(float x) {
    float hx = rh(x);
    float y = clamp(rh(hx * 0.017181396484375), -0.55615234375, 0.55615234375);
    float base = rh(-y * y + 0.92724609375);
    float p = rh(y * base + 1.375);
    uint h = packHalf2x16(vec2(p, 0.0)) & 0xffffu;
    uint exp_bits = ((h << 5u) + 0x8000u) & 0xffffu;
    return unpackHalf2x16(exp_bits).x;
}

// NeuralHub's activation (k_sr_stage ISA, the v_pk_*_f16 block with constants 0xad30 / 0x3698):
// z = f16(acc + b1), t = clamp(z, -2, 2), gate = 0.5 + t * (0.412109375 - 0.0810546875 * |t|),
// act = z * gate, every step rounded to f16 (rh, since RADV folds float16_t round trips) - the
// model's act_fn 'nhgelu'.
float nh_gelu(float z) {
    float zh = rh(z);
    float t = clamp(zh, -2.0, 2.0);
    float u = rh(rh(abs(t) * -0.0810546875) + 0.412109375);
    float g = rh(rh(t * u) + 0.5);
    return rh(zh * g);
}

// RMSNorm of token row t over all 128 channels, but only this thread's head group `h` is written:
// s = q8(f16(f16(x * rs) * gain)), rs = 1 / sqrt(sum x^2 + 2^-14). Every thread reads the full row.
void rmsnorm_part(uint t, uint h, uint gain_base) {
    float ss = 0.0;
    for (uint c = 0u; c < 128u; ++c) {
        float x = float(s_act[t][c]);
        ss += x * x;
    }
    float rs = 1.0 / sqrt(ss + 6.103515625e-05);
    for (uint c = 0u; c < 32u; ++c) {
        uint cc = h * 32u + c;
        float xr = rh(float(s_act[t][cc]) * rs);
        float g = read_f16(gain_base + 2u * vidx(cc));
        s_norm[t][cc] = float16_t(q8(rh(xr * g)));
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;  // 0..63
    uint tok = tid % 16u;               // token within the 4x4 window
    uint head = tid / 16u;              // 0..3: attention head and channel group

    int gx = int(gl_WorkGroupID.x);
    int gy = int(gl_WorkGroupID.y);
    int x0 = gx * 4 - shiftX;
    int y0 = gy * 4 - shiftY;

    int dx = int(tok % 4u);
    int dy = int(tok / 4u);
    int px = reflect_coord(x0 + dx, dimW);
    int py = reflect_coord(y0 + dy, dimH);

    uint HW = uint(dimH * dimW);
    uint pos = uint(py * dimW + px);
    uint w_off = wbuf_lo & 0x1fffffu;

    // 1. This thread's 32 channels of its token (input group = head).
    for (uint i = 0u; i < 32u; ++i) {
        s_act[tok][head * 32u + perm_P(i)] = float16_t(e4m3_to_f32(uint(in_act[(head * HW + pos) * 32u + i])));
    }
    barrier();

    // 2. RMSNorm 1 (gain1)
    rmsnorm_part(tok, head, w_off);
    barrier();

    // 3. Q, K, V of head `head` for this token. Head h: Wq (32 x 128), Wk (32 x 128), rel (16 x 16), Wo (128 x 32).
    uint hb = w_off + 256u + head * 12800u;
    float Q[32];
    for (uint r = 0u; r < 32u; ++r) {
        float sq = 0.0;
        float sk = 0.0;
        for (uint c = 0u; c < 128u; ++c) {
            float sv = float(s_norm[tok][c]);
            sq += sv * float(e4m3_lut[uint(wbuf[hb + frag_off(r, c, 128u)])]);
            sk += sv * float(e4m3_lut[uint(wbuf[hb + 4096u + frag_off(r, c, 128u)])]);
        }
        Q[r] = q8(sq);
        float kf = rh(sk);
        s_V[head][tok][r] = float16_t(kf);
        // The logits are Q.Q^T (Review R8), so the shared B operand is q8(Q), not q8(K).  K still
        // exists as s_V - V = f16(K), taken before the fp8 step, exactly as the model does.
        s_K8[head][tok][r] = float16_t(Q[r]);
    }
    barrier();

    // 4. Attention of this query token over the window's 16 keys, then the context (q8).
    float pe[16];
    for (uint j = 0u; j < 16u; ++j) {
        float dot = 0.0;
        for (uint r = 0u; r < 32u; ++r) dot += Q[r] * float(s_K8[head][j][r]);
        float rel = read_f16(hb + 8192u + 2u * (tok * 16u + j));
        pe[j] = nr_swin_exp(dot + rel);
    }
    float s8[8];
    float s4[4];
    float s2[2];
    for (uint i = 0u; i < 8u; ++i) s8[i] = rh(pe[2u * i] + pe[2u * i + 1u]);
    for (uint i = 0u; i < 4u; ++i) s4[i] = rh(s8[2u * i] + s8[2u * i + 1u]);
    for (uint i = 0u; i < 2u; ++i) s2[i] = rh(s4[2u * i] + s4[2u * i + 1u]);
    float tot = rh(s2[0] + s2[1]);
    float inv = 1.0 / max(tot, 1e-4);
    float prob[16];
    for (uint j = 0u; j < 16u; ++j) prob[j] = pe[j] * inv;
    for (uint r = 0u; r < 32u; ++r) {
        float a = 0.0;
        for (uint j = 0u; j < 16u; ++j) a += prob[j] * float(s_V[head][j][r]);
        s_ctx[head][tok][r] = float16_t(q8(a));
    }
    barrier();

    // 5. Output projection over all 4 heads for this thread's 32 channels, summed head by head in f32;
    // then s = f16(s + attn), s = f16(s + f16(v270)).
    uint v270 = w_off + 256u + 4u * 12800u;
    for (uint c = 0u; c < 32u; ++c) {
        uint cc = head * 32u + c;
        float attn = 0.0;
        for (uint hh = 0u; hh < 4u; ++hh) {
            uint wo = w_off + 256u + hh * 12800u + 8704u;
            float dot = 0.0;
            for (uint r = 0u; r < 32u; ++r) {
                dot += float(s_ctx[hh][tok][r]) * float(e4m3_lut[uint(wbuf[wo + frag_off(cc, r, 32u)])]);
            }
            attn += dot;
        }
        s_act[tok][cc] = float16_t(float(s_act[tok][cc]) + attn);
    }
    for (uint c = 0u; c < 32u; ++c) {
        uint cc = head * 32u + c;
        s_act[tok][cc] = float16_t(float(s_act[tok][cc]) + read_f16(v270 + 2u * vidx(cc)));
    }
    barrier();

    // 6. RMSNorm 2 (gain2)
    uint gain2 = v270 + 256u;
    rmsnorm_part(tok, head, gain2);
    barrier();

    // 7. MLP: 16 blocks of fc1 (32 x 128) + b1, GELU, fc2 (128 x 32). This thread: hidden 8*head..+8,
    // output channels 32*head..+32.
    uint ffn = gain2 + 256u;
    uint fc2_bias = ffn + 4096u + 64u + 4096u;
    for (uint c = 0u; c < 32u; ++c) s_mlp[tok][head * 32u + c] = float16_t(0.0);
    uint cur = ffn;
    for (uint b = 0u; b < 16u; ++b) {
        uint fc1 = cur;
        cur += 4096u;
        uint b1 = cur;
        cur += 64u;
        uint fc2 = cur;
        cur += 4096u;
        if (b == 0u) cur += 256u;           // fc2_bias sits once, after block 0

        for (uint ms = 0u; ms < 8u; ++ms) {
            uint m = head * 8u + ms;
            float z = 0.0;
            for (uint c = 0u; c < 128u; ++c) {
                z += float(s_norm[tok][c]) * float(e4m3_lut[uint(wbuf[fc1 + frag_off(m, c, 128u)])]);
            }
            z += read_f16(b1 + 2u * vidx(m));
            s_h1[tok][m] = float16_t(q8(nh_gelu(z)));
        }
        barrier();
        for (uint c = 0u; c < 32u; ++c) {
            uint cc = head * 32u + c;
            float sum = 0.0;
            for (uint m = 0u; m < 32u; ++m) {
                sum += float(s_h1[tok][m]) * float(e4m3_lut[uint(wbuf[fc2 + frag_off(cc, m, 32u)])]);
            }
            s_mlp[tok][cc] = float16_t(rh(float(s_mlp[tok][cc]) + rh(sum)));
        }
        barrier();
    }

    // 8. out = clamp(s + mlp + fc2_bias, -448, 448) as E4M3 RNE, this thread's 32 channels.
    int real_x = x0 + dx;
    int real_y = y0 + dy;
    if (real_x >= 0 && real_x < dimW && real_y >= 0 && real_y < dimH) {
        uint opos = uint(real_y * dimW + real_x);
        for (uint c = 0u; c < 32u; ++c) {
            uint cc = head * 32u + c;
            float b2 = read_f16(fc2_bias + 2u * vidx(cc));
            float v = clamp(float(s_act[tok][cc]) + float(s_mlp[tok][cc]) + b2, -448.0, 448.0);
            out_act[(head * HW + opos) * 32u + perm_invP(c)] = uint8_t(f32_to_e4m3_rne(v));
        }
    }
}
