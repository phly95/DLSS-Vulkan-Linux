#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable
#include "nh_mm.glsl"

// k_sr_tube_split, cooperative-matrix rewrite (optimisation phase).
//
// One 4x4 window = 16 tokens per workgroup; local_size 32 = one wave (RADV runs 32-thread
// workgroups wave32, which is what the coopmm fragment macros assume - sr_stage proves it).
// Every GEMM is a 16x16x16 WMMA through nh_mm.glsl: A operands are the LDS activation tiles,
// B operands the weights loaded straight from wrep (the row-major copy of the stage blob built
// by sr_repack_stage in src/vk/pipeline.cpp). Arithmetic follows tools/sr/sr_stage_model.py with
// f32 accumulation inside each WMMA - the R9 f16 chain splits, ISA-order sum trees and rh()
// rounding emulations are dropped (precision policy); the quantisation points (norm/Q/ctx/hidden
// to fp8) and the activation curves (the scaled nr_swin_exp, nhgelu) are kept.
//
// LDS per wave: sX fp8 [16][128] = the input; sN fp8 [16][128] = RMSNorm outputs (QKV/fc1
// operands); sQ fp8 / sV f16 [16][32] per head; sP f16 [16][16] probabilities; sC fp8 context;
// sH fp8 hidden; sB1 32 f16. Residual streams live in registers (st[8][8] f16 = one lane's
// column of every 16x16 tile).

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InW16       { float16_t  wbuf16[]; };
layout(set = 0, binding = 1) readonly buffer InAct       { NR_OPERAND in_act[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct     { NR_OPERAND out_act[]; };
layout(set = 0, binding = 3, std430) readonly buffer WRep { NR_OPERAND wrep[]; };

layout(push_constant) uniform StageArgs {
    uint wbuf_lo;
    uint wbuf_hi;
    layout(offset = 40) int dimW;
    int dimH;
    int shiftX;
    int shiftY;
};

shared NR_OPERAND sX[16 * 128];   // raw fp8: decode happens where it is read
shared NR_OPERAND sN[16 * 128];
shared NR_OPERAND sQ[16 * 32];
shared float16_t  sP[16 * 16];    // probabilities stay f16 (prob8=0 in the model)
shared NR_OPERAND sC[16 * 32];
shared NR_OPERAND sH[16 * 32];
shared float16_t  sB1[32];

// ---- scalar helpers ----------------------------------------------------------------

uint byte_of(uint w, uint k) { return (w >> (8u * k)) & 0xffu; }

// e4m3 code -> f16, exact (e = 0 subnormals get their own exponent field).
float16_t h_e4m3(uint b) {
    uint e = (b >> 3u) & 15u;
    uint m = b & 7u;
    uint s = (b >> 7u) << 15u;
    uint k = (m > 3u) ? 2u : ((m > 1u) ? 1u : 0u);
    uint sub = ((6u + k) << 10u) | (((m << (10u - k)) - 1024u) & 0x3ffu);
    uint bits = (e == 0u) ? ((m == 0u) ? 0u : sub) : (((e + 8u) << 10u) | (m << 7u));
    return float16_t(unpackHalf2x16(s | bits).x);
}

uint perm_P(uint i)    { return ((i >> 2u) << 1u) | (i & 1u) | (((i >> 1u) & 1u) << 4u); }
uint perm_invP(uint c) { return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u); }
uint vidx(uint c)      { return (c & ~31u) | perm_invP(c); }

float read_f16(uint byte_off) { return float(wbuf16[byte_off >> 1u]); }

// The +-448 clamp before the store. It returns plain f32 and the element type comes from
// NR_OPERAND at the store, so the f16-operand build (the lavapipe check) contains no fp8 values
// at all - the same shape sr_stage's q8 has (an fp8-typed value here made llvmpipe fault).
float quant8(float x) { return clamp(x, -448.0, 448.0); }

int reflect_coord(int p, int dim) {
    int a = abs(p);
    int b = 2 * (dim - 1) - a;
    int r = min(min(a, b), dim - 1);
    return (b < 0) ? dim - 1 : r;
}

// NeuralHub's scaled exp (model nr_swin_exp): NOT exp(x) - it is 2^(32p-47) with
// y = clamp(x*0.0171814, +-0.556), p = y*(0.92724609375 - y^2) + 1.375, i.e. exp(0.352 x)/8,
// the softmax's temperature. The curve stays; p is packed straight into f16 bits (RTZ).
float swin_exp(float x) {
    float y = clamp(x * 0.017181396484375, -0.55615234375, 0.55615234375);
    float p = y * (-y * y + 0.92724609375) + 1.375;
    uint h = packHalf2x16(vec2(p, 0.0)) & 0xffffu;
    return unpackHalf2x16(((h << 5u) + 0x8000u) & 0xffffu).x;
}

// NeuralHub's spline GELU (model act_fn 'nhgelu'), f32 arithmetic.
float nh_gelu(float z) {
    float t = clamp(z, -2.0, 2.0);
    return z * (t * (0.412109375 - 0.0810546875 * abs(t)) + 0.5);
}

void sync_lds() { memoryBarrierShared(); barrier(); }

// ---- input staging: fp8 bytes -> f16 in logical channel order -----------------------
// One storage load and one hardware e4m3->f16 convert a byte; perm_P folds (literal indices).

void stage_cg(uint cg, uint tok, uint base) {
#define SB(I) sX[tok * 128u + cg * 32u + perm_P(I)] = in_act[base + (I)];
    SB(0u)  SB(1u)  SB(2u)  SB(3u)  SB(4u)  SB(5u)  SB(6u)  SB(7u)
    SB(8u)  SB(9u)  SB(10u) SB(11u) SB(12u) SB(13u) SB(14u) SB(15u)
    SB(16u) SB(17u) SB(18u) SB(19u) SB(20u) SB(21u) SB(22u) SB(23u)
    SB(24u) SB(25u) SB(26u) SB(27u) SB(28u) SB(29u) SB(30u) SB(31u)
#undef SB
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint tok = tid & 15u;     // token inside the window (staging / output view)
    uint col = tid & 15u;     // column inside a 16-wide fragment tile (fragment view)
    uint rowh = tid >> 4u;    // which 8-row half this lane's components belong to

    int gx = int(gl_WorkGroupID.x);
    int gy = int(gl_WorkGroupID.y);
    int x0 = gx * 4 - shiftX;
    int y0 = gy * 4 - shiftY;
    int dx = int(tok & 3u);
    int dy = int(tok >> 2u);
    int px = reflect_coord(x0 + dx, dimW);
    int py = reflect_coord(y0 + dy, dimH);

    uint HW = uint(dimH * dimW);
    uint pos = uint(py * dimW + px);
    uint w_off = wbuf_lo & 0x1fffffu;

    // ---- 1. stage the window's input
    {
        uint cg0 = (tid >> 4u) * 2u;
        stage_cg(cg0, tok, (cg0 * HW + pos) * 32u);
        stage_cg(cg0 + 1u, tok, ((cg0 + 1u) * HW + pos) * 32u);
    }
    sync_lds();

    // ---- 2. RMSNorm 1 (gain1) -> sN, then sN feeds every head's QKV
    {
        float ss[8] = float[8](0, 0, 0, 0, 0, 0, 0, 0);
        for (uint t = 0u; t < 8u; ++t) {
            for (uint i = 0u; i < 8u; ++i) {
                float v = float(sX[(8u * rowh + i) * 128u + 16u * t + col]);
                ss[i] += v * v;
            }
        }
        for (uint i = 0u; i < 8u; ++i) { NR_ACC_ROW_REDUCE(ss[i]) }
        float rs[8];
        for (uint i = 0u; i < 8u; ++i) rs[i] = inversesqrt(ss[i] + 6.103515625e-05);
        for (uint t = 0u; t < 8u; ++t) {
            float g = read_f16(w_off + 2u * vidx(16u * t + col));
            for (uint i = 0u; i < 8u; ++i) {
                uint k = (8u * rowh + i) * 128u + 16u * t + col;
                sN[k] = NR_OPERAND(quant8(float(sX[k]) * (rs[i] * g)));
            }
        }
    }
    sync_lds();

    // ---- 3. attention + residual: the post-attention stream lives in registers. The array is
    // f32 holding f16-rounded values (every assignment narrows through float16_t, so the
    // arithmetic is the model's f16 state); llvmpipe's copy_prop_vars faults on an f16 array.
    float st[8][8];
    {
        // state = x + v270 (the model adds v270 before the heads)
        uint v270 = w_off + 256u + 4u * 12800u;
        for (uint t = 0u; t < 8u; ++t) {
            float v = read_f16(v270 + 2u * vidx(16u * t + col));
            for (uint i = 0u; i < 8u; ++i)
                st[t][i] = float16_t(float(sX[(8u * rowh + i) * 128u + 16u * t + col]) + v);
        }
    }

    for (uint h = 0u; h < 4u; ++h) {
        uint hb = w_off + 256u + h * 12800u;
        uint wo = hb + 64u * 128u + 512u;

        // 3a. Q and K: A = sN [tokens x C], B = wrep [32 x C] -> [token][dim] accumulators
        NR_FRAG_ACC qf[2];
        NR_FRAG_ACC kf[2];
        qf[0] = NR_ACC_ZERO; qf[1] = NR_ACC_ZERO;
        kf[0] = NR_ACC_ZERO; kf[1] = NR_ACC_ZERO;
        // unrolled: in a dynamic loop ACO cannot hoist iteration kk+1's fragment loads ahead of
        // iteration kk's MMAs, and the measurement says loads (0.48) and the MMA pipe (0.35) sit
        // fully serial (0.91 total). Straight-line code lets the scheduler interleave them.
        [[unroll]] for (uint kk = 0u; kk < 8u; ++kk) {
            NR_FRAG_A fa;
            NR_LOAD_A(fa, sN, 16u * kk, 128u);
            NR_FRAG_B bq0;
            NR_LOAD_B(bq0, wrep, hb + 16u * kk, 128u);
            NR_FRAG_B bq1;
            NR_LOAD_B(bq1, wrep, hb + 2048u + 16u * kk, 128u);
            NR_MMA(qf[0], fa, bq0);
            NR_MMA(qf[1], fa, bq1);
            NR_FRAG_B bk0;
            NR_LOAD_B(bk0, wrep, hb + 4096u + 16u * kk, 128u);
            NR_FRAG_B bk1;
            NR_LOAD_B(bk1, wrep, hb + 4096u + 2048u + 16u * kk, 128u);
            NR_MMA(kf[0], fa, bk0);
            NR_MMA(kf[1], fa, bk1);
        }
        for (uint j = 0u; j < 2u; ++j) {
            for (uint i = 0u; i < 8u; ++i) {
                sQ[(8u * rowh + i) * 32u + 16u * j + col] = NR_OPERAND(quant8(qf[j][i]));
            }
        }
        sync_lds();

        // 3b. logits = Q Q^T + relpos (the logit product's B operand comes from the same tile)
        NR_FRAG_ACC lg = NR_ACC_ZERO;
        [[unroll]] for (uint kk = 0u; kk < 2u; ++kk) {
            NR_FRAG_A la;
            NR_LOAD_A(la, sQ, 16u * kk, 32u);
            NR_FRAG_B lb;
            NR_LOAD_B(lb, sQ, 16u * kk, 32u);
            NR_MMA(lg, la, lb);
        }
        for (uint i = 0u; i < 8u; ++i)
            lg[i] = lg[i] + read_f16(hb + 8192u + 2u * ((8u * rowh + i) * 16u + col));

        // 3c. softmax: exp, then the row (query) sum over the window's 16 keys
        float e0 = swin_exp(lg[0]), e1 = swin_exp(lg[1]);
        float e2 = swin_exp(lg[2]), e3 = swin_exp(lg[3]);
        float e4 = swin_exp(lg[4]), e5 = swin_exp(lg[5]);
        float e6 = swin_exp(lg[6]), e7 = swin_exp(lg[7]);
        float s0 = e0, s1 = e1, s2 = e2, s3 = e3, s4 = e4, s5 = e5, s6 = e6, s7 = e7;
        NR_ACC_ROW_REDUCE(s0) NR_ACC_ROW_REDUCE(s1) NR_ACC_ROW_REDUCE(s2)
        NR_ACC_ROW_REDUCE(s3) NR_ACC_ROW_REDUCE(s4) NR_ACC_ROW_REDUCE(s5)
        NR_ACC_ROW_REDUCE(s6) NR_ACC_ROW_REDUCE(s7)
        {
            NR_FRAG_ACC16 pf;
            pf[0] = float16_t(e0 / s0); pf[1] = float16_t(e1 / s1);
            pf[2] = float16_t(e2 / s2); pf[3] = float16_t(e3 / s3);
            pf[4] = float16_t(e4 / s4); pf[5] = float16_t(e5 / s5);
            pf[6] = float16_t(e6 / s6); pf[7] = float16_t(e7 / s7);
            NR_STORE_ACC(pf, sP, 0u, 16u);
        }

        // 3d. ctx = P V (V as f16 B operand straight from its accumulator tiles)
        NR_FRAG_A16 pa;
        NR_LOAD_A(pa, sP, 0u, 16u);
        NR_FRAG_ACC cf[2];
        cf[0] = NR_ACC_ZERO; cf[1] = NR_ACC_ZERO;
        for (uint j = 0u; j < 2u; ++j) {
            NR_FRAG_B16 vb;
            for (uint i = 0u; i < 8u; ++i) vb[i] = float16_t(kf[j][i]);
            NR_MMA(cf[j], pa, vb);
        }
        for (uint j = 0u; j < 2u; ++j)
            for (uint i = 0u; i < 8u; ++i)
                sC[(8u * rowh + i) * 32u + 16u * j + col] = NR_OPERAND(quant8(cf[j][i]));
        sync_lds();

        // 3e. Wo: state = f16(state + ctx . Wo_h)
        // A = sC's two K slices are the SAME for all eight nt (only B varies): load them once.
        // The A-fragment loads measured 0.592 ms of this kernel's 0.912 (noA probe) and this loop
        // was reloading 8x2 of them a head for identical data.
        NR_FRAG_A wa0, wa1;
        NR_LOAD_A(wa0, sC, 0u, 32u);
        NR_LOAD_A(wa1, sC, 16u, 32u);
        for (uint nt = 0u; nt < 8u; ++nt) {
            NR_FRAG_ACC a = NR_ACC_ZERO;
            { NR_FRAG_B fb0; NR_LOAD_B(fb0, wrep, wo + 16u * nt * 32u, 32u);
              NR_MMA(a, wa0, fb0); }
            { NR_FRAG_B fb1; NR_LOAD_B(fb1, wrep, wo + 16u * nt * 32u + 16u, 32u);
              NR_MMA(a, wa1, fb1); }
            for (uint i = 0u; i < 8u; ++i) st[nt][i] = float16_t(st[nt][i] + a[i]);
        }
    }

    // ---- 4. RMSNorm 2 (gain2) from the register residual -> sN (norm1's copy is dead)
    sync_lds();
    {
        float ss[8] = float[8](0, 0, 0, 0, 0, 0, 0, 0);
        for (uint t = 0u; t < 8u; ++t) {
            for (uint i = 0u; i < 8u; ++i) ss[i] += st[t][i] * st[t][i];
        }
        for (uint i = 0u; i < 8u; ++i) { NR_ACC_ROW_REDUCE(ss[i]) }
        uint gain2 = w_off + 256u + 4u * 12800u + 256u;
        float rs[8];
        for (uint i = 0u; i < 8u; ++i) rs[i] = inversesqrt(ss[i] + 6.103515625e-05);
        for (uint t = 0u; t < 8u; ++t) {
            float g = read_f16(gain2 + 2u * vidx(16u * t + col));
            for (uint i = 0u; i < 8u; ++i) {
                uint k = (8u * rowh + i) * 128u + 16u * t + col;
                sN[k] = NR_OPERAND(quant8(st[t][i] * (rs[i] * g)));
            }
        }
    }
    sync_lds();

    // ---- 5. MLP residual mlp = state + fc2_bias, then 16 blocks of fc1/GELU/fc2
    {
        uint ffn = w_off + 256u + 4u * 12800u + 512u;
        uint fc2b = ffn + 8256u;
        for (uint t = 0u; t < 8u; ++t) {
            float b = read_f16(fc2b + 2u * vidx(16u * t + col));
            for (uint i = 0u; i < 8u; ++i) st[t][i] = float16_t(float(st[t][i]) + b);
        }

        // A = sN's eight K slices are FIXED for all 16 MLP blocks: load them ONCE here instead
        // of 8 loads x16 blocks (128 -> 8; fragments are registers, +~8 VGPR while live).
        NR_FRAG_A na0, na1, na2, na3, na4, na5, na6, na7;
        NR_LOAD_A(na0, sN,   0u, 128u); NR_LOAD_A(na1, sN,  16u, 128u);
        NR_LOAD_A(na2, sN,  32u, 128u); NR_LOAD_A(na3, sN,  48u, 128u);
        NR_LOAD_A(na4, sN,  64u, 128u); NR_LOAD_A(na5, sN,  80u, 128u);
        NR_LOAD_A(na6, sN,  96u, 128u); NR_LOAD_A(na7, sN, 112u, 128u);
        for (uint j = 0u; j < 16u; ++j) {
            uint base = ffn + j * 8256u + ((j == 0u) ? 0u : 256u);
            uint fc1 = base;
            uint b1o = base + 4096u;
            uint fc2 = base + 4160u;
            if (tid < 32u) sB1[tid] = float16_t(read_f16(b1o + 2u * vidx(tid)));

            // fc1: z = sN . W1^T + b1
            NR_FRAG_ACC zf[2];
            zf[0] = NR_ACC_ZERO; zf[1] = NR_ACC_ZERO;
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 0, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 0, 128u);
              NR_MMA(zf[0], na0, f0); NR_MMA(zf[1], na0, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 1, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 1, 128u);
              NR_MMA(zf[0], na1, f0); NR_MMA(zf[1], na1, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 2, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 2, 128u);
              NR_MMA(zf[0], na2, f0); NR_MMA(zf[1], na2, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 3, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 3, 128u);
              NR_MMA(zf[0], na3, f0); NR_MMA(zf[1], na3, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 4, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 4, 128u);
              NR_MMA(zf[0], na4, f0); NR_MMA(zf[1], na4, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 5, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 5, 128u);
              NR_MMA(zf[0], na5, f0); NR_MMA(zf[1], na5, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 6, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 6, 128u);
              NR_MMA(zf[0], na6, f0); NR_MMA(zf[1], na6, f1); }
            { NR_FRAG_B f0, f1; NR_LOAD_B(f0, wrep, fc1 + 16u * 7, 128u);
              NR_LOAD_B(f1, wrep, fc1 + 2048u + 16u * 7, 128u);
              NR_MMA(zf[0], na7, f0); NR_MMA(zf[1], na7, f1); }

            for (uint t = 0u; t < 2u; ++t) {
                float b = float(sB1[16u * t + col]);
                for (uint i = 0u; i < 8u; ++i)
                    sH[(8u * rowh + i) * 32u + 16u * t + col] = NR_OPERAND(quant8(nh_gelu(zf[t][i] + b)));
            }

            // fc2: state = f16(state + hidden . W2^T)
            // A = sH's two K slices are the SAME for all eight nt: load them once (was 16 loads
            // a block x16 blocks = 256 for two fragments).
            NR_FRAG_A ha0, ha1;
            NR_LOAD_A(ha0, sH, 0u, 32u);
            NR_LOAD_A(ha1, sH, 16u, 32u);
            for (uint nt = 0u; nt < 8u; ++nt) {
                NR_FRAG_ACC a = NR_ACC_ZERO;
                { NR_FRAG_B f0; NR_LOAD_B(f0, wrep, fc2 + 16u * nt * 32u, 32u);
                  NR_MMA(a, ha0, f0); }
                { NR_FRAG_B f1; NR_LOAD_B(f1, wrep, fc2 + 16u * nt * 32u + 16u, 32u);
                  NR_MMA(a, ha1, f1); }
                for (uint i = 0u; i < 8u; ++i) st[nt][i] = float16_t(st[nt][i] + a[i]);
            }
        }
    }

    // ---- 6. out = clamp(state, +-448) as E4M3, scattered to in-bounds pixels
    for (uint i = 0u; i < 8u; ++i) {
        uint row = 8u * rowh + i;
        int rx = x0 + int(row & 3u);
        int ry = y0 + int(row >> 2u);
        if (rx >= 0 && rx < dimW && ry >= 0 && ry < dimH) {
            uint opos = uint(ry * dimW + rx);
            for (uint t = 0u; t < 8u; ++t) {
                uint c = 16u * t + col;
                out_act[((c >> 5u) * HW + opos) * 32u + perm_invP(c & 31u)] =
                    NR_OPERAND(quant8(st[t][i]));
            }
        }
    }
}
