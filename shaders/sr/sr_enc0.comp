#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Enc0PushConstants {
    uint weights_offset;
    uint in_offset;
    uint skip_in_offset;
    uint skip_out_offset;
    uint down_out_offset;
    int dimW;
    int dimH;
    int shift_x;
    int shift_y;
    int C;
    int g;
    int mode;
    int Cnext;
    int W0;
    int H0;
} pc;

layout(set = 0, binding = 0, std430) buffer ActBuffer {
    uint8_t acts[];
};

layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer {
    uint8_t weights[];
};

shared float s_in_f[32][128];

float16_t read_f16(uint idx) {
    uint16_t lo = uint16_t(acts[idx]) | (uint16_t(acts[idx + 1u]) << 8u);
    return unpackFloat2x16(uint(lo)).x;
}

float16_t read_w_f16(uint idx) {
    uint16_t lo = uint16_t(weights[idx]) | (uint16_t(weights[idx + 1u]) << 8u);
    return unpackFloat2x16(uint(lo)).x;
}

float read_f32(uint idx) {
    uint b0 = uint(acts[idx]) | (uint(acts[idx + 1u]) << 8u) | (uint(acts[idx + 2u]) << 16u) | (uint(acts[idx + 3u]) << 24u);
    return uintBitsToFloat(b0);
}

float16_t e4m3_to_f16(uint8_t b) {
    uint u = uint(b);
    float16_t s = (u & 0x80u) != 0u ? float16_t(-1.0) : float16_t(1.0);
    uint e = (u >> 3u) & 0x0Fu;
    uint m = u & 0x07u;
    if (e == 0x0Fu && m == 0x07u) return float16_t(0.0);
    if (e == 0u) return s * (float16_t(m) / float16_t(8.0)) * float16_t(0.015625);
    return s * (float16_t(1.0) + float16_t(m) / float16_t(8.0)) * exp2(float16_t(int(e) - 7));
}

uint8_t f16_to_e4m3(float16_t x) {
    if (isnan(x)) return uint8_t(0x7F);
    uint sign = (x < float16_t(0.0)) ? 0x80u : 0u;
    float16_t ax = abs(x);
    if (ax > float16_t(448.0)) return uint8_t(sign | 0x7Eu);
    if (ax < float16_t(0.001953125)) {
        uint m = uint(round(float(ax) * 512.0));
        return uint8_t(sign | min(m, 7u));
    }
    int e = int(floor(log2(float(ax))));
    e = clamp(e, -6, 8);
    float base = exp2(float(e));
    float norm = (float(ax) - base) / base;
    uint m = uint(round(norm * 8.0));
    if (m >= 8u) {
        m = 0u;
        e += 1;
        if (e > 8) return uint8_t(sign | 0x7Eu);
    }
    uint exp_bits = uint(e + 7);
    return uint8_t(sign | (exp_bits << 3u) | m);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    int lx = int(tid % 8u);
    int ly = int(tid / 8u);

    int gx = int(gl_WorkGroupID.x) * 8 + lx;
    int gy = int(gl_WorkGroupID.y) * 8 + ly;

    if (gx >= pc.dimW || gy >= pc.dimH) return;

    // Render resolution: each L1 pixel (gx, gy) corresponds to 2x2 render pixels
    int rx0 = gx * 2;
    int ry0 = gy * 2;
    int rw = pc.dimW * 2;
    int rh = pc.dimH * 2;

    // 128 input features from 4 pixels x 32 channels
    float in_f[128];
    for (int p = 0; p < 4; ++p) {
        int dx = p % 2;
        int dy = p / 2;
        int cx = clamp(rx0 + dx, 0, rw - 1);
        int cy = clamp(ry0 + dy, 0, rh - 1);
        uint p_idx = uint(cy * rw + cx);

        // 0..3: g_col RGBA16F
        uint c_idx = pc.in_offset + p_idx * 8u;
        s_in_f[tid][p * 32 + 0] = float(read_f16(c_idx));
        s_in_f[tid][p * 32 + 1] = float(read_f16(c_idx + 2u));
        s_in_f[tid][p * 32 + 2] = float(read_f16(c_idx + 4u));
        s_in_f[tid][p * 32 + 3] = float(read_f16(c_idx + 6u));

        // 4..5: g_mv RG16F (offset in_offset + rw*rh*8)
        uint m_idx = pc.in_offset + uint(rw * rh * 8) + p_idx * 4u;
        s_in_f[tid][p * 32 + 4] = float(read_f16(m_idx));
        s_in_f[tid][p * 32 + 5] = float(read_f16(m_idx + 2u));

        // 6: g_dep R32F
        uint d_idx = pc.in_offset + uint(rw * rh * 12) + p_idx * 4u;
        s_in_f[tid][p * 32 + 6] = read_f32(d_idx);

        // Dither at enc0_w_offset (4096 bytes)
        int dith_x = cx % 64;
        int dith_y = cy % 64;
        s_in_f[tid][p * 32 + 7] = float(weights[pc.weights_offset + uint(dith_y * 64 + dith_x)]) / 255.0 - 0.5;

        for (int k = 8; k < 32; ++k) s_in_f[tid][p * 32 + k] = 0.0;
    }

    // Weights: w200 (64, 128) starts at pc.weights_offset + 4096u
    uint w_base = pc.weights_offset + 4096u;
    uint bias_base = w_base + uint(64 * 128); // 64 f16 bias values

    for (int c = 0; c < 64; ++c) {
        float acc = 0.0;
        for (int k = 0; k < 128; ++k) {
            float16_t w = e4m3_to_f16(weights[w_base + uint(c * 128 + k)]);
            acc += s_in_f[tid][k] * float(w);
        }
        float16_t bias = read_w_f16(bias_base + uint(c * 2));
        float16_t out_val = float16_t(acc + float(bias));

        uint slab = uint(c / 32);
        uint c_in_slab = uint(c % 32);
        uint idx = pc.skip_out_offset + (((slab * uint(pc.dimH) + uint(gy)) * uint(pc.dimW) + uint(gx)) * 32u + c_in_slab);
        acts[idx] = f16_to_e4m3(out_val);
    }
}
