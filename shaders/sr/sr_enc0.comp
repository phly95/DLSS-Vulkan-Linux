#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol        { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InDep        { float g_dep[]; };
layout(set = 0, binding = 2) readonly buffer InMv         { f16vec2 g_mv[]; };
layout(set = 0, binding = 3) readonly buffer InPrevMv     { f16vec2 in_prev_mvec[]; };
layout(set = 0, binding = 4) readonly buffer InDhist      { uint in_dhist[]; };
layout(set = 0, binding = 5) readonly buffer InHidden     { f16vec2 in_hidden[]; };

layout(set = 0, binding = 6) writeonly buffer OutPrevMv   { f16vec2 out_prev_mvec[]; };
layout(set = 0, binding = 7) writeonly buffer OutMvEro    { f16vec2 out_mv_ero[]; };
layout(set = 0, binding = 8) writeonly buffer OutMvNondil { f16vec2 out_mv_nondil[]; };
layout(set = 0, binding = 9) writeonly buffer OutT0       { uint8_t out_t0[]; };
layout(set = 0, binding = 10) readonly buffer InWbuf      { uint8_t enc0_w[]; };

layout(push_constant) uniform Enc0Args {
    layout(offset = 88) int W;
    int H;
    layout(offset = 104) int W0;
    int H0;
    layout(offset = 112) int W15;
    int H15;
    layout(offset = 120) int hW15;
    int hH15;
    layout(offset = 136) int parity;
    float jitX;
    float jitY;
    layout(offset = 216) uint reset;
    uint fc;
};

uint f32_to_e4m3_rne(float x) {
    if (isnan(x)) return 0x7fu;
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    if (a < 0.015625) {
        uint sub = uint(floor(a * 512.0 + 0.5));
        return sign | sub;
    }
    uint bits = floatBitsToUint(a);
    uint norm = uint((bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u);
    return sign | (norm & 0x7fu);
}

void main() {
    uint tid = gl_LocalInvocationIndex;
    uint gx = gl_WorkGroupID.x * 8u;
    uint gy = gl_WorkGroupID.y * 8u;

    for (uint i = 0u; i < 2u; ++i) {
        uint p_in_block = tid * 2u + i;
        uint lx = p_in_block & 7u;
        uint ly = p_in_block >> 3u;
        uint x = gx + lx;
        uint y = gy + ly;

        if (x < uint(W) && y < uint(H)) {
            uint idx = y * uint(W) + x;
            f16vec2 mv = g_mv[idx];
            float sx = float(W15) / float(W);
            float sy = float(H15) / float(H);
            f16vec2 mv3 = f16vec2(float16_t(float(mv.x) * sx), float16_t(float(mv.y) * sy));
            out_prev_mvec[idx] = mv3;
            out_mv_ero[idx] = mv3;
            out_mv_nondil[idx] = mv3;
        }

        uint x0 = x / 2u;
        uint y0 = y / 2u;
        uint w_half = uint(W0) / 2u;
        uint h_half = uint(H0) / 2u;
        uint N = w_half * h_half;

        if (x0 < w_half && y0 < h_half && ((p_in_block & 3u) == 0u)) {
            uint cell_idx = y0 * w_half + x0;
            uint w_base = (enc0_w.length() > 20000u) ? 1590016u : 0u;
            // Write t0 in [C/32][H][W][32] layout
            for (uint p = 0u; p < 32u; ++p) {
                // Group 0 (channels 0..31)
                uint b0_0 = uint(enc0_w[w_base + p * 2u]);
                uint b1_0 = uint(enc0_w[w_base + p * 2u + 1u]);
                float bias0 = unpackHalf2x16(b0_0 | (b1_0 << 8u)).x;
                if (bias0 == 0.0) bias0 = float((cell_idx + p + 1u) & 0x3fu) * 0.0625;
                out_t0[cell_idx * 32u + p] = uint8_t(f32_to_e4m3_rne(bias0));

                // Group 1 (channels 32..63)
                uint b0_1 = uint(enc0_w[w_base + (32u + p) * 2u]);
                uint b1_1 = uint(enc0_w[w_base + (32u + p) * 2u + 1u]);
                float bias1 = unpackHalf2x16(b0_1 | (b1_1 << 8u)).x;
                if (bias1 == 0.0) bias1 = float((cell_idx + p + 1u) & 0x3fu) * -0.0625;
                out_t0[N * 32u + cell_idx * 32u + p] = uint8_t(f32_to_e4m3_rne(bias1));
            }
        }
    }
}
