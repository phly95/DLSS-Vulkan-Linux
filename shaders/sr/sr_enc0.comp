#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : enable

#include "nh_mm.glsl"
#include "rh.glsl"

// k_sr_enc0 (NeuralHub SR preset M, oracle launch 2). Spec: tools/sr/sr_enc0_model.py (A1 green:
// t0 99.9638/99.9570 vs the oracle, the three MV buffers 100% on both frames). Every feature
// formula, constant and rounding point below is the model's, in its operation order; what changed
// against the first (bit-exact) port is the shape of the work, not the maths:
//
//  * the 80 -> 64 embed is one fp8 16x16x16 cooperative-matrix GEMM instead of the per-thread
//    scalar f16 chain: M = the 16 half-res cells of the tile (one fragment), N = the 64 output
//    channels (4 fragments), K = 128 (4 sub-pixels x 32 features, 20 real + 12 zero), so the
//    whole tile is 32 MMAs against 8192 scalar fma per cell. The accumulator is f32 (FP8 WMMA
//    accumulates in f32 only) and the f16 chain between the four sub-pixel groups is gone - the
//    precision policy of the optimisation phase allows that; the clamp +-6.28125 and the E4M3 RNE
//    store are unchanged.
//  * one thread owns one pixel, not one cell: the 32 lanes of the tile compute their two pixels'
//    MVF (3x3 depth tournament), MV stores and 20 features together, so the tournament runs once
//    per pixel instead of once for the MV outputs plus once per sub-pixel, and the four dhist
//    samples share one bilinear setup per sample (R,G,B ride the same taps) and one dither word
//    per pixel (the dither index depends on (fc, x, y) only).
//
// Workgroup: one 8x8 render tile = 32 lanes = ONE wave32 (a 64-thread group would run wave64 and
// the fragment layout below is the wave32 one). Grid (W0/8, H0/8) as before. Cell c of the tile is
// (c&3, c>>2) on the half-res grid; lane l's A row is cell 8*(l>>4)+c, its output column 16*n+l&15
// (the gfx1201 fragment map: component c of lane l is element (8*(l/16)+c, l%16)).
//
// The MV outputs are bit-identical to the first port: for raw y < H, prev_mvec1 = the min-depth
// read, mv_nondil = the centre read, each stored as f16(3.0*(mvoff +
// g_mv[read])) (3.0 is Enc0Args+0xa4/0xa8, mvoff +0xbc).
//
// Features 0..19 (model features()/dq), one dq() (dithered E4M3 quantizer, dither =
// enc0_w[0:4096] as 2048 u16, fc from push +0xdc) per logical feature:
//   0..2  tm(e*rgb) of the mirrored g_col row, e = expo[parity] (1.0 when the word is 0)
//         (LDR: lin_feat linear, no expo multiply, no tonemap),
//   3..14 four bilinear dhist samples (xR, then G, B) at the reprojected positions built from
//         the min/centre/max MV reads (+ F20) and the A read (no -F20 term) for sample 3,
//   15    reset: 0.22356846928596497 * ln(1 + sqrt(S)) of the MV-vs-prev_mvec difference,
//   16..19 the 4 int8 hidden channels warped at the sample-0 position (F28/size terms),
//   20..31 zero (never written by the kernel).
//
// Push constants: the oracle's own Enc0Args offsets (280-byte struct, HIP pointers not pushed);
// the block runs 88..252 (maxPushConstantsSize is 256 on this device, so Enc0Args+0x100 mvhi
// cannot be pushed - the host selects the mv buffer at bind time and nothing here reads it).

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// The GEMM's A operand: [16 cells][128] with K contiguous, K index = 32*sub-pixel + feature.
// 16-byte aligned rows, so every fragment load offset and stride is too.
shared NR_OPERAND sA[16 * 128];
// The wave's 10x10 depth + motion-vector neighbourhood of its tile, loaded cooperatively once:
// the 3x3 tournament then costs LDS reads instead of 832 scattered global loads a wave.
shared float sdep[100];
shared f16vec2 smv[100];

layout(set = 0, binding = 0) readonly buffer InCol        { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InDep        { float g_dep[]; };
layout(set = 0, binding = 2) readonly buffer InMv         { f16vec2 g_mv[]; };
layout(set = 0, binding = 3) readonly buffer InPrevMv     { f16vec2 in_prev_mvec[]; };
layout(set = 0, binding = 4) readonly buffer InDhist      { uint in_dhist[]; };
layout(set = 0, binding = 5) readonly buffer InHidden     { int8_t in_hidden[]; };

layout(set = 0, binding = 6) writeonly buffer OutPrevMv   { f16vec2 out_prev_mvec[]; };
// binding 7 (mv_ero) removed 2026-10-28: dead (sr_post binds but never reads it)
layout(set = 0, binding = 8) writeonly buffer OutMvNondil { f16vec2 out_mv_nondil[]; };
layout(set = 0, binding = 9) writeonly buffer OutT0       { uint8_t out_t0[]; };
layout(set = 0, binding = 10) readonly buffer InEnc0W     { uint8_t enc0_w[]; };
// the exposure buffer holds the two parity words (Enc0Args+0x80); the kernel reads enc0[parity]
// as an f16 bit pattern and uses 1.0 when that word is 0 (model load()).
layout(set = 0, binding = 11) readonly buffer InExpo      { uint in_expo[]; };
// The enc0 64x128 weight tile repacked on the host into [N][K] row-major (K contiguous), so the
// B operand loads ColumnMajor straight out of it (src/vk/pipeline.cpp sr_repack_enc0).
layout(set = 0, binding = 12, std430) readonly buffer InEnc0WR { NR_OPERAND w_enc0r[]; };

layout(push_constant) uniform Enc0Args {
    layout(offset = 88) int W;
    int H;
    layout(offset = 96) int Wb;                 // +0x60 the render size again (srref .i2)
    int Hb;
    layout(offset = 104) int W0;
    int H0;
    layout(offset = 112) int W15;
    int H15;
    layout(offset = 120) int hW15;
    int hH15;
    layout(offset = 136) int parity;
    float F20x;                                 // +0x8c this frame's jitter
    float F20y;
    float F28x;                                 // +0x94 the previous frame's jitter
    float F28y;
    layout(offset = 188) float mvoffx;           // +0xbc mv_offset_kernel (0 for unjittered MVs)
    float mvoffy;
    layout(offset = 216) uint resetv;            // +0xd8 the kernel never reads it (model note)
    uint fc;                                    // +0xdc dither frame counter
    layout(offset = 224) uint depinv;            // +0xe0 read by Enc0Args, unused by the maths
    uint mvpitch;                               // +0xe4 (the buffers are packed: mvpitch == W)
    layout(offset = 252) uint ldr;               // +0xfc LDR colour: linear colour
                                               // features (no expo/tm) and dhist
                                               // samples without *2.45 (below)
};

// ---------------------------------------------------------------- helpers

// The 8-bit -> E4M3 value (the model's LUT bit for bit, incl. code 0x7f = 480).
float e4m3_to_f32(uint b) {
    uint e = (b >> 3u) & 15u;
    float v = (e == 0u) ? float(b & 7u) * 0.001953125
                        : uintBitsToFloat(((e + 120u) << 23u) | ((b & 7u) << 20u));
    return ((b & 0x80u) != 0u) ? -v : v;
}

// f32 -> E4M3, RNE, saturating at 448, subnormal grid rounded half-up:
// the model's to_e4m3 / q8 (the t0 output encoder).
uint f32_to_e4m3_rne(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    uint sub = uint(floor(a * 512.0 + 0.5));
    uint bits = floatBitsToUint(a);
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | ((a < 0.015625) ? sub : (norm & 0x7fu));
}

// t0 epilogue store (uint8 buffer, software conversion both builds).
void t0_store(uint pos, float u) { out_t0[pos] = uint8_t(f32_to_e4m3_rne(u)); }

// The model's q8r: same, but the subnormal grid is RNE (this is what dq() feeds back into the
// GEMM). NaN takes the normal branch exactly as numpy does (bits 0x7fc00000 -> code 0x3c).
uint e4m3_q8r(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    uint bits = floatBitsToUint(a);
    float s512 = a * 512.0;
    float nf = floor(s512);
    uint n = uint(nf);
    float d = s512 - nf;
    uint sub = ((d > 0.5) || (d == 0.5 && (n & 1u) != 0u)) ? n + 1u : n;
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | ((a < 0.015625) ? sub : (norm & 0x7fu));
}

// f16 bit pattern of a finite f16-representable f32 (after rh(), so no rounding is left);
// NaN -> 0x7e00, the pattern np.float16(NaN) produces on the feature path.
uint f32_to_f16_bits(float x) {
    uint b = floatBitsToUint(x);
    uint s = (b >> 16u) & 0x8000u;
    float a = abs(x);
    if (a != a) return 0x7E00u;
    if (a >= 6.103515625e-05) {                 // normal f16
        uint e32 = (b >> 23u) & 0xffu;
        uint m = b & 0x7fffffu;
        return s | ((e32 - 112u) << 10u) | (m >> 13u);
    }
    if (a == 0.0) return s;
    return s | uint(a * 16777216.0);            // subnormal f16: multiples of 2^-24
}

// f16 bits -> f32, exact (subnormals, +-inf, NaN).
float f16_bits_to_f32(uint h) {
    uint s = (h & 0x8000u) << 16u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 0x3FFu;
    if (e == 0u) {
        float v = float(m) * 5.9604644775390625e-08;
        return ((h & 0x8000u) != 0u) ? -v : v;
    }
    if (e == 31u) return uintBitsToFloat(s | 0x7F800000u | (m << 13u));
    return uintBitsToFloat(s | ((e + 112u) << 23u) | (m << 13u));
}

// perm_invP: logical channel (mod 32) -> byte inside a P-permuted 32-block = m.IP (verified
// against tools/sr/sr_stage_model.py's P/IP; sr_dec0.comp ships the same formula).
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// The P-permuted f16 bias of output channel j: enc0.bin +12288 (model wmat).
float bias_f16(uint j) {
    uint b = 12288u + 2u * ((j & 0xFFFFFFE0u) | perm_invP(j & 31u));
    return f16_bits_to_f32(uint(enc0_w[b]) | (uint(enc0_w[b + 1u]) << 8u));
}

// Row of the g_col texel the kernel reads (model mirror_rows: |y| if |y| < H else 2H-2-|y|,
// clamped to [0, H-1]).
int mirror_row(int y) {
    int a = abs(y);
    int r = (a < H) ? a : (2 * H - 2 - a);
    return clamp(r, 0, H - 1);
}

// ---------------------------------------------------------------- the MV fields (model mv_fields)

struct MVF {
    vec2 mn;        // min-depth 3x3 read (+mvoff) -> prev_mvec1, dhist sample 0, reset's mv
    vec2 mx;        // max-depth 3x3 read          -> dhist sample 2 (mv_ero store removed)
    vec2 ct;        // centre read                 -> mv_nondil, dhist sample 1
    vec2 A;         // the 0x1bac read             -> dhist sample 3, the reset mask
};

void mvstep(float d, f16vec2 m,
            inout float mxv, inout f16vec2 mxm,
            inout float mnv, inout f16vec2 mnm) {
    bool kp = mxv >= d;                     // keep the earlier element on ties
    mxv = kp ? mxv : d;  mxm = kp ? mxm : m;
    bool nw = d < mnv;
    mnv = nw ? d : mnv;  mnm = nw ? m : mnm;
}

// The 3x3 tournament + the four MV reads, from the wave's LDS copy of the tile's neighbourhood.
// The tournament tracks the winning MV VALUES (f16vec2 is one register) rather than the winning
// row/column: same selection rule (ties keep the earlier element), ~25 fewer ops a pixel, and the
// coordinates are never needed again - the A read below has its own position.
MVF mvf(int x, int row, int row0, uint tile_x) {
    int xc = clamp(x, 0, W - 1);            // Enc0Args grids are W0 wide, reads clamp to W
    int yc = clamp(row, 0, H - 1);
    int lx = xc - int(tile_x) + 1;          // LDS coordinates: columns tile_x-1 .. tile_x+8,
    int ly = yc - row0;                     // rows row0 .. row0+9 (centre 1..8, border 0..9)

    float d0 = sdep[uint(ly * 10 + lx)];                 // centre
    float d1 = sdep[uint((ly - 1) * 10 + lx - 1)];       // (y-1, x-1)
    float d2 = sdep[uint((ly - 1) * 10 + lx)];           // (y-1, x)
    float d3 = sdep[uint((ly - 1) * 10 + lx + 1)];       // (y-1, x+1)
    float d4 = sdep[uint(ly * 10 + lx - 1)];             // (y, x-1)
    float d5 = sdep[uint(ly * 10 + lx + 1)];             // (y, x+1)
    float d6 = sdep[uint((ly + 1) * 10 + lx - 1)];       // (y+1, x-1)
    float d7 = sdep[uint((ly + 1) * 10 + lx)];           // (y+1, x)
    float d8 = sdep[uint((ly + 1) * 10 + lx + 1)];       // (y+1, x+1)

    f16vec2 m0 = smv[uint(ly * 10 + lx)];
    f16vec2 m1 = smv[uint((ly - 1) * 10 + lx - 1)];
    f16vec2 m2 = smv[uint((ly - 1) * 10 + lx)];
    f16vec2 m3 = smv[uint((ly - 1) * 10 + lx + 1)];
    f16vec2 m4 = smv[uint(ly * 10 + lx - 1)];
    f16vec2 m5 = smv[uint(ly * 10 + lx + 1)];
    f16vec2 m6 = smv[uint((ly + 1) * 10 + lx - 1)];
    f16vec2 m7 = smv[uint((ly + 1) * 10 + lx)];
    f16vec2 m8 = smv[uint((ly + 1) * 10 + lx + 1)];

    bool ge = d0 >= d1, gt = d0 > d1;
    float mxv = ge ? d0 : d1;  f16vec2 mxm = ge ? m0 : m1;
    float mnv = gt ? d1 : d0;  f16vec2 mnm = gt ? m1 : m0;
    mvstep(d2, m2, mxv, mxm, mnv, mnm);
    mvstep(d3, m3, mxv, mxm, mnv, mnm);
    mvstep(d4, m4, mxv, mxm, mnv, mnm);
    mvstep(d5, m5, mxv, mxm, mnv, mnm);
    mvstep(d6, m6, mxv, mxm, mnv, mnm);
    mvstep(d7, m7, mxv, mxm, mnv, mnm);
    mvstep(d8, m8, mxv, mxm, mnv, mnm);

    MVF f;
    f.ct = vec2(mvoffx, mvoffy) + vec2(float(m0.x), float(m0.y));
    f.mn = vec2(mvoffx, mvoffy) + vec2(float(mnm.x), float(mnm.y));
    f.mx = vec2(mvoffx, mvoffy) + vec2(float(mxm.x), float(mxm.y));
    // read A: floor(2*((p+0.5) - F20)) clamped, NaN -> 0 (the 0x1bac chain); not tile-local, so
    // this one stays a global read.
    float fax = floor(2.0 * ((float(x) + 0.5) - F20x));
    float fay = floor(2.0 * ((float(row) + 0.5) - F20y));
    int ax = (fax == fax) ? clamp(int(fax), 0, W - 1) : 0;
    int ay = (fay == fay) ? clamp(int(fay), 0, H - 1) : 0;
    f.A = vec2(mvoffx, mvoffy) + vec2(float(g_mv[uint(ay * W + ax)].x),
                                      float(g_mv[uint(ay * W + ax)].y));
    return f;
}

// ---------------------------------------------------------------- the model's scalar functions

// The model's constants, by their exact f32 bit patterns (tools/sr/sr_enc0_model.py hex).
#define C_CLAMP uintBitsToFloat(0x46FE0000u)   // 32512, min before the log
#define C_LO    uintBitsToFloat(0x38D1B717u)   // 1e-4
#define C_LOG   uintBitsToFloat(0x3E9A209Bu)   // log10(2)
#define C_SCALE uintBitsToFloat(0x3EB851ECu)   // 0.36
#define INV1023 uintBitsToFloat(0x3A802008u)   // 1/1023
#define C245    uintBitsToFloat(0x401CCCCDu)   // 2.45
#define KK      uintBitsToFloat(0x4598A2AFu)   // 4884.33544921875
#define LN2     uintBitsToFloat(0x3F317218u)   // ln(2)
#define SC      uintBitsToFloat(0x3E64EF22u)   // 0.22356846928596497

// tm(v) (model colour feature pre-pass): fma(100, v, 1), floor, log2*log10(2)*0.36, NaN -> 0.
float tm(float v) {
    float vc = (v > C_CLAMP) ? C_CLAMP : v;
    float t = fma(100.0, vc, 1.0);
    t = max(t, C_LO);
    float r = log2(t) * C_LOG;
    r = r * C_SCALE;
    return (v != v) ? 0.0 : r;
}

// One axis of a dhist sample position (model _axis): the round trip through (0.5/h)*C and the
// [-2, h+2] clamp (NaN -> -0.5), snapped to 1/256. Returns (tap, frac).
vec2 axis_dhist(float C, int h) {
    float a = (0.5 / float(h)) * C;
    float b = float(h) * a;
    float u = b - 0.5;
    u = (u != u) ? -0.5 : min(max(u, -2.0), float(h) + 2.0);
    float s = floor(u * 256.0 + 0.5) * (1.0 / 256.0);
    float tp = floor(s);
    return vec2(tp, s - tp);
}

// One bilinear dhist sample x 2.45 (model dhist_sample), all three channels at once: the taps and
// the bilinear weights are shared, only the 10-bit field of the loaded word moves (bits 0/10/20).
// The f32 accumulation order per channel is the model's ((w00*t00+w01*t01)+w10*t10)+w11*t11.
vec3 dhsamp3(vec2 C) {
    vec2 tx = axis_dhist(C.x, hW15);
    vec2 ty = axis_dhist(C.y, hH15);
    int ix = int(tx.x), iy = int(ty.x);
    float fx = tx.y, fy = ty.y;
    int x0 = clamp(ix, 0, hW15 - 1);
    int x1 = clamp(max(ix, -1) + 1, 0, hW15 - 1);
    int y0 = clamp(iy, 0, hH15 - 1);
    int y1 = clamp(max(iy, -1) + 1, 0, hH15 - 1);
    uint w00 = in_dhist[uint(y0 * hW15 + x0)];
    uint w01 = in_dhist[uint(y0 * hW15 + x1)];
    uint w10 = in_dhist[uint(y1 * hW15 + x0)];
    uint w11 = in_dhist[uint(y1 * hW15 + x1)];
    float b00 = (1.0 - fx) * (1.0 - fy);
    float b01 = fx * (1.0 - fy);
    float b10 = (1.0 - fx) * fy;
    float b11 = fx * fy;
    vec3 v;
    [[unroll]] for (uint ch = 0u; ch < 3u; ++ch) {
        uint sh = ch * 10u;
        float t00 = float((w00 >> sh) & 0x3FFu) * INV1023;
        float t01 = float((w01 >> sh) & 0x3FFu) * INV1023;
        float t10 = float((w10 >> sh) & 0x3FFu) * INV1023;
        float t11 = float((w11 >> sh) & 0x3FFu) * INV1023;
        v[ch] = ((b00 * t00 + b01 * t01) + b10 * t10) + b11 * t11;
    }
    // LDR (ldr != 0): dhist holds linear values, so the HDR tm-domain *2.45 (1/K) is
    // skipped (the kernel's ldr path branches around all twelve sites).
    return (ldr != 0u) ? v : v * C245;
}

// One axis of the prev_mvec interpolation (model reset_feature axis): clamp to [0,1] first,
// then the same [-2, n+2] clamp (NaN -> -0.5) and the 1/256 snap.
vec2 axis_reset(float u0, int n) {
    float t = u0 / float(n);
    t = min(max(t, 0.0), 1.0);
    float c = float(n) * t - 0.5;
    c = (c != c) ? -0.5 : min(max(c, -2.0), float(n) + 2.0);
    float s = floor(c * 256.0 + 0.5) * (1.0 / 256.0);
    float tp = floor(s);
    return vec2(tp, s - tp);
}

// Feature 15 (model reset_feature): the MV difference against the bilinear prev_mvec interp,
// the ISA's sqrt refinement, then 0.22356846928596497 * ln(1 + sqrt(S)); 0 where the sample-3
// position word leaves [0, W15] x [0, H15].
float reset_feat(MVF f, float xx, float yy) {
    float ux = (F28x + (xx - F20x)) + f.mn.x;
    float uy = (F28y + (yy - F20y)) + f.mn.y;
    vec2 ax = axis_reset(ux, W);
    vec2 ay = axis_reset(uy, H);
    int ix = int(ax.x), iy = int(ay.x);
    float fx = ax.y, fy = ay.y;
    int x0 = clamp(ix, 0, W - 1);
    int x1 = clamp(max(ix, -1) + 1, 0, W - 1);
    int y0 = clamp(iy, 0, H - 1);
    int y1 = clamp(max(iy, -1) + 1, 0, H - 1);
    f16vec2 m00 = in_prev_mvec[uint(y0 * W + x0)];
    f16vec2 m01 = in_prev_mvec[uint(y0 * W + x1)];
    f16vec2 m10 = in_prev_mvec[uint(y1 * W + x0)];
    f16vec2 m11 = in_prev_mvec[uint(y1 * W + x1)];
    float w00 = (1.0 - fy) * (1.0 - fx);
    float w01 = (1.0 - fy) * fx;
    float w10 = fy * (1.0 - fx);
    float w11 = fy * fx;
    float ipx = ((w00 * float(m00.x) + w01 * float(m01.x))
               + w10 * float(m10.x)) + w11 * float(m11.x);
    float ipy = ((w00 * float(m00.y) + w01 * float(m01.y))
               + w10 * float(m10.y)) + w11 * float(m11.y);
    float k = KK / float(H);
    float dx = f.mn.x - ipx * (1.0 / 3.0);
    float dy = f.mn.y - ipy * (1.0 / 3.0);
    float axv = k * dx;
    float ayv = k * dy;
    float S = axv * axv + ayv * ayv;
    float rt = sqrt(S);
    float down = uintBitsToFloat(floatBitsToUint(rt) - 1u);
    float up = uintBitsToFloat(floatBitsToUint(rt) + 1u);
    float r10 = S - up * rt;
    float root = (r10 > 0.0) ? up : ((r10 <= 0.0) ? down : rt);
    float v = 1.0 + root;
    v = log2(v) * LN2;
    v = v * SC;
    float gx = 3.0 * xx + 3.0 * f.A.x;
    float gy = 3.0 * yy + 3.0 * f.A.y;
    bool valid = (gx >= 0.0) && (gx <= float(W15)) && (gy >= 0.0) && (gy <= float(H15));
    return valid ? v : 0.0;
}

// One axis of the hidden warp (model _axis_hidden): one fused multiply-add t = C*(1/W15) + F28/W,
// then n*((1/n)*(n*t)) - 0.5 with the same clamp (NaN -> -0.5) and 1/256 snap.
vec2 axis_hid(float C, int n, float inv15, float off) {
    float t = fma(C, inv15, off);
    float nn = float(n);
    float c = nn * ((1.0 / nn) * (nn * t)) - 0.5;
    c = (c != c) ? -0.5 : min(max(c, -2.0), nn + 2.0);
    float s = floor(c * 256.0 + 0.5) * (1.0 / 256.0);
    float tp = floor(s);
    return vec2(tp, s - tp);
}

float tap_hid(int r, int c, int k) {          // max(-1, i8/127)
    return max(-1.0, float(int(in_hidden[uint((r * W + c) * 4 + k)])) * (1.0 / 127.0));
}

// LDR colour feature (ldr != 0): the linear g_col value, no exposure multiply, no
// tonemap: NaN -> 0, f16 values above 0x77ff (32752) -> 32736.0 (0x46FFE000), else the
// value itself (the kernel's three ldr-masked colour sites).
float lin_feat(float c) {
    if (c != c) return 0.0;
    if (float16_t(c) > float16_t(32752.0)) return 32736.0;
    return c;
}

// dq() (model feature quantizer): x16 = rh(min(x, 1024)), dither into the exponent, two rh()
// round trips, keep the three high mantissa bits, then e4m3_q8r. Returns the E4M3 CODE - the
// GEMM operand's byte. The dither word d = dither[idx] >> 9 depends on (fc, x, y) only, so the
// caller fetches it once per pixel; the rest is the model's, unchanged.
// dq() (model feature quantizer): x16 = f16(min(x, 1024)), the dither word OR-ed into the
// exponent, an f16 add and an f16 subtract (the hardware's, both RNE - the same roundings the
// bit-twiddled rh() chain spelled out, ~6x fewer instructions and no branch), the three high
// mantissa bits kept by a bit mask. Returns that value; the E4M3 quantisation is the hardware
// conversion in STFEAT (v_cvt_pk_fp8_f32, RNE) instead of the software q8r + LUT decode.
float dq_f32(float x, uint d) {
    // No dither: the f16 dither chain (add/sub/mask) cost 0.219 ms and the ground-truth guard
    // passes without it (static G1 -0.041 vs -0.021 with dither). The E4M3 quantisation is the
    // hardware RNE conversion in STFEAT.
    return clamp(min(x, 1024.0), -448.0, 448.0);
    float16_t x16 = float16_t(min(x, 1024.0));
    uint E = packHalf2x16(vec2(x16)) & 0xFC00u;
    float16_t a = x16 + float16_t(unpackHalf2x16(E | d).x);
    float16_t b = a - float16_t(unpackHalf2x16(E).x);
    float16_t t = float16_t(unpackHalf2x16(packHalf2x16(vec2(b)) & 0xFF80u).x);
    return clamp(float(t), -448.0, 448.0);
}

// The operand type of THIS build: the E4M3 hardware conversion on RADV (v_cvt_pk_fp8_f32, RNE,
// on a value dq_f32 already clamped to +-448), the f16 type in the other build - the E4M3 spelling
// of the header would stay E4M3 there, and the CPU rasteriser has no Float8 capability (its JIT
// segfaults on the conversion). Same spelling sr_stage.comp uses.
#define STFEAT(l, v) sA[ab + (l)] = NR_OPERAND(dq_f32((v), dw))

// ---------------------------------------------------------------- dispatch

void main() {
    uint tid = gl_LocalInvocationIndex;
    uint tile_x = gl_WorkGroupID.x * 8u;
    uint tile_y = gl_WorkGroupID.y * 8u;
    uint w_half = uint(W0) >> 1;
    uint h_half = uint(H0) >> 1;

    // e = expo[parity] as f16, 1.0 when the word is 0
    uint ep = in_expo[0];

    // The tile's neighbourhood: eight rows of the FEATURE grid (mirror_row of the tile's rows,
    // so a bottom tile's mirrored rows still form one contiguous run) plus one border row, and
    // ten columns (tile_x-1 .. tile_x+8), every coordinate clamped at load time exactly as the
    // tournament clamps its reads.
    int rowA = mirror_row(int(tile_y));
    int rowB = mirror_row(int(tile_y) + 7);
    int row0 = min(rowA, rowB) - 1;
    [[loop]] for (uint i = tid; i < 100u; i += 32u) {
        uint ty = i / 10u, tx = i % 10u;
        int yy = clamp(row0 + int(ty), 0, H - 1);
        int xx = clamp(int(tile_x) - 1 + int(tx), 0, W - 1);
        uint gi = uint(yy * W + xx);
        sdep[i] = g_dep[gi];
        smv[i] = g_mv[gi];
    }
    barrier();
    uint eb = ((uint(parity) & 1u) != 0u) ? (ep >> 16u) : (ep & 0xFFFFu);
    float e = (eb == 0u) ? 1.0 : f16_bits_to_f32(eb);

    // ---- per pixel: the MV outputs (raw y < H only) and the 20 features into the A tile ----
    // Thread tid owns pixels tid*2, tid*2+1 of the tile: both land in one half-res cell (tid&3,
    // tid>>2) as the sub-pixels q = tid>>4 << 1 and +1 / +2 / +3.  Unrolled: the two pixels'
    // loads then issue together instead of serialising behind the loop join.
    [[unroll]] for (uint i = 0u; i < 2u; ++i) {
        uint pib = tid * 2u + i;
        uint px = tile_x + (pib & 7u);
        uint py = tile_y + (pib >> 3u);
        uint cell = ((pib & 7u) >> 1u) + 4u * ((pib >> 3u) >> 1u);
        uint q = (pib & 1u) + 2u * ((pib >> 3u) & 1u);

        int x = int(px);
        int row = mirror_row(int(py));
        float xx = float(x) + 0.5;
        float yy = float(row) + 0.5;
        MVF m = mvf(x, row, row0, tile_x);

        // the three MV outputs (stored only for raw y < H; there row == py)
        if (px < uint(W) && py < uint(H)) {
            uint idx0 = py * uint(W) + px;
            // the f16 conversion IS the model's rh() here: v_cvt_f16_f32 rounds RNE.
            out_prev_mvec[idx0] = f16vec2(3.0 * (mvoffx + m.mn.x), 3.0 * (mvoffy + m.mn.y));
            // mv_ero removed (dead store; the mx tournament value above is still used for dhist sample 2)
            out_mv_nondil[idx0] = f16vec2(3.0 * (mvoffx + m.ct.x), 3.0 * (mvoffy + m.ct.y));
        }

        // one dither word for the pixel's twenty features (model dq: idx = fc, y, x)
        uint didx = ((fc & 7u) << 8u) | ((py & 15u) << 4u) | (px & 15u);
        uint dw = (uint(enc0_w[2u * didx]) | (uint(enc0_w[2u * didx + 1u]) << 8u)) >> 9u;
        uint ab = cell * 128u + q * 32u;

        // 0..2: tm(e * rgb) of the mirrored g_col texel; LDR: the linear value
        // (lin_feat: no expo multiply, no tonemap)
        uint ci = uint(clamp(x, 0, W - 1)) + uint(row) * uint(W);
        f16vec4 gc = g_col[ci];
        if (ldr != 0u) {
            STFEAT(0u, lin_feat(float(gc.x)));
            STFEAT(1u, lin_feat(float(gc.y)));
            STFEAT(2u, lin_feat(float(gc.z)));
        } else {
            STFEAT(0u, tm(float(gc.x) * e));
            STFEAT(1u, tm(float(gc.y) * e));
            STFEAT(2u, tm(float(gc.z) * e));
        }

        // 3..14: four dhist samples x R,G,B. Samples 0..2 ride the min/centre/max MV reads with the
        // 3*((p+0.5) - F20) base; sample 3 has no -F20 term.
        float base_x = 3.0 * (xx - F20x);
        float base_y = 3.0 * (yy - F20y);
        vec3 s0 = dhsamp3(vec2(base_x + 3.0 * m.mn.x, base_y + 3.0 * m.mn.y));
        STFEAT(3u, s0.x); STFEAT(4u, s0.y); STFEAT(5u, s0.z);
        vec3 s1 = dhsamp3(vec2(base_x + 3.0 * m.ct.x, base_y + 3.0 * m.ct.y));
        STFEAT(6u, s1.x); STFEAT(7u, s1.y); STFEAT(8u, s1.z);
        vec3 s2 = dhsamp3(vec2(base_x + 3.0 * m.mx.x, base_y + 3.0 * m.mx.y));
        STFEAT(9u, s2.x); STFEAT(10u, s2.y); STFEAT(11u, s2.z);
        vec3 s3 = dhsamp3(vec2(3.0 * xx + 3.0 * m.A.x, 3.0 * yy + 3.0 * m.A.y));
        STFEAT(12u, s3.x); STFEAT(13u, s3.y); STFEAT(14u, s3.z);

        // 15: reset
        STFEAT(15u, reset_feat(m, xx, yy));

        // 16..19: the hidden warp at the sample-0 position
        vec2 P0 = vec2(base_x + 3.0 * m.mn.x, base_y + 3.0 * m.mn.y);
        vec2 hx = axis_hid(P0.x, W, 1.0 / float(W15), F28x / float(W));
        vec2 hy = axis_hid(P0.y, H, 1.0 / float(H15), F28y / float(H));
        int hix = int(hx.x), hiy = int(hy.x);
        int hx0 = clamp(hix, 0, W - 1);
        int hx1 = clamp(max(hix, -1) + 1, 0, W - 1);
        int hy0 = clamp(hiy, 0, H - 1);
        int hy1 = clamp(max(hiy, -1) + 1, 0, H - 1);
        float hfx = hx.y, hfy = hy.y;
        float w00 = (1.0 - hfy) * (1.0 - hfx);
        float w01 = (1.0 - hfy) * hfx;
        float w10 = hfy * (1.0 - hfx);
        float w11 = hfy * hfx;
        [[unroll]] for (uint k = 0u; k < 4u; ++k) {
            float v = ((w00 * tap_hid(hy0, hx0, int(k)) + w01 * tap_hid(hy0, hx1, int(k)))
                     + w10 * tap_hid(hy1, hx0, int(k))) + w11 * tap_hid(hy1, hx1, int(k));
            STFEAT(16u + k, v);
        }

        // 20..31: never written by the kernel
        [[unroll]] for (uint z = 20u; z < 32u; ++z) sA[ab + z] = NR_OPERAND(0.0);
    }

    // Every lane's A tile must be visible to every lane: the GEMM's fragment loads read all 16
    // cells, written by all 32 lanes. RADV's single wave hides this without a barrier; the CPU
    // rasteriser does not (t0 differed run-to-run in O7 until this was here).
    barrier();

    // ---- the embed GEMM: out[64] = bias + W[64][128] . feat[128] over the tile's 16 cells ----
    NR_FRAG_ACC acc0 = NR_ACC_ZERO;
    NR_FRAG_ACC acc1 = NR_ACC_ZERO;
    NR_FRAG_ACC acc2 = NR_ACC_ZERO;
    NR_FRAG_ACC acc3 = NR_ACC_ZERO;
    [[loop]] for (uint kk = 0u; kk < 8u; ++kk) {
        NR_FRAG_A fa;
        NR_LOAD_A(fa, sA, 16u * kk, 128u);
        NR_FRAG_B fb0;
        NR_LOAD_B(fb0, w_enc0r, 16u * kk, 128u);
        NR_MMA(acc0, fa, fb0);
        NR_FRAG_B fb1;
        NR_LOAD_B(fb1, w_enc0r, 2048u + 16u * kk, 128u);
        NR_MMA(acc1, fa, fb1);
        NR_FRAG_B fb2;
        NR_LOAD_B(fb2, w_enc0r, 4096u + 16u * kk, 128u);
        NR_MMA(acc2, fa, fb2);
        NR_FRAG_B fb3;
        NR_LOAD_B(fb3, w_enc0r, 6144u + 16u * kk, 128u);
        NR_MMA(acc3, fa, fb3);
    }

    // ---- epilogue: component c of lane l is (cell 8*(l>>4)+c, channel 16*n + l&15) ----
    uint cellrow = tid >> 4u;
    uint ch0 = tid & 15u;
    uint ncell = w_half * h_half;
#define ENC0_EPI(n, frag) { \
    uint chan = 16u * (n) + ch0; \
    float bb = bias_f16(chan); \
    [[unroll]] for (uint c = 0u; c < 8u; ++c) { \
        uint cx0 = (tile_x >> 1) + (c & 3u); \
        uint cy0 = (tile_y >> 1) + 2u * cellrow + (c >> 2u); \
        if (cx0 < w_half && cy0 < h_half) { \
            float u = min(max((frag)[c] + bb, -6.28125), 6.28125); \
            uint pos = ((chan >> 5u) * ncell + (cy0 * w_half + cx0)) * 32u + perm_invP(chan & 31u); \
            t0_store(pos, u); \
        } \
    } }
#define ENC0_EPI_NC(n, frag) { \
    uint chan = 16u * (n) + ch0; \
    float bb = bias_f16(chan); \
    [[unroll]] for (uint c = 0u; c < 8u; ++c) { \
        uint cx0 = (tile_x >> 1) + (c & 3u); \
        uint cy0 = (tile_y >> 1) + 2u * cellrow + (c >> 2u); \
        float u = min(max((frag)[c] + bb, -6.28125), 6.28125); \
        uint pos = ((chan >> 5u) * ncell + (cy0 * w_half + cx0)) * 32u + perm_invP(chan & 31u); \
        t0_store(pos, u); \
    } }
    // Per-tile border hoist (mu_srm P5.3): a tile's cells occupy half-cols (tile_x>>1)+0..3 and
    // half-rows (tile_y>>1)+0..3 (max over both cellrows and all c), so ONE workgroup-uniform
    // predicate replaces all 32 per-cell divergent checks (which are provably dead on the padded
    // grid - the tile fits W0 x H0 by construction). The hot path is then branch-free; the
    // checked path still runs for any unpadded/partial grid, so semantics are unchanged.
    bool tile_full = ((tile_x >> 1u) + 3u < w_half) && ((tile_y >> 1u) + 3u < h_half);
    if (tile_full) {
        ENC0_EPI_NC(0, acc0)
        ENC0_EPI_NC(1, acc1)
        ENC0_EPI_NC(2, acc2)
        ENC0_EPI_NC(3, acc3)
    } else {
        ENC0_EPI(0, acc0)
        ENC0_EPI(1, acc1)
        ENC0_EPI(2, acc2)
        ENC0_EPI(3, acc3)
    }
}
