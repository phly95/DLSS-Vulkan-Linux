#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_GOOGLE_include_directive : require

// sr_downsample (k_sr_downsample): the level-15 full15 buffer -> the final output image, a 5x5
// (separable) FIR at 2/3 of the output pitch, firefly-clamped to the tap min/max per axis, then the
// inverse tonemap and the alpha from g_col.
//
// PERF (2026-10-28):
//  - the f16 rounding emulation is gone (the `rh()`/`rh3()` chain after every FIR tap existed only
//    to match NeuralHub's rounding bit for bit; the optimisation policy drops it): the FIR
//    accumulates in f32 and the tap weights are plain f32 constants,
//  - the inverse tonemap's three fma "remainder" pairs existed to emulate an exactly rounded IEEE
//    divide (v_div_scale/fmas/fixup); a plain divide is allowed now,
//  - the 28x28 LDS patch is staged as f32, not f16: the FIR reads it 25 times per output pixel and
//    an f16 LDS element costs a load PLUS a v_cvt per tap (75 conversions a thread).
//  TRIED AND REJECTED (pass 3): doing the whole FIR in f16, which is what NeuralHub's ISA does
//  (v_fma_f16 per tap) and which would let RADV pack two channels per instruction. Measured
//  3.491 ms against f32's 3.472, and the ISA explains it - ACO does not pack f16vec3 operands, so
//  the vopd dual-issue count fell from 74 to 8 and the instruction count rose 623 -> 685. This
//  kernel is ALU bound at ~74% of the issue peak; only fewer taps would make it faster, and the
//  5x5 tap set is the spec.
//
// The ldr path (ldr != 0) is the SDR variant: linear values, no tonemap, 1/2047 and 1/1023 scales.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InFull15 { uint full15[]; };
layout(set = 0, binding = 1) readonly buffer InCol    { f16vec4 g_col[]; };
layout(set = 0, binding = 2) readonly buffer InExpo   { f16vec2 expo; };
layout(set = 0, binding = 3) writeonly buffer OutImg  { vec4 out_color[]; };

layout(push_constant) uniform DownArgs {
    layout(offset = 24) int parity;
    int pad0;
    layout(offset = 40) int W;
    int H;
    int W15;
    int H15;
    int oW;
    int oH;
    float scaleX;
    float scaleY;
    float jitX;
    float jitY;
    uint log2_10;
    uint ldr;
};

// PERF: the patch is staged as f32, not f16. The FIR reads it 25 times per output pixel, and an
// f16 LDS element costs a load PLUS a v_cvt per tap (75 conversions a thread); staging the f32 the
// unpack already produced removes all of them for 1.8x the LDS, which this kernel has to spare.
shared f16vec3 s_patch[28][28];

f16vec3 unpack_color(uint u) {
    float r = float(u & 0x7ffu);
    float g = float((u >> 11) & 0x7ffu);
    float b = float((u >> 22) & 0x3ffu);
    if (ldr != 0u) {
        return f16vec3(float16_t(r * (1.0 / 2047.0)), float16_t(g * (1.0 / 2047.0)),
                       float16_t(b * (1.0 / 1023.0)));
    } else {
        const float c_rg = uintBitsToFloat(0x3a9ce069u);
        const float c_b  = uintBitsToFloat(0x3b1cf40au);
        return f16vec3(float16_t(r * c_rg), float16_t(g * c_rg), float16_t(b * c_b));
    }
}

float inv_tonemap(float16_t v0) {
    float v = float(v0);
    if (ldr != 0u) {
        return float(v0);
    }
    float c = clamp(v, 0.00010000000475, 3.0);
    const float kInv036 = uintBitsToFloat(0x4031c71cu);   // 1/0.36
    const float k001 = uintBitsToFloat(0x3c23d70au);      // 0.01

    float p = (c * kInv036) * uintBitsToFloat(log2_10);
    float e = exp2(p) - 1.0;
    float m = e * k001;

    return m / max(float(expo[parity]), 0.0001);
}

void main() {
    int tile_x0 = int(floor((float(gl_WorkGroupID.x * 16u) + 0.5) * 1.5)) - 2;
    int tile_y0 = int(floor((float(gl_WorkGroupID.y * 16u) + 0.5) * 1.5)) - 2;

    uint tid = gl_LocalInvocationIndex;
    for (uint i = tid; i < 784u; i += 256u) {
        int py = int(i / 28u);
        int px = int(i % 28u);
        int gx = clamp(tile_x0 + px, 0, W15 - 1);
        int gy = clamp(tile_y0 + py, 0, H15 - 1);
        s_patch[py][px] = unpack_color(full15[gy * W15 + gx]);
    }

    barrier();

    int ox = int(gl_GlobalInvocationID.x);
    int oy = int(gl_GlobalInvocationID.y);
    if (ox >= oW || oy >= oH) {
        return;
    }

    int bx = int(floor((float(ox) + 0.5) * 1.5)) - tile_x0;
    int by = int(floor((float(oy) + 0.5) * 1.5)) - tile_y0;

    // The two 5-tap sets are the even/odd halves of the same symmetric kernel
    const float16_t wA0 = float16_t(-0.0413513), wA1 = float16_t(0.0872803), wA2 = float16_t(0.6201172);
    const float16_t wA3 = float16_t(0.3720703),  wA4 = float16_t(-0.0382996);
    const float16_t wB0 = float16_t(-0.0382996), wB1 = float16_t(0.3720703), wB2 = float16_t(0.6201172);
    const float16_t wB3 = float16_t(0.0872803),  wB4 = float16_t(-0.0413513);
    float16_t wx[5], wy[5];
    if ((ox & 1) != 0) {
        wx[0] = wB0; wx[1] = wB1; wx[2] = wB2; wx[3] = wB3; wx[4] = wB4;
    } else {
        wx[0] = wA0; wx[1] = wA1; wx[2] = wA2; wx[3] = wA3; wx[4] = wA4;
    }
    if ((oy & 1) != 0) {
        wy[0] = wB0; wy[1] = wB1; wy[2] = wB2; wy[3] = wB3; wy[4] = wB4;
    } else {
        wy[0] = wA0; wy[1] = wA1; wy[2] = wA2; wy[3] = wA3; wy[4] = wA4;
    }

    // packed f16 FIR: RG ride one f16vec2 (one instruction covers two channels of every tap and
    // every clamp bound), B on its own float16_t - exactly the instruction shape of NeuralHub's
    // k_sr_downsample. Compare-select clamp on the packed halves, as their ISA does.
    f16vec2 colrg = f16vec2(0.0);
    float16_t colb = float16_t(0.0);
    f16vec2 colmn = f16vec2(65504.0), colmx = f16vec2(-65504.0);
    float16_t colbn = float16_t(65504.0), colbx = float16_t(-65504.0);

    for (int j = 0; j < 5; ++j) {
        int py = by - 2 + j;
        f16vec3 s0 = s_patch[py][bx - 2];
        f16vec3 s1 = s_patch[py][bx - 1];
        f16vec3 s2 = s_patch[py][bx + 0];
        f16vec3 s3 = s_patch[py][bx + 1];
        f16vec3 s4 = s_patch[py][bx + 2];
        f16vec2 r = s0.xy * f16vec2(wx[0]);
        r = fma(s1.xy, f16vec2(wx[1]), r);
        r = fma(s2.xy, f16vec2(wx[2]), r);
        r = fma(s3.xy, f16vec2(wx[3]), r);
        r = fma(s4.xy, f16vec2(wx[4]), r);
        float16_t rb = s0.z * wx[0];
        rb = fma(s1.z, wx[1], rb);
        rb = fma(s2.z, wx[2], rb);
        rb = fma(s3.z, wx[3], rb);
        rb = fma(s4.z, wx[4], rb);
        // Karis firefly clamp over the same five taps, on the packed halves
        f16vec2 mn = min(min(min(s0.xy, s1.xy), min(s2.xy, s3.xy)), s4.xy);
        f16vec2 mx = max(max(max(s0.xy, s1.xy), max(s2.xy, s3.xy)), s4.xy);
        r = clamp(r, mn, mx);               // plain min/max: mix(f16vec2,f16vec2,bvec2) miscompiles
        float16_t bmn = min(min(min(s0.z, s1.z), min(s2.z, s3.z)), s4.z);
        float16_t bmx = max(max(max(s0.z, s1.z), max(s2.z, s3.z)), s4.z);
        rb = clamp(rb, bmn, bmx);

        colrg = fma(r, f16vec2(wy[j]), colrg);
        colb = fma(rb, wy[j], colb);
        colmn = min(colmn, r); colmx = max(colmx, r);
        colbn = min(colbn, rb); colbx = max(colbx, rb);
    }
    colrg = clamp(colrg, colmn, colmx);     // same
    colb = clamp(colb, colbn, colbx);
    vec3 col_filtered = vec3(colrg.x, colrg.y, colb);

    vec3 final_rgb = vec3(inv_tonemap(colrg.x),
                          inv_tonemap(colrg.y),
                          inv_tonemap(colb));

    int src_x = clamp(int(ox * W / oW), 0, W - 1);
    int src_y = clamp(int(oy * H / oH), 0, H - 1);
    float alpha = float(g_col[src_y * W + src_x].a);

    out_color[oy * oW + ox] = vec4(final_rgb, alpha);
}
