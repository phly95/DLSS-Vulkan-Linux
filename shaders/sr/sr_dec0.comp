#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "coopmm.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Dec0PushConstants {
    uint t8_offset;
    uint prev_mvec_offset;
    uint hidden_in_offset;
    uint gates_offset;
    uint factors_offset;
    uint aniso_offset;
    uint hidden_out_offset;
    uint weights_offset;
    int W;
    int H;
    int W0;
    int H0;
    int W15;
    int H15;
    float dec0_s0;
    float dec0_f0;
} pc;

layout(set = 0, binding = 0, std430) buffer ActBuffer {
    uint8_t acts[];
};

layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer {
    uint8_t weights[];
};

float16_t e4m3_to_f16(uint8_t b) {
    uint u = uint(b);
    float16_t s = (u & 0x80u) != 0u ? float16_t(-1.0) : float16_t(1.0);
    uint e = (u >> 3u) & 0x0Fu;
    uint m = u & 0x07u;
    if (e == 0x0Fu && m == 0x07u) return float16_t(0.0);
    if (e == 0u) {
        return s * (float16_t(m) / float16_t(8.0)) * float16_t(0.015625);
    }
    return s * (float16_t(1.0) + float16_t(m) / float16_t(8.0)) * exp2(float16_t(int(e) - 7));
}

float16_t read_w_f16(uint byte_off) {
    uint16_t lo = uint16_t(weights[byte_off]);
    uint16_t hi = uint16_t(weights[byte_off + 1u]);
    uint16_t u = uint16_t(lo | (hi << 8u));
    return unpackFloat2x16(uint(u)).x;
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    int lx = int(tid % 8u);
    int ly = int(tid / 8u);

    int gx = int(gl_WorkGroupID.x) * 8 + lx;
    int gy = int(gl_WorkGroupID.y) * 8 + ly;

    if (gx >= pc.W || gy >= pc.H) return;

    // t8 resolution is L1w x L1h = (W0/2, H0/2)
    int l1w = pc.W0 / 2;
    int l1h = pc.H0 / 2;
    int px1 = min(gx / 2, l1w - 1);
    int py1 = min(gy / 2, l1h - 1);

    // Read 64 channels from t8
    float16_t t8_vals[64];
    for (int c = 0; c < 64; ++c) {
        uint slab = uint(c / 32);
        uint c_in_slab = uint(c % 32);
        uint idx = pc.t8_offset + (((slab * uint(l1h) + uint(py1)) * uint(l1w) + uint(px1)) * 32u + c_in_slab);
        t8_vals[c] = e4m3_to_f16(acts[idx]);
    }

    // Weights: dec0 matrix starts right at pc.weights_offset (128 x 64), bias at +8192
    uint w_base = pc.weights_offset;
    uint bias_base = pc.weights_offset + 8192u;

    // Decode gates (RGBA8), factors (RGBA8), aniso (RGBA16F = 4 halfs), hidden (RGBA8)
    // 1. Gates (4 floats -> 4 bytes)
    uint8_t g_out[4];
    for (int i = 0; i < 4; ++i) {
        float acc = 0.0;
        for (int c = 0; c < 64; ++c) {
            float16_t w = e4m3_to_f16(weights[w_base + uint(i * 64 + c)]);
            acc += float(t8_vals[c]) * float(w);
        }
        float bias = float(read_w_f16(bias_base + uint(i * 2)));
        float sig = 1.0 / (1.0 + exp(-(acc + bias)));
        g_out[i] = uint8_t(clamp(round(sig * 255.0), 0.0, 255.0));
    }

    // 2. Factors (4 floats -> 4 bytes)
    uint8_t f_out[4];
    for (int i = 0; i < 4; ++i) {
        float acc = 0.0;
        for (int c = 0; c < 64; ++c) {
            float16_t w = e4m3_to_f16(weights[w_base + uint((4 + i) * 64 + c)]);
            acc += float(t8_vals[c]) * float(w);
        }
        float bias = float(read_w_f16(bias_base + uint((4 + i) * 2)));
        float sig = 1.0 / (1.0 + exp(-(acc + bias)));
        f_out[i] = uint8_t(clamp(round(sig * 255.0), 0.0, 255.0));
    }

    // 3. Aniso (4 floats -> 4 halfs = 8 bytes)
    uint16_t a_out[4];
    for (int i = 0; i < 4; ++i) {
        float acc = 0.0;
        for (int c = 0; c < 64; ++c) {
            float16_t w = e4m3_to_f16(weights[w_base + uint((8 + i) * 64 + c)]);
            acc += float(t8_vals[c]) * float(w);
        }
        float bias = float(read_w_f16(bias_base + uint((8 + i) * 2)));
        acc = (acc + bias) * pc.dec0_s0; // Scale by min(exp(s0), 8)
        float16_t h = float16_t(acc);
        uint u = packHalf2x16(vec2(float(h), 0.0));
        a_out[i] = uint16_t(u & 0xFFFFu);
    }

    // 4. Hidden (4 floats -> 4 bytes)
    uint8_t h_out[4];
    for (int i = 0; i < 4; ++i) {
        float acc = 0.0;
        for (int c = 0; c < 64; ++c) {
            float16_t w = e4m3_to_f16(weights[w_base + uint((12 + i) * 64 + c)]);
            acc += float(t8_vals[c]) * float(w);
        }
        float bias = float(read_w_f16(bias_base + uint((12 + i) * 2)));
        float sig = 1.0 / (1.0 + exp(-(acc + bias)));
        h_out[i] = uint8_t(clamp(round(sig * 255.0), 0.0, 255.0));
    }

    // Write outputs
    uint p_idx = uint(gy * pc.W + gx);
    if (pc.gates_offset != 0u) {
        for (int i = 0; i < 4; ++i) acts[pc.gates_offset + p_idx * 4u + uint(i)] = g_out[i];
    }
    if (pc.factors_offset != 0u) {
        for (int i = 0; i < 4; ++i) acts[pc.factors_offset + p_idx * 4u + uint(i)] = f_out[i];
    }
    if (pc.aniso_offset != 0u) {
        uint byte_off = pc.aniso_offset + p_idx * 8u;
        for (int i = 0; i < 4; ++i) {
            acts[byte_off + uint(i * 2)] = uint8_t(a_out[i] & 0xFFu);
            acts[byte_off + uint(i * 2 + 1)] = uint8_t((a_out[i] >> 8u) & 0xFFu);
        }
    }
    if (pc.hidden_out_offset != 0u) {
        for (int i = 0; i < 4; ++i) acts[pc.hidden_out_offset + p_idx * 4u + uint(i)] = h_out[i];
    }
}
