#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : enable
#include "nh_mm.glsl"

// k_sr_dec0 (NeuralHub SR preset M, oracle launch 13). The spec is tools/sr/sr_dec0_model.py
// (its module docstring = Review R3 + R3b in docs/notes/k_sr_dec0.md): every formula below is the
// model's; the f16 rounding points (rh()) that existed only to match NeuralHub bit for bit are gone
// per the optimisation policy - the projection accumulates in f32, the heads keep their own
// rounding where the OUTPUT format needs it (the u8/i8/f16 stores round themselves).
//
// Workgroup: one 8x8 render tile (grid (W0/8, H0/8)); 32 threads x 2 pixels cover its 64 pixels.// The tile is a 4x4 tile of t8 (binding 0: [C/32][H0/2][W0/2][32] fp8, stored index i of a group
// holds logical channel P(i)).
//
// Projection, per render pixel: its t8 pixel (x>>1, y>>1) produces sub-pixel q = (x&1) + 2*(y&1)
// of the 2x upsample; only channels q*32 + 0..17 of the 128 outputs are read back:
//   u = bias[j] + sum_{k<64} t8[k]*W[j][k],  p = fp8(clamp(u, +-448))
//
// PERF (2026-10-28, optimisation phase) - the kernel was 22216 instructions and 1133 vmem per wave
// for a 128->18 1x1 projection, i.e. ~16k VALU of fp8->f32 conversions and frag_off() index math:
//  1. The four sub-pixels of one t8 pixel share its 64 channels, and an 8x8 render tile contains
//     all four, so the old code read each t8 byte FOUR times from HBM (133 MB per frame at 1080p;
//     the tile is now staged into LDS once - 1 KB per workgroup, 33 MB per frame).
//  2. dec0.bin's weights are in NeuralHub's per-lane WMMA fragment order, so every weight byte cost
//     a frag_off() walk (~10 integer ops). The host repacks them (sr_repack_dec0 in
//     src/vk/pipeline.cpp) into [q][n][k] f16 - every e4m3 value is exactly representable in f16 -
//     so the kernel loads two k per instruction with a linear index and no conversion at all.
//
// Heads (p channels): gates = rndne(255*clamp01(f16(sg(p_c)))), c = 0, 1, 10; factors are
// NOT computed (no shader reads them: sr_post binds but never reads binding 3 - the model records
// them and never consumes them); aniso =
// f16(A*A), f16(B*B), f16((A*B)*tanh(f0*p16)), A = s0*f16(sg(clamp(p14, +-20))), B likewise p15,
// element 3 = 0. Hidden: z <- p(6+k), h <- p(2+k), k = 0..3:
//   z = 0.5 + 0.5*tanh(0.5*p_z), h = z*th(p_h) + (1-z)*warp_k,
//   th(a) = copysign((1-e)/(1+e), a), e = exp2(-2*log2e*|a|); out = rndne(127*clamp(h,+-1)).
// warp = the previous hidden state (binding 2, 4 x int8 per pixel) bilinearly resampled at the
// reprojected position (prev_mvec = binding 1), coordinates snapped to 1/256, taps dequantized
// as max(-1, i8/127); 0 when the position leaves [0,W15]x[0,H15] or push +0x88 != 0. (The oracle's
// host alternates the buffers per frame parity: frame 0 binds hidden0 in / hidden1 out, frame 1 the
// reverse; the shader only sees binding 2 / binding 6.)
//
// Push constants: the oracle launch's own 160-byte Dec0Args passed verbatim; the block starts at
// offset 64 (bytes 0..0x3f are the HIP struct's device pointers, not pushed by the port host).

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// e4m3 in both builds (the f16-operand build widens it: make_test sizes in_t8 for that).
layout(set = 0, binding = 0) readonly buffer InT8        { NR_OPERAND in_t8[]; };
layout(set = 0, binding = 1) readonly buffer InPrevMv    { f16vec2 in_prev_mv[]; };
// A u32 view of the same bytes: one bilinear tap = its four channel bytes in ONE load (the four
// int8 reads it replaces were four scattered, uncoalesced accesses a tap a pixel). Fixed-size type
// in both builds, so the fixture does not change.
layout(set = 0, binding = 2) readonly buffer InHidden    { uint in_hidden32[]; };
layout(set = 0, binding = 3) writeonly buffer OutGates   { u8vec4 out_gates[]; };
// binding 4 (factors) removed 2026-10-28: dead (see header)
layout(set = 0, binding = 5) writeonly buffer OutAniso   { f16vec4 out_aniso[]; };
layout(set = 0, binding = 6) writeonly buffer OutHidden  { int8_t out_hidden[]; };
// binding 8: t0's next door - the SAME t8 buffer again, viewed as 16-byte vectors. A t8 pixel's
// plane is 32 B and 32 B aligned, so the staging loop takes the whole plane in two vector loads
// (64 loads a wave) instead of 1024 byte loads with a P-permuted index each (measured staging =
// 0.87 ms of this kernel's 1.46; see build/agents/enc0/progress.md).
layout(set = 0, binding = 8) readonly buffer InT8V4 { uvec4 in_t8v4[]; };
// binding 9: dec0's 128x64 tile repacked [N][K] row-major IN FP8 (sr_repack_dec0f8 from the
// original dec0.bin frag tile - binding 7 keeps only its biases now). FP8 halves the B-fragment
// load bytes against binding 7's f16 expansion (projection measured 0.238 ms, dominated by those
// loads) and doubles the MMA rate; the epilogue already converts through the hardware path.
layout(set = 0, binding = 9) readonly buffer InDec0F8 { NR_OPERAND dec0f8[]; };
// binding 7 is sr_dec0's OWN repacked weights (pipeline.cpp sr_repack_dec0), not dec0.bin:
//   words 0..4095   = [q][n][k] f16, two k per word
//   words 4096..    = [q][n] f16 biases, two per word
// Declared as an f16 view in both builds (the fp8 build reads the same bytes), so the projection
// can take the weights straight into an f16 cooperative-matrix B operand.
layout(set = 0, binding = 7) readonly buffer InDec0W     { float16_t dec0_w16[]; };

layout(push_constant) uniform Dec0Args {
    layout(offset = 64) int W;
    int H;
    int W2;                          // +0x48: the render size again (asserted equal on the host)
    int H2;
    int W0;
    int H0;
    int W15;
    int H15;
    float s0;                        // +0x60 aniso scale
    float f0;                        // +0x64 aniso rho scale
    float F20x;
    float F20y;
    float F28x;
    float F28y;
    float r15w;
    float r15h;
    float iW;                        // +0x80 1/W
    float iH;                        // 1/H
    uint flag88;                     // +0x88 warp disabled when nonzero
    float i15w;                      // +0x8c 1/W15
    float i15h;                      // 1/H15
    float F28xW;                     // +0x94 F28x/W
    float F28yH;                     // F28y/H
};

const float L2E = 1.4426950408889634;   // log2(e) as the model's f32 L2E

// ---- fp8 (the model's LUT / to_e4m3, bit for bit) -----------------------------------------------

float e4m3_to_f32(uint b) {
    uint e = (b >> 3u) & 15u;
    float v = (e == 0u) ? float(b & 7u) * 0.001953125
                        : uintBitsToFloat(((e + 120u) << 23u) | ((b & 7u) << 20u));
    return ((b & 0x80u) != 0u) ? -v : v;
}

// f32 -> E4M3, RNE, saturating at 448 (the model's to_e4m3).
uint f32_to_e4m3_rne(float x) {
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    uint sub = uint(floor(a * 512.0 + 0.5));
    uint bits = floatBitsToUint(a);
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | ((a < 0.015625) ? sub : (norm & 0x7fu));
}

// invP: logical channel mod 32 -> index in a P-permuted group (sr_stage's perm_invP). Used only
// while staging t8; the weight blob's own P-permutation was removed by the host's repack.
uint perm_invP(uint c) {
    return (((c >> 1u) & 7u) << 2u) | (c & 1u) | (((c >> 4u) & 1u) << 1u);
}

// ---- the model's scalar functions ------------------------------------------------------------------

float sigm(float x) {                       // sg: f32 exp, IEEE divide
    return 1.0 / (1.0 + exp(-x));
}

float copysgn(float mag, float sgn) {        // copysign, incl. the sign of zero
    return ((floatBitsToUint(sgn) & 0x80000000u) != 0u) ? -mag : mag;
}

float th(float a) {                         // odd tanh, sign of a
    float e = exp2(-2.0 * L2E * abs(a));
    return copysgn((1.0 - e) / (1.0 + e), a);
}

// f32 tanh for aniso[2]: odd polynomial through x^9 below 0.3 (truncation < 6e-8 relative, no
// cancellation), the exp form above (no cancellation for |x| >= 0.3).
float tanh32(float x) {
    float a = abs(x);
    float t;
    if (a < 0.3) {
        float x2 = a * a;
        t = a * (1.0 + x2 * (-1.0 / 3.0 + x2 * (2.0 / 15.0
              + x2 * (-17.0 / 315.0 + x2 * (62.0 / 2835.0)))));
    } else {
        float e = exp(-2.0 * a);
        t = (1.0 - e) / (1.0 + e);
    }
    return copysgn(t, x);
}

// max(-1, i8 / 127) for channel k of the word-aligned tap at byte index i (i % 4 == k)
float tap_dq(uint i) {
    uint w = in_hidden32[i >> 2u];
    uint b = (w >> (8u * (i & 3u))) & 0xffu;
    int v = int(b << 24u) >> 24u;            // sign-extend the i8
    return max(-1.0, float(v) * (1.0 / 127.0));
}

// One f16 bias: element 8192 + j of the f16 view (word 4096 + j/2, two halfs a word)
// The P permutation: stored byte index s holds LOGICAL channel P[s] (perm_invP is its inverse).
uint perm_P(uint s) {
    return ((s >> 2u) << 1u) | (s & 1u) | (((s >> 1u) & 1u) << 4u);
}

float b_f16(uint j) {
    return float(dec0_w16[8192u + j]);
}

// The workgroup's t8 tile: 4x4 t8 pixels x 64 channels, staged once as f16 (the hardware convert
// replaces the per-pixel 64x e4m3_to_f32 - the projection no longer decodes per render pixel).
// s_p: the projection result [16 parents][128 sub-pixel outputs] in f16 (only q*32+0..17 of each
// q block are ever read).
shared NR_OPERAND s_t8[16 * 64];
shared float16_t s_p[16 * 128];

void main() {
    uint tid = gl_LocalInvocationIndex;
    uint tile_x = gl_WorkGroupID.x * 8u;
    uint tile_y = gl_WorkGroupID.y * 8u;
    uint w_half = uint(W0) >> 1;
    uint h_half = uint(H0) >> 1;
    uint row_bytes = w_half * 32u;          // one t8 row, bytes

    // ---- stage the tile's 64 fp8 channels per t8 pixel into LDS (1 KB), in logical channel order
    // 64 units = 16 pixels x 2 planes x 2 vector halves, two a lane: ONE 16-byte load each,
    // then the P-permute is a register scatter. Replaces 1024 byte loads a wave, each with its own
    // perm_invP + plane/pixel address - the kernel's largest single block (0.87 ms measured).
    for (uint i = tid; i < 64u; i += 32u) {
        uint hb = i & 1u;
        uint gp = (i >> 1) & 1u;            // t8 group plane 0..1 (k >> 5)
        uint pix = i >> 2u;                 // local t8 pixel 0..15
        uint gx = (tile_x >> 1) + (pix & 3u);
        uint gy = (tile_y >> 1) + (pix >> 2);
        uint byteoff = gp * h_half * row_bytes + (gy * w_half + gx) * 32u + hb * 16u;
        uvec4 v = in_t8v4[byteoff >> 4];    // 32 B block => 16 B halves are 16 B aligned
        [[unroll]] for (uint b = 0u; b < 16u; ++b) {
            uint st = hb * 16u + b;       // stored byte index in the block
            // b is a literal after unrolling, so the word pick folds to one component read
            uint word = (b < 8u) ? ((b < 4u) ? v.x : v.y) : ((b < 12u) ? v.z : v.w);
            uint by = (word >> (8u * (b & 3u))) & 0xFFu;
            s_t8[pix * 64u + gp * 32u + perm_P(st)] = NR_OPERAND(e4m3_to_f32(by));
        }
    }
    // s_t8 is written by one lane and read by others through the A-fragment loads: without a
    // barrier the order is not guaranteed (lavapipe's O7 runs differed run to run).
    barrier();

    // ---- projection as four dense f16 WMMAs: for a fixed sub-pixel parity q the workgroup's 16
    // t8 parents are one [16 x 64] x [64 x 32] product (every parent contributes exactly one
    // render pixel of that parity, and the weight rows depend only on q) - 32 WMMAs replace
    // 64 pixels x 18 x 64 scalar fmAs with a frag_off-style walk. Only q*32 + 0..17 of each
    // 32-wide block is ever read back; the model's p = fp8(clamp(u)) is applied in the epilogue.
    for (uint qq = 0u; qq < 4u; ++qq) {
        NR_FRAG_ACC pr0 = NR_ACC_ZERO;
        NR_FRAG_ACC pr1 = NR_ACC_ZERO;
        // The bias is per output column: a lane's column inside a tile is tid & 15, so one value
        // per lane per tile covers all eight of its rows.
        float bj0 = b_f16(qq * 32u + (tid & 15u));
        float bj1 = b_f16(qq * 32u + 16u + (tid & 15u));
        for (uint k0 = 0u; k0 < 64u; k0 += 16u) {
            NR_FRAG_A fa;
            NR_LOAD_A(fa, s_t8, k0, 64u);
            NR_FRAG_B fb0;
            NR_LOAD_B(fb0, dec0f8, (qq * 32u + 0u) * 64u + k0, 64u);
            NR_MMA(pr0, fa, fb0);
            NR_FRAG_B fb1;
            NR_LOAD_B(fb1, dec0f8, (qq * 32u + 16u) * 64u + k0, 64u);
            NR_MMA(pr1, fa, fb1);
        }
        // bias first (f32), then the model's p = f16-decoded fp8(clamp(u)) - the quantisation
        // itself is the HARDWARE conversion (v_cvt_pk_fp8_f32 on the clamped f32), not the
        // software bit-twiddle: the epilogue ran to 64 x ~17 VALU a wave and measured as this
        // kernel's largest single block (projection 0.238 ms of 0.507 on VRAM).
        NR_FRAG_ACC16 h0, h1;
        [[unroll]] for (uint i = 0u; i < 8u; ++i) {
            h0[i] = float16_t(NR_OPERAND(clamp(pr0[i] + bj0, -448.0, 448.0)));
            h1[i] = float16_t(NR_OPERAND(clamp(pr1[i] + bj1, -448.0, 448.0)));
        }
        NR_STORE_ACC(h0, s_p, qq * 32u + 0u, 128u);
        NR_STORE_ACC(h1, s_p, qq * 32u + 16u, 128u);
    }
    barrier();   // s_p: fragment stores above, per-lane reads below

    for (uint i = 0u; i < 2u; ++i) {
        uint pix = tid + i * 32u;
        uint x = tile_x + (pix & 7u);
        uint y = tile_y + (pix >> 3u);
        if (x >= uint(W) || y >= uint(H)) continue;
        uint idx = y * uint(W) + x;

        // ---- projection: channels q*32 + 0..17 of this pixel's sub-pixel, from the tile product
        uint q = (x & 1u) + 2u * (y & 1u);
        uint j0 = q * 32u;
        uint sbase = (((y & 6u) >> 1) * 4u + ((x & 6u) >> 1)) * 64u;   // this pixel's t8 in LDS
        uint prow = sbase >> 6u;

        float p[18];
        for (uint c = 0u; c < 18u; ++c) p[c] = float(s_p[prow * 128u + j0 + c]);

        // ---- gates: channels 0, 1, 10 ----
        uint g0 = uint(roundEven(255.0 * clamp(sigm(p[0]), 0.0, 1.0)));
        uint g1 = uint(roundEven(255.0 * clamp(sigm(p[1]), 0.0, 1.0)));
        uint g2 = uint(roundEven(255.0 * clamp(sigm(p[10]), 0.0, 1.0)));
        out_gates[idx] = u8vec4(uint8_t(g0), uint8_t(g1), uint8_t(g2), uint8_t(0));

        // ---- factors: REMOVED (dead store + dead softmax; see header) ----

        // ---- aniso: channels 14, 15, 16 ----
        float A = s0 * sigm(clamp(p[14], -20.0, 20.0));
        float B = s0 * sigm(clamp(p[15], -20.0, 20.0));
        float T = tanh32(f0 * p[16]);
        out_aniso[idx] = f16vec4(float16_t(A * A), float16_t(B * B),
                                 float16_t((A * B) * T), float16_t(0.0));

        // ---- hidden: the reprojected position and its tap grid (shared by the 4 channels) ----
        f16vec2 mv = in_prev_mv[idx];
        float px = fma((float(x) + 0.5) - F20x, r15w, float(mv.x));
        float py = fma((float(y) + 0.5) - F20y, r15h, float(mv.y));
        bool ok = (flag88 == 0u) && px >= 0.0 && px <= float(W15)
                           && py >= 0.0 && py <= float(H15);
        int xa = 0, xb = 0, ya = 0, yb = 0;
        float gx2 = 0.0, gy2 = 0.0;
        if (ok) {
            float cx = fma(px, i15w, F28xW);
            cx = (cx * float(W)) * iW;
            cx = cx * float(W) - 0.5;
            cx = clamp(cx, -2.0, float(W) + 2.0);
            cx = floor(cx * 256.0 + 0.5) * (1.0 / 256.0);
            float cy = fma(py, i15h, F28yH);
            cy = (cy * float(H)) * iH;
            cy = cy * float(H) - 0.5;
            cy = clamp(cy, -2.0, float(H) + 2.0);
            cy = floor(cy * 256.0 + 0.5) * (1.0 / 256.0);
            int x0 = int(floor(cx));
            int y0 = int(floor(cy));
            xa = clamp(x0, 0, W - 1);
            xb = min(W - 1, max(-1, x0) + 1);
            ya = clamp(y0, 0, H - 1);
            yb = min(H - 1, max(-1, y0) + 1);
            gx2 = cx - float(x0);           // exact: cx is a multiple of 1/256
            gy2 = cy - float(y0);
        }

        uint base = idx * 4u;
        for (uint k = 0u; k < 4u; ++k) {
            float wk = 0.0;
            if (ok) {
                float t00 = tap_dq((uint(ya) * uint(W) + uint(xa)) * 4u + k);
                float t01 = tap_dq((uint(ya) * uint(W) + uint(xb)) * 4u + k);
                float t10 = tap_dq((uint(yb) * uint(W) + uint(xa)) * 4u + k);
                float t11 = tap_dq((uint(yb) * uint(W) + uint(xb)) * 4u + k);
                float acc = ((1.0 - gx2) * (1.0 - gy2)) * t00;
                acc = acc + (gx2 * (1.0 - gy2)) * t01;
                acc = acc + ((1.0 - gx2) * gy2) * t10;
                acc = acc + (gx2 * gy2) * t11;
                wk = acc;
            }
            float z = 0.5 + 0.5 * th(0.5 * p[6u + k]);
            float h = z * th(p[2u + k]) + (1.0 - z) * wk;
            int v = int(roundEven(127.0 * clamp(h, -1.0, 1.0)));
            out_hidden[base + k] = int8_t(v);
        }
    }
}
