#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_control_flow_attributes : enable

// sr_post.comp: NeuralHub's k_sr_post<false,12,16,false,false> (SR preset M, oracle launch 14) and
// k_sr_post<true,12,16,false,false> (SR preset L, oracle sr_L launch 15) - one source, two template
// instances selected by the push's isL flag (0xd0, below). The spec of the M instance is
// tools/sr/sr_post_model.py (SPEC sections 1-7), of the L instance tools/sr/sr_postL_model.py (same
// spec with a 4x4 tap grid).
//
// PERF (2026-10-28, optimisation phase; measured, see docs/notes/k_sr_post.md "Perf" and
// build/agents/tail/progress.md):
//  1. A THREAD NOW OWNS A 2x2 OUTPUT BLOCK (columns x15, x15+1 x rows 2r, 2r+1) instead of one
//     column x two rows. The spec's layout put a lane's two stores a full row apart (2*W15
//     elements, 30 KB at 4K) and its history taps in two rows W15 apart; now a wave's stores and
//     history taps are contiguous runs. The workgroup covers 32 x 32 output pixels, and the dhist
//     2x2 block falls inside a single thread, so the shared-memory reduction and its barrier are
//     gone (that whole path - s_pair, the second barrier, the extra tm_lin - measured 2.2 ms).
//  2. The spec's f16 rounding points (the rh() chain of the old source) and the IEEE divides
//     existed only to match NeuralHub's rounding bit for bit; per the optimisation policy they are
//     dropped - every intermediate is f32, `a / b` is a plain divide, `precise` is gone so RADV
//     contracts to fma. Quality is the guard's business (ground truth, quality_guard.py).
//  3. The source tile of a workgroup (18 x 18 source pixels at 2x upsample, 24 B/record as the
//     reference stages) is staged into LDS ONCE: tm(R,G,B), the gate bytes and the A'B'C'
//     anisotropy coefficients are per SOURCE pixel and were recomputed per (tap, thread) before.
//     What stays per output pixel is what must be: the quadratic weight exp2(a dx^2 + b dy^2 +
//     c dx dy), the (now f32) numerator chains, the history resample and the encodes.
//  12.87 ms (baseline) -> 8.5-9.8 ms at 1080p->4K for these three together. What is left is
//  bandwidth, not instructions: a build with the tap loop, the history AND every store deleted
//  (the SPIR-V compiles to 3 instructions) still measured 11.6 ms before the tile-stride fix, and
//  the kernel touches ~500 MB per frame (9 Catmull-Rom history texels per output pixel, 13 B of
//  stores, the staging tile).
//
// Thread layout: 16x16 threads per group; group (gx, gy) owns output columns 32*gx .. 32*gx+31 and
// output rows 32*gy .. 32*gy+31. Thread (tx, ty) owns the 2x2 block of columns 2tx, 2tx+1 (of the
// group) and the ROW PAIR r = 16*gy + ty, i.e. output rows 2r and 2r+1. Both rows take their source
// rows from ONE base row Yb (the even row's Y0), so the nine (M) / sixteen (L) source records are
// shared, and its 2x2 dhist block is columns x15, x15+1 x rows 2r, 2r+1 - entirely inside the
// thread.
//
// PostArgs: the push block is NeuralHub's 256-byte PostArgs at its own offsets, so an oracle
// launch's args hex can be passed verbatim (the fixtures patch ONLY 0xd0). Read here: 0x10 (parity),
// 0x88..0xa4 (W, H, W15, H15, hW15, hH15), 0xa8 (dec0_f1), 0xac/0xb0 (scale), 0xb4/0xb8 (F20
// jitter), 0xcc (log2 10). Not read: the pointers (0x00..0x87), ldr (0xd4) and mvhi (0xd8): both
// oracle instances load the same scalars (proved from the ISA: neither reads past +0xd3), and the
// model applies no mvoff (0xf8 is 0 in the oracle).
// isL (0xd0): the PORT's instance selector, not an oracle field. Both oracle instances leave +0xd0
// at 0 (depth_inverted) and neither reads it; the host writes 1 there iff preset L, whose oracle
// args hex the fixture patches at 0xd0 only. Every field the kernel reads stays byte-equal to the
// oracle's launch args in both presets.
//
// Bindings (kept from the stand-in): 0 g_col, 1 expo, 2 gates, 4 aniso, 5 ihist (history, read),
// 8 mv_nondil, 9 ihist out, 10 full15, 11 dhist. Bindings 3 (factors), 6 (prev_mvec) and 7 (mv_ero)
// are bound by the host but not read: the model records the factors and never consumes them, and the
// MV candidates are not decoded (see the MV note below).
//
// The host grid is (W15+31)/32 x (hH15+15)/16 (see the dispatch block in src/vk/pipeline.cpp and the
// sr_post case of shaders/tests/make_test.py).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol      { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InExpo     { float16_t expo[]; };
layout(set = 0, binding = 2) readonly buffer InGates    { u8vec4 gates[]; };
layout(set = 0, binding = 4) readonly buffer InAniso    { f16vec4 aniso[]; };
layout(set = 0, binding = 5) readonly buffer InIhist    { f16vec4 in_ihist[]; };
layout(set = 0, binding = 8) readonly buffer InMvNondil { f16vec2 in_mv_nondil[]; };

layout(set = 0, binding = 9) writeonly buffer OutIhist   { f16vec4 out_ihist[]; };
layout(set = 0, binding = 10) writeonly buffer OutFull15 { uint full15[]; };
layout(set = 0, binding = 11) writeonly buffer OutDhist  { uint out_dhist[]; };

layout(push_constant) uniform PostArgs {
    layout(offset = 0x10) uint parity;     // PostArgs +0x10: p (u64; the low dword is read)
    layout(offset = 0x88) int W;           // render size 256 x 144
    int H;
    layout(offset = 0x98) int W15;         // level-15 (output) size 768 x 432
    int H15;
    layout(offset = 0xa0) int hW15;        // dhist size 384 x 216
    int hH15;
    layout(offset = 0xa8) float dec0_f1;   // gate0 confidence scale (2.7530112)
    layout(offset = 0xac) float scaleX;    // W/W15, H/H15 as f32
    float scaleY;
    layout(offset = 0xb4) float jitterX;   // F20: this frame's jitter
    float jitterY;
    layout(offset = 0xcc) float log2_10;   // f32 bits 0x40549a78
    layout(offset = 0xd0) uint isL;        // PORT-ONLY instance flag (see the header): 0 = M's 3x3 taps
                                           // (the oracle dumps carry 0 here), 1 = L's 4x4 taps
};

// f32 constants of the spec, as their bit patterns (macros: glslang rejects uintBitsToFloat in a global const)
#define C_TM_LOG10_2 uintBitsToFloat(0x3E9A209Bu)   // log10(2)
#define C_TM_SCALE   uintBitsToFloat(0x3EB851ECu)   // 0.36
#define C_ANISO1     uintBitsToFloat(0xBF38A8C1u)   // -0.5 * log2(e)
#define C_ANISO2     uintBitsToFloat(0xBFB8A8C1u)   // -log2(e)
#define K_ENC        uintBitsToFloat(0x3ED0FAC6u)   // 1 / 2.45
#define C_I036       uintBitsToFloat(0x4031C71Cu)   // 1 / 0.36
#define C_PT01       uintBitsToFloat(0x3C23D70Au)   // 0.01
#define C_FLOOR      uintBitsToFloat(0x38D1B717u)   // 1e-4

// LDS source-tile records. A group covers 32 output columns and 32 output rows; at the pipeline's
// 2x upsample the tile is 18 (M) / 19 (L) source pixels square = 24 B per record, so ST_C * ST_R
// records of 3 x f16vec4 fit in 11.5 KB of LDS with room for a larger upscale ratio.
#define ST_C 20
#define ST_R 20
shared f16vec4 sA[ST_R * ST_C];   // tm(R), tm(G), tm(B), gate.x
shared f16vec4 sB[ST_R * ST_C];   // gate.y, gate.z, A', B'
shared f16vec4 sC[ST_R * ST_C];   // C', -, -, -

// exposure of a parity slot: expo[q], or 1.0 when that slot is 0 (SPEC 1)
float expo_at(uint q) {
    float v = float(expo[q]);
    return (v != 0.0) ? v : 1.0;
}

// SPEC 1: 0.36 * log10(1 + 100 * min(c * e, 32752)) for one channel (the spec's f16() rounding dropped)
float tm_rec(float c, float e) {
    float x = min(c * e, 32752.0);
    float y = max(1.0 + 100.0 * x, 1e-4);
    return (log2(y) * C_TM_LOG10_2) * C_TM_SCALE;
}

// SPEC 6: the tonemap of the linear value, tm = (log2(y) * log10(2)) * 0.36 with y = max(fma(100,x,1), 1e-4)
vec3 tm_lin(vec3 x) {
    vec3 y = max(fma(vec3(100.0), x, vec3(1.0)), vec3(C_FLOOR));
    vec3 lg = log2(y) * C_TM_LOG10_2;
    return lg * C_TM_SCALE;
}

// SPEC 6: decode(h) = 0.01 * (exp2(clamp(h, 1e-4, 3) * (1/0.36) * log2(10)) - 1)
vec3 decode_lin(vec3 h, float l210) {
    vec3 hc = clamp(h, vec3(C_FLOOR), vec3(3.0));
    return C_PT01 * (exp2((hc * C_I036) * l210) - 1.0);
}

// SPEC 6, the 1D Catmull-Rom weights of the sub-texel fraction f (clamped to [0,1]):
// returns w(-1), w(2), a = w0 + w1 and the 8-bit round-to-nearest quantised fraction r = w1 / a.
void cr_axis(float f0, out float wm1, out float w2, out float a, out float rq) {
    float f = clamp(f0, 0.0, 1.0);
    float f2 = f * f;
    float f3 = f2 * f;
    float wm1_ = fma(-0.5, f3 + f, f2);
    float w0 = 1.0 + fma(1.5, f3, -2.5 * f2);
    float w2_ = 0.5 * fma(f, f2, -f2);
    float w1 = fma(-0.5, f3 - f2, (1.0 - wm1_) - w0);
    float a_ = w0 + w1;
    wm1 = wm1_;
    w2 = w2_;
    a = a_;
    rq = roundEven((w1 / a_) * 256.0) / 256.0;
}

// SPEC 6: one bilinear fetch of the history at texel (xi0, yi0) with sub-texel weights rx, ry;
// clamp-to-edge addressing; texel centres.
vec3 bil(int xi0, int yi0, float rx, float ry) {
    int xi = clamp(xi0, 0, W15 - 1);
    int yi = clamp(yi0, 0, H15 - 1);
    int x1 = clamp(xi0 + 1, 0, W15 - 1);
    int y1 = clamp(yi0 + 1, 0, H15 - 1);
    vec3 h00 = vec3(in_ihist[yi * W15 + xi].xyz);
    vec3 h01 = vec3(in_ihist[yi * W15 + x1].xyz);
    vec3 h10 = vec3(in_ihist[y1 * W15 + xi].xyz);
    vec3 h11 = vec3(in_ihist[y1 * W15 + x1].xyz);
    vec3 top = h00 * (1.0 - rx) + h01 * rx;
    vec3 bot = h10 * (1.0 - rx) + h11 * rx;
    return top * (1.0 - ry) + bot * ry;
}

// SPEC 6: the 5-tap bilinear Catmull-Rom history sample at the reprojected position (posx, posy),
// in output texels; returns h, the tm-domain history.
vec3 cr_sample(float posx, float posy) {
    int Ix = int(floor(posx - 0.5));
    int Iy = int(floor(posy - 0.5));
    float fx = posx - (float(Ix) + 0.5);
    float fy = posy - (float(Iy) + 0.5);
    float wmx, w2x, ax, rxq;
    float wmy, w2y, ay, ryq;
    cr_axis(fx, wmx, w2x, ax, rxq);
    cr_axis(fy, wmy, w2y, ay, ryq);
    float W1 = wmx * ay;
    float W2 = w2x * ay;
    float W3 = ax * wmy;
    float W4 = ax * w2y;
    float W5 = ax * ay;
    vec3 t1 = bil(Ix - 1, Iy, 0.0, ryq);      // pure texel x, blended y
    vec3 t3 = bil(Ix, Iy - 1, rxq, 0.0);      // blended x, pure texel y
    vec3 t5 = bil(Ix, Iy, rxq, ryq);          // the main bilinear
    vec3 t4 = bil(Ix, Iy + 2, rxq, 0.0);
    vec3 t2 = bil(Ix + 2, Iy, 0.0, ryq);
    vec3 num = t1 * W1 + t3 * W3 + t5 * W5 + t4 * W4 + t2 * W2;
    float wcr = (((W3 + W1) + W5) + W4) + W2;
    return num / wcr;
}

// SPEC 7: R11 | G11 << 11 | B10 << 22 of the t2-blend tm
uint enc_full15(vec3 tm) {
    vec3 t = K_ENC * tm;
    uint qr = uint(clamp(trunc(fma(2047.0, t.r, 0.5)), 0.0, 2047.0));
    uint qg = uint(clamp(trunc(fma(2047.0, t.g, 0.5)), 0.0, 2047.0));
    uint qb = uint(clamp(trunc(fma(1023.0, t.b, 0.5)), 0.0, 1023.0));
    return qr | (qg << 11) | (qb << 22);
}

// SPEC 7: R10 | G10 << 10 | B10 << 20 of rndne(1023 * clamp(k * tm, 0, 1))
uint enc_dhist(vec3 tm) {
    vec3 q = roundEven(1023.0 * clamp(K_ENC * tm, vec3(0.0), vec3(1.0)));
    return uint(q.r) | (uint(q.g) << 10) | (uint(q.b) << 20);
}

void main() {
    const int tx = int(gl_LocalInvocationID.x);
    const int ty = int(gl_LocalInvocationID.y);
    const int x15 = int(gl_WorkGroupID.x) * 32 + 2 * tx;   // the thread's first output column
    const int r = int(gl_WorkGroupID.y) * 16 + ty;         // its output row PAIR (rows 2r, 2r+1)
    const int ye = 2 * r;
    const int yo = ye + 1;

    const float e = expo_at(parity);          // SPEC 1, and e0 of SPEC 6
    const float e_prev = expo_at(parity ^ 1u);

    // ---- the group's source tile (see the header). px/py are monotone in x15/r, so the tile is the
    // rectangle of source pixels any thread of the group can name: [X0lo-1 .. X0hi+kmax] x
    // [Y0lo-1 .. Y0hi+kmax]. Coordinates are clamped to the image at STAGE time, so the tap loop
    // below only has to index the tile.
    const bool L = (isL != 0u);
    const int kmax = L ? 2 : 1;
    const int gx0 = int(gl_WorkGroupID.x) * 32;
    const int gy0 = int(gl_WorkGroupID.y) * 32;
    const int X0lo = int(floor(fma(float(gx0) + 0.5, scaleX, jitterX) - 0.5));
    const int X0hi = int(floor(fma(float(gx0 + 31) + 0.5, scaleX, jitterX) - 0.5));
    const int Y0lo = int(floor(fma(float(gy0) + 0.5, scaleY, jitterY) - 0.5));
    const int Y0hi = int(floor(fma(float(gy0 + 30) + 0.5, scaleY, jitterY) - 0.5));
    const int sx0 = X0lo - 1;
    const int sy0 = Y0lo - 1;
    const int ncol = min(X0hi - X0lo + kmax + 2, ST_C);
    const int nrow = min(Y0hi - Y0lo + kmax + 2, ST_R);

    // ---- stage the tile: one record per source pixel (the work the old shader did per tap-thread).
    // The LDS row stride is ST_C for BOTH sides: the tile's live width is ncol <= ST_C, but a
    // reader below indexes (row * ST_C + col) directly.
    {
        const uint nrec = uint(ncol) * uint(nrow);
        for (uint i = gl_LocalInvocationIndex; i < nrec; i += 256u) {
            const uint cx = i % uint(ncol);
            const uint cy = i / uint(ncol);
            const int sxi = clamp(sx0 + int(cx), 0, W - 1);
            const int syi = clamp(sy0 + int(cy), 0, H - 1);
            const uint si = uint(syi * W + sxi);
            const uint di = cy * uint(ST_C) + cx;
            const f16vec4 cg = g_col[si];
            const u8vec4 gg = gates[si];
            const f16vec4 an = aniso[si];
            // 16-bit stores round, so the f16 fields are the spec's rh() points for free
            sA[di] = f16vec4(tm_rec(float(cg.x), e), tm_rec(float(cg.y), e), tm_rec(float(cg.z), e),
                             float16_t(float(gg.x) * (1.0 / 255.0)));
            sB[di] = f16vec4(float16_t(float(gg.y) * (1.0 / 255.0)),
                             float16_t(float(gg.z) * (1.0 / 255.0)),
                             float16_t(C_ANISO1 * float(an.x)),
                             float16_t(C_ANISO1 * float(an.y)));
            sC[di] = f16vec4(float16_t(C_ANISO2 * float(an.z)), float16_t(0.0), float16_t(0.0), float16_t(0.0));
        }
    }
    memoryBarrierShared();
    barrier();

    // ---- SPEC 2: output geometry, per column of the 2x2 block (px differs, py is per row)
    float px[2];
    float dx0[2];
    int X0[2];
    int bx[2];
    px[0] = fma(float(x15) + 0.5, scaleX, jitterX);
    px[1] = fma(float(x15 + 1) + 0.5, scaleX, jitterX);
    X0[0] = int(floor(px[0] - 0.5));
    X0[1] = int(floor(px[1] - 0.5));
    bx[0] = X0[0] - sx0;
    bx[1] = X0[1] - sx0;
    dx0[0] = (float(X0[0]) + 0.5) - px[0];
    dx0[1] = (float(X0[1]) + 0.5) - px[1];

    const float pye = fma(float(ye) + 0.5, scaleY, jitterY);
    const float pyo = fma(float(yo) + 0.5, scaleY, jitterY);
    const int Y0e = int(floor(pye - 0.5));
    const int Y0o = int(floor(pyo - 0.5));
    const int Yb = Y0e;                                   // the pair's base row
    const float dybE = (float(Y0e) + 0.5) - pye;          // Y0e == Yb, shift 0
    const float dybO = ((float(Y0o) + 0.5) - pyo) - float(Y0o - Yb);   // the odd row's shift onto Yb
    const int by = Yb - sy0;

    // ---- SPEC 3 and 4: the taps, kx-major. Records (tm RGB, gates, A'B'C') once per source pixel.
    // isL == 0: k_sr_post<false,..> (M) - a 3x3 splat, dx/dy in {-1,0,1}. isL != 0: k_sr_post<true,..>
    // (L) - a 4x4 splat, dx/dy in {-1,0,1,2} (the L model's tap grid). Both instances' record
    // staging, MV/history sampling, gate blend and encodes are identical.
    const int ntaps = L ? 16 : 9;
    const int nrt = L ? 4 : 3;
    vec3 nE[2], nO[2], gE[2], gO[2];      // colour (fields 0..2) and gates (fields 6..8)
    float wsumE[2], wsumO[2];
    for (int c = 0; c < 2; ++c) { nE[c] = vec3(0.0); nO[c] = vec3(0.0); gE[c] = vec3(0.0); gO[c] = vec3(0.0); wsumE[c] = 0.0; wsumO[c] = 0.0; }

    for (int k = 0; k < ntaps; ++k) {
        const int kx = k / nrt - 1;
        const int ky = k - (k / nrt) * nrt - 1;
        const int rowi = (by + ky) * ST_C;
        const float dyE = dybE + float(ky);
        const float dyO = dybO + float(ky);
        const float dyE2 = dyE * dyE;
        const float dyO2 = dyO * dyO;
        for (int c = 0; c < 2; ++c) {
            const f16vec4 rec = sA[rowi + bx[c] + kx];
            const f16vec4 rig = sB[rowi + bx[c] + kx];
            const vec3 abc = vec3(float(rig.z), float(rig.w), float(sC[rowi + bx[c] + kx].x));
            const vec3 rtm = vec3(rec.xyz);
            const vec3 rgt = vec3(float(rec.w), float(rig.x), float(rig.y));

            const float dx = dx0[c] + float(kx);
            const float dx2 = dx * dx;
            const float wE = exp2(fma(abc.x, dx2, fma(abc.y, dyE2, abc.z * (dx * dyE))));
            const float wO = exp2(fma(abc.x, dx2, fma(abc.y, dyO2, abc.z * (dx * dyO))));

            wsumE[c] += wE;
            wsumO[c] += wO;
            nE[c] = fma(rtm, vec3(wE), nE[c]);
            nO[c] = fma(rtm, vec3(wO), nO[c]);
            gE[c] = fma(rgt, vec3(wE), gE[c]);
            gO[c] = fma(rgt, vec3(wO), gO[c]);
        }
    }

    // SPEC 4: the spatial colour average S = n / wsum, then B = decode(S)
    // SPEC 5: the two gate blend weights, t1 (gate1, ihist1/dhist) and t2 (gate2, full15)
    vec3 BE[2], BO[2], AE[2], AO[2];
    vec3 x1E[2], x1O[2], x2E[2], x2O[2];
    for (int c = 0; c < 2; ++c) {
        const float invE = 1.0 / wsumE[c];
        const float invO = 1.0 / wsumO[c];
        BE[c] = decode_lin(nE[c] * invE, log2_10);
        BO[c] = decode_lin(nO[c] * invO, log2_10);

        const float v12E = clamp(dec0_f1 * gE[c].x, 0.0, 1.0);        // = (dec0_f1 * wsum) * (gE.x / wsum)
        const float v12O = clamp(dec0_f1 * gO[c].x, 0.0, 1.0);
        const float t1E = fma(v12E, fma(-invE, gE[c].y, 1.0), invE * gE[c].y);
        const float t1O = fma(v12O, fma(-invO, gO[c].y, 1.0), invO * gO[c].y);
        const float t2E = fma(v12E, fma(-invE, gE[c].z, 1.0), invE * gE[c].z);
        const float t2O = fma(v12O, fma(-invO, gO[c].z, 1.0), invO * gO[c].z);

        // SPEC 6: the history. The MV is read per output pixel from mv_nondil at the render pixel
        // that contains the output pixel's source position (clamped).
        // NOT DECODED (Review post-3): NeuralHub's per-pixel MV candidate selection (mv_nondil,
        // prev_mvec1, mv_ero) is not decoded. All three candidate buffers are identical and constant
        // in the oracle's frames 0/1, so reading mv_nondil here matches the model on those frames;
        // it is not a selection rule.
        const int mx = clamp(int(floor(px[c])), 0, W - 1);
        const int myE = clamp(int(floor(pye)), 0, H - 1);
        const int myO = clamp(int(floor(pyo)), 0, H - 1);
        const vec2 mvE = vec2(in_mv_nondil[uint(myE * W + mx)]);
        const vec2 mvO = vec2(in_mv_nondil[uint(myO * W + mx)]);
        const float posxE = (float(x15 + c) + 0.5) + mvE.x;
        const float posyE = (float(ye) + 0.5) + mvE.y;
        const float posxO = (float(x15 + c) + 0.5) + mvO.x;
        const float posyO = (float(yo) + 0.5) + mvO.y;

        // Off-screen (never fires on the oracle frames; the model has no off-screen path): the
        // tonemap of e_prev * g_col at the clamped nearest source pixel (SPEC 6, decoded, unverified).
        vec3 hE, hO;
        if (posxE >= 0.0 && posxE <= float(W15) && posyE >= 0.0 && posyE <= float(H15)) {
            hE = cr_sample(posxE, posyE);
        } else {
            int sx = clamp(int(floor(posxE * scaleX)), 0, W - 1);
            int sy = clamp(int(floor(posyE * scaleY)), 0, H - 1);
            f16vec4 cg = g_col[uint(sy * W + sx)];
            hE = vec3(tm_rec(float(cg.x), e_prev), tm_rec(float(cg.y), e_prev), tm_rec(float(cg.z), e_prev));
        }
        if (posxO >= 0.0 && posxO <= float(W15) && posyO >= 0.0 && posyO <= float(H15)) {
            hO = cr_sample(posxO, posyO);
        } else {
            int sx = clamp(int(floor(posxO * scaleX)), 0, W - 1);
            int sy = clamp(int(floor(posyO * scaleY)), 0, H - 1);
            f16vec4 cg = g_col[uint(sy * W + sx)];
            hO = vec3(tm_rec(float(cg.x), e_prev), tm_rec(float(cg.y), e_prev), tm_rec(float(cg.z), e_prev));
        }

        // SPEC 6: A = e0 * decode(h); x = fma(t, B - A, A) for the t1 blend (ihist1, dhist) and the
        // t2 blend (full15). On frame 0 the history is zero, so h = 0 and A = e * decode(0).
        AE[c] = e * decode_lin(hE, log2_10);
        AO[c] = e * decode_lin(hO, log2_10);
        x1E[c] = fma(vec3(t1E), BE[c] - AE[c], AE[c]);
        x1O[c] = fma(vec3(t1O), BO[c] - AO[c], AO[c]);
        x2E[c] = fma(vec3(t2E), BE[c] - AE[c], AE[c]);
        x2O[c] = fma(vec3(t2O), BO[c] - AO[c], AO[c]);
    }

    // ---- SPEC 7: stores. Consecutive lanes hold consecutive column pairs of the same two rows, so
    // the four 8 B stores of a thread are one contiguous 32 B run per row across a wave.
    const bool v0 = (x15 < W15) && (r < hH15);
    const bool v1 = (x15 + 1 < W15) && (r < hH15);
    if (v0) {
        const int iE = ye * W15 + x15;
        const int iO = yo * W15 + x15;
        out_ihist[iE] = f16vec4(f16vec3(tm_lin(x1E[0])), float16_t(0.0));
        out_ihist[iO] = f16vec4(f16vec3(tm_lin(x1O[0])), float16_t(0.0));
        full15[iE] = enc_full15(tm_lin(x2E[0]));
        full15[iO] = enc_full15(tm_lin(x2O[0]));
    }
    if (v1) {
        const int iE = ye * W15 + x15 + 1;
        const int iO = yo * W15 + x15 + 1;
        out_ihist[iE] = f16vec4(f16vec3(tm_lin(x1E[1])), float16_t(0.0));
        out_ihist[iO] = f16vec4(f16vec3(tm_lin(x1O[1])), float16_t(0.0));
        full15[iE] = enc_full15(tm_lin(x2E[1]));
        full15[iO] = enc_full15(tm_lin(x2O[1]));
    }

    // SPEC 7: dhist = the t1-blend x of the thread's own 2x2 block in the LINEAR domain: the row
    // pair is summed first, then the column pair (the model's order), then tonemap_lin and encode.
    if (v0 && v1) {
        const vec3 xm = ((x1E[0] + x1O[0]) + (x1E[1] + x1O[1])) * 0.25;
        out_dhist[r * hW15 + (x15 >> 1)] = enc_dhist(tm_lin(xm));
    }
}
