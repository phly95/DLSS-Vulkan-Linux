#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol        { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InExpo       { f16vec2 expo; };
layout(set = 0, binding = 2) readonly buffer InGates      { u8vec4 gates[]; };
layout(set = 0, binding = 3) readonly buffer InFactors    { u8vec4 factors[]; };
layout(set = 0, binding = 4) readonly buffer InAniso      { f16vec4 aniso[]; };
layout(set = 0, binding = 5) readonly buffer InIhist      { f16vec4 in_ihist[]; };
layout(set = 0, binding = 6) readonly buffer InPrevMv     { f16vec2 in_prev_mv[]; };
layout(set = 0, binding = 7) readonly buffer InMvEro      { f16vec2 in_mv_ero[]; };
layout(set = 0, binding = 8) readonly buffer InMvNondil   { f16vec2 in_mv_nondil[]; };

layout(set = 0, binding = 9) writeonly buffer OutIhist    { f16vec4 out_ihist[]; };
layout(set = 0, binding = 10) writeonly buffer OutFull15  { uint full15[]; };
layout(set = 0, binding = 11) writeonly buffer OutDhist   { uint out_dhist[]; };

layout(push_constant) uniform PostArgs {
    layout(offset = 16) uint parity;
    layout(offset = 136) int W;
    int H;
    layout(offset = 152) int W15;
    int H15;
    layout(offset = 160) int hW15;
    int hH15;
    layout(offset = 168) float dec0_f1;
    float scaleX;
    float scaleY;
    float jitterX;
    float jitterY;
    float invW;
    float invH;
    float invW15;
    float invH15;
    float log2_10;
    layout(offset = 208) uint reset_flag;
    uint ldr;
    uint mvhi;
    layout(offset = 248) float mvoffx;
    float mvoffy;
};

vec3 get_tonemapped(vec3 c, float e) {
    vec3 p = log2(max(1.0 + 100.0 * c * e, vec3(0.0001))) * 0.3010299956639812;
    return p * 0.36;
}

vec3 sample_history(float px, float py) {
    int x0 = clamp(int(floor(px)), 0, W15 - 1);
    int x1 = clamp(x0 + 1, 0, W15 - 1);
    int y0 = clamp(int(floor(py)), 0, H15 - 1);
    int y1 = clamp(y0 + 1, 0, H15 - 1);

    float fx = clamp(px - float(x0), 0.0, 1.0);
    float fy = clamp(py - float(y0), 0.0, 1.0);

    vec3 h00 = vec3(in_ihist[y0 * W15 + x0].rgb);
    vec3 h10 = vec3(in_ihist[y0 * W15 + x1].rgb);
    vec3 h01 = vec3(in_ihist[y1 * W15 + x0].rgb);
    vec3 h11 = vec3(in_ihist[y1 * W15 + x1].rgb);

    return mix(mix(h00, h10, fx), mix(h01, h11, fx), fy);
}

uint pack_from_tonemapped(vec3 t) {
    if (ldr != 0u) {
        vec3 c = max(pow(vec3(10.0), t / 0.36) - 1.0, vec3(0.0)) / 100.0;
        uint ur = uint(clamp(round(c.r * 2047.0), 0.0, 2047.0));
        uint ug = uint(clamp(round(c.g * 2047.0), 0.0, 2047.0));
        uint ub = uint(clamp(round(c.b * 1023.0), 0.0, 1023.0));
        return ur | (ug << 11u) | (ub << 22u);
    } else {
        vec3 v = t * (1.0 / 2.45);
        uint ur = uint(clamp(floor(v.r * 2047.0 + 0.5), 0.0, 2047.0));
        uint ug = uint(clamp(floor(v.g * 2047.0 + 0.5), 0.0, 2047.0));
        uint ub = uint(clamp(floor(v.b * 1023.0 + 0.5), 0.0, 1023.0));
        return ur | (ug << 11u) | (ub << 22u);
    }
}

vec3 process_pixel(int x, int y, float e) {
    float sx = (scaleX != 0.0) ? scaleX : (float(W) / float(W15));
    float sy = (scaleY != 0.0) ? scaleY : (float(H) / float(H15));

    float s3x = (float(x) + 0.5) * sx + jitterX;
    float s4y = (float(y) + 0.5) * sy + jitterY;

    int aniso_x = clamp(int(floor(s3x)), 0, W - 1);
    int aniso_y = clamp(int(floor(s4y)), 0, H - 1);
    uint aniso_idx = uint(aniso_y * W + aniso_x);

    // 1. 9-tap anisotropic spatial reconstruction
    f16vec4 A = aniso[aniso_idx];
    float Axx = float(A.x);
    float Ayy = float(A.y);
    float Axy = float(A.z);

    int fx = int(floor(s3x - 0.5));
    int fy = int(floor(s4y - 0.5));

    vec3 num = vec3(0.0);
    float den = 0.0;
    vec3 cmin = vec3(1e9);
    vec3 cmax = vec3(-1e9);

    for (int dy = 0; dy < 3; ++dy) {
        int in_y = clamp(fy + dy, 0, H - 1);
        float ddy = (float(fy + dy) + 0.5) - s4y;
        for (int dx = 0; dx < 3; ++dx) {
            int in_x = clamp(fx + dx, 0, W - 1);
            float ddx = (float(fx + dx) + 0.5) - s3x;

            float dist = -(Axx * (ddx * ddx) + 2.0 * Axy * ddx * ddy + Ayy * (ddy * ddy));
            float w = exp(dist);

            vec3 c = clamp(vec3(g_col[in_y * W + in_x].rgb), vec3(0.0), vec3(32752.0));
            num += w * c;
            den += w;

            vec3 tc = get_tonemapped(c, e);
            cmin = min(cmin, tc);
            cmax = max(cmax, tc);
        }
    }

    vec3 c_spatial = num / max(den, 1e-6);
    vec3 t_spatial = get_tonemapped(c_spatial, e);

    // Color gamut box expanded by 10%
    cmin = max(1.1 * cmin - vec3(0.05), vec3(0.0));
    cmax = 1.1 * cmax + vec3(0.05);

    // 2. Motion vector & history reprojection
    vec2 mv = vec2(in_mv_nondil[aniso_idx]);
    float px = float(x) + mv.x + mvoffx;
    float py = float(y) + mv.y + mvoffy;

    if (reset_flag != 0u || px < 0.0 || px > float(W15 - 1) || py < 0.0 || py > float(H15 - 1)) {
        return t_spatial;
    }

    vec3 t_hist = sample_history(px, py);
    if (dot(t_hist, t_hist) < 1e-6) {
        return t_spatial;
    }

    vec3 t_clamped = clamp(t_hist, cmin, cmax);

    // 3. Temporal gating and 3-way factor blending
    u8vec4 u_gate = gates[aniso_idx];
    u8vec4 u_fact = factors[aniso_idx];

    vec3 g = vec3(float(u_gate.x), float(u_gate.y), float(u_gate.z)) * (1.0 / 255.0);
    float f0 = float(u_fact.x) * (1.0 / 255.0);
    float f1 = float(u_fact.y) * (1.0 / 255.0);
    float f2 = float(u_fact.z) * (1.0 / 255.0);

    vec3 t_cand = f0 * t_spatial + f1 * t_hist + f2 * t_clamped;
    return mix(t_spatial, t_cand, g);
}

void main() {
    int gx = int(gl_WorkGroupID.x) * 16;
    int gy = int(gl_WorkGroupID.y) * 32;

    uint tid = gl_LocalInvocationIndex;
    int lx = int(tid & 15u);
    int ly = int(tid >> 4u) * 2;

    float e = max(float(expo[parity]), 0.0001);

    int x = gx + lx;
    int y0 = gy + ly;
    int y1 = y0 + 1;

    vec3 t0 = vec3(0.0);
    vec3 t1 = vec3(0.0);

    // Pixel 0 (x, y0)
    if (x < W15 && y0 < H15) {
        t0 = process_pixel(x, y0, e);
        uint idx0 = uint(y0 * W15 + x);
        full15[idx0] = pack_from_tonemapped(t0);
        out_ihist[idx0] = f16vec4(f16vec3(t0), float16_t(0.0));
    }

    // Pixel 1 (x, y1)
    if (x < W15 && y1 < H15) {
        t1 = process_pixel(x, y1, e);
        uint idx1 = uint(y1 * W15 + x);
        full15[idx1] = pack_from_tonemapped(t1);
        out_ihist[idx1] = f16vec4(f16vec3(t1), float16_t(0.0));
    }

    // Downsampled history 384x216 (half of 768x432)
    if ((lx & 1) == 0 && (x < W15) && (y0 < H15)) {
        int x_d = x >> 1;
        int y_d = y0 >> 1;
        if (x_d < hW15 && y_d < hH15) {
            vec3 t_avg = 0.5 * (t0 + t1);
            vec3 vd = t_avg * (1.0 / 2.45);
            uint ur = uint(clamp(floor(vd.r * 1023.0 + 0.5), 0.0, 1023.0));
            uint ug = uint(clamp(floor(vd.g * 1023.0 + 0.5), 0.0, 1023.0));
            uint ub = uint(clamp(floor(vd.b * 1023.0 + 0.5), 0.0, 1023.0));
            out_dhist[y_d * hW15 + x_d] = ur | (ug << 10u) | (ub << 20u);
        }
    }
}
