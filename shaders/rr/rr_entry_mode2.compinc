// rr_entry_mode2: up-projection entry for the decoder units u6/u8/u10/u12/u14.
// x = q8(mE8 @ low + v1a0)[pixel-shuffled q = dx + 2 dy] + s1d6 * skip
// (rr_level_model.py upsample + block_v2 up_entry, Review R9b: border tokens reflect in
// LOW-res space - parent = reflect(tx>>1, Wlow) - the parity is the RAW token parity, and
// the up result is staged in fp8: the model's up8 q8(clip(f16a(u))) round).
//
// Dataflow: every lane computes its OWN token's up. The up GEMM (M-tiles = C channels,
// K = Cup, N = tokens) needs A = mE8 row-block [q*C..), which varies with the token parity q
// - and a cooperative A load is wave-uniform, so the four parities run as four passes
// (pp = 0..3); each lane feeds its B operand (its parent's low channels, raw stored bytes -
// the weight channel axes are stored order per the HANDOFF) only on the pass whose parity
// matches its own token, zeros otherwise, so the accumulator picks up exactly its block.
// The fp8 staging round (+v1a0, Q8P through a scratch fragment) and the skip add complete
// st[]; the core seeds (st += v128', Q8P) after this include. No LDS, no barriers, no
// cross-wave data (a parity-per-wave + LDS variant is sketched in the REPORT; it needs a
// global-scope include hook in rr_swin.comp, which is the integrator's file).
//
// INTEGRATED by mu_rrl: v1a0 lives in the unified extras at the shader-scope
// v1a0o (= VH+160, raw f16->f32, 4C words; tube's VH+0 request would collide with
// u0's v218 - up units never need v218/v230/v188, down units never need v1a0).
// mE8 tiles after m108 (mA8/mC8 absent for mode 2) - unchanged.
    {
        const uint C_ = uint(RR_C);
        const uint KC_ = uint(C_in) >> 4u;           // Cup/16 K tiles (C_in == Cup for mode 2)
        // lane's own token (core mapping): full-res window coords, pre-reflection
        int txw_ = x0 + int(col & 7u);
        int tyw_ = y0 + int(q * 2u) + int(col >> 3u);
        // own parent: TX>>1 then reflect in LOW dims (Review R9b; identical to reflect-then-
        // halve for the even dims the pyramid uses, and matches the model for odd ones)
        int lpx_ = txw_ >> 1;
        int lpy_ = tyw_ >> 1;
        const uint W2_ = uint(W) >> 1u;              // low grid dims (level below)
        const uint H2_ = uint(H) >> 1u;
        const uint HW2_ = W2_ * H2_;
        uint lpos_ = uint(reflect_coord(lpy_, int(H2_))) * W2_
                   + uint(reflect_coord(lpx_, int(W2_)));
        uint p_ = uint(txw_ & 1) + 2u * uint(tyw_ & 1);   // own parity q = dx + 2 dy
        uint v1ao_ = v1a0o;   // unified extras slot (VH+160), raw stored order
        float s6v_ = wtab[s1d0o + 1u];               // s1d6 scalar (slot +17)
        uint spos_ = uint(reflect_coord(tyw_, H)) * uint(W) + uint(reflect_coord(txw_, W));
        // ---- the up GEMM: four parity passes, only the matching one feeds the accumulator
        NR_FRAG_B bk_;
        NR_FRAG_B qb_;                               // scratch for the fp8 staging round
        #define RR_UP_Z(m) NR_FRAG_ACC up##m = NR_ACC_ZERO;
        RR_FOR_NT(RR_UP_Z)
        for (uint pp = 0u; pp < 4u; ++pp) {
            for (uint kc = 0u; kc < KC_; ++kc) {
                if (p_ == pp) {
                    // B: K-tile kc's 16 low channels of my parent, raw stored bytes
                    uint byte_ = ((kc >> 1u) * HW2_ + lpos_) * 32u + (kc & 1u) * 16u + rowh * 8u;
                    RR_LD8B(bk_, byte_)   // opus_impl: typed fp8 copy (no decode + requant)
                } else {
                    Q8P(bk_, 0u, 0.0, 0.0) Q8P(bk_, 2u, 0.0, 0.0)
                    Q8P(bk_, 4u, 0.0, 0.0) Q8P(bk_, 6u, 0.0, 0.0)
                }
                #define RR_UP_M(m) { \
                    NR_FRAG_A wa_; \
                    NR_LOAD_A(wa_, wT, m108T + 256u * (NT + (pp * NT + uint(m)) * KC_ + kc), 16u); \
                    NR_MMA(up##m, wa_, bk_); }
                RR_FOR_NT(RR_UP_M)
            }
        }
        // ---- fill st[]: + v1a0, fp8 staging round (Q8P through qb_), + s1d6 * skip
        uint v1b_ = v1ao_ + p_ * C_;                 // bias block = q*C; the row index pairs
        // with the model's rows through basis() exactly like the tiled A rows do (tile[r] =
        // mE8f[basis(r)][basis(k)]). v1a0 reads RAW (mu_h2 fix): blob_raw[j] == model-logical
        // P(j) bit-exactly, so raw is exactly the matching bias for tile row j (P5 read P(P(j))
        // = a ~0.1-0.36 f32 error per hidden channel that the softmax amplifies).
        #define RR_M2_T(t) { \
            uint j0_ = 16u * uint(t) + 8u * rowh; \
            uint vbb_ = v1b_ + (j0_ & 0xFFFFFFE0u); \
            Q8P(qb_, 0u, up##t[0] + wtab[vbb_ + (j0_ & 31u)], \
                        up##t[1] + wtab[vbb_ + ((j0_ + 1u) & 31u)]) \
            Q8P(qb_, 2u, up##t[2] + wtab[vbb_ + ((j0_ + 2u) & 31u)], \
                        up##t[3] + wtab[vbb_ + ((j0_ + 3u) & 31u)]) \
            Q8P(qb_, 4u, up##t[4] + wtab[vbb_ + ((j0_ + 4u) & 31u)], \
                        up##t[5] + wtab[vbb_ + ((j0_ + 5u) & 31u)]) \
            Q8P(qb_, 6u, up##t[6] + wtab[vbb_ + ((j0_ + 6u) & 31u)], \
                        up##t[7] + wtab[vbb_ + ((j0_ + 7u) & 31u)]) \
            uint sb_ = ((uint(t) >> 1u) * HW + spos_) * 32u + (uint(t) & 1u) * 16u + rowh * 8u; \
            st##t[0] = float(qb_[0]) + s6v_ * RR_SKIPF(sb_); \
            st##t[1] = float(qb_[1]) + s6v_ * RR_SKIPF(sb_ + 1u); \
            st##t[2] = float(qb_[2]) + s6v_ * RR_SKIPF(sb_ + 2u); \
            st##t[3] = float(qb_[3]) + s6v_ * RR_SKIPF(sb_ + 3u); \
            st##t[4] = float(qb_[4]) + s6v_ * RR_SKIPF(sb_ + 4u); \
            st##t[5] = float(qb_[5]) + s6v_ * RR_SKIPF(sb_ + 5u); \
            st##t[6] = float(qb_[6]) + s6v_ * RR_SKIPF(sb_ + 6u); \
            st##t[7] = float(qb_[7]) + s6v_ * RR_SKIPF(sb_ + 7u); }
        RR_FOR_NT(RR_M2_T)
    }
