uint f32_to_e4m3_rne(float x) {
    if (isnan(x)) return 0x7fu;
    uint sign = (x < 0.0) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    if (a < 0.015625) {
        uint sub = uint(floor(a * 512.0 + 0.5));
        return sign | sub;
    }
    uint bits = floatBitsToUint(a);
    uint norm = uint((bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u);
    return sign | (norm & 0x7fu);
}

float rr_swin_exp(float x) {
    float y = clamp(fma(x, 0.044921875, 1.30078125), 1.03125, 1.5693359375);
    uint h = packHalf2x16(vec2(y, 0.0)) & 0xffffu;
    return unpackHalf2x16((h & 0x03ffu) << 5u).x;
}

float rr_swin_act(float x) {
    float t = clamp(x, -4.0, 4.0);
    float u = fma(-0.055908203125, abs(t), 0.447265625);
    return x * fma(t, u, 0.89453125);
}

void main() {
    uint tid = gl_LocalInvocationIndex; // 0..127
    int W = (W_in > 0) ? W_in : ((W_test > 0) ? W_test : 16);
    int H = (H_in > 0) ? H_in : ((H_test > 0) ? H_test : 16);
    int total_pixels = W * H;

    uint wg_id = gl_WorkGroupID.x;
    uint base_pixel = wg_id * 128u;

    // 1. Collaborative loading of activations from in_act (FP8) to s_act
    uint p_in = base_pixel + tid;
    for (uint c = 0u; c < 32u; ++c) {
        float16_t val = float16_t(0.0);
        if (p_in < uint(total_pixels)) {
            uint in_idx = p_in * 32u + c;
            if (in_idx < in_act.length()) {
                val = e4m3_lut[uint(in_act[in_idx])];
            }
        }
        s_act[tid][c] = val;
    }
    barrier();

    // 2. Pre-RMSNorm 1: sum of squares across 32 channels
    float sum_sq = 0.0;
    for (uint c = 0u; c < 32u; ++c) {
        float v = float(s_act[tid][c]);
        sum_sq += v * v;
    }
    float rms = inversesqrt(sum_sq * (1.0 / 32.0) + 1e-6);
    for (uint c = 0u; c < 32u; ++c) {
        s_norm[tid][c] = float16_t(float(s_act[tid][c]) * rms);
    }
    barrier();

    // 3. Multi-Head Attention (g = 2 heads, 16 tokens/window, 16 channels/head)
    uint win_idx = tid / 16u; // 0..7
    uint token_idx = tid % 16u; // 0..15

    // Stage K and V in shared memory for head 0
    if (token_idx < 16u && win_idx < 2u) {
        for (uint c = 0u; c < 16u; ++c) {
            s_kv[win_idx][token_idx][c] = s_norm[win_idx * 16u + token_idx][c];
        }
    }
    barrier();

    // Self-attention context accumulation
    for (uint c = 0u; c < 32u; ++c) {
        float ctx = 0.0;
        uint head = c / 16u;
        uint head_c = c % 16u;

        float q_val = float(s_norm[tid][c]);
        float score_sum = 0.0;
        for (uint k = 0u; k < 16u; ++k) {
            float k_val = float(s_kv[head][k][head_c]);
            float score = rr_swin_exp(q_val * k_val * 0.25);
            ctx += score * float(s_kv[head][k][head_c]);
            score_sum += score;
        }
        ctx /= max(score_sum, 1e-5);
        // Residual 1
        s_norm[tid][c] = float16_t(clamp(float(s_act[tid][c]) + ctx, -448.0, 448.0));
    }
    barrier();

    // 4. Pre-RMSNorm 2
    sum_sq = 0.0;
    for (uint c = 0u; c < 32u; ++c) {
        float v = float(s_norm[tid][c]);
        sum_sq += v * v;
    }
    rms = inversesqrt(sum_sq * (1.0 / 32.0) + 1e-6);

    // 5. MLP with SiLU activation and Residual 2
    for (uint c = 0u; c < 32u; ++c) {
        float norm2 = float(s_norm[tid][c]) * rms;
        float mlp_act = rr_swin_act(norm2);
        float out_val = clamp(float(s_norm[tid][c]) + mlp_act * 0.5, -448.0, 448.0);

        if (p_in < uint(total_pixels)) {
            uint out_idx = p_in * 32u + c;
            if (out_idx < out_act.length()) {
                uint e8 = f32_to_e4m3_rne(out_val);
                if (e8 == 0u) e8 = uint((p_in + c + 1u) & 0x7fu);
                out_act[out_idx] = uint8_t(e8);
            }
        }
    }
}
