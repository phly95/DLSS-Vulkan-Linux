layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InW    { uint8_t w[]; };
layout(set = 0, binding = 1) readonly buffer InAct  { uint8_t in_act[]; };
layout(set = 0, binding = 2) writeonly buffer OutAct { uint8_t out_act[]; };

layout(push_constant) uniform RrUnitArgs {
    layout(offset = 0) int W_in;
    int H_in;
    int sx_in;
    int sy_in;
    int mode_in;
    layout(offset = 40) int W_test;
    int H_test;
    int sx_test;
    int sy_test;
};

// LDS staging: 128 tokens covering a workgroup
shared float16_t s_act[128][32];  // 8192 bytes
shared float16_t s_norm[128][32]; // 8192 bytes
shared float16_t s_kv[2][16][16]; // 1024 bytes (2 heads, 16 tokens/window, 16 channels)

