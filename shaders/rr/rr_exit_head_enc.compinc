// rr_exit_head_enc: encoder o98 head (flags bit 0). Lanes 0..2 (+x88), lane 3 = 0.
// Contract: reads ofp[] (fp8 block output), x88 (binding 5), s1d0/v1b8 (table).
// Writes o98 (binding 7) for in-range tokens. Caller provides: x0/y0/W/H, col/q,
// flags_in, ofp[], hbias/s1d0o, wtab, in_5. f16 RNE stores (f16_enc).
    // ---- 6. encoder o98 head (flags bit 0): 3 gates, lane 3 = 0
    if ((flags_in & 1) != 0) {
        NR_FRAG_ACC gg = NR_ACC_ZERO;
        #define RR_G_KT(kt) { \
            NR_FRAG_A ma; NR_LOAD_A(ma, wT, m108T + 256u * uint(kt), 16u); \
            NR_MMA(gg, ma, ofp##kt); }
        RR_FOR_NT(RR_G_KT)
        // Heads 0..2 live in ACC rows 0..2; xor-16 makes them visible to every
        // lane of the wave (lanes 16..31 fetch their wave-mate's rows).
        float g0 = gg[0]; float g1 = gg[1]; float g2 = gg[2];
        g0 = (lane < 16u) ? g0 : subgroupShuffleXor(g0, 16u);
        g1 = (lane < 16u) ? g1 : subgroupShuffleXor(g1, 16u);
        g2 = (lane < 16u) ? g2 : subgroupShuffleXor(g2, 16u);
        float s0 = 1.0 / (1.0 + exp(-(g0 + wtab[hbias])));
        float s1 = 1.0 / (1.0 + exp(-(g1 + wtab[hbias + 1u])));
        float s2 = 1.0 / (1.0 + exp(-(g2 + wtab[hbias + 2u])));
        float s1d0 = wtab[s1d0o];
        int rx = x0 + int(col & 7u);
        int ry = y0 + int(q * 2u) + int(col >> 3u);
        float v0 = 0.0, v1 = 0.0, v2 = 0.0;
        if (rx >= 0 && rx < W && ry >= 0 && ry < H) {
            uint pix = uint(ry * W + rx);
            uint x0b = pix * 8u;
            float x88_0 = unpackHalf2x16(uint(in_5[x0b]) | (uint(in_5[x0b + 1u]) << 8u)).x;
            float x88_1 = unpackHalf2x16(uint(in_5[x0b + 2u]) | (uint(in_5[x0b + 3u]) << 8u)).x;
            float x88_2 = unpackHalf2x16(uint(in_5[x0b + 4u]) | (uint(in_5[x0b + 5u]) << 8u)).x;
            v0 = min(s1d0 * s0 * x88_0, 65504.0);
            v1 = min(s1d0 * s1 * x88_1, 65504.0);
            v2 = min(s1d0 * s2 * x88_2, 65504.0);
            uint e0b = f16_enc(v0); uint e1b = f16_enc(v1); uint e2b = f16_enc(v2);
            out_c[pix * 8u] = uint8_t(e0b & 0xFFu); out_c[pix * 8u + 1u] = uint8_t(e0b >> 8u);
            out_c[pix * 8u + 2u] = uint8_t(e1b & 0xFFu); out_c[pix * 8u + 3u] = uint8_t(e1b >> 8u);
            out_c[pix * 8u + 4u] = uint8_t(e2b & 0xFFu); out_c[pix * 8u + 5u] = uint8_t(e2b >> 8u);
            out_c[pix * 8u + 6u] = uint8_t(0); out_c[pix * 8u + 7u] = uint8_t(0);
        }
        // oa0 (flags bit 1, units 0-4): per-2x2-block f16 average of o98.
        // Each wave owns one block row (bj = q) and four block columns; the
        // block owner lane (rowh 0, even col, bi = col>>1) averages its four
        // taps. The wave holds 16 tokens in 32 lanes (lane 16+c duplicates
        // lane c's token), so the next-row taps are at col+8. Taps go through
        // the attention's f16 LDS (free at exit time): subgroup xors proved
        // unreliable here (multi-bit masks return 0; cascades nondeterministic
        // in 344/640 blocks), while LDS has no lane-activity dependence.
        // Out-of-range lanes contribute 0, matching the bit-exact port's s_o.
        if ((flags_in & 2) != 0) {
            if (rowh == 0u) {
                uint slot = (16u * q + col) * 3u;
                s_VB[slot] = float16_t(v0);
                s_VB[slot + 1u] = float16_t(v1);
                s_VB[slot + 2u] = float16_t(v2);
            }
            sync_lds();
            // Owners: rowh-0 lanes of the wave's first row (col < 8, even col);
            // bi = col>>1 in 0..3. (col 8..15 is the wave's second row: those
            // lanes would be phantom owners racing the next window's blocks.)
            if (rowh == 0u && col < 8u && (col & 1u) == 0u) {
                uint bi = col >> 1u;
                int X = x0 / 2 + int(bi);
                int Y = y0 / 2 + int(q);
                if (X >= 0 && X < W / 2 && Y >= 0 && Y < H / 2) {
                    uint t0 = (16u * q + 2u * bi) * 3u;
                    uint t1 = (16u * q + 2u * bi + 1u) * 3u;
                    uint t2 = (16u * q + 2u * bi + 8u) * 3u;
                    uint t3 = (16u * q + 2u * bi + 9u) * 3u;
                    float m0 = 0.25 * ((float(s_VB[t0]) + float(s_VB[t1])) + float(s_VB[t2]) + float(s_VB[t3]));
                    float m1 = 0.25 * ((float(s_VB[t0 + 1u]) + float(s_VB[t1 + 1u])) + float(s_VB[t2 + 1u]) + float(s_VB[t3 + 1u]));
                    float m2 = 0.25 * ((float(s_VB[t0 + 2u]) + float(s_VB[t1 + 2u])) + float(s_VB[t2 + 2u]) + float(s_VB[t3 + 2u]));
                    uint base = (uint(Y) * (uint(W) / 2u) + uint(X)) * 8u;
                    uint f0 = f16_enc(min(m0, 65504.0));
                    uint f1 = f16_enc(min(m1, 65504.0));
                    uint f2 = f16_enc(min(m2, 65504.0));
                    out_d[base] = uint8_t(f0 & 0xFFu); out_d[base + 1u] = uint8_t(f0 >> 8u);
                    out_d[base + 2u] = uint8_t(f1 & 0xFFu); out_d[base + 3u] = uint8_t(f1 >> 8u);
                    out_d[base + 4u] = uint8_t(f2 & 0xFFu); out_d[base + 5u] = uint8_t(f2 >> 8u);
                    out_d[base + 6u] = uint8_t(0); out_d[base + 7u] = uint8_t(0);
                }
            }
        }
    }
