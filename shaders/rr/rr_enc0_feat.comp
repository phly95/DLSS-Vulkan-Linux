#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_GOOGLE_include_directive : require

// The sanctioned fp8 spelling (sr_stage.comp / sr_enc0.comp): NR_OPERAND comes from the ONE
// wrapper nh_mm.glsl - the fp8 scalar type on the RADV build (the hardware v_cvt_pk_fp8_f32
// conversion), plain f16 under the offline f16-operand build (lavapipe has no Float8). R1 lint
// allows it: my file names neither the fp8 spellings nor the wrapper's internals.
#include "nh_mm.glsl"
#include "rr_texfmt.glsl"

// k_enc0_feat (RR preset F, oracle launches 3/4): the producer of E0be8, the [2][H0][W0][32] fp8
// feature tensor.  SPEC: tools/rr/rr_enc0feat_model.py (frame0 100.0000% bit-exact vs the oracle;
// this port follows its sections 2-4):
//   * every stored channel goes through dq(), the dithered e4m3 quantizer (dither table =
//     wbuf[0:4096] as u16[2048] = blob0's meta[20] region, binding 13; fc = E[0x19] & 7 ring),
//   * c02 = alb.g / c29 = alb.r (the F3 port had them swapped),
//   * the 15 SC_TM slots hold SC0*tm(col_c*expo) (the F3 port wrote mv*3 there),
//   * zeros / -0 / 1.0 / dep / spa all through dq() (the dither flips {18,19}, {56,57}, {48,49}
//     and the single d==0 cell of each dither row turns dq(-0.0) into 0x00).
//   * HISTORY BRANCH (model SPEC 6, the frame1-verified half of OPEN1): gated by rst (+0x14);
//     on history frames (rst == 0) the 15 SC_TM slots take SC0*tm(e_cur*h/e_prev) with
//     h = inv_tm(2.45*sample) of the pooled history - E0c0e (384x216, binding 14) at C/2 for
//     12 slots, E0c12 (192x108, binding 15) at C/4 for c17/c20/c21 - at the motion-compensated
//     position C = (W15/W)*((coord+0.5) - pj) + bev with pj = the pushed jitter (E0Args
//     +0x1a0/+0x1a4) and bev = the previous frame's mv-record [0,0] (pushed from bf6);
//     OOB lanes fall back to col*expo; c36 = -2^-9 (VERIFIED on the oracle's frame1; on the
//     other chain frames the oracle's c36 is a per-frame value this port cannot know -
//     build/agents/e0be8-port-fix/progress.md Step 5 - reported, not invented).
//   * c22-FAMILY (model SPEC 6b, decoded): on history frames {22,23,26,27,45,48,49,52} take
//     SC1*bilinear(E0c02 ch / 127) at C/3 + pj_prev - 0.5, where E0c02 (binding 16, render-grid
//     i8x4 k_level hidden) is sampled with the prior frame's jitter (pj_prev = pushed E0Args
//     +0x1a8/+0x1ac).  c22=c45=ch0, c23=c48=ch1, c26=c49=ch2, c27=c52=ch3.  VERIFIED 100% on
//     oracle frames 1,2,3,5,6,7,8 (model frame0+frame1 = 100.0000%).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol   { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InMv    { f16vec2 g_mv[]; };
layout(set = 0, binding = 2) readonly buffer InDep   { float g_dep[]; };
layout(set = 0, binding = 3) readonly buffer InNrm   { f16vec4 g_nrm[]; };
// opus_impl: bindings 4/5 are the RAW albedo / specular-albedo inputs (any RR format code),
// decoded here with rr_gather's decoder (rr_texfmt.glsl) - no f32x4 gather copy any more.
layout(set = 0, binding = 4) readonly buffer InAlb   { uint in_alb[]; };
layout(set = 0, binding = 5) readonly buffer InSpa   { uint in_spa[]; };
layout(set = 0, binding = 6) readonly buffer InRgh   { float g_rgh[]; };
layout(set = 0, binding = 7) readonly buffer InExpo  { vec4 in_expo[]; };

// out_be8: NR_OPERAND is 1 byte an element on the RADV build, so the [2][H0][W0][32] byte layout
// is unchanged; the f16-operand offline build widens it to f16 and make_test sizes that fixture 2x.
layout(set = 0, binding = 8) writeonly buffer OutBe8 { NR_OPERAND out_be8[]; };
layout(set = 0, binding = 9) writeonly buffer OutBec { f16vec4 out_bec[]; };
layout(set = 0, binding = 10) buffer Bf6RW { f16vec4 bf6_rw[]; };   // E0bf6 = this frame's mv*3
// (write target); at dispatch time it still holds the PREVIOUS frame's mv-record, which the
// history branch below reads per-pixel (the oracle's own addressing: base + thread-pixel offset,
// global_load_b96/b32 off s[44:45]+v[15:16] - NOT a constant [0,0] read; uniform pan made the two
// indistinguishable, varied Blender motion does not).
layout(set = 0, binding = 11) writeonly buffer OutBfa { f16vec2 out_bfa[]; };
layout(set = 0, binding = 12) writeonly buffer OutBfe { f16vec2 out_bfe[]; };
// dq()'s dither table (oracle E0Args +0x198 wbuf = blob0 + meta[20] = blob0 + 37984; u16[2048]).
layout(set = 0, binding = 13) readonly buffer InDither { uint8_t dith[]; };
// History (model SPEC 6): the pooled tone-history grids, u32 R10G10B10 words.
// binding 14 = E0c0e ((W15+1)/2 x (H15+1)/2, the chain's c0e written by k_post each frame),
// binding 15 = E0c12 (one pooling level below, re-pooled from E0c0e by k_pooled2 each
// non-reset frame).  At the enc0_feat dispatch both hold the PREVIOUS frame's state.
layout(set = 0, binding = 14) readonly buffer InC0e { uint g_c0e[]; };
layout(set = 0, binding = 15) readonly buffer InC12 { uint g_c12[]; };
// binding 16 = E0c02 (i8x4 render-grid hidden from k_level; the c22-family bilinear source,
// read as bytes; at the enc0_feat dispatch it holds the PREVIOUS frame's k_level output).
layout(set = 0, binding = 16) readonly buffer InC02 { uint8_t g_c02[]; };

layout(push_constant) uniform RrE0Args {
    int W0;               // +0x00 (oracle E0Args +0x00: W0, H0)
    int H0;
    int W;                // +0x08 (render W, H)
    int H;
    uint fc;              // +0x10 E0Args +0x10 = E[0x19] & 7: the dq() dither row
    uint rst;             // +0x14 E0Args +0x14: history gate (rst != 0 skips the history branch)
    uint dith_off;        // +0x18 byte offset of the dither table inside binding 13
    float SC0;            // +0x1c E0Args +0x200: the blob's f16 scalar (params.json enc0_s2598)
    float pjx;            // +0x20 E0Args +0x1a0: this frame's subpixel jitter (history position)
    float pjy;            // +0x24 E0Args +0x1a4
    float bev_x;          // +0x28 E0Args +0x160 (UNUSED now: kept for push-layout parity;
    float bev_y;          // +0x2c the oracle reads this buffer per-pixel, see bf6_rw above)
    int W15;              // +0x30 the history C-grid (oracle E: 768x432 = 3x render); E0c0e is
    int H15;              // +0x34 ((W15+1)/2) x ((H15+1)/2) words, E0c12 one level below
    float SC1;            // +0x38 E0Args +0x204: the c22-family coefficient (-0.2198486328125)
    float pjpx;           // +0x3c E0Args +0x1a8: the PREVIOUS frame's jitter (E0c02 texel offset)
    float pjpy;           // +0x40 E0Args +0x1ac
    uint pitch_alb;       // +0x44 opus_impl: raw albedo row pitch (W x bpp of its format)
    uint pitch_spa;       // +0x48 raw specular-albedo row pitch
    int fmt_alb;          // +0x4c RR format codes (rr_gather's table)
    int fmt_spa;          // +0x50
};

// ---------------------------------------------------------------- helpers

// dq(x): the feature quantizer (model SPEC 2, same law as sr_enc0.comp's dq), in the NATIVE f16
// spelling: the old rh_s()/f32_to_f16_bits()/f16_bits_to_f32() chains spent ~15 integer ops per
// round trip spelling out v_cvt_f16_f32 / v_cvt_f32_f16 (RNE - the same rounding the model's f16
// has, and every intermediate of the law is exact in f32, so the bit pattern is UNCHANGED: the
// fixture output is bit-identical before/after this port). The e4m3 code conversion is the store's
// NR_OPERAND() - the hardware v_cvt_pk_fp8_f32 - see the store section in main().
// The dither word d comes from the caller (it depends on fc, x, y only - one fetch per pixel for
// all 64 channels instead of 64, sr_enc0.comp's pattern).
float dqt(float x, uint d) {
    float16_t x16 = float16_t(isnan(x) ? 0.0 : min(x, 1024.0));
    uint h = packHalf2x16(vec2(x16));
    uint E = h & 0xFC00u;
    float16_t K = float16_t(unpackHalf2x16(E | d).x);
    float16_t a = x16 + K;
    float16_t b = a - float16_t(unpackHalf2x16(E).x);
    float16_t t = float16_t(unpackHalf2x16(packHalf2x16(vec2(b)) & 0xFF80u).x);
    float tc = min(max(float(t), -448.0), 448.0);
    return tc;
}

// tm(v) (model SPEC 4/6): 0.36*log10(max(1+100v, 1e-4)) in f32, NaN/inf/negative -> 0,
// clamp <= 1024.  The col path's inline expression was bit-identical to this (same op order).
float tm32(float v) {
    float t = max(1.0 + 100.0 * v, 0.0001);
    float r = 0.36 * (log2(t) * 0.3010299956639812);
    if (!(r >= 0.0)) r = 0.0;                       // model: isfinite(r) & r >= 0 else 0
    return min(r, 1024.0);
}

// inv_tm (model SPEC 6): undo the history's *2.45 tm round-trip: (10^(y/0.36) - 1)/100 with
// y = clamp(2.45*s, 1e-4, 8).  Constants are the ISA's exact words: 0x4031c71c = 1/0.36,
// 0x40549a78 = log2(10) (v_exp_f32 is 2^x), 0x3c23d70a = 0.01, 0x401ccccd = 2.45.
float inv_tm(float s) {
    float y = clamp(uintBitsToFloat(0x401ccccdu) * s, 1e-4, 8.0);
    float u = y * uintBitsToFloat(0x4031c71cu);     // /0.36
    u = u * uintBitsToFloat(0x40549a78u);           // *log2(10) -> 2^u
    return (exp2(u) - 1.0) * uintBitsToFloat(0x3c23d70au);
}

// One 10-bit R10G10B10 field (ch = 0,1,2) of a packed history word, /1023.
float r10(uint w, int ch) {
    return float((w >> uint(10 * ch)) & 1023u) * (1.0 / 1023.0);
}

// One axis of the history sample position (model _snap): pos = C/div - 0.5 clamped
// [-2, hmax+2], snapped floor(pos*256 + 0.5)/256 -> (integer tap, fraction).
void snap_taps(float C, int div, int hmax, out int it, out float fr) {
    float pos = clamp(C / float(div) - 0.5, -2.0, float(hmax) + 2.0);
    float s = floor(pos * 256.0 + 0.5) / 256.0;
    it = int(floor(s));
    fr = s - float(it);
}

// Bilinear tap of a history grid (model _hist_sample): tap0 = clip(it, 0, h-1),
// tap1 = clip(max(it, -1) + 1, 0, h-1); the four weight products summed in the model's order.
float bilin_tap(uint t00, uint t01, uint t10, uint t11, int ci, float frx, float fry) {
    float c00 = r10(t00, ci), c01 = r10(t01, ci);
    float c10 = r10(t10, ci), c11 = r10(t11, ci);
    return (1.0 - fry) * (1.0 - frx) * c00
         + (1.0 - fry) * frx * c01
         + fry * (1.0 - frx) * c10
         + fry * frx * c11;
}

// i8 byte -> f32 /127 (the ISA's 0x3c010204=1/127 + 0xc2fe0000=-127 fmac division of E0c02).
float i8dec(uint b) {
    int i = int(b & 0xFFu);
    return float(i >= 128 ? i - 256 : i) * (1.0 / 127.0);
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= W0 || y >= H0) return;

    int idx0 = y * W0 + x;
    float expo = in_expo[0].x;
    float e_prev = in_expo[0].y;              // the history branch divides by the previous expo

    // Symmetric reflect border for rows >= H
    int y_src = (y < H) ? y : (2 * (H - 1) - y);
    int in_idx = y_src * W + x;

    // The previous frame's mv-record at THIS pixel (read before the write below: same thread,
    // same texel, program-ordered). The oracle addresses it per-pixel, not [0,0].
    f16vec4 bev_prev = ((x < W) ? bf6_rw[in_idx] : f16vec4(0.0));

    f16vec4 c = g_col[in_idx];
    out_bec[idx0] = f16vec4(float16_t(float(c.r) * expo), float16_t(float(c.g) * expo), float16_t(float(c.b) * expo), float16_t(0.0));

    if (x < W && y < H) {
        int idx = y * W + x;
        f16vec2 mv = g_mv[idx];
        // E0bf6/E0bfa/E0bfe store the motion in C-grid texels (the history grids' units):
        // mv * (W15/W) - 3.0 where the C-grid is 3x the render grid (verified), 1.5 on the
        // native cell (output == render). A hardcoded 3.0 breaks every native history frame
        // while reset frames stay exact.
        float mvk = float(W15) / float(W);
        f16vec2 mv3 = f16vec2(float16_t(float(mv.x) * mvk), float16_t(float(mv.y) * mvk));
        out_bfa[idx] = mv3;
        out_bfe[idx] = mv3;
        bf6_rw[idx] = f16vec4(mv3.x, mv3.y, mv3.x, mv3.y);
    }

    // Feature encoding for out_be8 in [2][H0][W0][32] layout (model SPEC 3/4)
    float col_r = float(c.r) * expo;
    float col_g = float(c.g) * expo;
    float col_b = float(c.b) * expo;
    float tm_r = 0.36 * (log2(max(1.0 + 100.0 * col_r, 0.0001)) * 0.3010299956639812);
    float tm_g = 0.36 * (log2(max(1.0 + 100.0 * col_g, 0.0001)) * 0.3010299956639812);
    float tm_b = 0.36 * (log2(max(1.0 + 100.0 * col_b, 0.0001)) * 0.3010299956639812);

    vec4 a_val = vec4(0.0), s_val = vec4(0.0);
    if (x < W && y_src < H) {
        RR_FETCH(in_alb, pitch_alb, fmt_alb, x, y_src, a_val)
        RR_FETCH(in_spa, pitch_spa, fmt_spa, x, y_src, s_val)
    }
    float dep_val = (x < W && y_src < H) ? g_dep[in_idx] : 0.0;

    float scr = SC0 * tm_r;                 // SC_TM: SC0 * tm(col_c * expo)
    float scg = SC0 * tm_g;
    float scb = SC0 * tm_b;

    int N = W0 * H0;
    // one dither word for the pixel's sixty-four features (model dq: idx = fc, y, x)
    uint didx = ((fc & 7u) << 8u) | ((uint(y) & 15u) << 4u) | (uint(x) & 15u);
    uint bo = dith_off + 2u * didx;
    uint dw = (uint(dith[bo]) | (uint(dith[bo + 1u]) << 8u)) >> 9u;

    // ---- the 64 stored channels (model build_features) ----
    // E0 COMPACTION (48ch: 35 real + 13 zero pad; 16 always-zero slots dropped):
    // newpos[old] (0xFF = not stored). Kept zeros {11,14,19,30,31,32,33,34,35,
    // 38,39,42,43} land at 35..47; dropped {44,46,47,50,51,53..63} never stored.
    // Layout is [3][H0][W0][16] (was [2][H0][W0][32]); slot is a compile-time
    // literal at every STS site, so the map + guard fold away completely.
    const uint E0CP[64] = uint[64](
        0u, 1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 9u, 10u, 35u, 11u, 12u, 36u, 13u,
        14u, 15u, 16u, 37u, 17u, 18u, 19u, 20u, 21u, 22u, 23u, 24u, 25u, 26u,
        38u, 39u, 40u, 41u, 42u, 43u, 27u, 28u, 44u, 45u, 29u, 30u, 46u, 47u,
        0xFFu, 31u, 0xFFu, 0xFFu, 32u, 33u, 0xFFu, 0xFFu, 34u, 0xFFu, 0xFFu, 0xFFu,
        0xFFu, 0xFFu, 0xFFu, 0xFFu, 0xFFu, 0xFFu, 0xFFu, 0xFFu);
    // PERF (rr pass 4): this used to build float feat[64] and run dq() over it - 64 quantizers a
    // pixel, 1.62 of the kernel's 1.69 ms (probe: the loop gone = 0.065 ms). Three
    // value-preserving changes, checked byte-for-byte against the old shader on the fixture:
    //  * dq(+0.0, ANY dither word) is 0x00 identically (E = 0 puts the dither word in the
    //    subnormal mantissa, the 3-bit truncation zeroes it), so the 29 unmapped slots store a
    //    literal 0 with no quantizer; dq(-0.0) = 0x80 except where dw == 0 (the model's d==0
    //    cell, where -0 - (-0) turns +0), hence the select;
    //  * each DISTINCT value is quantized once and stored to its slot group - 22 quantizers on a
    //    history frame instead of 64 (the 15 SC_TM + 8 NEG0 stores of the reset frame are skipped
    //    on history frames, where the block below overwrites every one of those slots);
    //  * the store is NR_OPERAND(tc) = the hardware e4m3 conversion (v_cvt_pk_fp8_f32, RNE, on a
    //    value dqt already clamps to +-448) instead of software q8r - q8r was written to match
    //    exactly that op ("hardware v_cvt_pk_fp8_f32 is even there") and sr_enc0's STFEAT ships
    //    the same substitution.
    // PERF (rr pass 6): per-DWORD - each output dword's quantizers are computed immediately before
    // its four adjacent byte stores (one buffer_store_b32), so value->store distance is minimal
    // and each write overlaps the next dword's quantizers. One dqt per distinct value still (every
    // value maps into exactly one dword); two uniform sequences, one per frame type.
    #define STS(slot, v) { uint _np = E0CP[slot]; if (_np != 0xFFu) out_be8[int((_np >> 4u) * uint(N) * 16u + uint(idx0) * 16u + (_np & 15u))] = NR_OPERAND(v); }

    if (rst != 0u) {
        // reset frame: SC_TM takes SC0*tm(col); NEG0 slots are -0.0 (0x80, 0x00 on the d==0 cell)
        float e0 = dqt(scr, dw), e1 = dqt(scg, dw), e2 = dqt(scb, dw);
        float n0 = (dw == 0u) ? 0.0 : -0.0;
        float c0 = dqt(tm_r, dw); float c1 = dqt(tm_g, dw); float c2 = dqt(a_val.g, dw); float c3 = dqt(a_val.b, dw); STS(0, c0); STS(1, c1); STS(2, c2); STS(3, c3);
        float c4 = dqt(tm_b, dw); float c6 = dqt(min(s_val.r, 2.0), dw); float c7 = dqt(min(s_val.g, 2.0), dw); STS(4, c4); STS(5, e0); STS(6, c6); STS(7, c7);
        float c10 = dqt(min(s_val.b, 2.0), dw); STS(8, e1); STS(9, e2); STS(10, c10); STS(11, 0.0);
        float c15 = dqt(1.0, dw); STS(12, e0); STS(13, e1); STS(14, 0.0); STS(15, c15);
        float c18 = dqt(min(dep_val, 2.0), dw); STS(16, e2); STS(17, e0); STS(18, c18); STS(19, 0.0);
        STS(20, e1); STS(21, e2); STS(22, n0); STS(23, n0);
        STS(24, e0); STS(25, e1); STS(26, n0); STS(27, n0);
        float c29 = dqt(a_val.r, dw); STS(28, e2); STS(29, c29); STS(30, 0.0); STS(31, 0.0);
        STS(32, 0.0); STS(33, 0.0); STS(34, 0.0); STS(35, 0.0);
        STS(36, 0.0); STS(37, e0); STS(38, 0.0); STS(39, 0.0);
        STS(40, e1); STS(41, e2); STS(42, 0.0); STS(43, 0.0);
        STS(44, 0.0); STS(45, n0); STS(46, 0.0); STS(47, 0.0);
        STS(48, n0); STS(49, n0); STS(50, 0.0); STS(51, 0.0);
        STS(52, n0); STS(53, 0.0); STS(54, 0.0); STS(55, 0.0);
        STS(56, 0.0); STS(57, 0.0); STS(58, 0.0); STS(59, 0.0);
        STS(60, 0.0); STS(61, 0.0); STS(62, 0.0); STS(63, 0.0);
    }

    // History branch (model SPEC 6): gate = rst.  On history frames (rst == 0) the 15 SC_TM
    // slots take SC0*tm(e_cur*h/e_prev) with h = inv_tm(2.45*sample) of the pooled history
    // grids, c36 = -2^-9, and the c22-family takes SC1*bilinear(E0c02/127) (SPEC 6b).
    if (rst == 0u) {
        // Motion-compensated position in the W15xH15 C-grid (model SPEC 6): the render-to-C
        // scale is W15/W (== the oracle's 3.0 at the verified 256x144 / 768x432 geometry).
        // bev is the PREVIOUS frame's mv-record at this pixel (mv*3, per the oracle's addressing).
        int xs = min(x, W - 1);                       // model: xs = min(xx, W - 1)
        float Cx = (float(W15) / float(W)) * ((float(xs) + 0.5) - pjx) + float(bev_prev.x);
        float Cy = (float(H15) / float(H)) * ((float(y_src) + 0.5) - pjy) + float(bev_prev.y);
        bool inb = Cx >= 0.0 && Cx <= float(W15) && Cy >= 0.0 && Cy <= float(H15);

        int wE = (W15 + 1) / 2, hE = (H15 + 1) / 2;   // E0c0e grid (the chain's c0e)
        int wP = (wE + 1) / 2, hP = (hE + 1) / 2;     // E0c12 grid (pooled2 of E0c0e)
        // Both grids share the C position: E0c0e at C/2, E0c12 at C/4 (model _snap: pos =
        // C/div - 0.5, clamp [-2, hmax+2], snap floor(pos*256+0.5)/256).
        int itx0, ity0, itx1, ity1;
        float frx0, fry0, frx1, fry1;
        snap_taps(Cx, 2, wE, itx0, frx0);
        snap_taps(Cy, 2, hE, ity0, fry0);
        snap_taps(Cx, 4, wP, itx1, frx1);
        snap_taps(Cy, 4, hP, ity1, fry1);
        // model _hist_sample's clamped taps (tap1 = max(it, -1) + 1).
        int ax0 = clamp(itx0, 0, wE - 1), ax1 = clamp(max(itx0, -1) + 1, 0, wE - 1);
        int ay0 = clamp(ity0, 0, hE - 1), ay1 = clamp(max(ity0, -1) + 1, 0, hE - 1);
        int bx0 = clamp(itx1, 0, wP - 1), bx1 = clamp(max(itx1, -1) + 1, 0, wP - 1);
        int by0 = clamp(ity1, 0, hP - 1), by1 = clamp(max(ity1, -1) + 1, 0, hP - 1);
        uint u00 = g_c0e[uint(ay0) * uint(wE) + uint(ax0)];
        uint u01 = g_c0e[uint(ay0) * uint(wE) + uint(ax1)];
        uint u10 = g_c0e[uint(ay1) * uint(wE) + uint(ax0)];
        uint u11 = g_c0e[uint(ay1) * uint(wE) + uint(ax1)];
        uint v00 = g_c12[uint(by0) * uint(wP) + uint(bx0)];
        uint v01 = g_c12[uint(by0) * uint(wP) + uint(bx1)];
        uint v10 = g_c12[uint(by1) * uint(wP) + uint(bx0)];
        uint v11 = g_c12[uint(by1) * uint(wP) + uint(bx1)];

        float colc[3] = float[3](col_r, col_g, col_b);   // the OOB fallback (col * expo)
        float scE0[3], scE12[3];
        for (int ci = 0; ci < 3; ++ci) {
            float s0 = bilin_tap(u00, u01, u10, u11, ci, frx0, fry0);
            float s1 = bilin_tap(v00, v01, v10, v11, ci, frx1, fry1);
            scE0[ci]  = SC0 * tm32(inb ? expo * (inv_tm(s0) / e_prev) : colc[ci]);
            scE12[ci] = SC0 * tm32(inb ? expo * (inv_tm(s1) / e_prev) : colc[ci]);
        }
        float f0, f1, f2, f3;      // c22-family quantizers (assigned inside the block below)
        // c22-family (model SPEC 6b): SC1 * bilinear(E0c02 ch / 127) at C/3 + pj_prev - 0.5.
        // E0c02 (binding 16, render-grid i8x4) texel offset is the PREVIOUS frame's jitter.
        {
            int itxc, ityc; float frxc, fryc;
            snap_taps(Cx / 3.0 + pjpx, 1, W, itxc, frxc);   // pos = C/3 + pj_prev_x - 0.5
            snap_taps(Cy / 3.0 + pjpy, 1, H, ityc, fryc);
            int cx0 = clamp(itxc, 0, W - 1), cx1 = clamp(max(itxc, -1) + 1, 0, W - 1);
            int cy0 = clamp(ityc, 0, H - 1), cy1 = clamp(max(ityc, -1) + 1, 0, H - 1);
            uint row0 = uint(cy0) * uint(W), row1 = uint(cy1) * uint(W);
            float fam[4];
            for (int ch4 = 0; ch4 < 4; ++ch4) {
                uint b = uint(ch4);
                float c00 = i8dec(g_c02[(row0 + uint(cx0)) * 4u + b]);
                float c01 = i8dec(g_c02[(row0 + uint(cx1)) * 4u + b]);
                float c10 = i8dec(g_c02[(row1 + uint(cx0)) * 4u + b]);
                float c11 = i8dec(g_c02[(row1 + uint(cx1)) * 4u + b]);
                float bil = (1.0 - fryc) * (1.0 - frxc) * c00
                          + (1.0 - fryc) * frxc * c01
                          + fryc * (1.0 - frxc) * c10
                          + fryc * frxc * c11;
                fam[ch4] = SC1 * (inb ? bil : 0.0);
            }
            // c22=c45=ch0, c23=c48=ch1, c26=c49=ch2, c27=c52=ch3 (model SC1_FAM map).
            f0 = dqt(fam[0], dw); f1 = dqt(fam[1], dw);
            f2 = dqt(fam[2], dw); f3 = dqt(fam[3], dw);
        }
        // per-dword sequence: each dword's quantizers right before its four adjacent stores
        float p00, p01, p02, p10, p11, p12, p36;
        float c0 = dqt(tm_r, dw); float c1 = dqt(tm_g, dw); float c2 = dqt(a_val.g, dw); float c3 = dqt(a_val.b, dw); STS(0, c0); STS(1, c1); STS(2, c2); STS(3, c3);
        float c4 = dqt(tm_b, dw); p00 = dqt(scE0[0], dw); float c6 = dqt(min(s_val.r, 2.0), dw); float c7 = dqt(min(s_val.g, 2.0), dw); STS(4, c4); STS(5, p00); STS(6, c6); STS(7, c7);
        p01 = dqt(scE0[1], dw); p02 = dqt(scE0[2], dw); float c10 = dqt(min(s_val.b, 2.0), dw); STS(8, p01); STS(9, p02); STS(10, c10); STS(11, 0.0);
        float c15 = dqt(1.0, dw); STS(12, p00); STS(13, p01); STS(14, 0.0); STS(15, c15);
        p10 = dqt(scE12[0], dw); float c18 = dqt(min(dep_val, 2.0), dw); STS(16, p02); STS(17, p10); STS(18, c18); STS(19, 0.0);
        p11 = dqt(scE12[1], dw); p12 = dqt(scE12[2], dw); STS(20, p11); STS(21, p12); STS(22, f0); STS(23, f1);
        STS(24, p00); STS(25, p01); STS(26, f2); STS(27, f3);
        float c29 = dqt(a_val.r, dw); STS(28, p02); STS(29, c29); STS(30, 0.0); STS(31, 0.0);
        STS(32, 0.0); STS(33, 0.0); STS(34, 0.0); STS(35, 0.0);
        p36 = dqt(-0.001953125, dw); STS(36, p36); STS(37, p00); STS(38, 0.0); STS(39, 0.0);
        STS(40, p01); STS(41, p02); STS(42, 0.0); STS(43, 0.0);
        STS(44, 0.0); STS(45, f0); STS(46, 0.0); STS(47, 0.0);
        STS(48, f1); STS(49, f2); STS(50, 0.0); STS(51, 0.0);
        STS(52, f3); STS(53, 0.0); STS(54, 0.0); STS(55, 0.0);
        STS(56, 0.0); STS(57, 0.0); STS(58, 0.0); STS(59, 0.0);
        STS(60, 0.0); STS(61, 0.0); STS(62, 0.0); STS(63, 0.0);

    }


