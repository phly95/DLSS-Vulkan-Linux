#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable

// k_enc0_feat (RR preset F, oracle launches 3/4): the producer of E0be8, the [2][H0][W0][32] fp8
// feature tensor.  SPEC: tools/rr/rr_enc0feat_model.py (frame0 100.0000% bit-exact vs the oracle;
// this port follows its sections 2-4):
//   * every stored channel goes through dq(), the dithered e4m3 quantizer (dither table =
//     wbuf[0:4096] as u16[2048] = blob0's meta[20] region, binding 13; fc = E[0x19] & 7 ring),
//   * c02 = alb.g / c29 = alb.r (the F3 port had them swapped),
//   * the 15 SC_TM slots hold SC0*tm(col_c*expo) (the F3 port wrote mv*3 there),
//   * zeros / -0 / 1.0 / dep / spa all through dq() (the dither flips {18,19}, {56,57}, {48,49}
//     and the single d==0 cell of each dither row turns dq(-0.0) into 0x00).
//   * HISTORY BRANCH (model SPEC 6, the frame1-verified half of OPEN1): gated by rst (+0x14);
//     on history frames (rst == 0) the 15 SC_TM slots take SC0*tm(e_cur*h/e_prev) with
//     h = inv_tm(2.45*sample) of the pooled history - E0c0e (384x216, binding 14) at C/2 for
//     12 slots, E0c12 (192x108, binding 15) at C/4 for c17/c20/c21 - at the motion-compensated
//     position C = (W15/W)*((coord+0.5) - pj) + bev with pj = the pushed jitter (E0Args
//     +0x1a0/+0x1a4) and bev = the previous frame's mv-record [0,0] (pushed from bf6);
//     OOB lanes fall back to col*expo; c36 = -2^-9 (VERIFIED on the oracle's frame1; on the
//     other chain frames the oracle's c36 is a per-frame value this port cannot know -
//     build/agents/e0be8-port-fix/progress.md Step 5 - reported, not invented).
//     The c22-family {22,23,26,27,45,48,49,52} stays dq(-0.0) on history frames too: the model
//     (OPEN1) has its = SC1*v1 value chain not yet decoded, so it is left at the model's
//     current behavior rather than invented here.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol   { f16vec4 g_col[]; };
layout(set = 0, binding = 1) readonly buffer InMv    { f16vec2 g_mv[]; };
layout(set = 0, binding = 2) readonly buffer InDep   { float g_dep[]; };
layout(set = 0, binding = 3) readonly buffer InNrm   { f16vec4 g_nrm[]; };
layout(set = 0, binding = 4) readonly buffer InAlb   { vec4 g_alb[]; };
layout(set = 0, binding = 5) readonly buffer InSpa   { vec4 g_spa[]; };
layout(set = 0, binding = 6) readonly buffer InRgh   { float g_rgh[]; };
layout(set = 0, binding = 7) readonly buffer InExpo  { vec4 in_expo[]; };

layout(set = 0, binding = 8) writeonly buffer OutBe8 { uint8_t out_be8[]; };
layout(set = 0, binding = 9) writeonly buffer OutBec { f16vec4 out_bec[]; };
layout(set = 0, binding = 10) writeonly buffer OutBf6 { f16vec4 out_bf6[]; };
layout(set = 0, binding = 11) writeonly buffer OutBfa { f16vec2 out_bfa[]; };
layout(set = 0, binding = 12) writeonly buffer OutBfe { f16vec2 out_bfe[]; };
// dq()'s dither table (oracle E0Args +0x198 wbuf = blob0 + meta[20] = blob0 + 37984; u16[2048]).
layout(set = 0, binding = 13) readonly buffer InDither { uint8_t dith[]; };
// History (model SPEC 6): the pooled tone-history grids, u32 R10G10B10 words.
// binding 14 = E0c0e ((W15+1)/2 x (H15+1)/2, the chain's c0e written by k_post each frame),
// binding 15 = E0c12 (one pooling level below, re-pooled from E0c0e by k_pooled2 each
// non-reset frame).  At the enc0_feat dispatch both hold the PREVIOUS frame's state.
layout(set = 0, binding = 14) readonly buffer InC0e { uint g_c0e[]; };
layout(set = 0, binding = 15) readonly buffer InC12 { uint g_c12[]; };

layout(push_constant) uniform RrE0Args {
    int W0;               // +0x00 (oracle E0Args +0x00: W0, H0)
    int H0;
    int W;                // +0x08 (render W, H)
    int H;
    uint fc;              // +0x10 E0Args +0x10 = E[0x19] & 7: the dq() dither row
    uint rst;             // +0x14 E0Args +0x14: history gate (rst != 0 skips the history branch)
    uint dith_off;        // +0x18 byte offset of the dither table inside binding 13
    float SC0;            // +0x1c E0Args +0x200: the blob's f16 scalar (params.json enc0_s2598)
    float pjx;            // +0x20 E0Args +0x1a0: this frame's subpixel jitter (history position)
    float pjy;            // +0x24 E0Args +0x1a4
    float bev_x;          // +0x28 E0Args +0x160 bev_prev: the PREVIOUS frame's mv-record [0,0].xy
    float bev_y;          // +0x2c (the port's bf6 at dispatch time; constant global motion mv*3)
    int W15;              // +0x30 the history C-grid (oracle E: 768x432 = 3x render); E0c0e is
    int H15;              // +0x34 ((W15+1)/2) x ((H15+1)/2) words, E0c12 one level below
};

// ---------------------------------------------------------------- helpers

// f16 rounding with a signbit test (RADV folds float16_t casts - shaders/include/rh.glsl's law;
// signbit instead of (x < 0.0) because GLSL (-0.0 < 0.0) is false and dq(-0.0) must keep -0
// through its round trips).
float rh_s(float x) {
    uint b = floatBitsToUint(x);
    uint sgn = b & 0x80000000u;
    float a = abs(x);
    if (a >= 6.103515625e-05) {                      // normal f16 (>= 2^-14): 11 significant bits
        uint ab = b & 0x7fffffffu;
        uint r = (ab + 0xfffu + ((ab >> 13u) & 1u)) & 0xffffe000u;
        return uintBitsToFloat(sgn | r);
    }
    float q = roundEven(a * 16777216.0) * 5.9604644775390625e-08;   // subnormal f16: multiples of 2^-24
    return ((b >> 31u) != 0u) ? -q : q;
}

// f16 bit pattern of a finite f16-representable f32 (after rh_s, so no rounding is left);
// NaN -> 0x7e00, the pattern np.float16(NaN) produces on the feature path.
uint f32_to_f16_bits(float x) {
    uint b = floatBitsToUint(x);
    uint s = (b >> 16u) & 0x8000u;
    float a = abs(x);
    if (a != a) return 0x7E00u;
    if (a >= 6.103515625e-05) {                      // normal f16
        uint e32 = (b >> 23u) & 0xffu;
        uint m = b & 0x7fffffu;
        return s | ((e32 - 112u) << 10u) | (m >> 13u);
    }
    if (a == 0.0) return s;
    return s | uint(a * 16777216.0);                 // subnormal f16: multiples of 2^-24
}

// f16 bits -> f32, exact (subnormals, +-inf, NaN).
float f16_bits_to_f32(uint h) {
    uint s = (h & 0x8000u) << 16u;
    uint e = (h >> 10u) & 31u;
    uint m = h & 0x3FFu;
    if (e == 0u) {
        float v = float(m) * 5.9604644775390625e-08;
        return ((h & 0x8000u) != 0u) ? -v : v;
    }
    if (e == 31u) return uintBitsToFloat(s | 0x7F800000u | (m << 13u));
    return uintBitsToFloat(s | ((e + 112u) << 23u) | (m << 13u));
}

// The model's q8r (tools/rr/rr_enc0feat_model.py): f32 -> e4m3, RNE saturating at 448; signbit so
// -0.0 -> 0x80; the subnormal grid is RNE (ties-to-even) - the dq() 3-bit truncation grid lands
// |t| exactly on (n+0.5)*2^-9 whenever k = 4m+2, and hardware v_cvt_pk_fp8_f32 is even there.
uint q8r(float x) {
    uint sign = ((floatBitsToUint(x) >> 31u) != 0u) ? 0x80u : 0u;
    float a = min(abs(x), 448.0);
    uint bits = floatBitsToUint(a);
    if (a < 0.015625) {
        float s512 = a * 512.0;
        float nf = floor(s512);
        uint n = uint(nf);
        float d = s512 - nf;
        uint sub = ((d > 0.5) || (d == 0.5 && ((n & 1u) != 0u))) ? n + 1u : n;
        return sign | sub;
    }
    uint norm = (bits + 0x407ffffu + ((bits >> 20u) & 1u)) >> 20u;
    return sign | (norm & 0x7fu);
}

// dq(x): the feature quantizer (model SPEC 2, same law as sr_enc0.comp's dq): x16 = f16(min(x,
// 1024)) with NaN -> 0, dither d = dith[idx] >> 9 folded into the f16 exponent field, two f16
// round trips, the three high mantissa bits kept (3-bit truncation), clip, q8r.  idx indexes the
// GRID coordinates (fc&7 row, y&15, x&15).
uint dq(float x, uint xi, uint yi) {
    float x16 = rh_s(isnan(x) ? 0.0 : min(x, 1024.0));
    uint h = f32_to_f16_bits(x16);
    uint idx = ((fc & 7u) << 8u) | ((yi & 15u) << 4u) | (xi & 15u);
    uint bo = dith_off + 2u * idx;
    uint d = (uint(dith[bo]) | (uint(dith[bo + 1u]) << 8u)) >> 9u;
    uint E = h & 0xFC00u;
    float K = f16_bits_to_f32(E | d);
    float a = rh_s(x16 + K);
    float b = rh_s(a - f16_bits_to_f32(E));
    float t = f16_bits_to_f32(f32_to_f16_bits(b) & 0xFF80u);
    float tc = (t != t) ? t : min(max(t, -448.0), 448.0);
    return q8r(tc);
}

// tm(v) (model SPEC 4/6): 0.36*log10(max(1+100v, 1e-4)) in f32, NaN/inf/negative -> 0,
// clamp <= 1024.  The col path's inline expression was bit-identical to this (same op order).
float tm32(float v) {
    float t = max(1.0 + 100.0 * v, 0.0001);
    float r = 0.36 * (log2(t) * 0.3010299956639812);
    if (!(r >= 0.0)) r = 0.0;                       // model: isfinite(r) & r >= 0 else 0
    return min(r, 1024.0);
}

// inv_tm (model SPEC 6): undo the history's *2.45 tm round-trip: (10^(y/0.36) - 1)/100 with
// y = clamp(2.45*s, 1e-4, 8).  Constants are the ISA's exact words: 0x4031c71c = 1/0.36,
// 0x40549a78 = log2(10) (v_exp_f32 is 2^x), 0x3c23d70a = 0.01, 0x401ccccd = 2.45.
float inv_tm(float s) {
    float y = clamp(uintBitsToFloat(0x401ccccdu) * s, 1e-4, 8.0);
    float u = y * uintBitsToFloat(0x4031c71cu);     // /0.36
    u = u * uintBitsToFloat(0x40549a78u);           // *log2(10) -> 2^u
    return (exp2(u) - 1.0) * uintBitsToFloat(0x3c23d70au);
}

// One 10-bit R10G10B10 field (ch = 0,1,2) of a packed history word, /1023.
float r10(uint w, int ch) {
    return float((w >> uint(10 * ch)) & 1023u) * (1.0 / 1023.0);
}

// One axis of the history sample position (model _snap): pos = C/div - 0.5 clamped
// [-2, hmax+2], snapped floor(pos*256 + 0.5)/256 -> (integer tap, fraction).
void snap_taps(float C, int div, int hmax, out int it, out float fr) {
    float pos = clamp(C / float(div) - 0.5, -2.0, float(hmax) + 2.0);
    float s = floor(pos * 256.0 + 0.5) / 256.0;
    it = int(floor(s));
    fr = s - float(it);
}

// Bilinear tap of a history grid (model _hist_sample): tap0 = clip(it, 0, h-1),
// tap1 = clip(max(it, -1) + 1, 0, h-1); the four weight products summed in the model's order.
float bilin_tap(uint t00, uint t01, uint t10, uint t11, int ci, float frx, float fry) {
    float c00 = r10(t00, ci), c01 = r10(t01, ci);
    float c10 = r10(t10, ci), c11 = r10(t11, ci);
    return (1.0 - fry) * (1.0 - frx) * c00
         + (1.0 - fry) * frx * c01
         + fry * (1.0 - frx) * c10
         + fry * frx * c11;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= W0 || y >= H0) return;

    int idx0 = y * W0 + x;
    float expo = in_expo[0].x;
    float e_prev = in_expo[0].y;              // the history branch divides by the previous expo

    // Symmetric reflect border for rows >= H
    int y_src = (y < H) ? y : (2 * (H - 1) - y);
    int in_idx = y_src * W + x;

    f16vec4 c = g_col[in_idx];
    out_bec[idx0] = f16vec4(float16_t(float(c.r) * expo), float16_t(float(c.g) * expo), float16_t(float(c.b) * expo), float16_t(0.0));

    if (x < W && y < H) {
        int idx = y * W + x;
        f16vec2 mv = g_mv[idx];
        f16vec2 mv3 = f16vec2(float16_t(float(mv.x) * 3.0), float16_t(float(mv.y) * 3.0));
        out_bfa[idx] = mv3;
        out_bfe[idx] = mv3;
        out_bf6[idx] = f16vec4(mv3.x, mv3.y, mv3.x, mv3.y);
    }

    // Feature encoding for out_be8 in [2][H0][W0][32] layout (model SPEC 3/4)
    float col_r = float(c.r) * expo;
    float col_g = float(c.g) * expo;
    float col_b = float(c.b) * expo;
    float tm_r = 0.36 * (log2(max(1.0 + 100.0 * col_r, 0.0001)) * 0.3010299956639812);
    float tm_g = 0.36 * (log2(max(1.0 + 100.0 * col_g, 0.0001)) * 0.3010299956639812);
    float tm_b = 0.36 * (log2(max(1.0 + 100.0 * col_b, 0.0001)) * 0.3010299956639812);

    vec4 a_val = (x < W && y_src < H) ? g_alb[in_idx] : vec4(0.0);
    vec4 s_val = (x < W && y_src < H) ? g_spa[in_idx] : vec4(0.0);
    float dep_val = (x < W && y_src < H) ? g_dep[in_idx] : 0.0;

    float scr = SC0 * tm_r;                 // SC_TM: SC0 * tm(col_c * expo)
    float scg = SC0 * tm_g;
    float scb = SC0 * tm_b;

    // The 64 stored channels (model build_features); unmapped slots stay +0.0.
    float feat[64];
    for (int i = 0; i < 64; ++i) feat[i] = 0.0;
    feat[0] = tm_r; feat[1] = tm_g; feat[4] = tm_b;                    // TM_COL
    feat[2] = a_val.g; feat[3] = a_val.b; feat[29] = a_val.r;          // ALB
    feat[5] = scr;  feat[12] = scr;  feat[17] = scr;  feat[24] = scr;  feat[37] = scr;
    feat[8] = scg;  feat[13] = scg;  feat[20] = scg;  feat[25] = scg;  feat[40] = scg;
    feat[9] = scb;  feat[16] = scb;  feat[21] = scb;  feat[28] = scb;  feat[41] = scb;
    feat[6] = min(s_val.r, 2.0); feat[7] = min(s_val.g, 2.0); feat[10] = min(s_val.b, 2.0);
    feat[15] = 1.0;                                   // min(2, const 1.0)
    feat[18] = min(dep_val, 2.0);                     // min(2, dep)
    feat[22] = -0.0; feat[23] = -0.0; feat[26] = -0.0; feat[27] = -0.0;   // NEG0 -> dq(-0.0)
    feat[45] = -0.0; feat[48] = -0.0; feat[49] = -0.0; feat[52] = -0.0;

    // History branch (model SPEC 6): gate = rst.  On history frames (rst == 0) the 15 SC_TM
    // slots take SC0*tm(e_cur*h/e_prev) with h = inv_tm(2.45*sample) of the pooled history
    // grids, and c36 = -2^-9 (the model's frame1-verified values; the c22-family stays above
    // at dq(-0.0) - its SC1*v1 chain is still OPEN1 in the model and is not invented here).
    if (rst == 0u) {
        // Motion-compensated position in the W15xH15 C-grid (model SPEC 6): the render-to-C
        // scale is W15/W (== the oracle's 3.0 at the verified 256x144 / 768x432 geometry).
        int xs = min(x, W - 1);                       // model: xs = min(xx, W - 1)
        float Cx = (float(W15) / float(W)) * ((float(xs) + 0.5) - pjx) + bev_x;
        float Cy = (float(H15) / float(H)) * ((float(y_src) + 0.5) - pjy) + bev_y;
        bool inb = Cx >= 0.0 && Cx <= float(W15) && Cy >= 0.0 && Cy <= float(H15);

        int wE = (W15 + 1) / 2, hE = (H15 + 1) / 2;   // E0c0e grid (the chain's c0e)
        int wP = (wE + 1) / 2, hP = (hE + 1) / 2;     // E0c12 grid (pooled2 of E0c0e)
        // Both grids share the C position: E0c0e at C/2, E0c12 at C/4 (model _snap: pos =
        // C/div - 0.5, clamp [-2, hmax+2], snap floor(pos*256+0.5)/256).
        int itx0, ity0, itx1, ity1;
        float frx0, fry0, frx1, fry1;
        snap_taps(Cx, 2, wE, itx0, frx0);
        snap_taps(Cy, 2, hE, ity0, fry0);
        snap_taps(Cx, 4, wP, itx1, frx1);
        snap_taps(Cy, 4, hP, ity1, fry1);
        // model _hist_sample's clamped taps (tap1 = max(it, -1) + 1).
        int ax0 = clamp(itx0, 0, wE - 1), ax1 = clamp(max(itx0, -1) + 1, 0, wE - 1);
        int ay0 = clamp(ity0, 0, hE - 1), ay1 = clamp(max(ity0, -1) + 1, 0, hE - 1);
        int bx0 = clamp(itx1, 0, wP - 1), bx1 = clamp(max(itx1, -1) + 1, 0, wP - 1);
        int by0 = clamp(ity1, 0, hP - 1), by1 = clamp(max(ity1, -1) + 1, 0, hP - 1);
        uint u00 = g_c0e[uint(ay0) * uint(wE) + uint(ax0)];
        uint u01 = g_c0e[uint(ay0) * uint(wE) + uint(ax1)];
        uint u10 = g_c0e[uint(ay1) * uint(wE) + uint(ax0)];
        uint u11 = g_c0e[uint(ay1) * uint(wE) + uint(ax1)];
        uint v00 = g_c12[uint(by0) * uint(wP) + uint(bx0)];
        uint v01 = g_c12[uint(by0) * uint(wP) + uint(bx1)];
        uint v10 = g_c12[uint(by1) * uint(wP) + uint(bx0)];
        uint v11 = g_c12[uint(by1) * uint(wP) + uint(bx1)];

        float colc[3] = float[3](col_r, col_g, col_b);   // the OOB fallback (col * expo)
        float scE0[3], scE12[3];
        for (int ci = 0; ci < 3; ++ci) {
            float s0 = bilin_tap(u00, u01, u10, u11, ci, frx0, fry0);
            float s1 = bilin_tap(v00, v01, v10, v11, ci, frx1, fry1);
            scE0[ci]  = SC0 * tm32(inb ? expo * (inv_tm(s0) / e_prev) : colc[ci]);
            scE12[ci] = SC0 * tm32(inb ? expo * (inv_tm(s1) / e_prev) : colc[ci]);
        }
        // The 15 SC_TM slots (model SC_TM map): 12 from E0c0e, c17/c20/c21 from E0c12.
        feat[5] = scE0[0];  feat[12] = scE0[0];  feat[24] = scE0[0];  feat[37] = scE0[0];
        feat[17] = scE12[0];
        feat[8] = scE0[1];  feat[13] = scE0[1];  feat[25] = scE0[1];  feat[40] = scE0[1];
        feat[20] = scE12[1];
        feat[9] = scE0[2];  feat[16] = scE0[2];  feat[28] = scE0[2];  feat[41] = scE0[2];
        feat[21] = scE12[2];
        feat[36] = -0.001953125;               // c36 = s1 = -2^-9 (VERIFIED on oracle frame1)
    }

    int N = W0 * H0;
    int base0 = idx0 * 32;
    int base1 = N * 32 + idx0 * 32;
    for (int i = 0; i < 64; ++i) {
        uint b = dq(feat[i], uint(x), uint(y));
        out_be8[((i < 32) ? base0 : base1) + (i & 31)] = uint8_t(b);
    }
}
