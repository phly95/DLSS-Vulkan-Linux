#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Accumulator { uint64_t accumulator; };
layout(set = 0, binding = 1) readonly buffer PreviousAE { float16_t previous_ae; };
layout(set = 0, binding = 2) writeonly buffer NextAE { float16_t next_ae; };
layout(set = 0, binding = 3) writeonly buffer Exposure { vec4 exposure; };

layout(push_constant) uniform RrAEArgs {
    layout(offset = 24) float scale;
    layout(offset = 28) uint reset;
};

void main() {
    // E0cee is a 32.32 luma accumulator. On reset, the ISA converts it to
    // the target exposure, rounds the half state downward, and clears it.
    // The non-reset temporal adaptation is still being decoded; this target
    // exposure path is kept explicit so reset-frame oracle comparisons are
    // meaningful rather than reading the accumulator as float partials.
    float mean_luma = max(float(accumulator) * scale, 0.005);
    float target = 0.235470891 / mean_luma;

    uint half_bits = packHalf2x16(vec2(target, 0.0)) & 0xffffu;
    float half_value = unpackHalf2x16(half_bits).x;
    if (half_value > target && half_bits > 0u) {
        half_value = unpackHalf2x16(half_bits - 1u).x;
    }

    float prev = float(previous_ae);
    // First non-reset adaptation hypothesis: move seven eighths of the way
    // from the previous state to the current target, then quantize to f16.
    float updated = reset != 0u ? half_value : fma(half_value - prev, 0.875, prev);
    next_ae = float16_t(updated);
    exposure = vec4(half_value, prev, 1.0 / half_value, reset != 0u ? 0.0 : (updated - prev) / prev);
    accumulator = uint64_t(0);
}
