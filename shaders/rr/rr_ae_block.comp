#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_atomic_int64 : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InCol    { f16vec4 in_col[]; };
layout(set = 0, binding = 1) buffer OutAccumulator    { uint64_t accumulator; };

layout(push_constant) uniform RrAEArgs {
    layout(offset = 8) int W;
    int H;
};

shared float s_luma[256];

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    uint tid = gl_LocalInvocationIndex;

    float luma = 0.0;
    if (x < W && y < H) {
        f16vec4 c = in_col[y * W + x];
        luma = clamp(float(0.25 * c.r + 0.5 * c.g + 0.25 * c.b), 0.0, 10000.0);
    }
    s_luma[tid] = luma;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            s_luma[tid] += s_luma[tid + s];
        }
        barrier();
    }

    if (tid == 0u) {
        // NeuralHub accumulates per-block luma as unsigned 32.32 fixed point.
        // Its ISA uses RNE after multiplying by 2^32 / 10000.
        float scaled = roundEven(s_luma[0] * 429496.71875);
        atomicAdd(accumulator, uint64_t(scaled));
    }
}
