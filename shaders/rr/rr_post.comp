#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_control_flow_attributes : enable

// rr_post.comp: NeuralHub's rrio::k_post<24> (oracle launches 21 = frame 0, rst, and 22 = frame 1
// of rr_F), rewritten against tools/rr/rr_post_model.py - SPEC sections 1-6g of that model's
// docstring are the target, every constant below is an immediate of the ISA or of PostArgs, and
// every f16 rounding point goes through rh() (shaders/include/rh.glsl).
//
// Thread layout (the oracle's own grid, [48,14,1] at 16x16): thread (tx, ty) of group (gx, gy)
// owns output column x15 = 16*gx + tx and the PAIR r = 16*gy + ty, i.e. output rows 2r and 2r+1.
// Both rows share the source rows of the even row (Yb = Y0(2r)) and the tap records, so the 4x4
// footprint is loaded once and evaluated for both lanes. The 2x2 block of E0c0e for columns
// 2c, 2c+1 lives in lanes tx, tx+1 of the same group: shared memory (rows summed first, then the
// columns, then *0.25 - the model's order).
//
// PostArgs (0xb8 bytes, NeuralHub's own field offsets, tools/rr/rrref/rrref.cpp:533-547): the push
// block is PostArgs at those offsets, so an oracle launch's args hex passes verbatim.
// Read here: 0x00 W, 0x04 H, 0x08 W15, 0x0c H15, 0x10 rst, 0x14/0x18 scale, 0x1c/0x20 jitter,
// 0x34 dec0 (the packer's third dec0 scalar, exp(f16 table 0x1840); 1.126047134399414 on both
// dumped frames). Not read: 0x24..0x33 (reciprocals), 0x38 (texture pitch), 0x3c and the pointers
// 0x40..0xb4 (they are the bindings).
//
// Bindings follow the oracle's pointer slots exactly (launches.jsonl of the dump):
//   0 E0cf2 taps (16 f16 per render pixel), 1 E0c22 exposure (e0, e1), 2 E0c1a factors,
//   3 E0bf6|E0bf2 mv record (0x58, the parity-selected slot; the port's bf6 is both), 4 E0bfa (0x60),
//   5 E0bfe (0x68), 6 the previous history read through the 0x80 texture (E0c06/E0c0a),
//   7 E0d02 (513 x 4 f32 Catmull-Rom table), 8 the history WRITE (E0c0a/E0c06), 9 E0cf6,
//   10 E0cfa, 11 E0c0e.
// Bindings 2, 4 and 5 are bound but NOT read: the model records E0c1a as a no-op on these frames
// (its fits are 100%/99.94% without it), and it takes the mv from the 0x58 record only - the ISA's
// 2nd-MV-candidate block (0x1d2c) never fires because all four candidate buffers hold the same
// constant in the oracle's frames 0/1.
//
// The off-screen CR fallback of SPEC 6a is NOT modelled: cr_history() raises if it would fire and
// the oracle's mv is sub-texel, so it never fires. This shader computes the in-range path for
// every pixel; the bilinear taps clamp to the texture edge, which keeps the out-of-range case
// defined instead of inventing a fallback the spec does not describe.

#include "rh.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InTap      { f16vec4 in_tap[]; };
layout(set = 0, binding = 1) readonly buffer InExpo     { float expo[]; };
layout(set = 0, binding = 2) readonly buffer InFactors  { uint in_factors[]; };
layout(set = 0, binding = 3) readonly buffer InMv       { f16vec4 in_mv[]; };
layout(set = 0, binding = 4) readonly buffer InMv2      { f16vec2 in_mv2[]; };
layout(set = 0, binding = 5) readonly buffer InMv3      { f16vec2 in_mv3[]; };
layout(set = 0, binding = 6) readonly buffer InHist     { f16vec4 in_hist[]; };
layout(set = 0, binding = 7) readonly buffer InCrTab    { float cr_tab[]; };
layout(set = 0, binding = 8) writeonly buffer OutHist   { f16vec4 out_hist[]; };
layout(set = 0, binding = 9) writeonly buffer OutRG     { f16vec2 out_rg[]; };
layout(set = 0, binding = 10) writeonly buffer OutB     { float16_t out_b[]; };
layout(set = 0, binding = 11) writeonly buffer OutPacked{ uint out_packed[]; };

layout(push_constant) uniform PostArgs {
    layout(offset = 0x00) int W;
    int H;
    layout(offset = 0x08) int W15;
    int H15;
    layout(offset = 0x10) int rst;
    layout(offset = 0x14) float scaleX;
    float scaleY;
    layout(offset = 0x1c) float jitterX;
    float jitterY;
    layout(offset = 0x34) float dec0;
};

// f32 constants of the spec as their bit patterns (macros: glslang rejects uintBitsToFloat in a
// global const). Each one is an immediate of the ISA (rr_post_model.py SPEC "constants").
#define C_LOG10_2   uintBitsToFloat(0x3E9A209Bu)   // log10(2)
#define C_TM        uintBitsToFloat(0x3EB851ECu)   // 0.36
#define C_K         uintBitsToFloat(0x3ED0FAC6u)   // 1 / 2.45
#define C_FLOOR     uintBitsToFloat(0x38D1B717u)   // 1e-4
#define C_PT01      uintBitsToFloat(0x3C23D70Au)   // 0.01
#define C_I036      uintBitsToFloat(0x4031C71Cu)   // 1 / 0.36
#define C_L210      uintBitsToFloat(0x40549A78u)   // log2(10)
#define C_HUNDRED   uintBitsToFloat(0x42C80000u)   // 100

shared vec3 s_pair[16][16];

// IEEE-style f32 division a / b, as the hardware's v_div_scale / v_rcp / v_fma / v_div_fmas /
// v_div_fixup sequence computes it (the model's divisions are correctly rounded numpy f32
// divisions; a plain `a / b` compiles to v_rcp_f32 + a multiply, one ULP short - sr_post.comp has
// the same helper and the same reason).
float fdiv_ieee(float a, float b) {
    precise float r = 1.0 / b;
    precise float e0 = fma(-b, r, 1.0);
    precise float r1 = fma(r, e0, r);
    precise float q0 = a * r1;
    precise float e1 = fma(-b, q0, a);
    precise float q1 = fma(e1, r1, q0);
    precise float e2 = fma(-b, q1, a);
    return fma(e2, r1, q1);
}

// SPEC 3: q = f16( f16( f16(f16(dy*dy)*B) + f16(f16(dx*dx)*A) ) + f16(f16(dx*dy)*C) )
float quad_q(float dx, float dy, float A, float B, float C) {
    precise float dy2 = rh(rh(dy * dy) * B);
    precise float dx2 = rh(rh(dx * dx) * A);
    precise float cr = rh(rh(dx * dy) * C);
    return rh(rh(dy2 + dx2) + cr);
}

// SPEC 5 / 6d: decode(h) = 0.01 * (exp2(clamp(h, 1e-4, 3) * (1/0.36) * log2(10)) - 1)
vec3 decode_lin(vec3 h) {
    precise vec3 hc = clamp(h, vec3(C_FLOOR), vec3(3.0));
    precise vec3 arg = (hc * C_I036) * C_L210;
    precise vec3 d = exp2(arg) - 1.0;
    return C_PT01 * d;
}

// SPEC 6g (the frame-0 chain too): tm(x) = (log2(max(fma(100, x, 1), 1e-4)) * log10(2)) * 0.36
vec3 tm_lin(vec3 x) {
    precise vec3 y = max(fma(vec3(C_HUNDRED), x, vec3(1.0)), vec3(C_FLOOR));
    precise vec3 lg = log2(y) * C_LOG10_2;
    return lg * C_TM;
}

// SPEC 5: E0c0e = R10 | G10 << 10 | B10 << 20 | 0xc0000000 of rndne(1023 * clamp(k * tm, 0, 1))
uint enc10(vec3 tm) {
    precise vec3 t = clamp(C_K * tm, vec3(0.0), vec3(1.0));
    const uint r = uint(roundEven(1023.0 * t.r));
    const uint g = uint(roundEven(1023.0 * t.g));
    const uint b = uint(roundEven(1023.0 * t.b));
    return r | (g << 10u) | (b << 20u) | 0xc0000000u;
}

// SPEC 6c: one bilinear fetch of the history at texel (xi0, yi0) with sub-texel weights rx, ry;
// clamp-to-edge addressing, texel centres. The arithmetic is the model's f32 expression.
vec3 bil(int xi0, int yi0, float rx, float ry) {
    const int xi = clamp(xi0, 0, W15 - 1);
    const int yi = clamp(yi0, 0, H15 - 1);
    const int x1 = clamp(xi0 + 1, 0, W15 - 1);
    const int y1 = clamp(yi0 + 1, 0, H15 - 1);
    vec3 h00 = vec3(in_hist[uint(yi * W15 + xi)].xyz);
    vec3 h01 = vec3(in_hist[uint(yi * W15 + x1)].xyz);
    vec3 h10 = vec3(in_hist[uint(y1 * W15 + xi)].xyz);
    vec3 h11 = vec3(in_hist[uint(y1 * W15 + x1)].xyz);
    precise vec3 top = h00 * (1.0 - rx) + h01 * rx;
    precise vec3 bot = h10 * (1.0 - rx) + h11 * rx;
    return top * (1.0 - ry) + bot * ry;
}

// SPEC 6a-c: the 5-tap bilinear Catmull-Rom history sample h at pos = (x15 + 0.5 + mvx,
// y15 + 0.5 + mvy). The table index is k = min(512, trunc(fma(512, clamp(f, 0, 1), 0.5))) per
// axis, entry = E0d02[k] = (wm1, a = w0 + w1, w2, r); the bilinear sub-texel fraction is r
// quantised to 8 bits round-to-nearest (the sampler precision measured on sr_post), the -1/+2
// taps are pure texel centres (fraction 0). Weight sum order (((W3 + W1) + W5) + W4) + W2 and the
// fma numerator chain are the ISA's.
vec3 cr_history(float posx, float posy) {
    const int Ix = int(floor(posx - 0.5));
    const int Iy = int(floor(posy - 0.5));
    precise float fx = posx - (float(Ix) + 0.5);
    precise float fy = posy - (float(Iy) + 0.5);
    const int kx = int(min(fma(512.0, clamp(fx, 0.0, 1.0), 0.5), 512.0));
    const int ky = int(min(fma(512.0, clamp(fy, 0.0, 1.0), 0.5), 512.0));
    const uint ex = uint(kx) * 4u;                 // (wm1, a, w2, r) of the x fraction
    const uint ey = uint(ky) * 4u;
    const float rx = roundEven(cr_tab[ex + 3u] * 256.0) / 256.0;
    const float ry = roundEven(cr_tab[ey + 3u] * 256.0) / 256.0;
    const float aX = cr_tab[ex + 1u], aY = cr_tab[ey + 1u];
    precise float W1 = cr_tab[ex + 0u] * aY;       // wm1x * ay
    precise float W2 = cr_tab[ex + 2u] * aY;       // w2x  * ay
    precise float W3 = aX * cr_tab[ey + 0u];       // ax   * wm1y
    precise float W4 = aX * cr_tab[ey + 2u];       // ax   * w2y
    precise float W5 = aX * aY;                    // ax   * ay
    const vec3 t1 = bil(Ix - 1, Iy, 0.0, ry);      // pure texel x-1, blended y
    const vec3 t2 = bil(Ix + 2, Iy, 0.0, ry);      // pure texel x+2, blended y
    const vec3 t3 = bil(Ix, Iy - 1, rx, 0.0);      // blended x, pure texel y-1
    const vec3 t4 = bil(Ix, Iy + 2, rx, 0.0);      // blended x, pure texel y+2
    const vec3 t5 = bil(Ix, Iy, rx, ry);           // the main bilinear
    precise vec3 num = t1 * W1;
    num = fma(t3, vec3(W3), num);
    num = fma(t5, vec3(W5), num);
    num = fma(t4, vec3(W4), num);
    num = fma(t2, vec3(W2), num);
    precise float wcr = (((W3 + W1) + W5) + W4) + W2;
    return vec3(fdiv_ieee(num.x, wcr), fdiv_ieee(num.y, wcr), fdiv_ieee(num.z, wcr));
}

void main() {
    const int tx = int(gl_LocalInvocationID.x);
    const int ty = int(gl_LocalInvocationID.y);
    const int x15 = int(gl_WorkGroupID.x) * 16 + tx;
    const int r = int(gl_WorkGroupID.y) * 16 + ty;
    const int ye = 2 * r;                          // the pair's even output row
    const int yo = ye + 1;
    // No early return: every thread has to reach the shared-memory barrier below.
    const bool valid = (x15 < W15) && (ye < H15) && (yo < H15);

    // ---- SPEC 2: output geometry. px is shared by both rows, py is per row.
    precise float px = fma(float(x15) + 0.5, scaleX, jitterX);
    precise float pye = fma(float(ye) + 0.5, scaleY, jitterY);
    precise float pyo = fma(float(yo) + 0.5, scaleY, jitterY);
    const int X0 = int(floor(px - 0.5));
    const int Y0e = int(floor(pye - 0.5));
    const int Y0o = int(floor(pyo - 0.5));
    const int Yb = Y0e;                            // both rows take the even row's source rows
    precise float dx0 = rh((float(X0) + 0.5) - px);
    precise float dy0 = rh((float(Y0e) + 0.5) - pye);
    precise float dy1o = rh((float(Y0o) + 0.5) - pyo);
    const float dy1 = rh(dy1o - float(Y0o - Yb));  // the odd row shifted onto Yb (shift 0 or 1)

    // ---- SPEC 3 and 4: the 16 taps of the 4 x 4 footprint, kx-major (the ISA's column-major
    // order: kx = -1 with ky = -1..2, then kx = 0, 1, 2). Wsum and the six f16 numerator chains
    // are accumulated in that same order; the tap record is shared by both lanes.
    float wsumE = 0.0;
    float wsumO = 0.0;
    precise vec3 nE = vec3(0.0), nO = vec3(0.0);  // colour, fields 0..2
    precise vec3 gE = vec3(0.0), gO = vec3(0.0);  // gates, fields 3..5 (w0, w1, w2)
    for (int k = 0; k < 16; ++k) {
        const int kx = k / 4 - 1;
        const int ky = k - (k / 4) * 4 - 1;
        const int sxi = clamp(X0 + kx, 0, W - 1);
        const int syi = clamp(Yb + ky, 0, H - 1);
        const uint si = uint(syi * W + sxi);
        const f16vec4 t0 = in_tap[si * 4u + 0u];   // (tm R, tm G, tm B, w0)
        const f16vec4 t1 = in_tap[si * 4u + 1u];   // (w1, w2, A, B)
        const float16_t t2x = in_tap[si * 4u + 2u].x;   // C
        const vec3 col = vec3(t0.x, t0.y, t0.z);
        const vec3 gate = vec3(t0.w, t1.x, t1.y);
        const float A = float(t1.z), B = float(t1.w), C = float(t2x);
        const float ddx = rh(dx0 + float(kx));
        const float de = rh(dy0 + float(ky));
        const float dor = rh(dy1 + float(ky));
        const float we = exp2(quad_q(ddx, de, A, B, C));
        const float wo = exp2(quad_q(ddx, dor, A, B, C));
        wsumE = wsumE + we;
        wsumO = wsumO + wo;
        const float rhe = rh(we), rho = rh(wo);    // SPEC 4: n = f16(n + f16(w) * field)
        nE = rh3(nE + rhe * col);
        nO = rh3(nO + rho * col);
        gE = rh3(gE + rhe * gate);
        gO = rh3(gO + rho * gate);
    }
    const float invE = fdiv_ieee(1.0, wsumE);
    const float invO = fdiv_ieee(1.0, wsumO);

    // ---- SPEC 4: S = f32(n) * inv, then cur = decode(S) (SPEC 5)
    precise vec3 SE = nE * invE;
    precise vec3 SO = nO * invO;
    const vec3 curE = decode_lin(SE);
    const vec3 curO = decode_lin(SO);

    vec3 x1E, x1O, x2E, x2O;
    if (rst != 0) {
        // ---- SPEC 5 (frame 0, rst): no history term - the hardware's CR blocks are skipped and
        // its history endpoint becomes decode(S)/e0, so H = e0 * that = cur and BOTH blends are
        // the identity (checked against the oracle by the model).
        x1E = curE; x1O = curO;
        x2E = curE; x2O = curO;
    } else {
        // ---- SPEC 6a: the mv record of PostArgs 0x58, one record per render pixel (the ISA's
        // index: floor(py) * W + floor(px), each clamped to the render grid).
        const int mvx = clamp(int(floor(px)), 0, W - 1);
        const f16vec4 mvE = in_mv[uint(clamp(int(floor(pye)), 0, H - 1) * W + mvx)];
        const f16vec4 mvO = in_mv[uint(clamp(int(floor(pyo)), 0, H - 1) * W + mvx)];
        // ---- SPEC 6a: pos = (x15 + 0.5 + mvx, y15 + 0.5 + mvy) per output pixel.
        // The on-screen guard of the ISA (0 <= pos <= W15/H15) is the condition of the model's
        // off-screen fallback, which cr_history() raises on and which never fires on the oracle
        // frames - see the header note: the in-range path is computed for every pixel.
        const vec3 hE = cr_history((float(x15) + 0.5) + float(mvE.x),
                                   (float(ye) + 0.5) + float(mvE.y));
        const vec3 hO = cr_history((float(x15) + 0.5) + float(mvO.x),
                                   (float(yo) + 0.5) + float(mvO.y));
        // ---- SPEC 6d: H = e0 * decode(h) / e1 (decode clamps like decode(S))
        const float e0 = expo[0];
        const float e1 = expo[1];
        const vec3 dE = decode_lin(hE);
        const vec3 dO = decode_lin(hO);
        const vec3 HE = e0 * vec3(fdiv_ieee(dE.x, e1), fdiv_ieee(dE.y, e1), fdiv_ieee(dE.z, e1));
        const vec3 HO = e0 * vec3(fdiv_ieee(dO.x, e1), fdiv_ieee(dO.y, e1), fdiv_ieee(dO.z, e1));

        // ---- SPEC 6e: the two blend weights (one t for all three channels of a lane):
        // conf = clamp01((dec0 * Wsum) * (inv * f16(n_w0))), non-finite -> 0;
        // t1 = fma(conf, 1 - u1, u1) with u1 = inv * f16(n_w1) -> history write + E0c0e;
        // t2 = fma(conf, 1 - u2, u2) with u2 = inv * f16(n_w2) -> E0cf6/E0cfa.
        precise float cE0 = dec0 * wsumE, cO0 = dec0 * wsumO;
        precise float cE1 = invE * gE.x, cO1 = invO * gO.x;
        precise float confEr = cE0 * cE1, confOr = cO0 * cO1;
        const float confE = (isnan(confEr) || isinf(confEr)) ? 0.0 : clamp(confEr, 0.0, 1.0);
        const float confO = (isnan(confOr) || isinf(confOr)) ? 0.0 : clamp(confOr, 0.0, 1.0);
        precise float u1E = invE * gE.y, u1O = invO * gO.y;
        precise float u2E = invE * gE.z, u2O = invO * gO.z;
        const float t1E = fma(confE, 1.0 - u1E, u1E);
        const float t1O = fma(confO, 1.0 - u1O, u1O);
        const float t2E = fma(confE, 1.0 - u2E, u2E);
        const float t2O = fma(confO, 1.0 - u2O, u2O);

        // ---- SPEC 6f: x = fma(cur - H, t, H) per channel.
        precise vec3 dltE = curE - HE, dltO = curO - HO;
        x1E = fma(vec3(t1E), dltE, HE);
        x1O = fma(vec3(t1O), dltO, HO);
        x2E = fma(vec3(t2E), dltE, HE);
        x2O = fma(vec3(t2O), dltO, HO);
    }

    // ---- SPEC 5 / 6g: E0cf6 = f16(tm(x2_R)) | f16(tm(x2_G)) << 16, E0cfa = f16(tm(x2_B)),
    // the history write = f16(tm(x1)) with alpha 0 (the t1 blend).
    const vec3 tm2E = tm_lin(x2E), tm2O = tm_lin(x2O);
    const vec3 tm1E = tm_lin(x1E), tm1O = tm_lin(x1O);
    if (valid) {
        const int iE = ye * W15 + x15;
        const int iO = yo * W15 + x15;
        out_rg[iE] = f16vec2(rh(tm2E.x), rh(tm2E.y));
        out_rg[iO] = f16vec2(rh(tm2O.x), rh(tm2O.y));
        out_b[iE] = float16_t(rh(tm2E.z));
        out_b[iO] = float16_t(rh(tm2O.z));
        out_hist[iE] = f16vec4(rh(tm1E.x), rh(tm1E.y), rh(tm1E.z), float16_t(0.0));
        out_hist[iO] = f16vec4(rh(tm1O.x), rh(tm1O.y), rh(tm1O.z), float16_t(0.0));
    }

    // ---- SPEC 5: E0c0e from the 2x2 mean of x1 in the LINEAR domain. Rows first (each thread
    // sums its two rows into shared memory), then the column pair, then * 0.25 - the model's
    // order - then the frame-0 encode chain.
    s_pair[ty][tx] = x1E + x1O;
    memoryBarrierShared();
    barrier();
    if (valid && (tx & 1) == 0 && (x15 + 1) < W15) {
        precise vec3 xm = (s_pair[ty][tx] + s_pair[ty][tx + 1]) * 0.25;
        out_packed[uint(r) * uint((W15 + 1) >> 1) + uint(x15 >> 1)] = enc10(tm_lin(xm));
    }
}
