#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InTap    { f16vec4 in_tap[]; };
layout(set = 0, binding = 1) readonly buffer InExpo   { vec4 in_expo; };
layout(set = 0, binding = 2) writeonly buffer OutRG   { f16vec2 out_rg[]; };
layout(set = 0, binding = 3) writeonly buffer OutB    { float16_t out_b[]; };
layout(set = 0, binding = 4) writeonly buffer OutFull { f16vec4 out_full[]; };
layout(set = 0, binding = 5) writeonly buffer OutPacked { uint out_packed[]; };

layout(push_constant) uniform RrPostArgs {
    layout(offset = 0) int W;
    int H;
    int W15;
    int H15;
    int rst;
    float scaleX;
    float scaleY;
    float jitterX;
    float jitterY;
    float expo_val;
};

uint pack_tonemapped_1010102(float c0, float c1, float c2) {
    const float kLog2_10 = uintBitsToFloat(0x3e9a209bu);
    const float kScale = uintBitsToFloat(0x3eb851ecu) * uintBitsToFloat(0x3ed0fac6u);
    uint r = uint(roundEven(clamp(log2(max(1.0 + 100.0 * c0, 0.0001)) * kLog2_10 * kScale, 0.0, 1.0) * 1023.0));
    uint g = uint(roundEven(clamp(log2(max(1.0 + 100.0 * c1, 0.0001)) * kLog2_10 * kScale, 0.0, 1.0) * 1023.0));
    uint b = uint(roundEven(clamp(log2(max(1.0 + 100.0 * c2, 0.0001)) * kLog2_10 * kScale, 0.0, 1.0) * 1023.0));
    return (r & 1023u) | ((g & 1023u) << 10u) | ((b & 1023u) << 20u) | 0xc0000000u;
}

void main() {
    int x15 = int(gl_GlobalInvocationID.x);
    int targetW = (W15 > 0) ? W15 : W;
    int targetH = (H15 > 0) ? H15 : H;
    if (x15 >= targetW) return;

    int y_step = (gl_NumWorkGroups.y * gl_WorkGroupSize.y <= uint((targetH + 1) / 2 + 15)) ? 2 : 1;
    int y_start = (y_step == 2) ? (int(gl_GlobalInvocationID.y) * 2) : int(gl_GlobalInvocationID.y);
    int y_end = min(y_start + y_step, targetH);

    for (int y15 = y_start; y15 < y_end; ++y15) {
        float sx = (scaleX != 0.0) ? scaleX : (float(W) / float(targetW));
        float sy = (scaleY != 0.0) ? scaleY : (float(H) / float(targetH));

        float s3x = (float(x15) + 0.5) * sx + jitterX;
        float s4y = (float(y15) + 0.5) * sy + jitterY;

        int aniso_x = clamp(int(floor(s3x)), 0, W - 1);
        int aniso_y = clamp(int(floor(s4y)), 0, H - 1);
        int aniso_idx = aniso_y * W + aniso_x;

        float an0 = float(in_tap[aniso_idx * 4 + 1].z);
        float an1 = float(in_tap[aniso_idx * 4 + 1].w);
        float an2 = float(in_tap[aniso_idx * 4 + 2].x);

        int fx = int(floor(s3x - 0.5));
        int fy = int(floor(s4y - 0.5));

        vec3 num = vec3(0.0);
        float den = 0.0;

        for (int dy = 0; dy < 3; ++dy) {
            int in_y = clamp(fy + dy, 0, H - 1);
            float ddy = (float(fy + dy) + 0.5) - s4y;
            for (int dx = 0; dx < 3; ++dx) {
                int in_x = clamp(fx + dx, 0, W - 1);
                float ddx = (float(fx + dx) + 0.5) - s3x;

                float dist = an0 * (ddx * ddx) + an2 * ddx * ddy + an1 * (ddy * ddy);
                float w = exp2(dist);

                vec3 c = vec3(in_tap[(in_y * W + in_x) * 4 + 0].rgb);
                num += w * c;
                den += w;
            }
        }

        vec3 c_filt = num / max(den, 1e-6);

        int idx = y15 * targetW + x15;
        out_rg[idx] = f16vec2(float16_t(c_filt.r), float16_t(c_filt.g));
        out_b[idx] = float16_t(c_filt.b);
        out_full[idx] = f16vec4(f16vec3(c_filt), float16_t(0.0));
        if (((x15 | y15) & 1) == 0) {
            uint packed_idx = uint(y15 >> 1) * uint((targetW + 1) >> 1) + uint(x15 >> 1);
            out_packed[packed_idx] = pack_tonemapped_1010102(c_filt.r, c_filt.g, c_filt.b);
        }
    }
}
