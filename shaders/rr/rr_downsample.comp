#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable

// rr_downsample (RR launch 22, k_downsample): E0cf6/E0cfa (the rr_post pair output) -> the final
// output image, a 5x5 separable FIR at 2/3 of the output pitch, firefly-clamped to the tap min/max
// per axis, then the inverse tonemap and alpha 1.
//
// PERF (rr pass 2, ported from sr_downsample's pass 9+10, which the SR guard verified):
//  - the rh()/rh3() chain after every FIR tap existed only to match NeuralHub's rounding bit for
//    bit; the policy drops it, and native f16 FMA (v_pk_fma_f16 - what the oracle's ISA runs) both
//    matches the oracle's rounding more closely than f32-then-round and packs two channels per
//    instruction,
//  - the three Newton "remainder" pairs (c/0.36, e/100, m/expo) emulated exactly rounded IEEE
//    divides (v_div_scale/fmas/fixup); plain multiplies are allowed now (sr_downsample's guard
//    passes with them gone),
//  - TRUE two-pass separable FIR: a 16x16 output tile spans exactly 28 source rows, so the 5-tap
//    row filter runs ONCE per (source row, output column) = 448 times per tile instead of 5x per
//    output pixel (1280). The vertical pass reads 5 of them. Same arithmetic, same order: the row
//    sum and its Karis clamp are computed identically, only hoisted.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InRG   { f16vec2 in_rg[]; };
layout(set = 0, binding = 1) readonly buffer InB    { float16_t in_b[]; };
layout(set = 0, binding = 2) readonly buffer InExpo { vec4 in_expo; };
layout(set = 0, binding = 3) writeonly buffer OutImg{ vec4 out_color[]; };

layout(push_constant) uniform DownArgs {
    layout(offset = 16) int inW;
    int inH;
    layout(offset = 40) int oW;
    int oH;
};

shared f16vec3 s_patch[28][28];
// The hoisted row filters: pass 1 fills s_row[source row][output column], pass 2 reads 5 per output.
shared f16vec3 s_row[28][16];

float inv_tonemap(float16_t v0, float inv_e) {
    float c = clamp(float(v0), 0.00010000000475, 3.0);
    const float kInv036 = uintBitsToFloat(0x4031c71cu);   // 1/0.36
    const float kLog2_10 = uintBitsToFloat(0x40549a78u);  // log2(10): exp2 is 2^x
    const float k001 = uintBitsToFloat(0x3c23d70au);      // 0.01

    float p = (c * kInv036) * kLog2_10;
    float e = exp2(p) - 1.0;
    return e * k001 * inv_e;
}

void main() {
    int tile_x0 = int(floor((float(gl_WorkGroupID.x * 16u) + 0.5) * 1.5)) - 2;
    int tile_y0 = int(floor((float(gl_WorkGroupID.y * 16u) + 0.5) * 1.5)) - 2;

    uint tid = gl_LocalInvocationIndex;
    for (uint i = tid; i < 784u; i += 256u) {
        int py = int(i / 28u);
        int px = int(int(i) % 28);
        int gx = clamp(tile_x0 + px, 0, inW - 1);
        int gy = clamp(tile_y0 + py, 0, inH - 1);
        int idx = gy * inW + gx;
        s_patch[py][px] = f16vec3(in_rg[idx].x, in_rg[idx].y, in_b[idx]);
    }

    barrier();

    // The two 5-tap sets are the even/odd halves of the same symmetric kernel
    const float16_t wA0 = float16_t(-0.0413513), wA1 = float16_t(0.0872803), wA2 = float16_t(0.6201172);
    const float16_t wA3 = float16_t(0.3720703),  wA4 = float16_t(-0.0382996);
    const float16_t wB0 = float16_t(-0.0382996), wB1 = float16_t(0.3720703), wB2 = float16_t(0.6201172);
    const float16_t wB3 = float16_t(0.0872803),  wB4 = float16_t(-0.0413513);

    // ---- pass 1 (horizontal): one row filter per (source row, output column) ----
    for (uint i = gl_LocalInvocationIndex; i < 28u * 16u; i += 256u) {
        int py = int(i / 16u);
        int lx = int(int(i) % 16);
        int oxl = 16 * int(gl_WorkGroupID.x) + lx;
        int bxl = int(floor((float(oxl) + 0.5) * 1.5)) - tile_x0;
        f16vec3 t0 = s_patch[py][bxl - 2];
        f16vec3 t1 = s_patch[py][bxl - 1];
        f16vec3 t2 = s_patch[py][bxl + 0];
        f16vec3 t3 = s_patch[py][bxl + 1];
        f16vec3 t4 = s_patch[py][bxl + 2];
        // the x weights are set by the OUTPUT column's parity (16*gx is even, so lx's parity)
        bool odd = (lx & 1) != 0;
        f16vec2 r = t0.xy * f16vec2(odd ? wB0 : wA0);
        r = fma(t1.xy, f16vec2(odd ? wB1 : wA1), r);
        r = fma(t2.xy, f16vec2(odd ? wB2 : wA2), r);
        r = fma(t3.xy, f16vec2(odd ? wB3 : wA3), r);
        r = fma(t4.xy, f16vec2(odd ? wB4 : wA4), r);
        float16_t rb = t0.z * (odd ? wB0 : wA0);
        rb = fma(t1.z, odd ? wB1 : wA1, rb);
        rb = fma(t2.z, odd ? wB2 : wA2, rb);
        rb = fma(t3.z, odd ? wB3 : wA3, rb);
        rb = fma(t4.z, odd ? wB4 : wA4, rb);
        f16vec2 mn = min(min(min(t0.xy, t1.xy), min(t2.xy, t3.xy)), t4.xy);
        f16vec2 mx = max(max(max(t0.xy, t1.xy), max(t2.xy, t3.xy)), t4.xy);
        r = clamp(r, mn, mx);
        float16_t bmn = min(min(min(t0.z, t1.z), min(t2.z, t3.z)), t4.z);
        float16_t bmx = max(max(max(t0.z, t1.z), max(t2.z, t3.z)), t4.z);
        rb = clamp(rb, bmn, bmx);
        s_row[py][lx] = f16vec3(r.x, r.y, rb);
    }
    barrier();

    int ox = int(gl_GlobalInvocationID.x);
    int oy = int(gl_GlobalInvocationID.y);
    if (ox >= oW || oy >= oH) {
        return;
    }

    int bx = int(floor((float(ox) + 0.5) * 1.5)) - tile_x0;
    int by = int(floor((float(oy) + 0.5) * 1.5)) - tile_y0;
    int lx = ox - 16 * int(gl_WorkGroupID.x);

    float16_t wy[5];
    if ((oy & 1) != 0) {
        wy[0] = wB0; wy[1] = wB1; wy[2] = wB2; wy[3] = wB3; wy[4] = wB4;
    } else {
        wy[0] = wA0; wy[1] = wA1; wy[2] = wA2; wy[3] = wA3; wy[4] = wA4;
    }

    // ---- pass 2 (vertical): ONE tap per source row - the horizontal sum is already in s_row ----
    f16vec2 colrg = f16vec2(0.0);
    float16_t colb = float16_t(0.0);
    f16vec2 colmn = f16vec2(65504.0), colmx = f16vec2(-65504.0);
    float16_t colbn = float16_t(65504.0), colbx = float16_t(-65504.0);

    for (int j = 0; j < 5; ++j) {
        f16vec3 t = s_row[by - 2 + j][lx];
        colrg = fma(t.xy, f16vec2(wy[j]), colrg);
        colb = fma(t.z, wy[j], colb);
        colmn = min(colmn, t.xy);
        colmx = max(colmx, t.xy);
        colbn = min(colbn, t.z);
        colbx = max(colbx, t.z);
    }
    colrg = clamp(colrg, colmn, colmx);
    colb = clamp(colb, colbn, colbx);

    float inv_e = 1.0 / in_expo.x;
    vec3 final_rgb = vec3(inv_tonemap(colrg.x, inv_e),
                          inv_tonemap(colrg.y, inv_e),
                          inv_tonemap(colb, inv_e));

    out_color[oy * oW + ox] = vec4(final_rgb, 1.0);
}
