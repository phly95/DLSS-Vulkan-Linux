#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InRG   { f16vec2 in_rg[]; };
layout(set = 0, binding = 1) readonly buffer InB    { float16_t in_b[]; };
layout(set = 0, binding = 2) readonly buffer InExpo { vec4 in_expo; };
layout(set = 0, binding = 3) writeonly buffer OutImg{ vec4 out_color[]; };

layout(push_constant) uniform DownArgs {
    layout(offset = 16) int inW;
    int inH;
    layout(offset = 40) int oW;
    int oH;
};

shared f16vec3 s_patch[28][28];

float inv_tonemap(float v) {
    float c = clamp(v, 0.0001, 3.0);
    float t = c * (1.0 / 0.36);
    float p = t * 3.321928095;
    float e = in_expo.x;
    return (exp2(p) - 1.0) * (0.01 / e);
}

void main() {
    int tile_x0 = int(floor((float(gl_WorkGroupID.x * 16u) + 0.5) * 1.5)) - 2;
    int tile_y0 = int(floor((float(gl_WorkGroupID.y * 16u) + 0.5) * 1.5)) - 2;

    uint tid = gl_LocalInvocationIndex;
    for (uint i = tid; i < 784u; i += 256u) {
        int py = int(i / 28u);
        int px = int(i % 28u);
        int gx = clamp(tile_x0 + px, 0, inW - 1);
        int gy = clamp(tile_y0 + py, 0, inH - 1);
        int idx = gy * inW + gx;
        s_patch[py][px] = f16vec3(in_rg[idx].x, in_rg[idx].y, in_b[idx]);
    }

    barrier();

    int ox = int(gl_GlobalInvocationID.x);
    int oy = int(gl_GlobalInvocationID.y);
    if (ox >= oW || oy >= oH) return;

    int bx = int(floor((float(ox) + 0.5) * 1.5)) - tile_x0;
    int by = int(floor((float(oy) + 0.5) * 1.5)) - tile_y0;

    float16_t wx[5], wy[5];
    if ((ox & 1) != 0) {
        wx[0] = float16_t(-0.0382996);
        wx[1] = float16_t(0.3720703);
        wx[2] = float16_t(0.6201172);
        wx[3] = float16_t(0.0872803);
        wx[4] = float16_t(-0.0413513);
    } else {
        wx[0] = float16_t(-0.0413513);
        wx[1] = float16_t(0.0872803);
        wx[2] = float16_t(0.6201172);
        wx[3] = float16_t(0.3720703);
        wx[4] = float16_t(-0.0382996);
    }

    if ((oy & 1) != 0) {
        wy[0] = float16_t(-0.0382996);
        wy[1] = float16_t(0.3720703);
        wy[2] = float16_t(0.6201172);
        wy[3] = float16_t(0.0872803);
        wy[4] = float16_t(-0.0413513);
    } else {
        wy[0] = float16_t(-0.0413513);
        wy[1] = float16_t(0.0872803);
        wy[2] = float16_t(0.6201172);
        wy[3] = float16_t(0.3720703);
        wy[4] = float16_t(-0.0382996);
    }

    f16vec3 row[5];
    for (int k = 0; k < 5; ++k) {
        int yk = by - 2 + k;
        f16vec3 s0 = s_patch[yk][bx - 2];
        f16vec3 s1 = s_patch[yk][bx - 1];
        f16vec3 s2 = s_patch[yk][bx];
        f16vec3 s3 = s_patch[yk][bx + 1];
        f16vec3 s4 = s_patch[yk][bx + 2];

        f16vec3 r = s0 * wx[0] + s1 * wx[1] + s2 * wx[2] + s3 * wx[3] + s4 * wx[4];
        f16vec3 min_val = min(min(s1, s2), s3);
        f16vec3 max_val = max(max(s1, s2), s3);
        row[k] = clamp(r, min_val, max_val);
    }

    f16vec3 res = row[0] * wy[0] + row[1] * wy[1] + row[2] * wy[2] + row[3] * wy[3] + row[4] * wy[4];
    f16vec3 min_row = min(min(row[1], row[2]), row[3]);
    f16vec3 max_row = max(max(row[1], row[2]), row[3]);
    res = clamp(res, min_row, max_row);

    out_color[oy * oW + ox] = vec4(inv_tonemap(float(res.r)),
                                  inv_tonemap(float(res.g)),
                                  inv_tonemap(float(res.b)),
                                  1.0);
}
